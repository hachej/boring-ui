{
  "name": "boring-ui",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Composable native Pi adapters, resources and viewers; partial implementation with release qualification pending.",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "node scripts/check-docs.mjs && node scripts/check-platform-apis.mjs && node scripts/check-handlers.mjs && node scripts/check-sqlite-settings.mjs && node scripts/check-registry-blocks.mjs && node scripts/check-pi-boundary.mjs && node scripts/check-doc-drafts.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "npm run build && tsc --project tsconfig.contract-tests.json --noEmit",
    "pretest": "npm run build",
    "test": "node scripts/run-tests.mjs",
    "studio": "node examples/studio/server.mjs",
    "studio:headless": "node examples/studio/headless.mjs",
    "studio:journey": "node examples/studio/journey.mjs",
    "ambient": "node examples/ambient/server.mjs",
    "ambient:journey": "node examples/ambient/journey.mjs",
    "ambient:journey:scripted": "node examples/ambient/journey.mjs --scripted",
    "workspace-app": "node examples/workspace-app/server.mjs",
    "workspace-app:journey": "node examples/workspace-app/journey.mjs",
    "feedback": "node examples/feedback/server.mjs",
    "feedback:journey": "node examples/feedback/journey-composer.mjs",
    "feedback:journey:picker": "node examples/feedback/journey.mjs",
    "feedback:journey:e2e": "node examples/feedback/journey-e2e.mjs",
    "feedback:journey:ticket": "node examples/feedback/journey-ticket.mjs",
    "feedback:journey:preview": "node examples/feedback/journey-preview.mjs",
    "feedback:scenario": "node scripts/feedback-scenario.mjs",
    "feedback:voice-sync": "npm run build && node tools/feedback-voice-sync.mjs",
    "cloudflare:build": "npm run build && node examples/cloudflare/scripts/build-browser.mjs",
    "cloudflare:dev": "wrangler dev --config examples/cloudflare/wrangler.jsonc",
    "cloudflare:deploy": "npm run cloudflare:build && wrangler deploy --config examples/cloudflare/wrangler.jsonc",
    "aws:journey": "npm run build && node examples/aws/journey.mjs",
    "studio:journey:scripted": "node examples/studio/journey.mjs --scripted",
    "studio:smoke": "node examples/studio/journey.mjs --smoke",
    "studio:journey:correctness": "node examples/studio/journey-correctness.mjs",
    "studio:journey:team": "node examples/studio/journey-team.mjs",
    "slice:journey": "node examples/live-slice/journey.mjs",
    "bot": "node examples/bot/server.mjs",
    "bot:journey": "node examples/bot/journey.mjs",
    "browser-agent": "node examples/browser-agent/serve.mjs",
    "browser-agent:journey": "node examples/browser-agent/journey.mjs",
    "test:document-consumer": "node scripts/test-document-consumer.mjs",
    "verify": "npm run check && npm run typecheck && node scripts/run-tests.mjs && node scripts/verify-invariants.mjs",
    "verify:release": "npm run check && npm run typecheck && node scripts/run-tests.mjs && node scripts/verify-invariants.mjs --release",
    "test:editor-consumer": "node scripts/test-editor-consumer.mjs",
    "test:virtual-consumer": "node scripts/test-virtual-consumer.mjs",
    "test:presentation-consumer": "node scripts/test-question-consumer.mjs --presentation",
    "test:question-consumer": "node scripts/test-question-consumer.mjs",
    "test:canvas-consumer": "node scripts/test-canvas-consumer.mjs",
    "test:canvas-editor-consumer": "node scripts/test-canvas-consumer.mjs --editor",
    "canvas:journey:commands": "node scripts/test-canvas-browser.mjs",
    "test:remote-shell-consumer": "node scripts/test-remote-shell-consumer.mjs",
    "registry:build": "shadcn build registry.json --output public/r",
    "test:registry-consumer": "node scripts/test-registry-consumer.mjs",
    "test:app-registry-consumer": "node scripts/test-app-registry-consumer.mjs",
    "test:html-consumer": "node scripts/test-editor-consumer.mjs --html",
    "test:html-registry-consumer": "node scripts/test-registry-consumer.mjs --html",
    "test:feedback-registry-consumer": "node scripts/test-feedback-registry-consumer.mjs",
    "test:experience-consumer": "node scripts/test-experience-consumer.mjs",
    "test:remote-files-consumer": "node scripts/test-remote-files-consumer.mjs",
    "test:projection-consumer": "npm run build && node scripts/test-projection-consumer.mjs",
    "test:definitions-consumer": "node scripts/test-definitions-consumer.mjs",
    "test:testing-consumer": "npm run build && node scripts/test-testing-consumer.mjs",
    "canvas:journey:proposals": "node scripts/test-canvas-proposals-browser.mjs",
    "test:canvas-remote-consumer": "node scripts/test-canvas-consumer.mjs --remote",
    "canvas:journey:remote": "node scripts/test-canvas-remote-browser.mjs",
    "test:task-list-registry-consumer": "npm run registry:build && node scripts/test-registry-consumer.mjs --task-list",
    "task-list:journey": "node scripts/test-task-list-browser.mjs",
    "morning": "node examples/morning/server.mjs",
    "morning:journey": "node scripts/test-morning-browser.mjs",
    "test:morning-consumer": "node scripts/test-experience-consumer.mjs --morning",
    "redaction:browser": "node examples/redaction-browser/server.mjs",
    "redaction:journey": "node scripts/test-redaction-browser.mjs",
    "redaction:preparation:journey": "node scripts/test-redaction-preparation.mjs",
    "test:redaction-browser-consumer": "node scripts/test-editor-consumer.mjs --redaction",
    "check:pack": "node scripts/check-npm-packages.mjs",
    "draft-recovery:journey": "node examples/draft-recovery/journey.mjs",
    "release:preflight": "npm run verify:release && node scripts/check-npm-packages.mjs --release",
    "release:version": "node scripts/release-version.mjs",
    "file-tree:journey": "node examples/file-tree/journey.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-agentcore": "3.1146.0",
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-codemode": "1.0.4",
    "@earendil-works/pi-durable": "1.0.4",
    "@earendil-works/pi-mcp": "1.0.4",
    "@json-render/core": "0.21.0",
    "@json-render/react": "0.21.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-bubble-menu": "3.31.4",
    "@tiptap/extension-floating-menu": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tldraw/editor": "5.5.2",
    "@tldraw/store": "5.5.2",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/sandbox": "3.5.1",
    "agents": "0.26.0",
    "buffer": "6.0.3",
    "clsx": "2.1.1",
    "entities": "8.1.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "isomorphic-git": "1.43.1",
    "just-bash": "3.6.0",
    "lucide-react": "1.52.0",
    "marked": "17.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.3",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tldraw": "5.5.2",
    "typescript": "5.9.3",
    "use-stick-to-bottom": "1.1.6",
    "wrangler": "4.147.0",
    "zod": "4.6.5",
    "@tldraw/tlschema": "5.5.2",
    "ignore": "5.3.2",
    "@radix-ui/react-collapsible": "1.1.21"
  },
  "overrides": {
    "@earendil-works/pi-durable": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/chord": "1.0.4",
    "agents": {
      "@modelcontextprotocol/sdk": "1.32.0"
    }
  }
}
