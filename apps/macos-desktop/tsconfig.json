{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "electron"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src", "forge.config.ts", "scripts"]
}
