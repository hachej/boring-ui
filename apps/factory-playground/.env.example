# Optional: point the visible Factory workspace at another checkout.
BORING_FACTORY_WORKSPACE_ROOT=

# Optional: the epic key both seats are bound to (default: the epic branch name of the workspace root).
# BORING_FACTORY_EPIC_KEY=

# Host-side durable Pi sessions. Never place production sessions in container HOME.
BORING_AGENT_SESSION_ROOT=
# Optional host state root for the accepted-work request ledger.
BORING_FACTORY_STATE_ROOT=

# Optional strict default per seat, encoded as provider:model-id.
# Users may still select another available model for an individual session/turn.
BORING_FACTORY_ORCHESTRATOR_MODEL=openai-codex:gpt-5.6-sol
BORING_FACTORY_WORKER_MODEL=anthropic:claude-sonnet-4-6
# BORING_FACTORY_REVIEWER_MODEL=openai-codex:gpt-5.4

# Default is local-simulation: real isolated lease roots, but no security confinement.
BORING_FACTORY_SANDBOX_PROVIDER=local-simulation
BORING_FACTORY_SANDBOX_TTL_MS=1800000
BORING_FACTORY_SANDBOX_MAX_PER_WORKER=2
BORING_FACTORY_SANDBOX_MAX_TOTAL=4

# Vercel-only opt-in. Provider/snapshot/credentials remain host authority.
# BORING_FACTORY_SANDBOX_PROVIDER=vercel
# Optional: pin every lease to one fixed snapshot built from a single ref
# (e.g. origin/main) via `pnpm --filter factory-playground snapshot:vercel`.
# Leave unset (the default, recommended for a Factory instance bound to an
# epic branch) to use the per-epic snapshot registry instead: the host
# builds and caches one warm snapshot from THIS workspace's own HEAD per
# epicKey, so a lease's changed-since rebuild only ever sees that epic's own
# commits — not the drift between an epic branch and whatever ref a fixed
# snapshot happened to be built from. See snapshotRegistry.ts / README.
# BORING_FACTORY_VERCEL_SNAPSHOT_ID=  # from `pnpm --filter factory-playground snapshot:vercel` (warm by default; add --bare for the cheap node+git-only snapshot)
# Default 30 min (raised from 15: a snapshot whose baseSha has drifted from
# the epic branch can otherwise blow the lease's timeout on the incremental
# rebuild alone). The per-epic registry keeps this drift small in practice.
# BORING_AGENT_VERCEL_SANDBOX_TIMEOUT_MS=1800000
# Default 4 (the Factory composition applies this itself when unset — a
# default-resource, 1-vCPU lease reliably OOMs rebuilding memory-heavy
# packages during the warm bootstrap).
# BORING_AGENT_VERCEL_SANDBOX_VCPUS=4
# Bootstrap safety cap: if more than this many packages changed since the
# snapshot's baseSha, the lease refuses to rebuild serially and instead fails
# fast so the host can refresh the epic snapshot and retry (per-epic mode
# only — sandboxComposition.ts's provider wrapper does this automatically).
# BORING_FACTORY_MAX_INCREMENTAL_PACKAGES=12
# BORING_SANDBOX_TELEMETRY_SALT=
# VERCEL_OIDC_TOKEN=  # or VERCEL_ACCESS_TOKEN / VERCEL_TOKEN
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
# Optional git access token for the Vercel sandbox path against a PRIVATE
# origin (e.g. an epic launched via `factory-epic.mjs up --repo` against a
# private repo). Used to authenticate the seed-sandbox clone
# (warmSnapshot.ts) and the lease bootstrap's exact-SHA `git fetch`
# (remoteSnapshotProvider.ts) via a per-call `http.extraheader`, never
# written to git config or logged. When unset, falls back to `gh auth token`
# if the `gh` CLI is authenticated; otherwise git runs unauthenticated
# (fine for public repos).
# BORING_FACTORY_GIT_TOKEN=

# Optional override for how the exact-SHA tree reaches a Vercel sandbox.
# Default: 'fetch' when the workspace root has a resolvable 'origin' remote
# (seconds; the sandbox `git fetch`es the exact SHA itself, so the SHA must
# already be pushed and reachable on origin), else 'archive' (minutes; the
# full tracked tree is uploaded/seeded into the sandbox, works for any repo).
# BORING_FACTORY_REMOTE_SOURCE=fetch

# Gate 2 owner-handoff demo (`demo_sandbox`, Orchestrator-only). Default and hard
# cap for a live demo's TTL in minutes. Vercel's hobby-plan sandbox lifetime cap
# is 45 minutes; keep this at or below that.
# BORING_FACTORY_DEMO_MAX_MINUTES=40
