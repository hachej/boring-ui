# Optional: point the visible Factory workspace at another checkout.
BORING_FACTORY_WORKSPACE_ROOT=

# Host-side durable Pi sessions. Never place production sessions in container HOME.
BORING_AGENT_SESSION_ROOT=
# Optional host state root for the accepted-work request ledger.
BORING_FACTORY_STATE_ROOT=

# Default is local-simulation: real isolated lease roots, but no security confinement.
BORING_FACTORY_SANDBOX_PROVIDER=local-simulation
BORING_FACTORY_SANDBOX_TTL_MS=1800000
BORING_FACTORY_SANDBOX_MAX_PER_WORKER=2
BORING_FACTORY_SANDBOX_MAX_TOTAL=4

# Vercel-only opt-in. Provider/snapshot/credentials remain host authority.
# BORING_FACTORY_SANDBOX_PROVIDER=vercel
# BORING_FACTORY_VERCEL_SNAPSHOT_ID=
# BORING_AGENT_VERCEL_SANDBOX_TIMEOUT_MS=900000
# BORING_SANDBOX_TELEMETRY_SALT=
# VERCEL_OIDC_TOKEN=  # or VERCEL_ACCESS_TOKEN / VERCEL_TOKEN
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
