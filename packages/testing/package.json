{
  "name": "@hachej/boring-testing",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Node-only test helpers: a scripted keyless model on pi-ai's faux builders, a headless-Chromium driver over the DevTools protocol, an idle-timeout proxy and submit faults.",
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./network": {
      "types": "./dist/network.d.ts",
      "import": "./dist/network.js"
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.0.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hachej/boring-ui.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/hachej/boring-ui#readme",
  "bugs": {
    "url": "https://github.com/hachej/boring-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
