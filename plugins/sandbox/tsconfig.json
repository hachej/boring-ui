{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@hachej/boring-agent/shared": ["../../packages/agent/src/shared/index.ts"],
      "@hachej/boring-bash/agent": ["../../packages/boring-bash/src/agent/index.ts"],
      "@hachej/boring-sandbox/shared": ["../../packages/boring-sandbox/src/shared/index.ts"],
      "@hachej/boring-sandbox/providers/vercel-sandbox": ["../../packages/boring-sandbox/src/providers/vercel-sandbox/index.ts"],
      "@hachej/boring-workspace/server": ["../../packages/workspace/src/server/index.ts"]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}
