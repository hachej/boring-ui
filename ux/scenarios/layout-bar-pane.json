{
 "target": "layout:bar-pane",
 "title": "The right pane of the one composer",
 "summary": "The right pane: a line\u0027s detail, files in the kit\u0027s viewers, the library, previous and next, and a way back.",
 "try": [{"label": "Open a line's detail", "steps": [{"do": "tap", "text": "Card Harbor Garage", "until": "visible:fixture-record"}]}, {"label": "Open a file from the line", "steps": [{"do": "tap", "text": "Card Harbor Garage", "until": "visible:fixture-record"}, {"do": "tap", "target": "record-attachment[data-path=\"receipts/note-gap-0109.md\"]", "until": "visible:pane-markdown"}]}, {"label": "Open the library", "steps": [{"do": "tap", "target": "agent-bar-conversation", "until": "visible:agent-tray|agent-layer[data-state=half]"}, {"do": "tap", "target": "agent-layer-library", "until": "visible:fixture-library"}]}, {"label": "Ask the assistant to show a file", "steps": [{"do": "type", "target": "composer-input", "text": "Show me the discrepancies", "only": "1440"}, {"do": "tap", "target": "composer-submit", "only": "1440", "until": "visible:artifact-csv", "timeout": 8000}]}],
 "purpose": "AppShell composer=\"bar\": the right pane is one place with a back stack (an app's detail, a file in the kit's viewer, the library, the agent's present), previous and next through a set, Esc and focus, a phone's Back, a resize and a reload.",
 "fixture": {
  "entry": "test/fixtures/themes/one-composer.jsx",
  "query": "tabs=1",
  "queryBy": { "1440": "single=1" },
  "ready": "[data-testid=composer-input]",
  "install": "npx shadcn@4.23.0 add app-shell pi-chat agent-bar",
  "usage": "<AppShell layout=\"screen\" composer=\"bar\" nav={nav} agent={{ controller, library, files: { read: path => readBlob(path) } }} />  then useAgentLayer().pane.push({ title, content } | { file, files })"
 },
 "viewports": [
  { "name": "390", "width": 390, "height": 844, "touch": true },
  { "name": "1440", "width": 1440, "height": 900 }
 ],
 "watch": [["field", "[data-testid=composer]"], ["pane", "[data-testid=agent-preview]"], ["page", "[data-testid=page-row]"]],
 "thresholds": { "cls": 0.08, "settledMs": 1500, "touchTarget": 44 },
 "notes": "One pane, one stack: whatever opened it, the same frame, the same back control (“← <what is under>”), the same viewers. Back returns to what was under exactly as it was; the pane keeps its width whatever it shows; one message field in every state; a send never opens the conversation.",
 "states": [
  { "id": "01", "name": "detail", "steps": [{ "do": "tap", "text": "Card Harbor Garage", "until": "visible:fixture-record" }] },
  { "id": "02", "name": "file-over-detail", "steps": [{ "do": "tap", "text": "Card Harbor Garage", "until": "visible:fixture-record" }, { "do": "tap", "target": "record-attachment[data-path=\"receipts/note-gap-0109.md\"]", "until": "visible:pane-markdown" }] },
  { "id": "03", "name": "presented", "only": "1440", "steps": [{ "do": "type", "target": "composer-input", "text": "Show me the discrepancies" }, { "do": "tap", "target": "composer-submit", "until": "visible:artifact-csv", "timeout": 8000 }] }
 ],
 "flows": [
  { "id": "S1", "name": "A line's detail, a file on top, back to the detail as it was", "steps": [
    { "do": "tap", "target": "[data-testid=page-row]:has-text(\"Card Harbor Garage\")", "say": "Open the line of Jan 09", "motion": true, "until": "visible:fixture-record & text:agent-preview-title~Entry of Jan 09 & eval:(window.__pw = document.querySelector('[data-dock=preview]')?.getBoundingClientRect().width ?? 0) >= 0", "focus": "agent-preview-title", "expect": "The app's detail opens in the pane, focus on its heading." },
    { "do": "tap", "target": "label:has([data-testid=record-justified])", "say": "Tick “Gap justified”", "until": "eval:document.querySelector('[data-testid=record-justified]').checked" },
    { "do": "scroll", "target": "fixture-record", "to": 180, "say": "Scroll the detail down", "until": "eval:document.querySelector('[data-testid=fixture-record]').scrollTop > 60" },
    { "do": "tap", "target": "record-attachment[data-path=\"receipts/receipt-harbor-garage-0109.pdf\"]", "say": "Open the attached receipt", "motion": true, "until": "text:agent-preview-title~receipt-harbor-garage-0109.pdf & text:agent-preview-back~Entry of Jan 09 & text:file-position~1 / 3 & eval:Math.abs((document.querySelector('[data-dock=preview]')?.getBoundingClientRect().width ?? 0) - window.__pw) < 2", "focus": "agent-preview-title", "expect": "The PDF opens in the same pane in the kit's viewer, “← Entry of Jan 09”, at the same width." },
    { "do": "press", "key": "Escape", "only": "1440", "say": "Press Esc", "motion": true, "until": "text:agent-preview-title~Entry of Jan 09 & eval:document.querySelector('[data-testid=record-justified]').checked && document.querySelector('[data-testid=fixture-record]').scrollTop > 60", "focus": "record-attachment", "expect": "Back on the detail as it was (ticked, scrolled), focus on the attachment that opened the file." },
    { "do": "back", "only": "390", "say": "The phone's Back", "motion": true, "until": "text:agent-preview-title~Entry of Jan 09 & eval:document.querySelector('[data-testid=record-justified]').checked && document.querySelector('[data-testid=fixture-record]').scrollTop > 60", "focus": "record-attachment", "expect": "Back on the detail as it was." },
    { "do": "tap", "target": "record-attachment[data-path=\"receipts/note-gap-0109.md\"]", "only": "1440", "say": "Open the note", "until": "visible:pane-markdown & text:agent-preview-back~Entry of Jan 09" },
    { "do": "tap", "target": "agent-preview-close", "only": "1440", "say": "Close from the file", "motion": true, "until": "gone:agent-preview", "focus": "page-row", "expect": "The whole pane closes; focus is back on the row that opened the detail." },
    { "do": "tap", "target": "agent-preview-close", "only": "390", "say": "Close the detail", "until": "gone:agent-preview", "expect": "The pane closes." }
  ] },
  { "id": "S2", "name": "Docked, the agent presents a file: it takes the conversation's place under “← Assistant”", "only": "1440", "steps": [
    { "do": "tap", "target": "agent-bar-conversation", "say": "Open the conversation", "until": "visible:agent-tray" },
    { "do": "tap", "target": "agent-tray-dock", "say": "Dock it on the right", "until": "visible:agent-layer[data-state=open]" },
    { "do": "type", "target": "composer-input", "text": "Show me the discrepancies", "say": "Ask to see the gaps" },
    { "do": "tap", "target": "composer-submit", "say": "Send", "motion": true, "timeout": 8000, "until": "visible:agent-preview[data-placement=stacked] & visible:artifact-csv & text:agent-preview-back~Assistant & eval:window.__presented.some(a => a.kind === 'opened') && [...document.querySelectorAll('[data-testid=composer-input]')].filter(e => e.getClientRects().length).length === 1", "expect": "The file replaces the chat in the column, “← Assistant”; the one field stays under it; the agent's present is acknowledged." },
    { "do": "tap", "target": "agent-preview-back", "say": "“← Assistant”", "motion": true, "until": "gone:agent-preview & eval:(() => { const card = document.querySelector('[data-testid=agent-layer] [data-testid=artifact-card]'), box = card?.closest('[data-testid=transcript-scroll], [data-slot=scroll-area-viewport]') ?? document.querySelector('[data-testid=agent-layer]'); const a = card?.getBoundingClientRect(), b = box.getBoundingClientRect(); return !!a && a.bottom > b.top && a.top < b.bottom; })()", "expect": "The conversation is back where it was, the presenting message in view." },
    { "do": "tap", "target": "[data-testid=agent-layer] [data-testid=artifact-card]", "say": "Tap the file's card in the reply", "motion": true, "until": "visible:agent-preview[data-placement=stacked] & visible:artifact-csv & text:agent-preview-back~Assistant", "expect": "The same pane, as when the agent presented it." },
    { "do": "press", "key": "Escape", "say": "Press Esc", "until": "gone:agent-preview & visible:agent-layer[data-state=open]", "expect": "Back to the docked conversation." }
  ] },
  { "id": "S3", "name": "Folded at the bottom, the agent presents: the pane opens on the right, the conversation stays folded", "steps": [
    { "do": "type", "target": "composer-input", "text": "Show me the discrepancies", "say": "Ask to see the gaps" },
    { "do": "tap", "target": "composer-submit", "say": "Send", "motion": true, "timeout": 8000, "until": { "1440": "visible:agent-preview[data-placement=column] & visible:artifact-csv & gone:agent-tray & visible:agent-card", "390": "visible:agent-card-file & gone:agent-preview & eval:window.__presented.some(a => a.kind === 'refused')" }, "expect": "Wide: the file opens on the right, the reply card stays folded on the field. Phone: nothing takes the screen (the kit's narrow rule); the card offers the file." },
    { "do": "tap", "target": "agent-card-file[data-path=\"uploads/discrepancies-january.csv\"]", "only": "390", "say": "Tap the file on the card", "motion": true, "until": "visible:agent-preview[data-placement=screen] & visible:artifact-csv", "focus": "agent-preview-title", "expect": "The file opens full screen." },
    { "do": "tap", "target": "agent-preview-close", "say": "Close it", "motion": true, "until": "gone:agent-preview & visible:page-row", "expect": "Back on the page where it was." },
    { "do": "tap", "target": "[data-testid=page-row]:has-text(\"Card Harbor Garage\")", "only": "1440", "say": "Open the line of Jan 09", "until": "visible:fixture-record" },
    { "do": "type", "target": "composer-input", "text": "Show me the discrepancies", "only": "1440", "say": "Ask again" },
    { "do": "tap", "target": "composer-submit", "only": "1440", "say": "Send", "timeout": 8000, "until": "visible:artifact-csv & text:agent-preview-back~Entry of Jan 09", "expect": "The presented file goes on top of the detail." },
    { "do": "press", "key": "Escape", "only": "1440", "say": "Press Esc", "until": "visible:fixture-record & text:agent-preview-title~Entry of Jan 09", "expect": "Back returns to the detail." }
  ] },
  { "id": "K1", "name": "The files of one reply: a table, a PDF, a note; previous and next", "steps": [
    { "do": "type", "target": "composer-input", "text": "Show me the discrepancies", "say": "Ask to see the gaps" },
    { "do": "tap", "target": "composer-submit", "say": "Send", "timeout": 8000, "until": "visible:agent-card-file" },
    { "do": "tap", "target": "agent-card-file[data-path=\"uploads/discrepancies-january.csv\"]", "say": "Tap the table on the card", "until": "visible:artifact-csv & text:file-position~1 / 3", "expect": "A CSV is a table; “1 / 3” with previous and next." },
    { "do": "tap", "target": "file-next", "say": "Next file", "motion": true, "until": "text:agent-preview-title~receipt-harbor-garage-0109.pdf & text:file-position~2 / 3", "focus": "file-next", "expect": "The receipt PDF, in the same pane; focus stays on “next”." },
    { "do": "press", "key": "ArrowRight", "only": "1440", "say": "→", "until": "visible:pane-markdown & text:file-position~3 / 3", "expect": "The note, read as a note." },
    { "do": "swipe", "target": "agent-preview-body", "dir": "left", "only": "390", "say": "Swipe left", "until": "visible:pane-markdown & text:file-position~3 / 3", "expect": "The note." },
    { "do": "press", "key": "ArrowLeft", "only": "1440", "say": "←", "until": "text:agent-preview-title~receipt-harbor-garage-0109.pdf", "expect": "Back to the receipt." },
    { "do": "tap", "target": "file-previous", "only": "390", "say": "Previous file", "until": "text:agent-preview-title~receipt-harbor-garage-0109.pdf", "expect": "Back to the receipt." },
    { "do": "type", "target": "composer-input", "text": "x", "only": "1440", "say": "Type in the field" },
    { "do": "press", "key": "ArrowLeft", "only": "1440", "say": "← while typing", "until": "text:agent-preview-title~receipt-harbor-garage-0109.pdf", "expect": "The field keeps its arrows: the file does not change." },
    { "do": "tap", "target": "agent-preview-close", "say": "Close", "until": "gone:agent-preview" }
  ] },
  { "id": "K2", "name": "From the library: an image to zoom, a JSON, a text, a video; back to the library", "steps": [
    { "do": "tap", "target": "agent-bar-conversation", "say": "Open the conversation", "until": "visible:agent-tray|agent-layer[data-state=half]" },
    { "do": "tap", "target": "agent-layer-library", "say": "Tap “Library”", "until": "visible:fixture-library" },
    { "do": "tap", "text": "receipts", "say": "Unfold “receipts”", "until": "text:fixture-library~ticket-harbor-garage-0109.png" },
    { "do": "tap", "text": "ticket-harbor-garage-0109.png", "say": "Open the photo of the ticket", "motion": true, "until": "visible:[data-pane-top] img & text:agent-preview-back~Library & text:file-position~3 / 3", "expect": "The image in the kit's viewer, on top of the library, “3 / 3” of its folder." },
    { "do": "tap", "target": "agent-preview-zoom-in", "only": "1440", "say": "Zoom in", "until": "eval:!/^100/.test(document.querySelector('[data-testid=agent-preview-zoom-level]')?.textContent ?? '100')", "expect": "The image is larger." },
    { "do": "tap", "target": "agent-preview-back", "say": "“← Library”", "until": "visible:fixture-library & text:agent-preview-title~Library", "expect": "The library as it was (the folder still open)." },
    { "do": "tap", "text": "exports", "say": "Unfold “exports”", "until": "text:fixture-library~entries-january.json" },
    { "do": "tap", "text": "entries-january.json", "say": "Open the JSON export", "until": "visible:agent-preview-text & text:agent-preview-text~Card Harbor Garage", "expect": "Code as text." },
    { "do": "tap", "target": "file-next", "say": "Next file", "until": "text:agent-preview-text~Delmore House", "expect": "The plain text letter." },
    { "do": "tap", "target": "agent-preview-back", "say": "“← Library”", "until": "visible:fixture-library" },
    { "do": "tap", "text": "videos", "say": "Unfold “videos”", "until": "text:fixture-library~studio-tour.webm" },
    { "do": "tap", "text": "studio-tour.webm", "say": "Open the video", "timeout": 6000, "until": "visible:agent-preview-video", "expect": "The video plays with the native controls." },
    { "do": "tap", "target": { "390": "agent-preview-back", "1440": "agent-preview-close" }, "say": "Leave", "until": { "390": "visible:fixture-library", "1440": "gone:agent-preview" } }
  ] },
  { "id": "R1", "name": "A wider pane and a reload: the width and the files stay", "steps": [
    { "do": "tap", "target": "agent-bar-conversation", "say": "Open the conversation", "until": "visible:agent-tray|agent-layer[data-state=half]" },
    { "do": "tap", "target": "agent-layer-library", "say": "Tap “Library”", "until": "visible:fixture-library" },
    { "do": "tap", "text": "uploads", "say": "Unfold “uploads”", "until": "text:fixture-library~discrepancies-january.csv" },
    { "do": "tap", "text": "discrepancies-january.csv", "say": "Open the table", "until": "visible:artifact-csv & eval:(window.__pw = document.querySelector('[data-dock=preview]')?.getBoundingClientRect().width ?? 0) >= 0" },
    { "do": "focus", "target": "[role=separator]:has(+ [data-dock=preview])", "only": "1440", "say": "Focus the pane's edge" },
    { "do": "press", "key": "ArrowLeft ArrowLeft ArrowLeft ArrowLeft", "only": "1440", "say": "Widen it", "until": "eval:(sessionStorage.__pw2 = document.querySelector('[data-dock=preview]').getBoundingClientRect().width) > window.__pw + 40", "expect": "The pane grows." },
    { "do": "reload", "say": "Reload the page", "timeout": 8000, "until": "visible:artifact-csv & text:agent-preview-back~Library & eval:!document.querySelector('[data-dock=preview]') || Math.abs(document.querySelector('[data-dock=preview]').getBoundingClientRect().width - Number(sessionStorage.__pw2)) < 2", "expect": "The table is back, the library under it, at the width chosen." },
    { "do": "back", "only": "390", "say": "The phone's Back", "until": "visible:fixture-library & text:agent-preview-title~Library", "expect": "Back to the library." },
    { "do": "press", "key": "Escape", "only": "1440", "say": "Press Esc", "until": "visible:fixture-library & text:agent-preview-title~Library", "expect": "Back to the library." }
  ] }
 ]
}
