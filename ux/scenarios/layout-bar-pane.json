{
 "target": "layout:bar-pane",
 "title": "The right pane of the one composer",
 "purpose": "AppShell composer=\"bar\": the right pane is one place with a back stack (an app's detail, a file in the kit's viewer, the library, the agent's present), previous and next through a set, Échap and focus, a phone's Back, a resize and a reload.",
 "fixture": {
  "entry": "test/fixtures/themes/one-composer.jsx",
  "query": "tabs=1",
  "queryBy": { "1440": "single=1" },
  "ready": "[data-testid=composer-input]",
  "install": "npx shadcn@4.23.0 add app-shell pi-chat agent-bar",
  "usage": "<AppShell layout=\"screen\" composer=\"bar\" nav={nav} agent={{ controller, library, files: { read: path => readBlob(path) } }} />  then useAgentLayer().pane.push({ title, content } | { file, files })"
 },
 "viewports": [
  { "name": "390", "width": 390, "height": 844, "touch": true },
  { "name": "1440", "width": 1440, "height": 900 }
 ],
 "watch": [["field", "[data-testid=composer]"], ["pane", "[data-testid=agent-preview]"], ["page", "[data-testid=page-row]"]],
 "thresholds": { "cls": 0.08, "settledMs": 1500, "touchTarget": 44 },
 "notes": "One pane, one stack: whatever opened it, the same frame, the same back control (« ← <what is under> »), the same viewers. Back returns to what was under exactly as it was; the pane keeps its width whatever it shows; one message field in every state; a send never opens the conversation.",
 "states": [
  { "id": "01", "name": "detail", "steps": [{ "do": "tap", "text": "Carte Garage du Port", "until": "visible:fixture-record" }] },
  { "id": "02", "name": "file-over-detail", "steps": [{ "do": "tap", "text": "Carte Garage du Port", "until": "visible:fixture-record" }, { "do": "tap", "target": "record-attachment[data-path=\"justificatifs/note-ecart-0901.md\"]", "until": "visible:pane-markdown" }] },
  { "id": "03", "name": "presented", "only": "1440", "steps": [{ "do": "type", "target": "composer-input", "text": "Montre-moi les écarts" }, { "do": "tap", "target": "composer-submit", "until": "visible:artifact-csv", "timeout": 8000 }] }
 ],
 "flows": [
  { "id": "S1", "name": "A line's detail, a file on top, back to the detail as it was", "steps": [
    { "do": "tap", "target": "[data-testid=page-row]:has-text(\"Carte Garage du Port\")", "say": "Open the line of 09/01", "motion": true, "until": "visible:fixture-record & text:agent-preview-title~Écriture du 09/01 & eval:(window.__pw = document.querySelector('[data-dock=preview]')?.getBoundingClientRect().width ?? 0) >= 0", "focus": "agent-preview-title", "expect": "The app's detail opens in the pane, focus on its heading." },
    { "do": "tap", "target": "label:has([data-testid=record-justified])", "say": "Tick « Écart justifié »", "until": "eval:document.querySelector('[data-testid=record-justified]').checked" },
    { "do": "scroll", "target": "fixture-record", "to": 180, "say": "Scroll the detail down", "until": "eval:document.querySelector('[data-testid=fixture-record]').scrollTop > 60" },
    { "do": "tap", "target": "record-attachment[data-path=\"justificatifs/recu-garage-0901.pdf\"]", "say": "Open the attached receipt", "motion": true, "until": "text:agent-preview-title~recu-garage-0901.pdf & text:agent-preview-back~Écriture du 09/01 & text:file-position~1 / 3 & eval:Math.abs((document.querySelector('[data-dock=preview]')?.getBoundingClientRect().width ?? 0) - window.__pw) < 2", "focus": "agent-preview-title", "expect": "The PDF opens in the same pane in the kit's viewer, « ← Écriture du 09/01 », at the same width." },
    { "do": "press", "key": "Escape", "only": "1440", "say": "Press Échap", "motion": true, "until": "text:agent-preview-title~Écriture du 09/01 & eval:document.querySelector('[data-testid=record-justified]').checked && document.querySelector('[data-testid=fixture-record]').scrollTop > 60", "focus": "record-attachment", "expect": "Back on the detail as it was (ticked, scrolled), focus on the attachment that opened the file." },
    { "do": "back", "only": "390", "say": "The phone's Back", "motion": true, "until": "text:agent-preview-title~Écriture du 09/01 & eval:document.querySelector('[data-testid=record-justified]').checked && document.querySelector('[data-testid=fixture-record]').scrollTop > 60", "focus": "record-attachment", "expect": "Back on the detail as it was." },
    { "do": "tap", "target": "record-attachment[data-path=\"justificatifs/note-ecart-0901.md\"]", "only": "1440", "say": "Open the note", "until": "visible:pane-markdown & text:agent-preview-back~Écriture du 09/01" },
    { "do": "tap", "target": "agent-preview-close", "only": "1440", "say": "Close from the file", "motion": true, "until": "gone:agent-preview", "focus": "page-row", "expect": "The whole pane closes; focus is back on the row that opened the detail." },
    { "do": "tap", "target": "agent-preview-close", "only": "390", "say": "Close the detail", "until": "gone:agent-preview", "expect": "The pane closes." }
  ] },
  { "id": "S2", "name": "Docked, the agent presents a file: it takes the conversation's place under « ← Assistant »", "only": "1440", "steps": [
    { "do": "tap", "target": "agent-bar-conversation", "say": "Open the conversation", "until": "visible:agent-tray" },
    { "do": "tap", "target": "agent-tray-dock", "say": "Dock it on the right", "until": "visible:agent-layer[data-state=open]" },
    { "do": "type", "target": "composer-input", "text": "Montre-moi les écarts", "say": "Ask to see the gaps" },
    { "do": "tap", "target": "composer-submit", "say": "Send", "motion": true, "timeout": 8000, "until": "visible:agent-preview[data-placement=stacked] & visible:artifact-csv & text:agent-preview-back~Assistant & eval:window.__presented.some(a => a.kind === 'opened') && [...document.querySelectorAll('[data-testid=composer-input]')].filter(e => e.getClientRects().length).length === 1", "expect": "The file replaces the chat in the column, « ← Assistant »; the one field stays under it; the agent's present is acknowledged." },
    { "do": "tap", "target": "agent-preview-back", "say": "« ← Assistant »", "motion": true, "until": "gone:agent-preview & eval:(() => { const card = document.querySelector('[data-testid=agent-layer] [data-testid=artifact-card]'), box = card?.closest('[data-testid=transcript-scroll], [data-slot=scroll-area-viewport]') ?? document.querySelector('[data-testid=agent-layer]'); const a = card?.getBoundingClientRect(), b = box.getBoundingClientRect(); return !!a && a.bottom > b.top && a.top < b.bottom; })()", "expect": "The conversation is back where it was, the presenting message in view." },
    { "do": "tap", "target": "[data-testid=agent-layer] [data-testid=artifact-card]", "say": "Tap the file's card in the reply", "motion": true, "until": "visible:agent-preview[data-placement=stacked] & visible:artifact-csv & text:agent-preview-back~Assistant", "expect": "The same pane, as when the agent presented it." },
    { "do": "press", "key": "Escape", "say": "Press Échap", "until": "gone:agent-preview & visible:agent-layer[data-state=open]", "expect": "Back to the docked conversation." }
  ] },
  { "id": "S3", "name": "Folded at the bottom, the agent presents: the pane opens on the right, the conversation stays folded", "steps": [
    { "do": "type", "target": "composer-input", "text": "Montre-moi les écarts", "say": "Ask to see the gaps" },
    { "do": "tap", "target": "composer-submit", "say": "Send", "motion": true, "timeout": 8000, "until": { "1440": "visible:agent-preview[data-placement=column] & visible:artifact-csv & gone:agent-tray & visible:agent-card", "390": "visible:agent-card-file & gone:agent-preview & eval:window.__presented.some(a => a.kind === 'refused')" }, "expect": "Wide: the file opens on the right, the reply card stays folded on the field. Phone: nothing takes the screen (the kit's narrow rule); the card offers the file." },
    { "do": "tap", "target": "agent-card-file[data-path=\"uploads/ecarts-janvier.csv\"]", "only": "390", "say": "Tap the file on the card", "motion": true, "until": "visible:agent-preview[data-placement=screen] & visible:artifact-csv", "focus": "agent-preview-title", "expect": "The file opens full screen." },
    { "do": "tap", "target": "agent-preview-close", "say": "Close it", "motion": true, "until": "gone:agent-preview & visible:page-row", "expect": "Back on the page where it was." },
    { "do": "tap", "target": "[data-testid=page-row]:has-text(\"Carte Garage du Port\")", "only": "1440", "say": "Open the line of 09/01", "until": "visible:fixture-record" },
    { "do": "type", "target": "composer-input", "text": "Montre-moi les écarts", "only": "1440", "say": "Ask again" },
    { "do": "tap", "target": "composer-submit", "only": "1440", "say": "Send", "timeout": 8000, "until": "visible:artifact-csv & text:agent-preview-back~Écriture du 09/01", "expect": "The presented file goes on top of the detail." },
    { "do": "press", "key": "Escape", "only": "1440", "say": "Press Échap", "until": "visible:fixture-record & text:agent-preview-title~Écriture du 09/01", "expect": "Back returns to the detail." }
  ] },
  { "id": "K1", "name": "The files of one reply: a table, a PDF, a note; previous and next", "steps": [
    { "do": "type", "target": "composer-input", "text": "Montre-moi les écarts", "say": "Ask to see the gaps" },
    { "do": "tap", "target": "composer-submit", "say": "Send", "timeout": 8000, "until": "visible:agent-card-file" },
    { "do": "tap", "target": "agent-card-file[data-path=\"uploads/ecarts-janvier.csv\"]", "say": "Tap the table on the card", "until": "visible:artifact-csv & text:file-position~1 / 3", "expect": "A CSV is a table; « 1 / 3 » with previous and next." },
    { "do": "tap", "target": "file-next", "say": "Next file", "motion": true, "until": "text:agent-preview-title~recu-garage-0901.pdf & text:file-position~2 / 3", "focus": "file-next", "expect": "The receipt PDF, in the same pane; focus stays on « next »." },
    { "do": "press", "key": "ArrowRight", "only": "1440", "say": "→", "until": "visible:pane-markdown & text:file-position~3 / 3", "expect": "The note, read as a note." },
    { "do": "swipe", "target": "agent-preview-body", "dir": "left", "only": "390", "say": "Swipe left", "until": "visible:pane-markdown & text:file-position~3 / 3", "expect": "The note." },
    { "do": "press", "key": "ArrowLeft", "only": "1440", "say": "←", "until": "text:agent-preview-title~recu-garage-0901.pdf", "expect": "Back to the receipt." },
    { "do": "tap", "target": "file-previous", "only": "390", "say": "Previous file", "until": "text:agent-preview-title~recu-garage-0901.pdf", "expect": "Back to the receipt." },
    { "do": "type", "target": "composer-input", "text": "x", "only": "1440", "say": "Type in the field" },
    { "do": "press", "key": "ArrowLeft", "only": "1440", "say": "← while typing", "until": "text:agent-preview-title~recu-garage-0901.pdf", "expect": "The field keeps its arrows: the file does not change." },
    { "do": "tap", "target": "agent-preview-close", "say": "Close", "until": "gone:agent-preview" }
  ] },
  { "id": "K2", "name": "From the library: an image to zoom, a JSON, a text, a video; back to the library", "steps": [
    { "do": "tap", "target": "agent-bar-conversation", "say": "Open the conversation", "until": "visible:agent-tray|agent-layer[data-state=half]" },
    { "do": "tap", "target": "agent-layer-library", "say": "Tap « Bibliothèque »", "until": "visible:fixture-library" },
    { "do": "tap", "text": "justificatifs", "say": "Unfold « justificatifs »", "until": "text:fixture-library~ticket-garage-0901.png" },
    { "do": "tap", "text": "ticket-garage-0901.png", "say": "Open the photo of the ticket", "motion": true, "until": "visible:[data-pane-top] img & text:agent-preview-back~Bibliothèque & text:file-position~3 / 3", "expect": "The image in the kit's viewer, on top of the library, « 3 / 3 » of its folder." },
    { "do": "tap", "target": "agent-preview-zoom-in", "only": "1440", "say": "Zoom in", "until": "eval:!/^100/.test(document.querySelector('[data-testid=agent-preview-zoom-level]')?.textContent ?? '100')", "expect": "The image is larger." },
    { "do": "tap", "target": "agent-preview-back", "say": "« ← Bibliothèque »", "until": "visible:fixture-library & text:agent-preview-title~Bibliothèque", "expect": "The library as it was (the folder still open)." },
    { "do": "tap", "text": "exports", "say": "Unfold « exports »", "until": "text:fixture-library~ecritures-janvier.json" },
    { "do": "tap", "text": "ecritures-janvier.json", "say": "Open the JSON export", "until": "visible:agent-preview-text & text:agent-preview-text~Carte Garage du Port", "expect": "Code as text." },
    { "do": "tap", "target": "file-next", "say": "Next file", "until": "text:agent-preview-text~Maison Delorme", "expect": "The plain text letter." },
    { "do": "tap", "target": "agent-preview-back", "say": "« ← Bibliothèque »", "until": "visible:fixture-library" },
    { "do": "tap", "text": "videos", "say": "Unfold « videos »", "until": "text:fixture-library~visite-atelier.webm" },
    { "do": "tap", "text": "visite-atelier.webm", "say": "Open the video", "timeout": 6000, "until": "visible:agent-preview-video", "expect": "The video plays with the native controls." },
    { "do": "tap", "target": { "390": "agent-preview-back", "1440": "agent-preview-close" }, "say": "Leave", "until": { "390": "visible:fixture-library", "1440": "gone:agent-preview" } }
  ] },
  { "id": "R1", "name": "A wider pane and a reload: the width and the files stay", "steps": [
    { "do": "tap", "target": "agent-bar-conversation", "say": "Open the conversation", "until": "visible:agent-tray|agent-layer[data-state=half]" },
    { "do": "tap", "target": "agent-layer-library", "say": "Tap « Bibliothèque »", "until": "visible:fixture-library" },
    { "do": "tap", "text": "uploads", "say": "Unfold « uploads »", "until": "text:fixture-library~ecarts-janvier.csv" },
    { "do": "tap", "text": "ecarts-janvier.csv", "say": "Open the table", "until": "visible:artifact-csv & eval:(window.__pw = document.querySelector('[data-dock=preview]')?.getBoundingClientRect().width ?? 0) >= 0" },
    { "do": "focus", "target": "[role=separator]:has(+ [data-dock=preview])", "only": "1440", "say": "Focus the pane's edge" },
    { "do": "press", "key": "ArrowLeft ArrowLeft ArrowLeft ArrowLeft", "only": "1440", "say": "Widen it", "until": "eval:(sessionStorage.__pw2 = document.querySelector('[data-dock=preview]').getBoundingClientRect().width) > window.__pw + 40", "expect": "The pane grows." },
    { "do": "reload", "say": "Reload the page", "timeout": 8000, "until": "visible:artifact-csv & text:agent-preview-back~Bibliothèque & eval:!document.querySelector('[data-dock=preview]') || Math.abs(document.querySelector('[data-dock=preview]').getBoundingClientRect().width - Number(sessionStorage.__pw2)) < 2", "expect": "The table is back, the library under it, at the width chosen." },
    { "do": "back", "only": "390", "say": "The phone's Back", "until": "visible:fixture-library & text:agent-preview-title~Bibliothèque", "expect": "Back to the library." },
    { "do": "press", "key": "Escape", "only": "1440", "say": "Press Échap", "until": "visible:fixture-library & text:agent-preview-title~Bibliothèque", "expect": "Back to the library." }
  ] }
 ]
}
