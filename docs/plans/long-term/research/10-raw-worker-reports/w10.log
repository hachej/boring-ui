+  const keep =
+    /^#{1,6} /.test(prev) ||
+    /^#{1,6} /.test(next) ||
+    /^[-*+] /.test(next) ||
+    /^\d+\. /.test(next) ||
+    /^```/.test(next) ||
+    /^\|/.test(next) ||
+    (/^[-*+] /.test(prev) && !/^[-*+] /.test(next)) ||
+    (/^\|/.test(prev) && !/^\|/.test(next)) ||
+    (/^```/.test(prev))
+  if (keep && out.at(-1) !== '') out.push('')
+}
+
+fs.writeFileSync(path, out.join('\n').replace(/\n{3,}/g, '\n\n'))
