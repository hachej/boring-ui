   757	/**
   758	 * Projects only Agent-site contributions from canonical artifacts that the app
   759	 * resolver already imported and preflighted. It never discovers or loads a
   760	 * package, so Workspace and fleet activation cannot grow separate machinery.
   761	 */
   762	export function projectAgentSpecPluginArtifacts(
   763	  agent: AgentHostAgentSpec,
   764	  artifacts: readonly ResolvedWorkspacePluginArtifact[],
   765	): AgentSpecPluginArtifactProjection {
   766	  const byId = new Map<string, ResolvedWorkspacePluginArtifact>()
   767	  for (const artifact of artifacts) {
   768	    if (byId.has(artifact.id)) {
   769	      throw new AgentSpecPluginProjectionError(`duplicate resolved plugin artifact "${artifact.id}"`)
   770	    }
   771	    byId.set(artifact.id, artifact)
   772	  }
   773	
   774	  const requested = "legacyDefault" in agent ? [] : (agent.plugins ?? [])
   775	  const selected: ResolvedWorkspacePluginArtifact[] = []
   776	  const selectedIds = new Set<string>()
   777	  for (const binding of requested) {
   778	    if (selectedIds.has(binding.name)) {
   779	      throw new AgentSpecPluginProjectionError(
   780	        `agent "${agent.agentTypeId}" selects plugin "${binding.name}" more than once`,
   781	      )
   782	    }
   783	    selectedIds.add(binding.name)
   784	    const artifact = byId.get(binding.name)
   785	    if (!artifact) {
   786	      throw new AgentSpecPluginProjectionError(
   787	        `agent "${agent.agentTypeId}" selects plugin "${binding.name}" without a preflighted artifact`,
   788	      )
   789	    }
   790	    selected.push(artifact)
   791	  }
   792	
   793	  const projected = bootstrapServer({ plugins: selected.map((artifact) => artifact.plugin) })
   794	  return {
   795	    artifacts: selected,
   796	    runtimePlugins: projected.runtimePlugins,
   797	    agentOptions: {
   798	      extraTools: projected.agentTools,
   799	      systemPromptAppend: projected.systemPromptAppend || undefined,
   800	      pi: {
   801	        packages: projected.piPackages,
   802	        extensionPaths: projected.extensionPaths,
   803	      },
   804	    },
   805	  }
   806	}
