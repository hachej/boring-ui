    94	/**
    95	 * Resolves an Agent's declared `mcpServerRefs` into the connectors/tools it
    96	 * is actually allowed to use, through per-agent grants only — never a
    97	 * parallel authorization path.
    98	 *
    99	 * - Default-deny: no grants for `(workspaceId, agentTypeId)` -> no connectors.
   100	 * - Every declared ref without a matching grant is dropped with a stable
   101	 *   diagnostic; it is never silently ignored.
   102	 * - A granted connector does not imply all of its tools: `allowedTools` is
   103	 *   the tool-level filter, and (when a catalog is supplied) is further
   104	 *   intersected with the connector's known tool surface.
   105	 * - Isolation: resolution only ever consults grants whose `agentTypeId`
   106	 *   exactly matches the requested Agent, so two Agents in one workspace
   107	 *   never see each other's connectors.
   108	 */
   109	export function resolveAgentMcpGrants(input: ResolveAgentMcpGrantsInput): ResolvedAgentMcpGrants {
   110	  const { workspaceId, agentTypeId, mcpServerRefs, grants, catalog } = input
   111	  const connectors: ResolvedMcpConnectorGrant[] = []
   112	  const diagnostics: McpGrantDiagnostic[] = []
   113	
   114	  const grantsByConnector = new Map<string, McpGrant>()
   115	  for (const grant of grants) {
   116	    if (grant.workspaceId !== workspaceId || grant.agentTypeId !== agentTypeId) continue
   117	    grantsByConnector.set(grant.connectorId, grant)
   118	  }
   119	
   120	  for (const ref of new Set(mcpServerRefs)) {
   121	    const grant = grantsByConnector.get(ref)
   122	    if (!grant) {
   123	      diagnostics.push({
   124	        code: ErrorCode.enum.AGENT_MCP_GRANT_REF_UNGRANTED,
   125	        connectorId: ref,
   126	        message: `mcpServerRefs entry '${ref}' has no matching MCP grant for this Agent in this workspace; it was dropped.`,
   127	      })
   128	      continue
   129	    }
   130	
   131	    const catalogTools = catalog?.getConnectorTools(grant.connectorId)
   132	    if (catalog && !catalogTools) {
   133	      // The connector is unknown to the catalog. This must DENY, not skip
   134	      // filtering: silently admitting every grant.allowedTools entry here
   135	      // would mean an unrecognized/misconfigured connectorId gets a free
   136	      // pass to every tool a grant happens to list, which is the opposite
   137	      // of default-deny.
   138	      diagnostics.push({
   139	        code: ErrorCode.enum.AGENT_MCP_GRANT_CONNECTOR_UNKNOWN,
   140	        connectorId: grant.connectorId,
   141	        message: `Grant for connector '${grant.connectorId}' references a connector unknown to the supplied catalog; the connector was dropped.`,
   142	      })
   143	      continue
   144	    }
   145	
   146	    const allowedTools: string[] = []
   147	    // Defend against a grant sourced from a third-party/legacy store where
   148	    // `allowedTools` may be missing or non-array despite the interface
   149	    // declaring it required — iterating it directly would throw "not
   150	    // iterable" and take down resolution for every other ref.
   151	    for (const tool of Array.isArray(grant.allowedTools) ? grant.allowedTools : []) {
   152	      if (catalogTools && !catalogTools.includes(tool)) {
   153	        diagnostics.push({
   154	          code: ErrorCode.enum.AGENT_MCP_GRANT_TOOL_NOT_ALLOWED,
   155	          connectorId: grant.connectorId,
   156	          tool,
   157	          message: `Grant for connector '${grant.connectorId}' allows tool '${tool}', which is not part of the connector's known tool catalog; it was dropped.`,
   158	        })
   159	        continue
   160	      }
   161	      allowedTools.push(tool)
   162	    }
   163	
   164	    connectors.push({ connectorId: grant.connectorId, allowedTools })
   165	  }
   166	
   167	  return { connectors, diagnostics }
   168	}

