   825	async function assertAgentReloadAvailable(blockers: readonly WorkspaceAgentReloadBlocker[]): Promise<void> {
   826	  for (const blocker of blockers) {
   827	    const block = await blocker.getBlock()
   828	    if (!block) continue
   829	    if (typeof block.code !== "string" || !block.code || typeof block.message !== "string" || !block.message) {
