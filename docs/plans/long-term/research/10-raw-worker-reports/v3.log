   121	      if (!isPending(question)) throw new AskUserStoreError(ASK_USER_ERROR_CODES.QUESTION_NOT_FOUND, "question is not pending")
   122	      question.status = "cancelled"
   123	      question.updatedAt = nowIso()
   124	      delete state.pendingBySession[question.sessionId]
   125	      this.emit({ sessionId: question.sessionId, questionId, reason: "cancel" })
   126	    })
