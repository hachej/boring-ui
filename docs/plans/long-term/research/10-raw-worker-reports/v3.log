    94	export async function appendVerifiedNativeRename(
    95	  filepath: string,
    96	  sessionDir: string,
    97	  cwd: string,
    98	  title: string,
    99	): Promise<void> {
   100	  const staleRenameIds = new Set<string>();
   101	  for (let attempt = 0; attempt < NATIVE_RENAME_MAX_ATTEMPTS; attempt += 1) {
   102	    try {
   103	      // Stat before opening so any append between open and append is inside the
   104	      // bounded inspected suffix and forces a fresh branch attempt.
   105	      const before = await fsStat(filepath);
   106	      const header = parseJsonlPrefixEntries(await readJsonlPrefix(filepath)).find(
   107	        (entry): entry is SessionHeader => entry.type === "session",
   108	      );
   109	      if (header?.version !== CURRENT_SESSION_VERSION) {
   110	        throw nativeRenameLockedError("This native session was created by an unsupported Pi version and cannot be renamed.");
   111	      }
   112	      const manager = SessionManager.open(filepath, sessionDir, cwd);
   113	      if (staleRenameIds.size > 0) {
   114	        const concurrentLeaf = latestConcurrentEntryId(manager, staleRenameIds);
   115	        if (!concurrentLeaf) break;
   116	        manager.branch(concurrentLeaf);
   117	      }
   118	      const append: NativeRenameAppend = {
   119	        parentId: manager.getLeafId(),
   120	        id: manager.appendSessionInfo(title),
   121	      };
   122	      staleRenameIds.add(append.id);
   123	      const verifiedSize = await verifiedNativeRenameAppend(filepath, before, append, title);
   124	      if (verifiedSize !== null) {
   125	        await restoreVerifiedNativeRenameMtime(filepath, before, verifiedSize);
   126	        return;
   127	      }
   128	    } catch (error) {
   129	      if ((error as { code?: unknown }).code === ErrorCode.enum.SESSION_LOCKED) throw error;
   130	      // The next bounded optimistic attempt reopens Pi's latest session tree.
   131	    }
   132	  }
   133	  throw nativeRenameLockedError();
   134	}
