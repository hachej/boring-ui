   114	    this.perPrincipalPerHour = options.limits?.perPrincipalPerHour ?? 30
   115	  }
   116	
   117	  async abandonOrphanedPending(sessionIds: string[]): Promise<void> {
   118	    for (const sessionId of sessionIds) {
   119	      const pending = await this.store.getPending(sessionId)
   120	      if (pending && !this.coordinator.hasWaiter(pending.questionId)) {
   121	        await this.abandon(pending.questionId, pending.sessionId)
   122	      }
   123	    }
   124	  }
   125	
   126	
   127	  async ask(request: AskUserRequest, signal?: AbortSignal): Promise<AskUserToolResult> {
   128	    const ownerPrincipalId = request.ownerPrincipalId ?? this.ownerPrincipalId
   129	    await this.abandonOrphanedPending([request.sessionId])
   130	    this.assertAllowed(request.sessionId, ownerPrincipalId)
   131	    const parsedArtifacts = HumanArtifactListSchema.safeParse(request.artifacts ?? [])
   132	    if (!parsedArtifacts.success) throw new AskUserRuntimeError(ASK_USER_ERROR_CODES.SCHEMA_INVALID, parsedArtifacts.error.message)
   133	    const question = this.createQuestion({ ...request, artifacts: parsedArtifacts.data, ownerPrincipalId })
   134	    const parsed = AskUserFormSchemaSchema.safeParse(request.schema)
   135	    if (!parsed.success) throw new AskUserRuntimeError(ASK_USER_ERROR_CODES.SCHEMA_INVALID, parsed.error.message)
   136	    question.schema = parsed.data
   137	
   138	    // Register the waiter before publishing/persisting the question. The UI
   139	    // state publisher can make a question answerable as soon as createPending
   140	    // mutates the store; if the browser answers in that small window before the
   141	    // waiter exists, submitAnswer correctly treats it as abandoned. Cancellation
   142	    // is armed only after persistence so abort/timeout cannot leave a visible
   143	    // question with no waiter.
   144	    const pendingAnswer = this.coordinator.registerWaiter(question.questionId, question.sessionId)
   145	    try {
   146	      await this.store.createPending(question)
   147	      await this.store.appendTranscriptEvent({ type: "created", question, at: this.isoNow() })
   148	      await this.store.appendTranscriptEvent({ type: "ready", questionId: question.questionId, sessionId: question.sessionId, schema: parsed.data, at: this.isoNow() })
   149	      if (signal?.aborted) {
   150	        await this.cancelQuestion(question.questionId, question.sessionId, "aborted")
