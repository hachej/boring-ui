    44	/**
    45	 * Opens (or creates) the durable event-stream SQLite database under the same
    46	 * durable-volume root convention as session storage (AGENTS.md hard rule 9):
    47	 * `sessionRoot` (the host's `BORING_AGENT_SESSION_ROOT`-derived path) when
    48	 * set, else the HOST-side storage root resolved via
    49	 * `getOptionalRuntimeBundleStorageRoot` — the same accessor already used
    50	 * twelve lines above this call for `bashRuntimeBundle`. This deliberately
    51	 * never falls back to `runtimeBundle.workspace.root`: in sandbox runtime
    52	 * mode that is an IN-SANDBOX (guest) path, and writing the durable store
    53	 * there would either fail invisibly or, worse, silently land the "durable"
    54	 * store inside an ephemeral guest filesystem that vanishes with the sandbox.
    55	 * If the store cannot be opened while the durable-stream flag is on —
    56	 * because neither a session root nor a host storage root is resolvable, or
    57	 * because `openDatabase` fails at the resolved path — this fails LOUDLY:
    58	 * a stable-coded telemetry diagnostic is reported and a
    59	 * {@link DurableStreamUnavailableError} (code `DURABLE_STREAM_UNAVAILABLE`,
    60	 * carrying the underlying cause) is thrown so boot aborts. The operator
    61	 * asked for durability; silently degrading to in-memory streaming would
    62	 * betray that. Flag off = this function is never called and behavior is
    63	 * byte-identical to pre-durability composition.
    64	 */
    65	export function openDurableEventStore(input: {
    66	  readonly sessionRoot?: string
