    87	  async createPending(question: AskUserQuestion): Promise<void> {
    88	    await this.mutate(async (state) => {
    89	      const existing = state.pendingBySession[question.sessionId]
    90	      if (existing && isPending(state.questions[existing])) {
    91	        throw new AskUserStoreError(ASK_USER_ERROR_CODES.PENDING_EXISTS, "a pending question already exists for this session")
