     1	export function textFromPiContent(content: unknown): string {
     2	  if (typeof content === "string") return content;
     3	  if (!Array.isArray(content)) return "";
     4	  return content
     5	    .map((part) => {
     6	      const item = part as { type?: unknown; text?: unknown } | null;
     7	      return item?.type === "text" && typeof item.text === "string" ? item.text : "";
     8	    })
     9	    .join("");
    10	}
