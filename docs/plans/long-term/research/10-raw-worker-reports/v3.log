    29	    const atimeSeconds = fileTimeSeconds(before.atimeMs);
    30	    const mtimeSeconds = fileTimeSeconds(before.mtimeMs);
    31	    if (atimeSeconds === undefined || mtimeSeconds === undefined) return;
    32	    await utimes(filepath, atimeSeconds, mtimeSeconds);
    33	
    34	    const restored = await fsStat(filepath);
    35	    if (restored.size !== verifiedSize) {
    36	      const restoredAtimeSeconds = fileTimeSeconds(restored.atimeMs);
    37	      if (restoredAtimeSeconds !== undefined) await utimes(filepath, restoredAtimeSeconds, Date.now() / 1000);
    38	    }
