    15	}
    16	
    17	export function questionsRoutes(app: FastifyInstance, opts: QuestionsRoutesOptions, done: (err?: Error) => void): void {
    18	  app.post("/api/v1/questions/commands", async (request, reply) => {
    19	    if (!passesOrigin(request, opts.allowedOrigins)) return reply.code(403).send({ error: "forbidden", message: "invalid origin" })
    20	    if (!(await passesCsrf(request, opts))) return reply.code(403).send({ error: "forbidden", message: "invalid csrf token" })
    21	
    22	    const parsed = QuestionsCommandSchema.safeParse(request.body)
    23	    if (!parsed.success) {
    24	      return reply.code(400).send({ error: "validation_error", message: parsed.error.issues[0]?.message ?? "invalid command" })
    25	    }
    26	
    27	    const bridge = new QuestionsBridge({
    28	      store: opts.store,
    29	      runtime: opts.runtime,
    30	      getAuthContext: opts.getAuthContext ? () => opts.getAuthContext!(request) : undefined,
    31	    })
    32	
    33	    try {
    34	      return await bridge.handle(parsed.data as QuestionsCommand)
    35	    } catch (error) {
    36	      return sendError(reply, error)
    37	    }
    38	  })
    39	
    40	  done()
    41	}
    42	
    43	function passesOrigin(request: FastifyRequest, allowedOrigins?: string[]): boolean {
    44	  if (!allowedOrigins || allowedOrigins.length === 0) return true
    45	  const origin = request.headers.origin
    46	  return typeof origin === "string" && allowedOrigins.includes(origin)
    47	}
    48	
    49	async function passesCsrf(request: FastifyRequest, opts: QuestionsRoutesOptions): Promise<boolean> {
    50	  if (!opts.csrfToken) return true
    51	  const headerName = (opts.csrfHeaderName ?? "x-csrf-token").toLowerCase()
    52	  const actual = request.headers[headerName]
    53	  const expected = typeof opts.csrfToken === "function" ? await opts.csrfToken(request) : opts.csrfToken
    54	  return typeof actual === "string" && typeof expected === "string" && constantTimeEqual(expected, actual)
    55	}
    56	
    57	function sendError(reply: FastifyReply, error: unknown) {
    58	  if (error instanceof QuestionsBridgeError) {
    59	    return reply.code(error.statusCode).send({ error: error.code, message: error.message })
    60	  }
    61	  throw error
    62	}

