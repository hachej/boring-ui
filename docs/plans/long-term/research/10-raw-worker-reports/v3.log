    37	  const globalSettingsPath = join(agentDir, "settings.json");
    38	  const projectSettingsPath = join(cwd, ".pi", "settings.json");
    39	  let globalSettingsOverrideJson: string | undefined;
    40	  let projectSettingsOverrideJson: string | undefined;
    41	
    42	  // Host-declared Pi packages are an in-memory project overlay. Normal reads
    43	  // still come from Pi's real settings files so `resourceLoader.reload()` sees
    44	  // user edits; SettingsManager writes remain in-memory.
    45	  const storage: Parameters<typeof SettingsManager.fromStorage>[0] = {
    46	    withLock(scope, fn) {
    47	      if (scope === "global") {
    48	        const current = globalSettingsOverrideJson
    49	          ?? mergeInjectedProjectPackages(readSettingsFileIfPresent(globalSettingsPath), [], options.includePackage);
