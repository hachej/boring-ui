   196	    }
   197	  }
   198	
   199	  private async waitForAnswer(
   200	    question: AskUserQuestion,
   201	    pendingAnswer: Promise<AskUserToolResult>,
   202	    timeoutMs?: number,
   203	    signal?: AbortSignal,
   204	  ): Promise<AskUserToolResult> {
   205	    let settled = false
   206	    const cancel = (reason: AskUserCancelReason) => {
   207	      if (settled) return
   208	      void this.cancelQuestion(question.questionId, question.sessionId, reason).catch(() => undefined)
   209	    }
   210	    const onAbort = () => cancel("aborted")
   211	    signal?.addEventListener("abort", onAbort, { once: true })
   212	    if (signal?.aborted) cancel("aborted")
