   113	      case "text":
   114	      case "textarea":
   115	        if (typeof value !== "string") throw invalid(field.name)
   116	        if (field.minLength !== undefined && value.length < field.minLength) throw invalid(field.name)
   117	        if (field.maxLength !== undefined && value.length > field.maxLength) throw invalid(field.name)
   118	        if (field.type === "text" && field.pattern && !new RegExp(field.pattern).test(value)) throw invalid(field.name)
