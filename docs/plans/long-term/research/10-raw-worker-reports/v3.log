   169	    const globals = await discoverFromDir(GLOBAL_DIR, "global");
   170	    candidates.push(...globals);
   171	  }
   172	
   173	  const localDir = join(options.cwd, LOCAL_DIR);
   174	  const locals = await discoverFromDir(localDir, "local");
   175	  candidates.push(...locals);
   176	
   177	  const npmDirs = await discoverNpmPlugins(options.cwd);
   178	  for (const dir of npmDirs) {
   179	    candidates.push({ path: dir, source: "npm" });
   180	  }
   181	
   182	  const config = await loadExtensionsJson(options.cwd);
   183	  if (config?.npm) {
   184	    for (const pkg of config.npm) {
   185	      const pkgDir = join(options.cwd, "node_modules", pkg);
