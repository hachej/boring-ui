   173	  private async mutate(fn: (state: StoredAskUserState) => Promise<void> | void): Promise<void> {
   174	    const run = this.writeChain.then(async () => {
   175	      const state = await this.load()
   176	      await fn(state)
   177	      await this.save(state)
   178	    })
   179	    this.writeChain = run.catch(() => undefined)
   180	    return run
   181	  }
   182	
   183	  private async load(): Promise<StoredAskUserState> {
   184	    if (this.state) return this.state
   185	    if (!this.loadInFlight) {
   186	      this.loadInFlight = (async () => {
   187	        try {
   188	          const raw = await readFile(this.filePath, "utf8")
   189	          this.state = { ...clone(EMPTY_STATE), ...JSON.parse(raw) }
   190	        } catch (error) {
   191	          if ((error as { code?: string }).code !== "ENOENT") throw error
   192	          this.state = clone(EMPTY_STATE)
   193	        }
   194	        return this.state as StoredAskUserState
   195	      })().finally(() => {
   196	        this.loadInFlight = null
   197	      })
   198	    }
   199	    return this.loadInFlight
   200	  }
   201	
   202	  private async save(state: StoredAskUserState): Promise<void> {
   203	    await mkdir(dirname(this.filePath), { recursive: true })
   204	    const tmp = join(dirname(this.filePath), `.${randomUUID()}.tmp`)
   205	    await writeFile(tmp, JSON.stringify(state, null, 2), "utf8")
   206	    await rename(tmp, this.filePath)
   207	  }
   208	
   209	  private emit(change: AskUserStoreChange): void {
   210	    for (const listener of this.listeners) {
   211	      try {
   212	        const result = listener(change) as unknown
   213	        if (isPromiseLike(result)) result.catch(() => undefined)
   214	      } catch {
   215	        // Store mutations must not be rolled back because an observer failed.
   216	      }
   217	    }
   218	  }
   219	}
