   152	      }
   153	      return await this.waitForAnswer(question, pendingAnswer, request.timeoutMs, signal)
   154	    } catch (error) {
   155	      this.coordinator.resolveCancelled(question.questionId, "abandoned")
   156	      throw error
   157	    }
   158	  }
