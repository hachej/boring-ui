   225	  private async resolveCancelledUnlessAnswered(questionId: string, reason: AskUserCancelReason): Promise<void> {
   226	    const latest = await this.store.getByQuestionId(questionId).catch(() => null)
   227	    if (latest?.status === "answered") return
   228	    this.coordinator.resolveCancelled(questionId, reason)
   229	  }
