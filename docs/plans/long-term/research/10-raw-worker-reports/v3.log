   109	      question.updatedAt = nowIso()
   110	      state.answers[questionId] = clone(answer)
   111	      delete state.pendingBySession[question.sessionId]
   112	      this.emit({ sessionId: question.sessionId, questionId, reason: "answer" })
   113	    })
   114	  }
