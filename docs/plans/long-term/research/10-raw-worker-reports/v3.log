    28	}
    29	
    30	export interface AskUserCoordinator {
    31	  registerWaiter(questionId: string, sessionId: string, signal?: AbortSignal): Promise<AskUserToolResult>
    32	  hasWaiter(questionId: string): boolean
    33	  resolveAnswered(questionId: string, answer: AskUserAnswer): boolean
