    99	  async answer(questionId: string, answer: AskUserAnswer): Promise<void> {
   100	    await this.mutate(async (state) => {
   101	      const question = requireQuestion(state, questionId)
   102	      if (answer.questionId !== questionId || answer.sessionId !== question.sessionId) {
   103	        throw new AskUserStoreError(ASK_USER_ERROR_CODES.SESSION_MISMATCH, "answer does not match question/session")
