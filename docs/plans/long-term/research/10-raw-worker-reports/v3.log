   229	function requireQuestion(state: StoredAskUserState, questionId: string): AskUserQuestion {
   230	  const question = state.questions[questionId]
   231	  if (!question) throw new AskUserStoreError(ASK_USER_ERROR_CODES.QUESTION_NOT_FOUND, `question ${questionId} not found`)
   232	  return question
   233	}
   234	
   235	function transcriptSessionId(event: AskUserTranscriptEvent): string {
   236	  switch (event.type) {
   237	    case "created": return event.question.sessionId
   238	    case "answered": return event.answer.sessionId
   239	    default: return event.sessionId
   240	  }
   241	}
   242	
   243	function transcriptQuestionId(event: AskUserTranscriptEvent): string {
   244	  switch (event.type) {
   245	    case "created": return event.question.questionId
   246	    case "answered": return event.answer.questionId
   247	    default: return event.questionId
   248	  }
   249	}
