   175	    }
   176	    return "answered"
   177	  }
   178	
   179	  async cancelQuestion(questionId: string, sessionId: string, reason: AskUserCancelReason = "user_cancelled"): Promise<void> {
   180	    const question = await this.store.getByQuestionId(questionId)
   181	    if (!question || question.sessionId !== sessionId) throw new AskUserRuntimeError(ASK_USER_ERROR_CODES.QUESTION_NOT_FOUND, "question not found")
   182	    if (!this.coordinator.hasWaiter(questionId)) {
   183	      await this.abandon(questionId, sessionId)
   184	      return
   185	    }
   186	    let cancelPersisted = false
   187	    try {
   188	      await this.store.cancel(questionId)
