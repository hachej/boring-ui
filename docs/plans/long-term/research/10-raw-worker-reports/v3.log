   260	  private consume(buckets: Map<string, RateLimitBucket>, key: string, windowMs: number, limit: number): boolean {
   261	    const now = this.now().getTime()
   262	    const bucket = buckets.get(key)
   263	    if (!bucket || bucket.resetAt <= now) {
   264	      buckets.set(key, { count: 1, resetAt: now + windowMs })
