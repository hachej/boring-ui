    44	/** Reads only the bounded suffix written since the attempt's pre-append stat. */
    45	async function verifiedNativeRenameAppend(
    46	  filepath: string,
    47	  before: Stats,
    48	  append: NativeRenameAppend,
    49	  title: string,
    50	): Promise<number | null> {
    51	  const after = await fsStat(filepath);
    52	  if (after.dev !== before.dev || after.ino !== before.ino) return null;
    53	
    54	  const appendedBytes = after.size - before.size;
    55	  if (!Number.isSafeInteger(before.size) || !Number.isSafeInteger(after.size)
    56	    || appendedBytes <= 0 || appendedBytes > NATIVE_RENAME_MAX_APPEND_BYTES) return null;
    57	
    58	  const handle = await open(filepath, "r");
    59	  try {
    60	    const record = Buffer.allocUnsafe(appendedBytes);
    61	    const { bytesRead } = await handle.read(record, 0, record.length, before.size);
    62	    if (bytesRead !== record.length || record.at(-1) !== 0x0a || record.indexOf(0x0a) !== record.length - 1) return null;
    63	    const parsed: unknown = JSON.parse(record.toString("utf-8"));
    64	    if (typeof parsed !== "object" || parsed === null) return null;
    65	    const entry = parsed as { type?: unknown; id?: unknown; parentId?: unknown; name?: unknown };
    66	    return entry.type === "session_info"
    67	      && entry.id === append.id
    68	      && entry.parentId === append.parentId
    69	      && entry.name === title
    70	      ? after.size
    71	      : null;
    72	  } catch {
    73	    return null;
    74	  } finally {
    75	    await handle.close();
    76	  }
    77	}
