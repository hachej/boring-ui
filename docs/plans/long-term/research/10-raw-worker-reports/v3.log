    37	export class InProcessAskUserCoordinator implements AskUserCoordinator {
    38	  private readonly waiters = new Map<string, Waiter>()
    39	
    40	  registerWaiter(questionId: string, sessionId: string, signal?: AbortSignal): Promise<AskUserToolResult> {
    41	    if (this.waiters.has(questionId)) {
    42	      throw new AskUserRuntimeError(ASK_USER_ERROR_CODES.PENDING_EXISTS, `waiter already exists for ${questionId}`)
    43	    }
    44	    if (signal?.aborted) return Promise.resolve({ status: "cancelled", questionId, sessionId, reason: "aborted" })
    45	
    46	    return new Promise((resolve) => {
    47	      const onAbort = () => this.resolveCancelled(questionId, "aborted")
    48	      const waiter: Waiter = {
    49	        sessionId,
    50	        settled: false,
    51	        resolve,
    52	        cleanup: () => signal?.removeEventListener("abort", onAbort),
    53	      }
    54	      this.waiters.set(questionId, waiter)
    55	      signal?.addEventListener("abort", onAbort, { once: true })
    56	    })
    57	  }
    58	
    59	  hasWaiter(questionId: string): boolean {
    60	    return this.waiters.has(questionId)
    61	  }
    62	
    63	  resolveAnswered(questionId: string, answer: AskUserAnswer): boolean {
    64	    return this.resolve(questionId, { status: "answered", answer })
    65	  }
    66	
    67	  resolveCancelled(questionId: string, reason: AskUserCancelReason): boolean {
    68	    const waiter = this.waiters.get(questionId)
    69	    const sessionId = waiter?.sessionId ?? ""
    70	    return this.resolve(questionId, { status: "cancelled", questionId, sessionId, reason })
    71	  }
    72	
    73	  private resolve(questionId: string, result: AskUserToolResult): boolean {
    74	    const waiter = this.waiters.get(questionId)
    75	    if (!waiter || waiter.settled) return false
    76	    waiter.settled = true
    77	    this.waiters.delete(questionId)
    78	    waiter.cleanup()
    79	    waiter.resolve(result)
    80	    return true
