     8	export type QuestionsRoutesOptions = {
     9	  store: AskUserStore
    10	  runtime: AskUserRuntime
    11	  getAuthContext?: (request: FastifyRequest) => QuestionsAuthContext | Promise<QuestionsAuthContext>
    12	  allowedOrigins?: string[]
