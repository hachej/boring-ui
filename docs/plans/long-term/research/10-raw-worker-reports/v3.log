    29	export function createResourceSettingsManager(
    30	  cwd: string,
    31	  agentDir: string,
    32	  piPackages: PiPackageSource[],
    33	  options: { includePackage?: (source: PiPackageSource) => boolean } = {},
    34	): SettingsManager {
    35	  if (piPackages.length === 0 && !options.includePackage) return SettingsManager.create(cwd, agentDir);
