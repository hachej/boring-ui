    90	export function constantTimeEqual(expected: string, actual: string): boolean {
    91	  const expectedBytes = new TextEncoder().encode(expected)
    92	  const actualBytes = new TextEncoder().encode(actual)
    93	  const length = Math.max(expectedBytes.length, actualBytes.length)
    94	  const left = new Uint8Array(length)
    95	  const right = new Uint8Array(length)
    96	  left.set(expectedBytes)
    97	  right.set(actualBytes)
    98	  return timingSafeEqual(left, right) && expectedBytes.length === actualBytes.length
