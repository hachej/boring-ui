     6	/**
     7	 * Environment mount contract (gh-1123, slice 1).
     8	 *
     9	 * An environment mount makes an already-authorized filesystem binding
    10	 * physically visible to sandboxed commands at a logical path. Mounts are
    11	 * inputs to the single `SandboxProviderV1.create` call — never a second
    12	 * realization path — and only providers that declare
    13	 * `ProviderCapabilities.mounts: true` may receive a non-empty list.
    14	 *
    15	 * `sourceRoot` is always an ordinary host directory. View mounts (the
    16	 * Operations→FUSE bridge, later slice) hand providers a host mountpoint
    17	 * directory through this same shape; providers never learn about FUSE.
    18	 */
    19	export interface SandboxEnvironmentMountV1 {
    20	  /** Host directory realized inside the sandbox. Realpath-resolved once at create. */
    21	  readonly sourceRoot: string;
    22	  /**
    23	   * Sandbox-visible path. Must live in the dedicated mount namespace
    24	   * (`/mnt/<fsid>`), never under the primary `/workspace` root.
    25	   */
    26	  readonly logicalPath: string;
    27	  readonly access: "ro" | "rw";
    28	}
    29	
    30	/** Sandbox-visible namespace that all environment mounts must live under. */
    31	export const ENVIRONMENT_MOUNT_NAMESPACE = "/mnt";
    32	
    33	/** Server-side flag gating mount realization (exec grants are policy-data). */
    34	export const ENVIRONMENT_MOUNTS_FLAG = "BORING_ENV_MOUNTS";
    35	
    36	export const ENVIRONMENT_MOUNT_ERROR_CODES = {
    37	  unsupported: "SANDBOX_PROVIDER_MOUNTS_UNSUPPORTED",
    38	  invalid: "SANDBOX_MOUNT_INVALID",
    39	} as const;
    40	
    41	export type EnvironmentMountErrorCode =
    42	  (typeof ENVIRONMENT_MOUNT_ERROR_CODES)[keyof typeof ENVIRONMENT_MOUNT_ERROR_CODES];
    43	
    44	export function isEnvironmentMountsEnabled(
    45	  env: Record<string, string | undefined> = process.env,
    46	): boolean {
    47	  return env[ENVIRONMENT_MOUNTS_FLAG] === "1";
    48	}
    49	
    50	/**
    51	 * Resolves the effective mount set for a provider create context. With
    52	 * `BORING_ENV_MOUNTS` unset the resolution yields the empty set for every
    53	 * context, making flag-off behavior byte-identical to the pre-mount contract.
    54	 */
    55	export function resolveContextMounts(
    56	  context: Pick<SandboxProviderCreateContextV1, "mounts">,
    57	  env?: Record<string, string | undefined>,
    58	): readonly SandboxEnvironmentMountV1[] {
    59	  if (!isEnvironmentMountsEnabled(env)) return [];
    60	  return context.mounts ?? [];
    61	}
    62	
    63	/**
    64	 * Fail-closed guard for providers without mount support: a non-empty
    65	 * effective mount set is rejected with a stable error code instead of being
    66	 * silently dropped (a dropped mount would be a grant the agent believes it
    67	 * holds but does not have).
    68	 */
    69	export function assertNoEnvironmentMounts(
    70	  providerId: string,
    71	  context: Pick<SandboxProviderCreateContextV1, "mounts">,
    72	  env?: Record<string, string | undefined>,
    73	): void {
    74	  const mounts = resolveContextMounts(context, env);
    75	  if (mounts.length === 0) return;
    76	  throw new SandboxProviderError(
    77	    ENVIRONMENT_MOUNT_ERROR_CODES.unsupported,
    78	    `sandbox provider "${providerId}" does not support environment mounts (requested ${mounts.length})`,
    79	  );
    80	}
