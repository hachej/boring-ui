    88	export function createSandboxRuntimeModeAdapter(
    89	  mode: BuiltinRuntimeModeId,
    90	  options: SandboxRuntimeModeOptions = {},
    91	): RuntimeModeAdapter {
    92	  switch (mode) {
    93	    case 'direct':
    94	      return createDirectModeAdapter({
    95	        provider: createDirectSandboxProvider(),
    96	        runtimeHost: agentSandboxRuntimeHostOperations,
    97	      })
    98	    case 'local':
    99	      return createLocalModeAdapter({
   100	        provider: createBwrapSandboxProvider(),
   101	        runtimeHost: agentSandboxRuntimeHostOperations,
   102	      })
   103	    case 'vercel-sandbox':
   104	      return createVercelSandboxModeAdapter({
   105	        provider: createVercelSandboxProvider({
   106	          ...(options.sandboxHandleStore
   107	            ? { store: options.sandboxHandleStore, orphanGuardMaxIdleMs: null }
   108	            : {}),
   109	        }),
   110	        runtimeHost: agentSandboxRuntimeHostOperations,
   111	        remoteRoot: VERCEL_SANDBOX_REMOTE_ROOT,
   112	        workspaceRoot: VERCEL_SANDBOX_WORKSPACE_ROOT,
   113	      })
   114	    default:
   115	      throw new Error(
   116	        `Runtime mode "${String(mode)}" has no built-in adapter. Pass runtimeModeAdapter to use a custom sandbox mode.`,
   117	      )
   118	  }
   119	}
   120	
   121	export function createAgentSandboxRuntimeModeAdapter(mode: RuntimeModeId = 'direct'): RuntimeModeAdapter {
   122	  return createSandboxRuntimeModeAdapter(mode as BuiltinRuntimeModeId)
   123	}
