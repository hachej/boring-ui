   111	  strategy: Extract<RuntimeBashStrategy, { kind: 'remote' }>,
   112	): BashToolOptions {
   113	  return {
   114	    operations: remoteSandboxBashOps(bundle.sandbox, bundle.workspace, {
   115	      defaultPath: strategy.defaultPath,
   116	      runtime,
   117	      executionRuntimeEnv,
