   256	export function createBwrapSandbox(opts: CreateBwrapSandboxOptions = {}): Sandbox {
   257	  const sandboxOptions = opts
   258	  let workspace: Workspace | null = null
   259	  let hostWorkspaceRoot = sandboxOptions.hostWorkspaceRoot
   260	  let runtimeContext = sandboxOptions.runtimeContext ?? { runtimeCwd: SANDBOX_HOME }
   261	  let globalToolMountArgs: string[] | null = null
   262	
   263	  return {
   264	    id: 'bwrap',
   265	    placement: 'server',
   266	    provider: 'bwrap',
   267	    capabilities: ['exec'],
   268	    get runtimeContext() {
   269	      return runtimeContext
   270	    },
   271	    async init(ctx) {
   272	      workspace = ctx.workspace
   273	      hostWorkspaceRoot = sandboxOptions.hostWorkspaceRoot ?? getNodeWorkspaceHostRoot(ctx.workspace) ?? ctx.workspace.root
   274	      runtimeContext = sandboxOptions.runtimeContext ?? { runtimeCwd: SANDBOX_HOME }
   275	      await assertBwrapAvailable()
   276	      globalToolMountArgs = await buildGlobalToolMounts(hostWorkspaceRoot)
   277	    },
   278	    async exec(cmd, opts) {
   279	      if (!workspace) {
   280	        throw new Error('BwrapSandbox not initialized')
   281	      }
   282	
   283	      const start = Date.now()
   284	      const timeoutMs = opts?.timeoutMs ?? DEFAULT_TIMEOUT_MS
   285	      const maxOutputBytes = opts?.maxOutputBytes ?? DEFAULT_MAX_OUTPUT_BYTES
   286	      const workspaceRoot = hostWorkspaceRoot ?? workspace.root
   287	      const sandboxCwd = computeSandboxCwd(workspaceRoot, runtimeContext.runtimeCwd, opts?.cwd)
   288	      const postWorkspaceArgs = globalToolMountArgs
   289	        ?? await buildGlobalToolMounts(workspaceRoot)
   290	      const baseArgs = buildBwrapArgs(workspaceRoot, {
   291	        postWorkspaceArgs,
   292	        network: sandboxOptions.network,
   293	        dropAllCapabilities: sandboxOptions.dropAllCapabilities,
   294	        mounts: sandboxOptions.mounts,
   295	      })
   296	      const args = [
   297	        ...withSandboxCwd(baseArgs, sandboxCwd),
   298	        ...buildCommandArgs(cmd, sandboxOptions.resourceLimits),
   299	      ]
   300	
   301	      return await new Promise((resolve, reject) => {
   302	        const child = spawn('bwrap', args, {
   303	          env: {
   304	            ...withWorkspacePythonEnv({ workspaceRoot, env: opts?.env, sandboxRoot: SANDBOX_HOME }),
   305	            PWD: sandboxCwd,
   306	          },
   307	          stdio: ['ignore', 'pipe', 'pipe'],
   308	          detached: process.platform !== 'win32',
   309	        })
   310	
   311	        const stdoutChunks: Buffer[] = []
   312	        const stderrChunks: Buffer[] = []
   313	        const captureState: CaptureState = {
   314	          capturedBytes: 0,
   315	          maxBytes: maxOutputBytes,
   316	          truncated: false,
   317	        }
   318	
   319	        let timeoutHandle: NodeJS.Timeout | null = null
   320	        let killHandle: NodeJS.Timeout | null = null
   321	        let heartbeatHandle: NodeJS.Timeout | null = null
   322	        let timedOut = false
   323	        let settled = false
   324	
   325	        const cleanup = (): void => {
   326	          if (timeoutHandle) clearTimeout(timeoutHandle)
   327	          if (killHandle) clearTimeout(killHandle)
   328	          if (heartbeatHandle) clearInterval(heartbeatHandle)
   329	        }
   330	
   331	        const settle = (exitCode: number | null): void => {
   332	          if (settled) return
   333	          settled = true
   334	          cleanup()
   335	
   336	          resolve({
   337	            stdout: new Uint8Array(Buffer.concat(stdoutChunks)),
   338	            stderr: new Uint8Array(Buffer.concat(stderrChunks)),
   339	            exitCode: typeof exitCode === 'number' ? exitCode : timedOut ? 124 : 1,
   340	            durationMs: Date.now() - start,
   341	            truncated: captureState.truncated,
   342	            stdoutEncoding: 'utf-8',
   343	            stderrEncoding: 'utf-8',
   344	          })
   345	        }
   346	
   347	        child.stdout?.on('data', (chunk: Buffer) => {
   348	          appendOutput(stdoutChunks, chunk, captureState, opts?.onStdout)
   349	        })
   350	        child.stderr?.on('data', (chunk: Buffer) => {
   351	          appendOutput(stderrChunks, chunk, captureState, opts?.onStderr)
   352	        })
   353	
   354	        child.on('error', (error) => {
   355	          if (settled) return
   356	          settled = true
   357	          cleanup()
   358	          reject(error)
   359	        })
   360	
   361	        child.on('close', (code) => {
   362	          settle(code)
   363	        })
   364	
   365	        timeoutHandle = setTimeout(() => {
   366	          timedOut = true
   367	          terminateProcess(child, 'SIGTERM')
   368	          killHandle = setTimeout(() => {
   369	            if (!settled) terminateProcess(child, 'SIGKILL')
   370	          }, KILL_GRACE_SECONDS * 1_000)
   371	        }, timeoutMs)
   372	
   373	        if (opts?.onHeartbeat) {
   374	          heartbeatHandle = setInterval(() => {
   375	            opts.onHeartbeat?.(Date.now() - start)
   376	          }, 1_000)
   377	        }
   378	
   379	        if (opts?.signal) {
   380	          const abort = (): void => {
   381	            terminateProcess(child, 'SIGTERM')
   382	            killHandle = setTimeout(() => {
   383	              if (!settled) terminateProcess(child, 'SIGKILL')
   384	            }, KILL_GRACE_SECONDS * 1_000)
   385	          }
   386	
   387	          if (opts.signal.aborted) {
   388	            abort()
   389	          } else {
   390	            opts.signal.addEventListener('abort', abort, { once: true })
   391	            child.on('close', () => {
   392	              opts.signal?.removeEventListener('abort', abort)
   393	            })
   394	          }
   395	        }
   396	      })
   397	    },
   398	  }
   399	}
     1	import { isAbsolute, posix } from 'node:path'
     2	
     3	import {
     4	  ENVIRONMENT_MOUNT_NAMESPACE,
     5	  type SandboxEnvironmentMountV1,
     6	} from '../../shared/mounts'
     7	
     8	const SANDBOX_HOME = '/workspace'
     9	const MAX_WORKSPACE_ROOT_LENGTH = 4096
    10	
    11	export const BWRAP_TIMEOUT_SECONDS = 30
    12	export const KILL_GRACE_SECONDS = 5
    13	
    14	export const RO_BIND_DIRS = [
    15	  '/usr',
    16	  '/lib',
    17	  '/lib64',
    18	  '/bin',
    19	  '/sbin',
    20	  '/etc',
    21	  '/etc/ssl',
    22	  '/etc/ca-certificates',
    23	]
    24	
    25	export const RO_BIND_TRY_DIRS = [
    26	  // Ubuntu/systemd commonly makes /etc/resolv.conf a symlink to this
    27	  // directory. The sandbox already shares the network namespace, but DNS
    28	  // still fails if the symlink target is hidden by the tmpfs root.
    29	  '/run/systemd/resolve',
    30	]
    31	
    32	function validateHostPath(value: string, name: string): void {
    33	  if (value.length === 0) {
    34	    throw new Error(`${name} must not be empty`)
    35	  }
    36	
    37	  if (!isAbsolute(value)) {
    38	    throw new Error(`${name} must be an absolute path`)
    39	  }
    40	
    41	  for (const segment of value.split('/')) {
    42	    if (segment === '.' || segment === '..') {
    43	      throw new Error(`${name} must not contain traversal segments`)
    44	    }
    45	  }
    46	
    47	  if (value.includes('\0')) {
    48	    throw new Error(`${name} must not contain null bytes`)
    49	  }
    50	
    51	  if (value.includes('\n') || value.includes('\r')) {
    52	    throw new Error(`${name} must not contain newlines`)
    53	  }
    54	
    55	  if (Buffer.byteLength(value, 'utf8') > MAX_WORKSPACE_ROOT_LENGTH) {
    56	    throw new Error(`${name} exceeds max path length`)
    57	  }
    58	}
    59	
    60	function validateWorkspaceRoot(workspaceRoot: string): void {
    61	  validateHostPath(workspaceRoot, 'workspaceRoot')
    62	}
    63	
    64	function validateMounts(
    65	  mounts: readonly SandboxEnvironmentMountV1[],
    66	  sandboxHome: string,
    67	): void {
    68	  const seenLogicalPaths = new Set<string>()
    69	  for (const mount of mounts) {
    70	    validateHostPath(mount.sourceRoot, 'mount sourceRoot')
    71	    validateHostPath(mount.logicalPath, 'mount logicalPath')
    72	
    73	    if (posix.normalize(mount.logicalPath) !== mount.logicalPath) {
    74	      throw new Error('mount logicalPath must be normalized')
    75	    }
    76	
    77	    // Dedicated namespace outside the primary rw root: avoids bind shadowing
    78	    // and readonly-under-HOME breakage (gh-1123 mount hygiene).
    79	    if (!mount.logicalPath.startsWith(`${ENVIRONMENT_MOUNT_NAMESPACE}/`)) {
    80	      throw new Error(
    81	        `mount logicalPath must live under ${ENVIRONMENT_MOUNT_NAMESPACE}/`,
    82	      )
    83	    }
    84	
    85	    if (
    86	      mount.logicalPath === sandboxHome
    87	      || mount.logicalPath.startsWith(`${sandboxHome}/`)
    88	    ) {
    89	      throw new Error('mount logicalPath must not live under the workspace root')
    90	    }
    91	
    92	    if (seenLogicalPaths.has(mount.logicalPath)) {
    93	      throw new Error(`duplicate mount logicalPath: ${mount.logicalPath}`)
    94	    }
    95	    seenLogicalPaths.add(mount.logicalPath)
    96	  }
    97	}
    98	
    99	export interface BwrapArgsOptions {
   100	  extraArgs?: string[]
   101	  postWorkspaceArgs?: string[]
   102	  network?: 'shared' | 'isolated'
   103	  newSession?: boolean
   104	  dropAllCapabilities?: boolean
   105	  /**
   106	   * Sandbox-visible home/primary root. Defaults to `/workspace`; reconciles
   107	   * the `local-sandbox` strategy's `sandboxRoot` option (gh-1123 slice 1).
   108	   */
   109	  sandboxHome?: string
   110	  /**
   111	   * Environment mounts (gh-1123). Source roots must already be
   112	   * realpath-resolved once at lease create; this builder re-emits the
   113	   * resolved paths verbatim on every spawn.
   114	   */
   115	  mounts?: readonly SandboxEnvironmentMountV1[]
   116	  /**
   117	   * Workspace-relative prefixes re-bound readonly on top of the writable
   118	   * workspace mount, so spawned shells cannot mutate protected paths that the
   119	   * Operations layer already refuses to mutate.
   120	   */
   121	  readonlyPaths?: readonly string[]
   122	}
   123	
   124	function normalizeReadonlyPath(input: string): string {
   125	  if (typeof input !== 'string' || input.length === 0) {
   126	    throw new Error('readonly path must be a non-empty workspace-relative path')
   127	  }
   128	  if (input.includes('\0') || input.includes('\n') || input.includes('\r')) {
   129	    throw new Error('readonly path must not contain null bytes or newlines')
   130	  }
   131	  const normalized = input.replace(/\\/g, '/')
   132	  if (normalized.startsWith('/')) {
   133	    throw new Error('readonly path must be workspace-relative')
   134	  }
   135	  const segments = normalized.split('/').filter((segment) => segment !== '' && segment !== '.')
   136	  if (segments.length === 0 || segments.includes('..')) {
   137	    throw new Error('readonly path must not be empty or contain traversal segments')
   138	  }
   139	  return segments.join('/')
   140	}
   141	
   142	export function buildBwrapArgs(workspaceRoot: string, options?: BwrapArgsOptions): string[] {
   143	  validateWorkspaceRoot(workspaceRoot)
   144	
   145	  const sandboxHome = options?.sandboxHome ?? SANDBOX_HOME
   146	  validateHostPath(sandboxHome, 'sandboxHome')
   147	  const mounts = options?.mounts ?? []
   148	  validateMounts(mounts, sandboxHome)
   149	
   150	  const network = options?.network ?? 'shared'
   151	  const args: string[] = [
   152	    '--unshare-all',
   153	    ...(network === 'shared' ? ['--share-net'] : []),
   154	    '--die-with-parent',
   155	    ...(options?.newSession === false ? [] : ['--new-session']),
   156	    ...(options?.dropAllCapabilities ? ['--cap-drop', 'ALL'] : []),
   157	    '--tmpfs', '/',
   158	    '--proc', '/proc',
   159	    '--dev', '/dev',
   160	    '--tmpfs', '/tmp',
   161	  ]
   162	
   163	  for (const dir of RO_BIND_DIRS) {
   164	    args.push('--ro-bind', dir, dir)
   165	  }
   166	
   167	  for (const dir of RO_BIND_TRY_DIRS) {
   168	    args.push('--ro-bind-try', dir, dir)
   169	  }
   170	
   171	  if (options?.extraArgs) {
   172	    args.push(...options.extraArgs)
   173	  }
   174	
   175	  args.push(
   176	    '--bind',
   177	    workspaceRoot,
   178	    sandboxHome,
   179	    '--chdir',
   180	    sandboxHome,
   181	    '--setenv',
   182	    'HOME',
   183	    sandboxHome,
   184	  )
   185	
   186	  // Order matters: bwrap applies binds sequentially, so these must follow the
   187	  // writable workspace bind to shadow it. `--ro-bind-try` keeps a policy entry
   188	  // that does not exist yet from failing the whole spawn.
   189	  for (const path of options?.readonlyPaths ?? []) {
   190	    const relative = normalizeReadonlyPath(path)
   191	    args.push('--ro-bind-try', `${workspaceRoot.replace(/\/$/, '')}/${relative}`, `${sandboxHome}/${relative}`)
   192	  }
   193	
   194	  for (const mount of mounts) {
   195	    args.push(
   196	      mount.access === 'rw' ? '--bind' : '--ro-bind',
   197	      mount.sourceRoot,
   198	      mount.logicalPath,
   199	    )
   200	  }
   201	
   202	  if (options?.postWorkspaceArgs) {
   203	    args.push(...options.postWorkspaceArgs)
   204	  }
   205	
   206	  args.push('--')
   207	
   208	  return args
   209	}

