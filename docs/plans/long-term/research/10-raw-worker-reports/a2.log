   136	      return hostBashToolOptions(bundle, runtime, strategy)
   137	    case 'local-sandbox':
   138	      return localSandboxBashToolOptions(bundle, runtime, strategy)
   139	    case 'remote':
   140	      return remoteBashToolOptions(bundle, runtime, executionRuntimeEnv, strategy)
