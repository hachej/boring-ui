   144	export function parsePiChatReplayRangeError(status: number, body: unknown): PiChatReplayRangeError | null {
   145	  if (status !== 409 || typeof body !== 'object' || body === null) return null
   146	  const record = body as Record<string, unknown>
   147	  const payload = typeof record.error === 'object' && record.error !== null ? (record.error as Record<string, unknown>) : record
   148	  const details = typeof payload.details === 'object' && payload.details !== null ? payload.details as Record<string, unknown> : undefined
   149	  const reason = payload.code === PI_CHAT_REPLAY_GAP_CODE || payload.code === PI_CHAT_CURSOR_AHEAD_CODE
   150	    ? payload.code
   151	    : payload.message === PI_CHAT_REPLAY_GAP_CODE || payload.message === PI_CHAT_CURSOR_AHEAD_CODE
   152	      ? payload.message
   153	      : details?.reason === PI_CHAT_REPLAY_GAP_CODE || details?.reason === PI_CHAT_CURSOR_AHEAD_CODE
   154	        ? details.reason
   155	        : undefined
   156	  if (reason !== PI_CHAT_REPLAY_GAP_CODE && reason !== PI_CHAT_CURSOR_AHEAD_CODE) return null
   157	  const latestSeq = readLatestSeq(payload) ?? readLatestSeq(record)
   158	  if (latestSeq === undefined) return null
   159	  return { type: reason, latestSeq }
   160	}
