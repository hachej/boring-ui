    76	  try {
    77	    while (true) {
    78	      const { value, done } = await reader.read()
    79	      if (done) break
    80	      buffered += decoder.decode(value, { stream: true })
    81	
    82	      let newlineIndex = buffered.indexOf('\n')
    83	      while (newlineIndex >= 0) {
    84	        const line = buffered.slice(0, newlineIndex)
    85	        buffered = buffered.slice(newlineIndex + 1)
    86	        processLine(line)
    87	        newlineIndex = buffered.indexOf('\n')
    88	      }
    89	    }
    90	
    91	    buffered += decoder.decode()
    92	    if (buffered.length > 0) processLine(buffered)
