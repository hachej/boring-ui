   105	export function createPiChatFrameProcessor(initialSeq: number, handlers: PiChatFrameProcessorHandlers) {
   106	  let lastSeq = initialSeq
   107	
   108	  return {
   109	    getLastSeq() {
   110	      return lastSeq
   111	    },
   112	    handle(frame: PiChatStreamFrame): PiChatStreamSeqResult | { type: 'heartbeat' } {
   113	      if (frame.type === 'heartbeat') {
   114	        handlers.onHeartbeat?.(frame)
   115	        return { type: 'heartbeat' }
   116	      }
   117	
   118	      const result = processPiChatSequencedEvent(lastSeq, frame)
   119	      if (result.type === 'applied') {
   120	        lastSeq = result.lastSeq
   121	        handlers.onEvent(frame)
   122	      } else if (result.type === 'stale') {
   123	        handlers.onStaleEvent?.(result)
   124	      } else {
   125	        handlers.onSeqGap?.(result)
   126	      }
   127	      return result
   128	    },
   129	  }
   130	}
