   116	export function processPiChatSequencedEvent(lastSeq: number, event: PiChatEvent): PiChatStreamSeqResult {
   117	  if (event.seq <= lastSeq) return { type: 'stale', event, lastSeq }
   118	  const expectedSeq = lastSeq + 1
