   132	function readLatestSeq(value: unknown): number | undefined {
   133	  if (typeof value !== 'object' || value === null) return undefined
   134	  const record = value as Record<string, unknown>
   135	  if (typeof record.latestSeq === 'number' && Number.isInteger(record.latestSeq) && record.latestSeq >= 0) return record.latestSeq
   136	  const details = record.details
   137	  if (typeof details === 'object' && details !== null) {
   138	    const latestSeq = (details as Record<string, unknown>).latestSeq
   139	    if (typeof latestSeq === 'number' && Number.isInteger(latestSeq) && latestSeq >= 0) return latestSeq
   140	  }
   141	  return undefined
   142	}
