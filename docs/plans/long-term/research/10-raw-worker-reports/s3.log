<style>
:root{color-scheme:dark}body{margin:0;font:15px/1.5 ui-sans-serif,system-ui;background:#0f1115;color:#e6e8ee;display:flex;flex-direction:column;height:100vh}
header{padding:12px 18px;border-bottom:1px solid #232733;font-size:13px;color:#8b93a7}
header b{color:#e6e8ee}
#log{flex:1;overflow:auto;padding:18px;display:flex;flex-direction:column;gap:12px}
.m{max-width:70ch;padding:10px 14px;border-radius:12px;white-space:pre-wrap}
.user{align-self:flex-end;background:#2a4d8f}
.assistant{align-self:flex-start;background:#1a1e28;border:1px solid #232733}
.err{align-self:flex-start;color:#ff8080;font-size:13px}
form{display:flex;gap:8px;padding:14px;border-top:1px solid #232733}
input{flex:1;padding:11px 14px;border-radius:10px;border:1px solid #2b3040;background:#151923;color:inherit;font:inherit}
button{padding:11px 18px;border-radius:10px;border:0;background:#3b6fd4;color:#fff;font:inherit;cursor:pointer}
button:disabled{opacity:.5;cursor:default}
</style>
<header>agent <b>Hello</b> · model <b>google/gemini-2.5-flash</b> · runtime <b>celld 0.1.0</b> · conversation <b id=cid></b></header>
<div id=log></div>
<form id=f><input id=i placeholder="Message the agent…" autocomplete=off autofocus><button id=b>Send</button></form>
<script>
const cid = new URLSearchParams(location.search).get('c') || 'web-' + Math.random().toString(36).slice(2,8);
document.getElementById('cid').textContent = cid;
const log = document.getElementById('log'), f = document.getElementById('f'), i = document.getElementById('i'), b = document.getElementById('b');
let seen = '';
function render(d){
  const parts = [];
  for (const m of d.messages || []) for (const p of (m.parts||[])) if (p.text) parts.push([m.role, p.text]);
  for (const s of d.settlements || []) if (s.outcome === 'failed') parts.push(['err', s.error && s.error.message || 'failed']);
  const key = JSON.stringify(parts);
  if (key === seen) return; seen = key;
  log.innerHTML = '';
  for (const [role, text] of parts){
    const el = document.createElement('div');
    el.className = 'm ' + (role === 'user' ? 'user' : role === 'err' ? 'err' : 'assistant');
    el.textContent = text; log.appendChild(el);
  }
  log.scrollTop = log.scrollHeight;
}
async function poll(){
  try { const r = await fetch('/agents/hello/' + cid); if (r.ok) render(await r.json()); } catch {}
}
setInterval(poll, 1000); poll();
f.onsubmit = async (e) => {
  e.preventDefault();
  const body = i.value.trim(); if (!body) return;
  i.value = ''; b.disabled = true;
  await fetch('/agents/hello/' + cid, {method:'POST', headers:{'content-type':'application/json'}, body: JSON.stringify({kind:'user', body})});
  b.disabled = false; i.focus(); poll();
};
</script>`;

app.get('/', (c) => c.html(PAGE));

mountShim(app);

export default app;
