   187	export function calculateJitteredBackoffDelayMs({
   188	  attempt,
   189	  baseMs = 1_000,
   190	  maxMs = 30_000,
   191	  jitterRatio = 0.25,
   192	  random = Math.random,
   193	}: {
   194	  attempt: number
   195	  baseMs?: number
   196	  maxMs?: number
   197	  jitterRatio?: number
   198	  random?: () => number
   199	}): number {
   200	  const normalizedAttempt = Math.max(0, Math.floor(attempt))
   201	  const exponential = Math.min(maxMs, baseMs * 2 ** normalizedAttempt)
   202	  const jitter = Math.max(0, jitterRatio)
   203	  const min = exponential * Math.max(0, 1 - jitter)
   204	  const max = exponential * (1 + jitter)
   205	  return Math.round(Math.min(maxMs, min + random() * (max - min)))
   206	}
