   384	        agentTypeId: definitionId,
   385	        code: ErrorCode.enum.AGENT_DEFINITION_UNSEATED,
   386	        message: `discovered agent definition "${definitionId}" is not seated and remains inert`,
   387	      } : {
   388	        agentTypeId: definitionId,
   389	        code: ErrorCode.enum.AGENT_FLEET_SEAT_PERSONA_INVALID,
   390	        message: `discovered agent definition "${definitionId}" failed plugin preflight and is excluded`,
   391	      })
   392	    }
   393	  }
   394	
   395	  for (const binding of seats) {
   396	    let recorded = false
