    77	async function assertInsideRoot(root: string, candidate: string): Promise<void> {
    78	  const realRoot = await realpath(root)
    79	  const existing = await realpath(candidate)
    80	  const rel = path.relative(realRoot, existing)
    81	  if (rel.startsWith('..') || path.isAbsolute(rel)) throw new Error('path escapes company context root')
    82	}
