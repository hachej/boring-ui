   207	async function withConnection<T>(
   208	  input: ProjectionInput,
   209	  request: FastifyRequest,
   210	  ref: AgentSessionRef,
   211	  action: (connection: AgentSessionConnection) => Promise<T>,
   212	): Promise<T> {
   213	  const scope = await input.options.authorizeAgentRequest(request)
   214	  const connection = await input.gateway.connectSession({ scope, ref })
   215	  try {
   216	    return await action(connection)
   217	  } finally {
   218	    await connection.close()
   219	  }
   220	}
