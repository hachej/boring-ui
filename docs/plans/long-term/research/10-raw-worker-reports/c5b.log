    70	function defaultAdminMutationsAllowed(options: CreateGovernanceFilesystemBindingsOptions): boolean {
    71	  if (options.resolveCompanyContextRoot) return false
    72	  const companyRoot = process.env.BORING_GOVERNANCE_COMPANY_CONTEXT_ROOT?.trim()
    73	  if (!companyRoot) return false
    74	  const workspaceRoot = path.resolve(process.env.BORING_AGENT_WORKSPACE_ROOT?.trim() || process.cwd())
    75	  const resolvedCompanyRoot = path.resolve(companyRoot)
    76	  const relative = path.relative(workspaceRoot, resolvedCompanyRoot)
    77	  return relative.startsWith('..') || path.isAbsolute(relative)
    78	}
