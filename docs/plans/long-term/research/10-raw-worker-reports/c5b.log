   585	export function redactMcpSecrets(value: unknown): unknown {
   586	  if (typeof value === "string") return value.replace(SECRET_VALUE_PATTERN, REDACTION)
   587	  if (Array.isArray(value)) return value.map(redactMcpSecrets)
   588	  if (!value || typeof value !== "object") return value
