   238	    agentTypeId: string,
   239	    scope: AuthorizedAgentScope,
   240	    claim: VerifiedAgentScopeClaim,
   241	    operation: 'new-binding' | 'existing-session' | 'reload',
   242	    requestId: string,
   243	    sessionId?: string,
   244	  ): Promise<ResolvedAgentRuntimeScope> => {
   245	    if (options.resolveAuthorizedEnvironmentScope && options.resolveAuthorizedAgentRuntimeScope) {
