   323	/**
   324	 * Loads the config-driven production/CLI agent fleet: `.agents/factory/fleet.yaml`
   325	 * seat → skill-digest bindings, boot-injected plugin-shaped persona package
   326	 * descriptors, `.agents/factory/policy.yaml` `models.seats` tiers, and the
   327	 * priority-ordered `models.tiers` candidates declared in fleet.yaml.
   328	 *
   329	 * Fails closed per seat: a persona that fails materialization, digest
   330	 * verification, or spec composition is excluded with a stable diagnostic —
   331	 * the remaining valid seats still compose. Whole-fleet config errors (an
   332	 * unreadable/malformed fleet.yaml or policy.yaml) throw `FleetConfigError`,
   333	 * since there is no seat set to fail closed against.
   334	 */
   335	export async function loadConfiguredAgentFleet(
   336	  options: LoadConfiguredAgentFleetOptions,
   337	): Promise<LoadConfiguredAgentFleetResult> {
