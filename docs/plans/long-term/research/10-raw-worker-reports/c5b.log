   227	  const leaseBinding: LeaseBoundWorkspaceAgent = Object.freeze({
   228	    workspace: guardMethods(operationEnvironment.bundle.workspace, assertActive, trackOperation, registerCleanup),
   229	    signal: abort.signal,
   230	    async dispatch(
