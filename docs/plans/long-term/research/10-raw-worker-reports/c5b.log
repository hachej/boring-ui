    82	export async function createGovernance(config: CoreConfig): Promise<CreateGovernanceResult> {
    83	  const service = await buildGovernanceService({ config })
    84	  // The database only exists after the host builds its server, so capture the
    85	  // metering getDb closure and reuse it to serve the read-only usage route.
    86	  // Any host that wires governance metering gets the usage-summary route for free.
    87	  let usageDb: (() => BudgetDb) | undefined
    88	  const getUsageReader = (): GovernanceUsageSpendReader | undefined => (
    89	    usageDb
    90	      ? new PostgresBudgetReservationStore(usageDb(), { eligibleLegacySources: GOVERNANCE_ELIGIBLE_LEGACY_SOURCES })
    91	      : undefined
    92	  )
    93	  return {
    94	    service,
    95	    status: service.policyStatus(),
    96	    serverPlugin: createGovernanceServerPlugin(service, { getUsageReader }),
    97	    filterModels: createGovernanceModelFilter(service),
    98	    createMeteringSink: (delegate, getDb) => {
    99	      usageDb = getDb
   100	      return createGovernanceMeteringSink({ service, delegate, getDb })
   101	    },
   102	    getFilesystemBindings: (options = {}) => createGovernanceFilesystemBindings(service, {
   103	      ...options,
   104	      resolveCompanyContextRoot: options.resolveCompanyContextRoot ?? createDefaultCompanyContextRootResolver(),
   105	      allowAdminMutations: options.allowAdminMutations ?? defaultAdminMutationsAllowed(options),
   106	    }),
   107	    pi: { strictModelResolution: service.isEnabled() },
   108	  }
   109	}
