   101	    const absolutePath = path.join(current, entry.name)
   102	    if (entry.isDirectory()) await makeProjectionReadonly(root, absolutePath)
   103	    else if (entry.isFile()) await chmod(absolutePath, 0o400)
   104	  }
   105	  await chmod(current, 0o500)
   106	}
