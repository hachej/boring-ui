   483	  private async send(
   484	    ref: AgentSessionRef,
   485	    scope: AuthorizedAgentScope,
   486	    claim: VerifiedAgentScopeClaim,
   487	    command: IdempotentAgentSend,
   488	  ) {
   489	    const binding = await this.bindingForSession(scope, claim, ref)
   490	    const service = binding.composition.service
   491	    if (command.kind === 'prompt') {
   492	      return await this.sessionEffect(ref, claim, 'session.prompt', command.requestId, command as unknown as JsonValue, async () => {
   493	        const receipt = await service.prompt(context(claim, command.requestId, binding.scope.identity), ref.sessionId, {
   494	          message: command.content,
   495	          displayMessage: command.displayContent,
   496	          clientNonce: command.clientNonce,
   497	          model: command.model,
   498	          thinkingLevel: command.thinkingLevel,
   499	          attachments: command.attachments ? [...command.attachments] : undefined,
   500	        })
   501	        this.runtime.activity.set(claim.workspaceScopeId, ref, 'running')
   502	        return { ...receipt, disposition: 'prompt' as const }
   503	      }, {
   504	        duplicateReceipt: true,
   505	        bindingKey: binding.key,
   506	        classifySafeActionFailure: stableServiceActionFailure,
   507	        guard: async () => await this.promptAdmission(
   508	          scope,
   509	          claim,
   510	          ref,
   511	          command.requestId,
   512	          command.requireIdle === true,
   513	        ),
   514	      })
   515	    }
   516	    return await this.sessionEffect(ref, claim, 'session.followup', command.requestId, command as unknown as JsonValue, async () => {
   517	      const receipt = await service.followUp(context(claim, command.requestId, binding.scope.identity), ref.sessionId, {
   518	        message: command.content,
   519	        displayMessage: command.displayContent,
   520	        clientNonce: command.clientNonce,
   521	        clientSeq: command.clientSeq,
   522	      })
   523	      return { ...receipt, disposition: 'followup' as const }
   524	    }, {
   525	      duplicateReceipt: true,
   526	      bindingKey: binding.key,
   527	      classifySafeActionFailure: stableServiceActionFailure,
   528	    })
   529	  }
