   128	function cloneFleet(agents: readonly AgentHostAgentSpec[]): AgentHostAgentSpec[] {
   129	  if (!Array.isArray(agents) || agents.length === 0) {
   130	    throw new TypeError('createAgentHost requires a non-empty agents fleet')
   131	  }
   132	  return agents.map((agent) => structuredClone(agent))
   133	}
   134	
   135	function validateFleetIds(agents: readonly { readonly agentTypeId: string }[]): void {
   136	  const ids = new Set<string>()
   137	  for (const agent of agents) {
   138	    if (!SAFE_AGENT_TYPE_ID.test(agent.agentTypeId)) {
   139	      throw new TypeError(`unsafe agentTypeId: ${agent.agentTypeId}`)
   140	    }
   141	    if (ids.has(agent.agentTypeId)) {
   142	      throw new TypeError(`duplicate agentTypeId: ${agent.agentTypeId}`)
   143	    }
   144	    ids.add(agent.agentTypeId)
   145	  }
   146	}
   147	
   148	function freezeRecursive<T>(value: T, seen = new WeakSet<object>()): T {
   149	  if ((typeof value !== 'object' && typeof value !== 'function') || value === null) return value
   150	  const object = value as object
   151	  if (seen.has(object)) return value
   152	  seen.add(object)
   153	  for (const property of Reflect.ownKeys(object)) {
   154	    const descriptor = Object.getOwnPropertyDescriptor(object, property)
   155	    if (descriptor && 'value' in descriptor) freezeRecursive(descriptor.value, seen)
   156	  }
   157	  return Object.freeze(value)
   158	}
   159	
   160	async function compileFleet(
   161	  options: CreateAgentHostOptions,
   162	): Promise<readonly CompiledAgentHostAgentSpec[]> {
   163	  const cloned = cloneFleet(options.agents)
   164	  validateFleetIds(cloned)
   165	  const compiled = [...await options.fleetCompiler.compile({ agents: cloned })]
   166	  validateFleetIds(compiled)
   167	  const expected = new Set(cloned.map((agent) => agent.agentTypeId))
   168	  if (compiled.length !== cloned.length || compiled.some((agent) => !expected.has(agent.agentTypeId))) {
   169	    throw new TypeError('fleet compiler output must preserve the input agentTypeId set one-to-one')
   170	  }
   171	  return freezeRecursive(compiled.map((agent) => freezeRecursive(agent)))
   172	}
   173	
   174	async function resolveHostId(options: CreateAgentHostOptions): Promise<string> {
   175	  if (options.hostId !== undefined) {
   176	    const hostId = options.hostId.trim()
   177	    if (!SAFE_HOST_ID.test(hostId)) throw new TypeError('hostId is empty or unsafe')
   178	    return hostId
   179	  }
   180	  if (!options.sessionRoot?.trim()) {
   181	    throw new TypeError('createAgentHost requires hostId or a durable sessionRoot')
   182	  }
   183	  const root = options.sessionRoot
   184	  await mkdir(root, { recursive: true })
   185	  const identityPath = join(root, '.agent-host-id')
   186	  try {
   187	    const existing = (await readFile(identityPath, 'utf8')).trim()
   188	    if (!SAFE_HOST_ID.test(existing)) throw new TypeError('stored agent host ID is invalid')
   189	    return existing
   190	  } catch (error) {
   191	    if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error
   192	  }
   193	  const generated = randomUUID()
   194	  try {
   195	    await writeFile(identityPath, `${generated}\n`, { encoding: 'utf8', flag: 'wx', mode: 0o600 })
   196	    return generated
   197	  } catch (error) {
   198	    if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error
   199	    const existing = (await readFile(identityPath, 'utf8')).trim()
   200	    if (!SAFE_HOST_ID.test(existing)) throw new TypeError('stored agent host ID is invalid')
   201	    return existing
   202	  }
   203	}
