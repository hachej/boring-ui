    95	function createStandaloneScopeAuthority() {
    96	  const issued = new WeakSet<object>()
    97	  const issue = (workspaceScopeId: string): AuthorizedAgentScope => {
    98	    const scope = Object.freeze({
    99	      workspaceScopeId,
   100	      authSubjectId: 'standalone',
   101	    }) as AuthorizedAgentScope
   102	    issued.add(scope as object)
   103	    return scope
   104	  }
   105	  return {
   106	    issue,
   107	    verifier: {
   108	      async verify(scope: AuthorizedAgentScope): Promise<VerifiedAgentScopeClaim> {
   109	        if (!issued.has(scope as object)) throw new Error('standalone Agent Host scope denied')
   110	        return { workspaceScopeId: scope.workspaceScopeId, authSubjectId: 'standalone' }
   111	      },
   112	    },
   113	  }
   114	}
