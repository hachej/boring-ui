    21	  /** Asset-manager scan results supplied by the workspace/CLI boot layer. */
    22	  readonly discoveredPackages?: readonly DiscoveredAgentPackageDescriptor[]
    23	  /**
    24	   * Root of the workspace the `user` filesystem serves, or `null` when the
    25	   * host resolves one per request. Explicit rather than defaulted, because it
    26	   * is a DIFFERENT root from `repositoryRoot` in every multi-workspace host —
    27	   * the two only coincide in the single-root dogfood/playground case.
    28	   * Personas outside it are not published as openable instruction refs (see
    29	   * `loadConfiguredAgentFleet`): a well-formed path the workbench cannot open
    30	   * is worse than no link.
    31	   */
    32	  readonly workspaceRoot: string | null
    33	  /** Overridable for tests; defaults to `process.env`. */
    34	  readonly env?: NodeJS.ProcessEnv
