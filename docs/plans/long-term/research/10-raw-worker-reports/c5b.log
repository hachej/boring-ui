    63	  | typeof ErrorCode.enum.AGENT_MCP_GRANT_TOOL_NOT_ALLOWED
    64	  | typeof ErrorCode.enum.AGENT_MCP_GRANT_RECORD_MALFORMED
    65	  | typeof ErrorCode.enum.AGENT_MCP_GRANT_CONNECTOR_UNKNOWN
    66	  | typeof ErrorCode.enum.AGENT_MCP_GRANT_TOOL_NAME_INVALID
    67	
    68	export interface McpGrantDiagnostic {
    69	  readonly code: McpGrantDiagnosticCode
    70	  readonly connectorId: string
    71	  readonly message: string
    72	  readonly tool?: string
    73	}
