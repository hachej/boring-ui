    37	function createTrustedLocalScope(): {
    38	  readonly scope: AuthorizedAgentScope
    39	  readonly verifier: AgentScopeVerifier
    40	} {
    41	  const scope = Object.freeze({
    42	    workspaceScopeId: PLAYGROUND_WORKSPACE_SCOPE_ID,
    43	    authSubjectId: PLAYGROUND_AUTH_SUBJECT_ID,
    44	  }) as AuthorizedAgentScope
    45	
    46	  return {
    47	    scope,
    48	    verifier: {
    49	      async verify(candidate) {
    50	        if (candidate !== scope) throw new Error('agent-playground scope denied')
    51	        return {
    52	          workspaceScopeId: PLAYGROUND_WORKSPACE_SCOPE_ID,
    53	          authSubjectId: PLAYGROUND_AUTH_SUBJECT_ID,
    54	        }
    55	      },
    56	    },
    57	  }
    58	}
