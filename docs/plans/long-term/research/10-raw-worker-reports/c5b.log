     1	# Boring Factory policy — workspace-editable, git-audited.
     2	# This file is permanently trust-class B: no agent may modify it via a
     3	# class-A merge. Parsed by the Beadle automation and merge gates.
     4	
     5	beadle:
     6	  tick_minutes: 10
     7	  worker_cap: 3 # concurrent /exec workers, fleet-wide; max 1 UI-surface worker at a time (file-collision lane rule)
     8	  stale_lease_minutes: 90
     9	  lease_heartbeat_minutes: 15 # a working session must touch its bead at least this often
    10	  bugfix_reserved_slots: 0 # worker slots held for the bugfix lane
    11	
    12	bounce:
    13	  worker_attempts_per_bead: 2 # then back to Steward as spec defect
    14	  review_rounds_max: 3 # then escalation intention to owner
    15	  plan_resubmissions_max: 1 # rejected plan gets one re-submission, then conversation
    16	
    17	review:
    18	  budget_added_lines: 1500 # review budget guideline, from rolling-small-fixes.md
    19	
    20	sessions:
    21	  handoff_context_threshold: 0.75 # handoff ritual fires before compaction
    22	
    23	epic_branches:
    24	  rebase_behind_commits: 10 # rebase epic branch when behind main by N
    25	  rebase_max_age_days: 2 # ...or older than this, whichever first
    26	  worktree_root: .worktrees/
    27	
    28	bugfix_lane:
    29	  branch: fix/rolling
    30	  # Graduating to auto-merge requires amending rolling-small-fixes.md first
    31	  # ("never auto-merge a rolling batch") — the procedure outranks this flag.
    32	  merge: owner-flush
    33	
    34	trust_ladder:
    35	  # Precedence: class_b_always is evaluated first and overrides any class_a
    36	  # match. A path listed here is class B even when an allowlist glob covers it
    37	  # (e.g. docs/** covers docs/procedures/MODEL-CARD.md — the card stays class B).
    38	  class_b_always:
    39	    - .agents/factory/policy.yaml
    40	    - .github/workflows/**
    41	    - docs/procedures/MODEL-CARD.md
    42	    - AGENTS.md
    43	    - .agents/personas/**
    44	    - .agents/factory/**
    45	  class_a:
    46	    max_changed_lines: 300
    47	    require_reviewer_pass: true
    48	    path_allowlist:
    49	      - docs/**
    50	      - "**/__tests__/**"
    51	      - .agents/skills/**
    52	
    53	models:
    54	  # Tiers resolve via docs/procedures/MODEL-CARD.md (priority-ordered).
    55	  # Seats, owner-ratified 2026-08-10 (gh-1187 S0): triage / orchestrator /
    56	  # worker. `worker`'s tier is only its DEFAULT — model routing lives at
    57	  # dispatch (per-session, or per-automation via #1143), so a taste-heavy UI
    58	  # bead opens a worker session on a higher tier without a roster change.
    59	  # Deferred grow-on-demand seats (concierge, reviewer, auditor, beadle) get
    60	  # their tier back here when they get a fleet.yaml entry back.
    61	  seats:
    62	    orchestrator: T1
    63	    worker: T3
    64	    triage: T3
    65	    automation: T4
