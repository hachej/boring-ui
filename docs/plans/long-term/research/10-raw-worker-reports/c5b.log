   144	class RegexFilteredCompanyContextProvider implements FilesystemBindingProvider {
   145	  constructor(
   146	    private readonly sourceRoot: string,
   147	    private readonly allowedRules: readonly RegExp[],
   148	    private readonly projectionRootParent: string,
   149	  ) {}
   150	
   151	  async disposeBinding(prepared: PreparedFilesystemBinding): Promise<void> {
   152	    const handle = prepared.handle as Partial<RegexProjectionHandle>
   153	    if (handle.lifecycle) handle.lifecycle.active = false
   154	    if (handle.projectionRoot) {
   155	      await makeProjectionRemovable(handle.projectionRoot)
   156	      await rm(handle.projectionRoot, { recursive: true, force: true })
   157	    }
   158	  }
   159	
   160	  async prepareBinding(_ctx: BoundFilesystemContext, binding: FilesystemBinding): Promise<PreparedFilesystemBinding> {
   161	    if (binding.filesystem !== COMPANY_CONTEXT_FILESYSTEM_ID) throw new Error(`unsupported filesystem binding ${binding.filesystem}`)
   162	    if (binding.access !== 'readonly' || binding.projection !== 'policy-filtered') {
   163	      throw new Error('company_context policy mount only supports readonly policy-filtered bindings')
   164	    }
   165	
   166	    await access(this.sourceRoot, constants.R_OK)
   167	    const projectionRoot = await mkdtemp(path.join(this.projectionRootParent, 'boring-company-context-'))
   168	    try {
   169	      const files = await walkFiles(this.sourceRoot)
   170	
   171	      for (const sourceFile of files) {
   172	        await assertInsideRoot(this.sourceRoot, sourceFile)
   173	        const rel = path.relative(this.sourceRoot, sourceFile).split(path.sep).join('/')
   174	        const companyPath = normalizeCompanyPath(rel)
   175	        if (!this.allowedRules.some((rule) => rule.test(companyPath))) continue
   176	        const destination = path.join(projectionRoot, ...companyPath.slice(1).split('/'))
   177	        await mkdir(path.dirname(destination), { recursive: true })
   178	        await copyFile(sourceFile, destination)
   179	      }
   180	
   181	      await makeProjectionReadonly(projectionRoot)
   182	      return {
   183	        binding,
   184	        handle: {
   185	          filesystem: binding.filesystem,
   186	          projectionRoot,
   187	          lifecycle: { active: true },
   188	        } satisfies RegexProjectionHandle,
   189	      }
   190	    } catch (error) {
   191	      await makeProjectionRemovable(projectionRoot)
   192	      await rm(projectionRoot, { recursive: true, force: true })
   193	      throw error
   194	    }
   195	  }
   196	}
