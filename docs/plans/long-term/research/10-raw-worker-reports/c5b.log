   339	  const fleetRaw = await readYamlFile(options.fleetConfigPath, 'fleetConfigPath')
   340	  const seats = parseFleetConfig(fleetRaw, options.fleetConfigPath)
   341	  const modelTierCandidates = parseModelTierCandidates(fleetRaw, options.fleetConfigPath)
   342	
   343	  let seatTiers: Readonly<Record<string, string>> = Object.freeze({})
   344	  try {
   345	    seatTiers = parseSeatTiers(await readYamlFile(options.policyPath, 'policyPath'))
   346	  } catch {
   347	    // Model-tier resolution is best-effort: an unreadable/malformed policy
   348	    // file omits preferred models for every seat rather than failing boot.
   349	    seatTiers = Object.freeze({})
   350	  }
   351	  validateSeatTierCandidates(seatTiers, modelTierCandidates, options.fleetConfigPath, options.policyPath)
   352	
   353	  // Resolve the served root once, but keep failure per-seat and fail-closed:
   354	  // composition can still proceed while publication reports the existing
   355	  // stable unpublishable diagnostic.
   356	  const canonicalWorkspaceRoot = options.workspaceRoot === null
   357	    ? null
   358	    : await realpath(resolve(options.workspaceRoot)).catch(() => null)
   359	
   360	  const agents: ConfiguredAgentHostAgentSpec[] = []
   361	  const diagnostics: FleetLoaderDiagnostic[] = []
   362	  const packagesByDefinitionId = new Map<string, DiscoveredAgentPackageDescriptor[]>()
   363	  for (const descriptor of options.discoveredPackages) {
   364	    const definitionId = descriptor.manifest.boring.agent.definitionId
   365	    const existing = packagesByDefinitionId.get(definitionId) ?? []
   366	    existing.push(descriptor)
   367	    packagesByDefinitionId.set(definitionId, existing)
   368	  }
   369	  const seatedDefinitionIds = new Set(seats.map((seat) => seat.agentTypeId))
   370	  const conflictedDefinitionIds = new Set<string>()
   371	  for (const [definitionId, descriptors] of packagesByDefinitionId) {
   372	    if (descriptors.length > 1) {
   373	      conflictedDefinitionIds.add(definitionId)
   374	      for (const _descriptor of descriptors) {
   375	        diagnostics.push({
   376	          agentTypeId: definitionId,
   377	          code: ErrorCode.enum.AGENT_DEFINITION_ID_CONFLICT,
   378	          message: `agent definition "${definitionId}" is claimed by multiple discovered packages`,
   379	        })
