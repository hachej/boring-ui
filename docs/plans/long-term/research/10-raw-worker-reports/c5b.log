   207	  if (!resolved.environment.placementIdentity.trim() || !resolved.environment.provisioningFingerprint.trim()) {
   208	    throw new TypeError('resolved environment identity must be non-empty')
   209	  }
   210	}
   211	
   212	function validateDirectResolvedRuntimeScope(
