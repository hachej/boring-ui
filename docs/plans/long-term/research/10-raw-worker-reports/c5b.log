   164	    this.closePromise ??= this.closeAll(Math.max(0, graceMs))
   165	    return this.closePromise
   166	  }
   167	
   168	  private disposeRecord(record: EnvironmentRecord): Promise<void> {
   169	    record.disposalPromise ??= (async () => {
   170	      let generation: EnvironmentGeneration
   171	      try {
   172	        generation = await record.generation
   173	      } catch {
   174	        // Creation owns and reports its failure. If it acquired provider bytes,
   175	        // createEnvironment already owns their exactly-once cleanup.
   176	        return
   177	      }
   178	      await generation.bundle.disposeRuntime?.()
   179	    })()
   180	    // A shutdown deadline may detach this cleanup. Always observe its eventual
   181	    // rejection, and keep this one promise as the exactly-once teardown owner.
   182	    record.disposalPromise.catch(() => {})
   183	    return record.disposalPromise
   184	  }
   185	
   186	  private async closeAll(graceMs: number): Promise<void> {
   187	    const records = [...this.records.values()]
   188	    this.records.clear()
   189	    const disposals = records.map((record) => this.disposeRecord(record))
   190	    if (disposals.length === 0) return
   191	    const result = await Promise.race([
   192	      Promise.allSettled(disposals).then((results) => ({ completed: true as const, results })),
   193	      delay(graceMs).then(() => ({ completed: false as const })),
   194	    ])
   195	    if (!result.completed) return
   196	    const failed = result.results.find((entry): entry is PromiseRejectedResult => entry.status === 'rejected')
   197	    if (failed) throw failed.reason
   198	  }
   199	
   200	  /** Test/diagnostic snapshot; does not expose roots or providers publicly. */
   201	  size(): number {
   202	    return this.records.size
   203	  }
   204	}
