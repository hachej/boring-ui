    68	function normalizeCompanyPath(value: string): string {
    69	  const normalized = value.replace(/\\/g, '/')
    70	  if (normalized.includes('\0')) throw new Error('invalid company path')
    71	  const withRoot = normalized.startsWith('/') ? normalized : `/${normalized}`
    72	  const parts = withRoot.split('/').filter(Boolean)
    73	  if (parts.some((part) => part === '.' || part === '..')) throw new Error('company path traversal is not allowed')
    74	  return `/${parts.join('/')}`
    75	}
