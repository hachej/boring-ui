    86	/** Runs one callback-scoped dispatcher lease and fences every operation before provider release. */
    87	export async function runWithWorkspaceAgentLease(input: {
    88	  readonly runtime: AgentHostRuntime
    89	  readonly gateway: EmbeddedAgentGateway
    90	  readonly request: AgentHostDispatcherRunInput
    91	  readonly run: (binding: LeaseBoundWorkspaceAgent) => Promise<void>
    92	}): Promise<void> {
    93	  const { runtime, gateway, request, run } = input
    94	  const requestId = request.requestId.trim()
    95	  if (!requestId || requestId.length > 128) throw new TypeError('requestId must be 1-128 characters')
