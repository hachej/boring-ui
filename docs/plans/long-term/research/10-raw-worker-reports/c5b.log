    30	/**
    31	 * Flag-gated durable event streaming. When set (`1`/`true`), production
    32	 * composition constructs a {@link SqliteEventStreamStore} on the host
    33	 * session-root volume so `HarnessPiChatService` can resume live streams
    34	 * across process restarts. Absent (default), behavior is byte-identical to
    35	 * pre-durability composition: no store, in-memory streaming only.
    36	 */
    37	export const DURABLE_STREAM_ENV_FLAG = 'BORING_CHAT_DURABLE_STREAM'
    38	export const EVENT_STORE_FILE_NAME = '.agent-event-stream.sqlite'
    39	
    40	export function isDurableStreamEnabled(): boolean {
    41	  const raw = process.env[DURABLE_STREAM_ENV_FLAG]
    42	  return raw === '1' || raw === 'true'
    43	}
