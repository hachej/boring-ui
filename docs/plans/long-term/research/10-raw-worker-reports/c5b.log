    36	
    37	/**
    38	 * `BORING_AGENT_FLEET=1` composes the config-driven production fleet
    39	 * from boot-injected plugin scan descriptors plus `.agents/factory` under `repositoryRoot`
    40	 * alongside the default agent; flag absent preserves the legacy
    41	 * single-default-agent boot byte-identically. Shared by
    42	 * `createWorkspaceAgentServer`, `createCoreWorkspaceAgentServer`, and the CLI
    43	 * hub — one composition path for every production/CLI entry point.
    44	 *
    45	 * Fails closed at two levels:
    46	 *  - Per seat: `loadConfiguredAgentFleet` excludes an individual invalid
    47	 *    persona/skill with a stable diagnostic; the remaining seats still boot
    48	 *    (see its own docstring).
    49	 *  - Whole fleet: a missing/malformed `fleet.yaml` or `policy.yaml` would
    50	 *    otherwise throw `FleetConfigError` out of the boot path. That throw is
    51	 *    preserved for direct/programmatic callers of `loadConfiguredAgentFleet`
    52	 *    (e.g. the playground, tests), but this boot-seam wrapper catches it and
    53	 *    degrades to the legacy default-agent-only fleet plus a logged
    54	 *    diagnostic — a container with the flag on and no `.agents/` tree must
    55	 *    still boot.
    56	 */
    57	export async function resolveDefaultAgentFleet(
    58	  options: ResolveDefaultAgentFleetOptions,
    59	): Promise<readonly AgentHostAgentSpec[]> {
    60	  const env = options.env ?? process.env
    61	  if (env.BORING_AGENT_FLEET !== '1') return LEGACY_DEFAULT_AGENT_FLEET
    62	  const root = options.repositoryRoot ?? process.cwd()
    63	  try {
    64	    if (!options.discoveredPackages) throw new Error('agent package discovery descriptors were not injected by the boot layer')
    65	    const { agents: configuredAgents, diagnostics } = await loadConfiguredAgentFleet({
    66	      discoveredPackages: options.discoveredPackages,
    67	      workspaceRoot: options.workspaceRoot,
    68	      fleetConfigPath: resolve(root, '.agents', 'factory', 'fleet.yaml'),
    69	      policyPath: resolve(root, '.agents', 'factory', 'policy.yaml'),
    70	      skillsRoot: resolve(root, '.agents', 'skills'),
    71	      env,
    72	    })
    73	    for (const diagnostic of diagnostics) {
    74	      // Not every diagnostic excludes a seat: an unpublishable instructions
    75	      // path withholds one link while the seat boots and chats normally, and
    76	      // an unseated discovered definition is merely inert.
    77	      const excluded = diagnostic.code !== ErrorCode.enum.AGENT_FLEET_SEAT_INSTRUCTIONS_PATH_UNPUBLISHABLE
    78	      logger.warn(excluded ? 'fleet package excluded or inert' : 'fleet seat instructions not linkable', {
    79	        seat: diagnostic.seat,
    80	        agentTypeId: diagnostic.agentTypeId,
    81	        code: diagnostic.code,
    82	        message: diagnostic.message,
    83	      })
    84	    }
    85	    return Object.freeze([...LEGACY_DEFAULT_AGENT_FLEET, ...configuredAgents])
    86	  } catch (error) {
    87	    logger.error('fleet composition failed at boot; degrading to the legacy default agent', {
    88	      error: error instanceof Error ? error.message : String(error),
    89	      code: (error as { code?: unknown })?.code,
    90	    })
    91	    return LEGACY_DEFAULT_AGENT_FLEET
    92	  }
    93	}
