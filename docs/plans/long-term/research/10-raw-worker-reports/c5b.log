   560	/** Host-owned addressed routes that require a runtime binding/harness. */
   561	export function createAgentHostRuntimeCapabilityRoutes(
   562	  projection: AgentHostRuntimeCapabilityProjection,
   563	): FastifyPluginAsync {
   564	  return async (app) => {
   565	    app.setErrorHandler((error, _request, reply) => sendError(reply, error))
   566	    const cache = new WeakMap<FastifyRequest, Map<string, Promise<AgentHostRuntimeCapabilityBinding>>>()
   567	    const resolve = (request: FastifyRequest, agentTypeId: string, sessionId?: string) => {
   568	      let entries = cache.get(request)
   569	      if (!entries) {
   570	        entries = new Map()
   571	        cache.set(request, entries)
   572	      }
   573	      const key = JSON.stringify([agentTypeId, sessionId ?? null])
   574	      let value = entries.get(key)
   575	      if (!value) {
   576	        value = projection.resolveBinding({ request, agentTypeId, sessionId })
   577	        entries.set(key, value)
   578	      }
   579	      return value
   580	    }
   581	    const agentId = (request: FastifyRequest) =>
   582	      (request.params as { agentTypeId: string }).agentTypeId
   583	
   584	    await app.register(modelsRoutes, {
   585	      path: '/api/v1/agents/:agentTypeId/models',
   586	      filterModels: projection.filterModels,
   587	      authorizeRequest: async (request) => { await resolve(request, agentId(request)) },
   588	    })
   589	    await app.register(skillsRoutes, {
