   198	function asRuntimeOperations(ops: ReadonlyProjectionOperations): RuntimeFilesystemBindingOperations {
   199	  return {
   200	    read: (descriptor) => ops.read(descriptor),
   201	    list: (descriptor) => ops.list(descriptor),
   202	    find: (descriptor, pattern, options) => ops.find(descriptor, pattern, options),
   203	    grep: (descriptor, pattern, options) => ops.grep(descriptor, pattern, options),
   204	    stat: (descriptor) => ops.stat(descriptor),
   205	    rejectMutation: (operation, descriptor) => ops.rejectMutation(operation, descriptor),
   206	  }
   207	}
