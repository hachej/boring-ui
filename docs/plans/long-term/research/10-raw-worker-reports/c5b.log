   403	  app.get('/api/v1/agents/:agentTypeId/sessions/:sessionId/events', async (request, reply) => {
   404	    const params = parseWithSchema(SessionParamsSchema, request.params, reply, 'params')
   405	    if (!params) return
   406	    const query = parseWithSchema(EventsQuerySchema, request.query, reply, 'query')
   407	    if (!query) return
   408	
   409	    let connection: AgentSessionConnection | undefined
   410	    let connectionClose: Promise<void> | undefined
   411	    let heartbeat: ReturnType<typeof setInterval> | undefined
   412	    let clientClosed = request.raw.aborted
   413	    let listenersRemoved = false
   414	    const closeConnection = () => {
   415	      if (!connection) return Promise.resolve()
   416	      connectionClose ??= connection.close().catch(() => {})
   417	      return connectionClose
   418	    }
   419	    const close = () => {
   420	      clientClosed = true
   421	      if (!listenersRemoved) {
   422	        listenersRemoved = true
   423	        request.raw.off('aborted', close)
   424	        reply.raw.off('close', close)
   425	      }
   426	      if (heartbeat) {
   427	        clearInterval(heartbeat)
   428	        heartbeat = undefined
   429	      }
   430	      void closeConnection()
   431	    }
   432	    request.raw.once('aborted', close)
   433	    reply.raw.once('close', close)
   434	    if (request.raw.aborted) close()
   435	    try {
   436	      connection = await input.gateway.connectSession({
   437	        scope: await input.options.authorizeAgentRequest(request),
   438	        ref: params,
   439	        cursor: query.cursor,
   440	      })
   441	      if (clientClosed) {
   442	        await closeConnection()
   443	        return reply
   444	      }
   445	      const activeConnection = connection
   446	      const stream = new PassThrough()
   447	      const writeFrame = (frame: unknown) => {
   448	        if (!clientClosed) stream.write(`${JSON.stringify(frame)}\n`)
   449	      }
   450	      const writeHeartbeat = () => writeFrame({ type: 'heartbeat', now: new Date().toISOString() })
   451	      heartbeat = setInterval(writeHeartbeat, ADDRESSED_HEARTBEAT_INTERVAL_MS)
   452	      heartbeat.unref()
   453	      writeHeartbeat()
   454	      void (async () => {
   455	        try {
   456	          for await (const event of activeConnection.events) writeFrame(event)
   457	        } finally {
   458	          if (!clientClosed) stream.end()
   459	          close()
   460	        }
   461	      })().catch((error) => {
   462	        if (!clientClosed) stream.destroy(error instanceof Error ? error : new Error(String(error)))
   463	        close()
   464	      })
   465	      return reply
   466	        .header('Content-Type', 'application/x-ndjson')
   467	        .header('Cache-Control', 'no-cache, no-transform')
   468	        .header('X-Accel-Buffering', 'no')
   469	        .send(stream)
   470	    } catch (error) {
   471	      const wasClientClosed = clientClosed
   472	      close()
   473	      await closeConnection()
   474	      if (wasClientClosed) return reply
   475	      return sendError(reply, error)
   476	    }
   477	  })
