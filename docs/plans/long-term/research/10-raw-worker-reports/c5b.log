   210	  const explicitSourceRoot = env[GOVERNANCE_COMPANY_CONTEXT_ROOT_ENV]?.trim()
   211	  if (explicitSourceRoot) return () => path.resolve(explicitSourceRoot)
   212	  if (env[AGENT_MODE_ENV]?.trim() === 'vercel-sandbox') return undefined
