    15	export interface ResolveDefaultAgentFleetOptions {
    16	  /**
    17	   * Repository root used to resolve `.agents/{factory,skills}` when
    18	   * `BORING_AGENT_FLEET=1` composes the fleet. Defaults to `process.cwd()`.
    19	   */
