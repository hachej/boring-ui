    67	
    68	function normalizeCompanyPath(value: string): string {
    69	  const normalized = value.replace(/\\/g, '/')
    70	  if (normalized.includes('\0')) throw new Error('invalid company path')
    71	  const withRoot = normalized.startsWith('/') ? normalized : `/${normalized}`
    72	  const parts = withRoot.split('/').filter(Boolean)
    73	  if (parts.some((part) => part === '.' || part === '..')) throw new Error('company path traversal is not allowed')
    74	  return `/${parts.join('/')}`
    75	}
    76	
    77	async function assertInsideRoot(root: string, candidate: string): Promise<void> {
    78	  const realRoot = await realpath(root)
    79	  const existing = await realpath(candidate)
    80	  const rel = path.relative(realRoot, existing)
    81	  if (rel.startsWith('..') || path.isAbsolute(rel)) throw new Error('path escapes company context root')
    82	}
    83	
    84	async function walkFiles(root: string, current = root): Promise<string[]> {
    85	  const entries = await readdir(current, { withFileTypes: true })
    86	  const out: string[] = []
    87	  for (const entry of entries) {
    88	    if (current === root && entry.name === COMPANY_CONTEXT_STATE_DIR) continue
    89	    const absolutePath = path.join(current, entry.name)
    90	    const entryStat = await lstat(absolutePath)
    91	    if (entryStat.isSymbolicLink()) continue
    92	    if (entry.isDirectory()) out.push(...await walkFiles(root, absolutePath))
    93	    else if (entry.isFile()) out.push(absolutePath)
    94	  }
    95	  return out
    96	}
    97	
    98	async function makeProjectionReadonly(root: string, current = root): Promise<void> {
    99	  const entries = await readdir(current, { withFileTypes: true })
   100	  for (const entry of entries) {
   101	    const absolutePath = path.join(current, entry.name)
   102	    if (entry.isDirectory()) await makeProjectionReadonly(root, absolutePath)
   103	    else if (entry.isFile()) await chmod(absolutePath, 0o400)
   104	  }
   105	  await chmod(current, 0o500)
   106	}
   107	
   108	async function makeProjectionRemovable(current: string): Promise<void> {
   109	  await chmod(current, 0o700).catch(() => {})
   110	  const entries = await readdir(current, { withFileTypes: true }).catch(() => [])
   111	  for (const entry of entries) {
   112	    const absolutePath = path.join(current, entry.name)
   113	    if (entry.isDirectory()) await makeProjectionRemovable(absolutePath)
   114	    else await chmod(absolutePath, 0o600).catch(() => {})
   115	  }
   116	}
