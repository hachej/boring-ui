    45	
    46	const CACHE_TTL_MS = 30_000
    47	
    48	function provisionedWorkspaceRoots(additionalSkillPaths: readonly string[]): string[] {
    49	  // Provisioning can contribute both runtime-visible and real-disk
    50	  // <workspace root>/.agents/skills paths, so preserve every coordinate.
    51	  const userSkillsSuffix = `${sep}.agents${sep}skills`
    52	  return additionalSkillPaths
    53	    .map((skillPath) => resolve(skillPath))
    54	    .filter((skillPath) => skillPath.endsWith(userSkillsSuffix))
    55	    .map((skillPath) => dirname(dirname(skillPath)))
    56	}
    57	
    58	export function pathForWorkspaceEditor(
    59	  workspace: Pick<Workspace, 'root'>,
    60	  filePath: string,
    61	  additionalSkillPaths: readonly string[] = [],
    62	): string {
    63	  const roots = [workspace.root, ...provisionedWorkspaceRoots(additionalSkillPaths)]
    64	  for (const root of roots) {
    65	    const pathWithinWorkspace = relative(resolve(root), resolve(filePath))
    66	    if (pathWithinWorkspace === '' || pathWithinWorkspace === '..' || pathWithinWorkspace.startsWith(`..${sep}`) || isAbsolute(pathWithinWorkspace)) {
    67	      continue
    68	    }
    69	    return pathWithinWorkspace.split(sep).join('/')
    70	  }
    71	  return filePath
    72	}
    73	
    74	function resourceKey(resource: AgentSkillResource): string {
    75	  return `${resource.filesystem}\0${resource.path}`
    76	}
    77	
    78	export interface SkillsRoutesOptions {
    79	  path?: string
    80	  authorizeRequest?: (request: FastifyRequest) => void | Promise<void>
    81	  workspace?: Workspace
    82	  additionalSkillPaths?: string[]
    83	  piPackages?: PiPackageSource[]
    84	  noSkills?: boolean
    85	  getWorkspace?: (request: FastifyRequest) => Workspace | Promise<Workspace>
    86	  getAdditionalSkillPaths?: (request: FastifyRequest) => string[] | undefined | Promise<string[] | undefined>
    87	  getPiPackages?: (request: FastifyRequest) => PiPackageSource[] | undefined | Promise<PiPackageSource[] | undefined>
    88	  getNoSkills?: (request: FastifyRequest) => boolean | undefined | Promise<boolean | undefined>
    89	  getSkillResourceSnapshot?: (request: FastifyRequest) => AgentSkillResourceSnapshot | undefined | Promise<AgentSkillResourceSnapshot | undefined>
    90	}
    91	
    92	export function skillsRoutes(
    93	  app: FastifyInstance,
    94	  opts: SkillsRoutesOptions,
    95	  done: (err?: Error) => void,
    96	): void {
    97	  const cached = new Map<string, { skills: SkillSummary[]; expiresAt: number }>()
    98	
    99	  async function resolveSkillsForRequest(request: FastifyRequest, refresh = false) {
   100	    const workspace = opts.getWorkspace
   101	      ? await opts.getWorkspace(request)
   102	      : opts.workspace
   103	    if (!workspace) throw new Error('skills route requires workspace or getWorkspace')
   104	    const workspaceRoot = workspace.root
   105	    const additionalSkillPaths = opts.getAdditionalSkillPaths
   106	      ? await opts.getAdditionalSkillPaths(request)
   107	      : opts.additionalSkillPaths
   108	    const piPackages = opts.getPiPackages
   109	      ? await opts.getPiPackages(request)
   110	      : opts.piPackages
   111	    // Capture the locator/catalog generation once so this response cannot mix
   112	    // management rows and locators from different reload snapshots.
   113	    const resourceSnapshot = await opts.getSkillResourceSnapshot?.(request)
   114	    // `undefined` means the host didn't say — resolve through the canonical
   115	    // harness policy so a bare registration can't silently flip ambient
   116	    // skill discovery on.
   117	    const noSkills = (opts.getNoSkills
   118	      ? await opts.getNoSkills(request)
   119	      : opts.noSkills) ?? withPiHarnessDefaults().noSkills
   120	    const cacheKey = JSON.stringify([workspaceRoot, additionalSkillPaths ?? [], piPackages ?? [], noSkills, resourceSnapshot?.generation ?? null])
   121	    const now = Date.now()
   122	    for (const [key, entry] of cached) {
   123	      if (entry.expiresAt <= now) cached.delete(key)
   124	    }
   125	    const cachedEntry = cached.get(cacheKey)
   126	    if (!refresh && cachedEntry && cachedEntry.expiresAt > now) return cachedEntry
   127	
   128	    const agentDir = getAgentDir()
   129	    const packageSkillPaths = noSkills
   130	      ? []
   131	      : await (async () => {
   132	          const settingsManager = createResourceSettingsManager(
   133	            workspaceRoot,
   134	            agentDir,
   135	            piPackages ?? [],
   136	          )
   137	          const packageManager = new DefaultPackageManager({
   138	            cwd: workspaceRoot,
   139	            agentDir,
   140	            settingsManager,
   141	          })
   142	          const resolved = await packageManager.resolve()
   143	          return resolved.skills
   144	            .filter((resource) => resource.enabled)
   145	            .map((resource) => resource.path)
   146	        })()
   147	    const result = loadSkills({
   148	      cwd: workspaceRoot,
   149	      agentDir,
   150	      skillPaths: [...packageSkillPaths, ...(additionalSkillPaths ?? [])],
   151	      includeDefaults: !noSkills,
   152	    })
   153	    const invocationSkills: SkillSummary[] = (result.skills as unknown as Array<Record<string, unknown>>).map((s) => {
   154	      const absoluteFilePath = typeof s.filePath === 'string' ? s.filePath : undefined
   155	      const workspacePath = absoluteFilePath
   156	        ? pathForWorkspaceEditor(workspace, absoluteFilePath, additionalSkillPaths ?? [])
   157	        : undefined
   158	      const resource = absoluteFilePath
   159	        ? resourceSnapshot?.locateSkill(absoluteFilePath) ??
   160	          (workspacePath && !isAbsolute(workspacePath) ? { filesystem: 'user' as const, path: workspacePath } : undefined)
   161	        : undefined
   162	      return {
   163	        name: String(s.name),
   164	        description: String(s.description ?? ''),
   165	        ...(resource ? { resource } : {}),
   166	        ...(typeof (s.sourceInfo as { scope?: unknown } | undefined)?.scope === 'string' ? { source: (s.sourceInfo as { scope: string }).scope } : {}),
   167	      }
   168	    })
   169	    // Pinned Pi collapses duplicate frontmatter names. Preserve every admitted
   170	    // management identity while leaving Pi's invocation winner untouched.
   171	    const skills: SkillSummary[] = []
   172	    const seenResources = new Set<string>()
   173	    const managementSkills = (resourceSnapshot?.managedSkills ?? []).map((skill) => ({
   174	      ...skill,
   175	      invocable: skill.invocable ?? false,
   176	    }))
   177	    for (const skill of [...invocationSkills, ...managementSkills]) {
   178	      if (skill.resource) {
   179	        const key = resourceKey(skill.resource)
   180	        if (seenResources.has(key)) continue
   181	        seenResources.add(key)
   182	      }
   183	      skills.push(skill)
   184	    }
   185	    const entry = { skills, expiresAt: now + CACHE_TTL_MS }
