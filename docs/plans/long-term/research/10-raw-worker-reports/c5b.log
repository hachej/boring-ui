   128	  const drainRequested = new Promise<void>((resolve) => { signalDrain = resolve })
   129	  let signalRevocation!: () => void
   130	  const revocation = new Promise<void>((resolve) => { signalRevocation = resolve })
   131	  let drainDeadline: number | undefined
   132	  const registerCleanup = (cleanup: () => void) => {
   133	    cleanups.add(cleanup)
   134	    return () => cleanups.delete(cleanup)
   135	  }
   136	  const trackOperation = <T>(operation: Promise<T>): Promise<T> => {
   137	    const publication = Promise.race([
   138	      operation.then((value) => {
   139	        if (revoked) throw bindingDisposedError()
   140	        return value
   141	      }),
   142	      revocation.then(() => { throw bindingDisposedError() }),
   143	    ])
   144	    const tracked = publication.finally(() => operations.delete(tracked))
   145	    operations.add(tracked)
