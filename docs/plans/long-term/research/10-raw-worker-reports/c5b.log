    51	function instructionBlock(appendix: TrustedAgentInstructionAppendix): string {
    52	  return [
    53	    `<!-- boring-skill:start name=${appendix.name} digest=${appendix.digest} -->`,
    54	    appendix.content,
    55	    `<!-- boring-skill:end name=${appendix.name} -->`,
    56	  ].join('\n')
