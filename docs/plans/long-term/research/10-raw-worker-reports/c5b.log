    58	
    59	function frozenJson(value: JsonValue): JsonValue {
    60	  if (Array.isArray(value)) return Object.freeze(value.map(frozenJson))
    61	  if (value !== null && typeof value === 'object') {
    62	    return Object.freeze(Object.fromEntries(
    63	      Object.entries(value).map(([key, entry]) => [key, frozenJson(entry)]),
    64	    ))
    65	  }
    66	  return value
    67	}
