    69	async function validateAppendices(
    70	  appendices: readonly TrustedAgentInstructionAppendix[],
    71	): Promise<readonly TrustedAgentInstructionAppendix[]> {
    72	  const seen = new Set<string>()
    73	  const validated: TrustedAgentInstructionAppendix[] = []
    74	  for (const [index, appendix] of appendices.entries()) {
    75	    const field = `policy.instructionAppendices[${index}]`
    76	    if (!APPENDIX_NAME_RE.test(appendix.name)) {
    77	      throw new TrustedAgentCompositionError(`${field}.name`, 'instruction appendix name is invalid')
    78	    }
    79	    if (seen.has(appendix.name)) {
    80	      throw new TrustedAgentCompositionError(`${field}.name`, 'instruction appendix name is duplicated')
    81	    }
    82	    if (appendix.content.trim().length === 0) {
    83	      throw new TrustedAgentCompositionError(`${field}.content`, 'instruction appendix content is empty')
    84	    }
    85	    if (await createAgentAssetDigest(appendix.content) !== appendix.digest) {
    86	      throw new TrustedAgentCompositionError(`${field}.digest`, 'instruction appendix digest does not match content')
    87	    }
    88	    seen.add(appendix.name)
    89	    validated.push(Object.freeze({ ...appendix }))
    90	  }
    91	  return Object.freeze(validated)
    92	}
