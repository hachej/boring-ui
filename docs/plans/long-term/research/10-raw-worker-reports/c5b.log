   282	  const publishedBindings = new Map<string, RuntimeBinding>()
   283	  const publishedCurrentBindings = new Map<string, RuntimeBinding>()
   284	  const currentBindingReservations = new Map<string, string>()
   285	  const nextBindingGeneration = new Map<string, number>()
   286	  const pendingBindings = new Set<Promise<RuntimeBinding>>()
   287	  const rejectPendingBindings = new Set<(error: unknown) => void>()
   288	  const bindingDisposals = new WeakMap<RuntimeBinding, Promise<void>>()
   289	  const subscriptions = new Set<() => void | Promise<void>>()
   290	  const subscriptionClosures = new Set<Promise<void>>()
