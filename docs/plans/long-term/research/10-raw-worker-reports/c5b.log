   250	  async listAgents(input: { readonly scope: AuthorizedAgentScope }) {
   251	    await this.verify(input.scope)
   252	    return this.runtime.compiledAgents.map((agent) => ({
   253	      agentTypeId: agent.agentTypeId,
   254	      label: 'legacyDefault' in agent ? 'Agent' : agent.definition.label,
   255	      ...('legacyDefault' in agent || !agent.plugins?.length
   256	        ? {}
   257	        : { pluginIds: agent.plugins.map((plugin) => plugin.name) }),
   258	      ...('legacyDefault' in agent || !agent.definition.version
   259	        ? {}
   260	        : { definition: { version: agent.definition.version, digest: canonicalDigest(agent.definition as unknown as JsonValue) } }),
