   176	function statusForGatewayError(code: string): number {
   177	  if (code === AgentGatewayErrorCode.AGENT_SCOPE_DENIED) return 403
   178	  if (code === AgentGatewayErrorCode.AGENT_SESSION_NOT_FOUND || code === AgentGatewayErrorCode.AGENT_TYPE_UNKNOWN) return 404
   179	  if (
   180	    code === AgentGatewayErrorCode.AGENT_REQUEST_CONFLICT
   181	    || code === AgentGatewayErrorCode.AGENT_REQUEST_IN_PROGRESS
   182	    || code === AgentGatewayErrorCode.AGENT_REQUEST_OUTCOME_UNKNOWN
   183	    || code === AgentGatewayErrorCode.AGENT_RUNTIME_RESTART_REQUIRED
   184	    || code === AgentGatewayErrorCode.AGENT_COMMAND_INVALID_STATE
   185	    || code === AgentGatewayErrorCode.AGENT_SESSION_RUNTIME_SCOPE_MISMATCH
   186	    || code.includes('CURSOR')
   187	    || code.includes('REPLAY')
   188	  ) return 409
   189	  if (
   190	    code === AgentGatewayErrorCode.AGENT_GATEWAY_CLOSED
   191	    || code === AgentGatewayErrorCode.AGENT_SHARED_ENVIRONMENT_UNAVAILABLE
   192	  ) return 503
   193	  return 400
   194	}
