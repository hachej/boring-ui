   216	  if (!resolved.resourceInputDigest?.trim()) {
   217	    throw new TypeError('direct resolved runtime scope resourceInputDigest must be non-empty')
   218	  }
   219	  if (!resolved.physicalBindingIdentity?.trim()) {
   220	    throw new TypeError('direct resolved runtime scope physicalBindingIdentity must be non-empty')
   221	  }
   222	}
