    45	/**
    46	 * Opens (or creates) the durable event-stream SQLite database under the same
    47	 * durable-volume root convention as session storage (AGENTS.md hard rule 9):
    48	 * `sessionRoot` (the host's `BORING_AGENT_SESSION_ROOT`-derived path) when
    49	 * set, else the HOST-side storage root resolved via
    50	 * `getOptionalRuntimeBundleStorageRoot` — the same accessor already used
    51	 * twelve lines above this call for `bashRuntimeBundle`. This deliberately
    52	 * never falls back to `runtimeBundle.workspace.root`: in sandbox runtime
    53	 * mode that is an IN-SANDBOX (guest) path, and writing the durable store
    54	 * there would either fail invisibly or, worse, silently land the "durable"
    55	 * store inside an ephemeral guest filesystem that vanishes with the sandbox.
    56	 * If the store cannot be opened while the durable-stream flag is on —
    57	 * because neither a session root nor a host storage root is resolvable, or
    58	 * because `openDatabase` fails at the resolved path — this fails LOUDLY:
    59	 * a stable-coded telemetry diagnostic is reported and a
    60	 * {@link DurableStreamUnavailableError} (code `DURABLE_STREAM_UNAVAILABLE`,
    61	 * carrying the underlying cause) is thrown so boot aborts. The operator
    62	 * asked for durability; silently degrading to in-memory streaming would
    63	 * betray that. Flag off = this function is never called and behavior is
    64	 * byte-identical to pre-durability composition.
    65	 */
    66	export function openDurableEventStore(input: {
    67	  readonly sessionRoot?: string
    68	  readonly hostStorageRoot?: string
    69	  readonly telemetry?: TelemetrySink
    70	}): { store: EventStreamStore; close: () => void } {
    71	  const root = input.sessionRoot ?? input.hostStorageRoot
    72	  if (!root) {
    73	    const reason = 'No sessionRoot and no host storage root available; refusing to fall back to a sandbox/guest path.'
    74	    reportEventStoreOpenFailure(input.telemetry, '(no host-resolvable root)', reason)
    75	    throw new DurableStreamUnavailableError('(no host-resolvable root)', reason)
    76	  }
    77	  const path = join(root, EVENT_STORE_FILE_NAME)
    78	  let opened: OpenDatabaseResult
    79	  try {
    80	    opened = openDatabase(path)
    81	  } catch (error) {
    82	    const reason = error instanceof Error ? error.message : String(error)
    83	    reportEventStoreOpenFailure(input.telemetry, path, reason)
    84	    throw new DurableStreamUnavailableError(path, reason, error)
    85	  }
    86	  return {
    87	    store: new SqliteEventStreamStore(opened.sql, opened.runTransaction),
    88	    close: () => opened.db.close(),
    89	  }
