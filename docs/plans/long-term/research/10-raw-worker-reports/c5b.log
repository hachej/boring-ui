   586	/** Awaited Fastify projection for the addressed Gateway surface. */
   587	export function createAgentHostRoutes(input: ProjectionInput): FastifyPluginAsync {
   588	  return async (app) => {
   589	    claimAgentHostProjection(app, input.host)
   590	    app.addHook('preClose', async () => {
   591	      await input.host.drain()
   592	    })
   593	    app.addHook('onClose', async () => {
   594	      await input.host.close()
   595	    })
   596	    app.setErrorHandler((error, _request, reply) => {
   597	      if ((error as { code?: unknown }).code === 'FST_ERR_CTP_INVALID_JSON_BODY') {
   598	        sendValidationError(reply, 'body')
   599	        return
   600	      }
   601	      // Preserve the embedding app's canonical error envelope and telemetry.
   602	      throw error
   603	    })
   604	
   605	    registerAddressedRoutes(app, input)
   606	    if (input.runtimeCapabilities) {
   607	      await app.register(createAgentHostRuntimeCapabilityRoutes(input.runtimeCapabilities))
   608	    }
   609	  }
   610	}
   420	            return {
   421	              kind: 'reject' as const,
   422	              error: new AgentGatewayError(
   423	                AgentGatewayErrorCode.AGENT_COMMAND_INVALID_STATE,
   424	                'Agent runtime binding is not currently published',
   425	              ).toJSON(),
   426	            }
   427	          }
   428	          const currentIdentity = canonicalDigest(binding.scope.identity)
   429	          const currentFingerprint = canonicalDigest(binding.scope.environment.provisioningFingerprint)
   430	          const currentPhysicalBinding = canonicalDigest(binding.scope.physicalBindingIdentity ?? binding.scope.identity)
   431	          if (
   432	            currentIdentity !== candidateIdentity
   433	            || currentFingerprint !== candidateFingerprint
   434	            || currentPhysicalBinding !== candidatePhysicalBinding
   435	          ) {
   436	            return {
   437	              kind: 'reject' as const,
   438	              error: {
   439	                code: AgentGatewayErrorCode.AGENT_RUNTIME_RESTART_REQUIRED,
   440	                message: 'Agent runtime identity changed; restart is required',
   441	                details: {
   442	                  currentIdentity,
   443	                  candidateIdentity,
   444	                  currentFingerprint,
   445	                  candidateFingerprint,
   446	                  currentPhysicalBinding,
   447	                  candidatePhysicalBinding,
   448	                },
   449	              },
   450	            }
   451	          }
   452	          await candidate.revalidateResourceInputs?.()
   453	          return { kind: 'execute' as const }
   454	        },
   455	        action: async () => {
   456	          const current = binding
   457	          if (!current) throw new TypeError('reload executed before binding classification')
   458	          return await runtime.runBindingOperation(current.key, async () => {
   459	            // Admission is asynchronous and occurs after classification. Fence
   460	            // again before the first external reload mutation; failures from
   461	            // this post-begin point intentionally remain outcome-unknown.
   462	            await candidate.revalidateResourceInputs?.()
   463	            if (!current.composition.harness.reloadSession) {
   464	              throw new AgentGatewayError(
   465	                AgentGatewayErrorCode.AGENT_COMMAND_INVALID_STATE,
   466	                'Agent harness does not support reload',
   467	              )
   468	            }
   469	            const applied = await candidate.applyReload?.({
   470	              runtimeBundle: current.composition.runtimeBundle,
   471	            })
   472	            await candidate.revalidateResourceInputs?.()
   473	            const reloaded = await current.composition.harness.reloadSession(reloadSessionId)
   474	            await candidate.revalidateResourceInputs?.()
   475	            const diagnostics = (current.composition.harness.getResourceDiagnostics?.(reloadSessionId) ?? [])
   476	              .map((entry) => ({ source: entry.source, message: entry.message }))
   477	            const mergedDiagnostics = [
   478	              ...(candidate.reloadMetadata?.diagnostics ?? []),
   479	              ...(applied?.diagnostics ?? []),
   480	              ...diagnostics,
   481	            ]
   482	            const restartWarnings = [
   483	              ...(candidate.reloadMetadata?.restartWarnings ?? []),
   484	              ...(applied?.restartWarnings ?? []),
   485	            ]
   486	            return {
   487	              ok: true,
   488	              ...(sessionId ? { sessionId } : {}),
   489	              reloaded,
   490	              ...(mergedDiagnostics.length > 0 ? { diagnostics: mergedDiagnostics } : {}),
   491	              ...(restartWarnings.length
   492	                ? { restartWarnings }
   493	                : {}),
   494	            }
   495	          })
   496	        },
   497	      })
   498	    },
   499	  }
   500	}
