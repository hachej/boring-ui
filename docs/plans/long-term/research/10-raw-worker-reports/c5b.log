    35	export class TrustedAgentCompositionError extends Error {
    36	  readonly code = ErrorCode.enum.CONFIG_INVALID
    37	  readonly field: string
    38	
    39	  constructor(field: string, message: string) {
    40	    super(message)
    41	    this.name = 'TrustedAgentCompositionError'
    42	    this.field = field
    43	  }
