   264	  async listSessions(input: Parameters<AgentGateway['listSessions']>[0]) {
   265	    const claim = await this.verify(input.scope)
   266	    const normalizedLimit = Math.min(MAX_PAGE_LIMIT, Math.max(1, Math.floor(input.limit ?? DEFAULT_PAGE_LIMIT)))
   267	    if (input.agentTypeId && !this.runtime.compiledById.has(input.agentTypeId)) {
   268	      throw new AgentGatewayError(AgentGatewayErrorCode.AGENT_TYPE_UNKNOWN, 'agent type is not available')
   269	    }
   270	    const cursor = input.cursor
   271	      ? this.decodeCursor(input.cursor, claim.workspaceScopeId, input.agentTypeId, normalizedLimit)
   272	      : undefined
   273	    const agents = input.agentTypeId
   274	      ? [input.agentTypeId]
   275	      : [...this.runtime.compiledById.keys()]
   276	    const rows: AgentSessionSummary[] = []
   277	    for (const agentTypeId of agents) {
   278	      const listed = await this.runtime.listSessionSummaries(agentTypeId, input.scope, claim)
   279	      for (const item of listed) {
   280	        const ref = { agentTypeId, sessionId: item.id }
   281	        rows.push(summaryFromLegacy(ref, item, this.runtime.activity.get(claim.workspaceScopeId, ref)))
   282	      }
   283	    }
   284	    rows.sort(compareSessions)
   285	    const eligible = cursor ? rows.filter((row) => isAfterCursor(row, cursor)) : rows
   286	    const sessions = eligible.slice(0, normalizedLimit)
   287	    const nextCursor = eligible.length > sessions.length && sessions.length > 0
   288	      ? this.encodeCursor(claim.workspaceScopeId, input.agentTypeId, normalizedLimit, sessions.at(-1)!)
   289	      : undefined
   290	    return { sessions, ...(nextCursor ? { nextCursor } : {}) }
   291	  }
