   122	function userFromContext(ctx: GovernanceFilesystemBindingContext): GovernanceUserLike | null {
   123	  const requestUser = ctx.request?.user
   124	  if (requestUser?.email) {
   125	    const requestEmail = normalizePolicyEmail(requestUser.email)
   126	    const contextEmail = ctx.userEmail ? normalizePolicyEmail(ctx.userEmail) : null
   127	    const sameContextPrincipal =
   128	      contextEmail === requestEmail &&
   129	      (!requestUser.id || !ctx.userId || requestUser.id === ctx.userId)
   130	    return {
   131	      id: requestUser.id ?? (sameContextPrincipal ? ctx.userId : undefined),
   132	      email: requestUser.email,
   133	      // Some host auth hooks expose the principal on request.user but keep the
   134	      // normalized verification bit in the binding context. Trust the context
   135	      // bit only when it names the same principal; never combine verification
   136	      // from one principal with another request user's email.
   137	      emailVerified: requestUser.emailVerified === true || (sameContextPrincipal && ctx.userEmailVerified === true),
   138	    }
