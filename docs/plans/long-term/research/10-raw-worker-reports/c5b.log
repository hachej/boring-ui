    33	export async function loadGovernancePolicy({
    34	  env = process.env,
    35	  nodeEnv = process.env['NODE_ENV'] ?? 'development',
    36	  config,
    37	}: LoadGovernancePolicyOptions = {}): Promise<GovernanceLoadResult> {
    38	  const configuredPath = env[GOVERNANCE_POLICY_PATH_ENV]?.trim()
    39	  if (!configuredPath) {
    40	    return {
    41	      enabled: false,
    42	      policy: null,
    43	      status: { state: 'disabled', reason: 'missing-env', path: null },
    44	    }
    45	  }
    46	
    47	  let fileStat
    48	  try {
    49	    fileStat = await stat(configuredPath)
    50	  } catch (error) {
    51	    const code = (error as { code?: unknown }).code
    52	    if (code === 'ENOENT') {
    53	      return {
    54	        enabled: false,
    55	        policy: null,
    56	        status: { state: 'disabled', reason: 'missing-file', path: configuredPath },
    57	      }
    58	    }
    59	    throw error
    60	  }
    61	
    62	  if (fileStat.size > MAX_POLICY_BYTES) {
    63	    const result = invalidResult(configuredPath, new Error(`policy file exceeds ${MAX_POLICY_BYTES} bytes`))
    64	    if (nodeEnv === 'production') throw new Error(result.status.state === 'invalid' ? result.status.message : 'invalid governance policy')
    65	    return result
    66	  }
    67	
    68	  try {
    69	    if (config && !isCoreEmailVerificationEnabled(config) && !shouldAllowDevEmailVerificationOverride(env, nodeEnv)) {
    70	      throw new Error(
    71	        `governance requires email verification; configure mail or set ${GOVERNANCE_DEV_EMAIL_VERIFICATION_OVERRIDE_ENV}=1 outside production`,
    72	      )
    73	    }
    74	    const raw = await readFile(configuredPath, 'utf8')
    75	    const parsed = parse(raw)
    76	    const policy = validateGovernancePolicy(parsed)
    77	    return {
    78	      enabled: true,
    79	      policy,
    80	      status: {
    81	        state: 'active',
    82	        path: configuredPath,
    83	        tenantId: policy.tenant.id,
    84	        userCount: policy.users.length,
    85	      },
    86	    }
    87	  } catch (error) {
    88	    const result = invalidResult(configuredPath, error)
    89	    if (nodeEnv === 'production') throw new Error(result.status.state === 'invalid' ? result.status.message : 'invalid governance policy')
    90	    return result
    91	  }
    92	}
