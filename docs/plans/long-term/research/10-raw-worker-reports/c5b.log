   187	    return entry
   188	  }
   189	
   190	  app.get<{ Querystring: SkillsQuery }>(opts.path ?? '/api/v1/agents/:agentTypeId/skills', async (request, reply) => {
   191	    await opts.authorizeRequest?.(request)
   192	    try {
   193	      const entry = await resolveSkillsForRequest(request, request.query.refresh === '1')
   194	      return reply.code(200).send({ skills: entry.skills })
   195	    } catch (error) {
   196	      request.log.warn({ err: error }, '[agent] failed to load skills')
   197	      // Still 200 so the slash-command picker keeps working. Never expose a
   198	      // package-manager/loader error that may contain an absolute host path.
   199	      return reply.code(200).send({
   200	        skills: [],
   201	        error: { code: ErrorCode.enum.SKILL_DISCOVERY_FAILED, message: 'skill discovery failed' },
   202	      })
   203	    }
   204	  })
   205	
   206	  done()
   207	}

