    72	/**
    73	 * The one reusable fleet binding-validation funnel. Apps supply only their
    74	 * already-resolved plugin contracts and optional stricter policy compiler.
    75	 */
    76	export function createValidatingAgentFleetCompiler(
    77	  options: CreateValidatingAgentFleetCompilerOptions,
    78	): AgentFleetCompiler {
    79	  const plugins = new Map(options.plugins.map((plugin) => [
    80	    plugin.id,
    81	    new Set(plugin.configKeys ?? []),
    82	  ]))
    83	
    84	  const validateBindings = (agents: readonly AgentHostAgentSpec[]): void => {
    85	    for (const agent of agents) {
    86	      if ('legacyDefault' in agent) continue
    87	      for (const plugin of agent.plugins ?? []) {
    88	        const configKeys = plugins.get(plugin.name)
    89	        if (!configKeys) {
    90	          throw new AgentFleetCompilationError(
    91	            AgentFleetCompilationErrorCode.AGENT_FLEET_PLUGIN_UNKNOWN,
    92	            `unknown Agent fleet plugin: ${plugin.name}`,
    93	            { agentTypeId: agent.agentTypeId, pluginId: plugin.name },
    94	          )
    95	        }
    96	        validateConfigBinding(agent.agentTypeId, plugin.name, plugin.config, configKeys)
    97	      }
    98	      if (agent.model !== undefined && options.requireCompilerForModelPolicy && !options.compiler) {
    99	        throw new AgentFleetCompilationError(
   100	          AgentFleetCompilationErrorCode.AGENT_FLEET_MODEL_POLICY_UNCOMPILED,
   101	          `Agent model policy requires an app fleet compiler: ${agent.agentTypeId}`,
   102	          { agentTypeId: agent.agentTypeId },
   103	        )
   104	      }
   105	    }
   106	  }
   107	
   108	  return {
   109	    async compile({ agents }) {
   110	      validateBindings(agents)
   111	      const compiled: readonly CompiledAgentHostAgentSpec[] = options.compiler
   112	        ? await options.compiler.compile({ agents })
   113	        : agents
   114	      validateBindings(compiled)
   115	      return compiled
   116	    },
   117	  }
   118	}
