    60	async function closeRuntime(created: CreatedAgentHost, app: FastifyInstance): Promise<void> {
    61	  let firstError: unknown
    62	  for (const operation of [
    63	    () => app.close(),
    64	    () => created.host.close(),
    65	  ]) {
    66	    try {
    67	      await operation()
    68	    } catch (error) {
    69	      firstError ??= error
    70	    }
    71	  }
    72	  if (firstError !== undefined) throw firstError
    73	}
