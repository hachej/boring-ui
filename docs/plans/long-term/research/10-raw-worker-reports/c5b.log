   137	  /**
   138	   * Per-model consumed/remaining usage for the caller, plus an aggregate row
   139	   * when an aggregate (per-user) cap is configured. `used`/`held` are read from
   140	   * the same store accounting the admission path uses; `resetsAt` is the store's
   141	   * period boundary (never hardcoded).
   142	   */
   143	  async getUsageSummary(
   144	    user: GovernanceUserLike | null | undefined,
   145	    reader: GovernanceUsageSpendReader,
   146	  ): Promise<GovernanceUsageSummary> {
   147	    if (!this.loaded.enabled) return { ...this.usageSummaryMeta(user), currency: 'EUR', models: [], aggregate: null }
   148	    const userPolicy = this.userPolicy(user)
   149	    const userId = user?.id
   150	    if (!userPolicy || !userId) return { ...this.usageSummaryMeta(user), currency: 'EUR', models: [], aggregate: null }
   151	
   152	    const models: GovernanceUsageEntry[] = []
   153	    for (const grant of userPolicy.models) {
   154	      const snapshot = await reader.getSpendSnapshot({ scope: 'model', userId, provider: grant.provider, model: grant.id })
   155	      models.push(buildUsageEntry({
   156	        provider: grant.provider,
   157	        id: grant.id,
   158	        label: grant.id,
   159	        budgetMicros: grant.monthlyBudgetMicros,
   160	        snapshot,
   161	      }))
   162	    }
   163	
   164	    let aggregate: GovernanceUsageEntry | null = null
   165	    const aggregateBudgetMicros = userPolicy.budgets.monthlyMicros
   166	    if (aggregateBudgetMicros !== null) {
   167	      const snapshot = await reader.getSpendSnapshot({ scope: 'user', userId })
   168	      aggregate = buildUsageEntry({
   169	        provider: '',
   170	        id: '__all__',
   171	        label: 'All models',
   172	        budgetMicros: aggregateBudgetMicros,
   173	        snapshot,
   174	      })
   175	    }
   176	
   177	    return { ...this.usageSummaryMeta(user), currency: 'EUR', models, aggregate }
   178	  }
   179	
   180	  /**
   181	   * Non per-model summary fields (role, aggregate cap, company-context access +
   182	   * rules) shared by every getUsageSummary return path and by the plugin route's
   183	   * empty fallback. Reuses the existing policy accessors so the panel and the
   184	   * admission path can never disagree.
   185	   */
   186	  usageSummaryMeta(user: GovernanceUserLike | null | undefined): {
   187	    enabled: boolean
   188	    role: TenantRole | null
   189	    aggregateCapMicros: number | null
   190	    companyContextAccess: CompanyContextAccess
   191	    companyContextRules: string[]
   192	  } {
   193	    return {
   194	      enabled: this.loaded.enabled,
   195	      role: this.roleForUser(user),
   196	      aggregateCapMicros: user ? this.userMonthlyBudgetMicros(user) : null,
   197	      companyContextAccess: this.companyContextAccessForUser(user),
   198	      companyContextRules: user ? this.companyContextRules(user) : [],
   199	    }
   200	  }
   201	
   202	  me(user: GovernanceUserLike | null | undefined): GovernanceMeResponse {
   203	    const role = this.roleForUser(user)
   204	    const admin = role === 'admin'
   205	    const base: GovernanceMeResponse = {
   206	      enabled: this.loaded.enabled,
   207	      role,
   208	      admin,
   209	    }
   210	    if (!this.loaded.enabled) return base
   211	    const policy = this.loaded.policy
   212	    if (!policy) {
   213	      return { ...base, policyStatus: this.loaded.status }
   214	    }
   215	    if (!admin) return base
   216	    return {
   217	      ...base,
   218	      policyStatus: this.loaded.status,
   219	      tenant: {
   220	        id: policy.tenant.id,
   221	        companyContextWorkspaceId: policy.tenant.companyContextWorkspaceId,
   222	        defaultMonthlyModelBudgetEur: policy.tenant.defaultMonthlyModelBudgetEur,
   223	        perRunHoldEur: policy.tenant.perRunHoldEur,
   224	      },
   225	      users: policy.users.map((entry) => ({
   226	        email: entry.email,
   227	        role: entry.role,
   228	        modelCount: entry.models.length,
   229	        monthlyBudgetEur: entry.budgets.monthlyEur,
   230	        contextRuleCount: entry.companyContext.allow.length,
   231	      })),
   232	      models: policy.users.flatMap((entry) => entry.models.map((model) => ({ ...model, email: entry.email }))),
   233	      companyContextRules: policy.users.flatMap((entry) => (
   234	        entry.companyContext.allow.map((pattern) => ({ email: entry.email, pattern }))
   235	      )),
   236	    }
   237	  }
   238	}
   239	
   240	function buildUsageEntry(args: {
   241	  provider: string
   242	  id: string
   243	  label: string
   244	  budgetMicros: number | null
   245	  snapshot: { usedMicros: number; heldMicros: number; periodEnd: Date }
   246	}): GovernanceUsageEntry {
   247	  const { provider, id, label, budgetMicros, snapshot } = args
   248	  const usedMicros = Math.max(0, snapshot.usedMicros)
   249	  const heldMicros = Math.max(0, snapshot.heldMicros)
   250	  const consumedMicros = usedMicros + heldMicros
   251	  const base = { provider, id, label, usedMicros, heldMicros, resetsAt: snapshot.periodEnd.toISOString() }
   252	  if (budgetMicros === null) {
   253	    // No cap configured: report usage but no percentage/bar.
   254	    return { ...base, budgetMicros: null, remainingMicros: null, pctUsed: null }
   255	  }
   256	  if (budgetMicros <= 0) {
   257	    // Zero budget: no room; treat as fully consumed.
   258	    return { ...base, budgetMicros, remainingMicros: 0, pctUsed: 100 }
   259	  }
   260	  return {
   261	    ...base,
   262	    budgetMicros,
   263	    remainingMicros: Math.max(0, budgetMicros - consumedMicros),
   264	    pctUsed: Math.min(100, Math.round((consumedMicros / budgetMicros) * 100)),
   265	  }
   266	}
