    13	 * exact-match allowlist of tool names; `plugins/boring-mcp`'s
    14	 * `deniedTools`/`wildcardMatch` glob-interprets `"*"` (and other glob
    15	 * metacharacters) as "match everything". Storing `["*"]` here and later
    16	 * interpreting it as a glob at the consumption seam would silently flip an
    17	 * intended single-item allowlist into "every tool is allowed" — the exact
    18	 * opposite of the grant model's default-deny intent. Reject it at
    19	 * grant-write time instead so this footgun can never be stored.
    20	 */
    21	export class McpGrantToolNameInvalidError extends Error {
    22	  readonly code = ErrorCode.enum.AGENT_MCP_GRANT_TOOL_NAME_INVALID
    23	  readonly tool: string
    24	
    25	  constructor(tool: string) {
    26	    super(`MCP grant tool name '${tool}' contains a glob metacharacter, which is not a valid exact tool name for allowedTools.`)
    27	    this.name = 'McpGrantToolNameInvalidError'
    28	    this.tool = tool
    29	  }
    30	}
    31	
    32	const GLOB_METACHARACTER_PATTERN = /[*?[\]]/
    33	
    34	/** Throws {@link McpGrantToolNameInvalidError} if any tool name in `allowedTools` contains a glob metacharacter (`*`, `?`, `[`, `]`). Call before persisting a grant. */
    35	export function assertValidGrantToolNames(allowedTools: readonly string[]): void {
    36	  for (const tool of allowedTools) {
    37	    if (GLOB_METACHARACTER_PATTERN.test(tool)) throw new McpGrantToolNameInvalidError(tool)
    38	  }
    39	}
