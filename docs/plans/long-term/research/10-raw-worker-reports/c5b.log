   249	      if (reply.raw.destroyed || reply.raw.writableEnded) return
   250	      reply.raw.write(`event: ${event}\ndata: ${JSON.stringify(data)}\n\n`)
   251	    }
   252	    const unsubscribe = input.activity.subscribe(workspaceScopeId, (update: AgentSessionActivityUpdate) => {
   253	      write('activity', update)
   254	    })
   255	    write('snapshot', { sessions: input.activity.snapshot(workspaceScopeId) })
   256	    const heartbeat = setInterval(() => {
   257	      if (!reply.raw.writableEnded) reply.raw.write(': heartbeat\n\n')
   258	    }, ADDRESSED_HEARTBEAT_INTERVAL_MS)
   259	    let cleanedUp = false
   260	    const cleanup = () => {
   261	      if (cleanedUp) return
   262	      cleanedUp = true
   263	      clearInterval(heartbeat)
   264	      unsubscribe()
   265	    }
   266	    request.raw.once('close', cleanup)
   267	    reply.raw.once('close', cleanup)
   268	    reply.hijack()
   269	  })
