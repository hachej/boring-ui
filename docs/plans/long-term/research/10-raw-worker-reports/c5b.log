    21	/**
    22	 * Mount application-owned filesystem routes over finite Host Environment leases.
    23	 * The FS event stream explicitly retains its lease until the transport closes.
    24	 */
    25	export async function registerAgentHostEnvironmentRoutes(
    26	  app: FastifyInstance,
    27	  options: AgentHostEnvironmentHttpProjectionOptions,
    28	): Promise<void> {
    29	  const leases = new WeakMap<FastifyRequest, Promise<Awaited<ReturnType<CreatedAgentHost['acquireEnvironment']>>>>()
    30	  const deferred = new WeakSet<FastifyRequest>()
    31	  const released = new WeakSet<FastifyRequest>()
    32	  const observingTransport = new WeakSet<FastifyRequest>()
    33	  const transportClosed = new WeakSet<FastifyRequest>()
    34	  const gitHostRoots = new WeakMap<object, string>()
    35	
    36	  const acquire = (request: FastifyRequest) => {
    37	    if (!observingTransport.has(request)) {
    38	      observingTransport.add(request)
    39	      const markClosed = () => {
    40	        transportClosed.add(request)
    41	        if (deferred.has(request)) void release(request)
    42	      }
    43	      request.raw.once('aborted', markClosed)
    44	      request.raw.socket.once('close', markClosed)
    45	    }
    46	    let lease = leases.get(request)
    47	    if (!lease) {
    48	      lease = options.authorizeAgentRequest(request).then(async (authorizedScope) => {
    49	        return await options.created.acquireEnvironment({
    50	          authorizedScope,
    51	          intent: { kind: 'http-route', requestId: request.id },
    52	        })
    53	      })
    54	      leases.set(request, lease)
    55	    }
    56	    return lease
    57	  }
    58	
    59	  const release = async (request: FastifyRequest) => {
    60	    if (released.has(request)) return
    61	    released.add(request)
    62	    const lease = leases.get(request)
    63	    if (!lease) return
    64	    try {
    65	      await (await lease).release()
    66	    } catch {
    67	      // Cleanup must not replace the route/acquisition error or fail a
    68	      // response that has already been written.
    69	    }
    70	  }
    71	
    72	  app.addHook('onResponse', async (request) => {
    73	    if (!deferred.has(request)) await release(request)
    74	  })
    75	  app.addHook('onError', async (request) => {
    76	    if (!deferred.has(request)) await release(request)
    77	  })
    78	
    79	  const getWorkspace = async (request: FastifyRequest) => (await acquire(request)).workspace
