   116	export function createGovernanceModelFilter(
   117	  service: GovernanceService,
   118	): NonNullable<CreateCoreWorkspaceAgentServerOptions['filterModels']> {
   119	  return async ({ request }, models, defaultModel) => {
   120	    const user = governanceUserFromRequest(request)
   121	    if (!service.isEnabled()) return { models, defaultModel }
   122	    if (!user) return { models: [] }
   123	    const aggregateBudgetMicros = service.userMonthlyBudgetMicros(user)
   124	    if (aggregateBudgetMicros !== null && aggregateBudgetMicros <= 0) return { models: [], defaultModel: undefined }
   125	    const allowedModels = service
   126	      .allowedModelsForUser(user, models)
   127	      .filter((model) => (service.monthlyBudgetMicros(user, model) ?? 0) > 0)
   128	    const allowedDefault = defaultModel && allowedModels.some((model) => (
   129	      model.available && model.provider === defaultModel.provider && model.id === defaultModel.id
   130	    ))
   131	      ? defaultModel
   132	      : undefined
   133	    return { models: allowedModels, defaultModel: allowedDefault }
   134	  }
   135	}
