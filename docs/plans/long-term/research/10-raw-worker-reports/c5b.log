    69	  ): Promise<EnvironmentLease> {
    70	    if (this.closed) throw closedError()
    71	    const key = JSON.stringify([workspaceScopeId, environment.placementIdentity])
    72	    let record = this.records.get(key)
    73	    if (record && record.scope.provisioningFingerprint !== environment.provisioningFingerprint) {
    74	      throw new AgentGatewayError(
