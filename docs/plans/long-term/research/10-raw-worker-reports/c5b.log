    47	export function claimAgentHostProjection(
    48	  app: Parameters<FastifyPluginAsync>[0],
    49	  host: AgentHostHandle,
    50	): void {
    51	  const server = app.server as object
    52	  let mounted = mountedHostsByServer.get(server)
    53	  if (!mounted) {
    54	    mounted = new WeakSet<object>()
    55	    mountedHostsByServer.set(server, mounted)
    56	  }
    57	  if (mounted.has(host)) {
    58	    throw Object.assign(
    59	      new TypeError('Agent Host projection is already registered on this Fastify app'),
    60	      { code: ErrorCode.enum.CONFIG_INVALID },
    61	    )
    62	  }
    63	  mounted.add(host)
    64	}
