    55	 */
    56	export interface McpConnectorCatalog {
    57	  /** Returns the connector's known tool names, or `undefined` if the connector itself is unknown to the catalog. */
    58	  getConnectorTools(connectorId: string): readonly string[] | undefined
    59	}
