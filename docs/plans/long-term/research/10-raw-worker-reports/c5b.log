   235	async function resolveCompanyContextSourceRoot(
   236	  ctx: GovernanceFilesystemBindingContext,
   237	  companyContextWorkspaceId: string,
   238	  resolver: CompanyContextRootResolver | undefined,
   239	): Promise<string | null> {
   240	  if (!resolver) {
   241	    logCompanyContextBindingError(ctx, 'missing_explicit_source_root_resolver', { companyContextWorkspaceId })
   242	    return null
   243	  }
   244	
   245	  let candidate: string | null | undefined
   246	  try {
   247	    candidate = await resolver(ctx, companyContextWorkspaceId)
   248	  } catch (error) {
   249	    logCompanyContextBindingError(ctx, 'source_root_resolver_failed', { companyContextWorkspaceId, err: error })
   250	    return null
   251	  }
   252	
   253	  if (!candidate?.trim()) {
   254	    logCompanyContextBindingError(ctx, 'missing_explicit_source_root', { companyContextWorkspaceId })
   255	    return null
   256	  }
   257	
   258	  try {
   259	    const sourceRoot = await realpath(path.resolve(candidate))
   260	    const sourceStat = await stat(sourceRoot)
   261	    if (!sourceStat.isDirectory()) {
   262	      logCompanyContextBindingError(ctx, 'source_root_not_directory', { companyContextWorkspaceId, sourceRoot })
   263	      return null
   264	    }
   265	    await access(sourceRoot, constants.R_OK)
   266	    return sourceRoot
   267	  } catch (error) {
   268	    logCompanyContextBindingError(ctx, 'source_root_unavailable', { companyContextWorkspaceId, sourceRoot: path.resolve(candidate), err: error })
   269	    return null
   270	  }
   271	}
