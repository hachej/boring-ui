    41	export interface McpGrant {
    42	  readonly workspaceId: string
    43	  readonly agentTypeId: string
    44	  readonly connectorId: string
    45	  /** Empty array means the connector is granted but no tools are allowed. */
    46	  readonly allowedTools: readonly string[]
