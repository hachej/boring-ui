   156	const SHA256_RE = /^sha256:[0-9a-f]{64}$/
   157	
   158	function parseFleetConfig(raw: unknown, path: string): readonly FleetSeatBinding[] {
   159	  const name = basename(path)
   160	  if (!isRecord(raw) || !Array.isArray(raw.seats)) {
   161	    throw new FleetConfigError({ field: 'seats', message: `${name} must declare a "seats" array` })
   162	  }
   163	  return raw.seats.map((entry, index) => {
   164	    if (
   165	      !isRecord(entry) ||
   166	      typeof entry.seat !== 'string' ||
   167	      typeof entry.agentTypeId !== 'string' ||
   168	      !Array.isArray(entry.skills)
   169	    ) {
   170	      throw new FleetConfigError({
   171	        field: `seats[${index}]`,
   172	        message: `${name} seats[${index}] must have seat, agentTypeId, and skills`,
   173	      })
   174	    }
   175	    const skills = entry.skills.map((skill, skillIndex) => {
   176	      if (!isRecord(skill) || typeof skill.name !== 'string' || typeof skill.digest !== 'string' || !SHA256_RE.test(skill.digest)) {
   177	        throw new FleetConfigError({
   178	          field: `seats[${index}].skills[${skillIndex}]`,
   179	          message: `${name} seats[${index}].skills[${skillIndex}] must have a name and a sha256:... digest`,
   180	        })
   181	      }
   182	      return Object.freeze({ name: skill.name, digest: skill.digest as Sha256Digest })
   183	    })
   184	    return Object.freeze({ seat: entry.seat, agentTypeId: entry.agentTypeId, skills: Object.freeze(skills) })
   185	  })
   186	}
   187	
   188	const ENV_VAR_RE = /^[A-Za-z_][A-Za-z0-9_]*$/
   189	
   190	export function parseModelTierCandidates(raw: unknown, path: string): ModelTierCandidates {
   191	  const name = basename(path)
   192	  const models = isRecord(raw) ? raw.models : undefined
   193	  const tiers = isRecord(models) ? models.tiers : undefined
   194	  if (!isRecord(tiers) || Object.keys(tiers).length === 0) {
   195	    throw new FleetConfigError({
   196	      field: 'models.tiers',
   197	      message: `${name} must declare a non-empty "models.tiers" mapping`,
   198	    })
   199	  }
   200	
   201	  const result: Record<string, readonly ModelTierCandidate[]> = {}
   202	  for (const [tier, entries] of Object.entries(tiers)) {
   203	    if (!Array.isArray(entries) || entries.length === 0) {
   204	      throw new FleetConfigError({
   205	        field: `models.tiers.${tier}`,
   206	        message: `${name} models.tiers.${tier} must be a non-empty candidate array`,
   207	      })
   208	    }
   209	    result[tier] = Object.freeze(entries.map((entry, index) => {
   210	      if (
   211	        !isRecord(entry) ||
   212	        !isNonBlankString(entry.provider) ||
   213	        !isNonBlankString(entry.id) ||
   214	        typeof entry.envVar !== 'string' || !ENV_VAR_RE.test(entry.envVar)
   215	      ) {
   216	        throw new FleetConfigError({
   217	          field: `models.tiers.${tier}[${index}]`,
   218	          message: `${name} models.tiers.${tier}[${index}] must have non-empty provider and id strings plus a valid envVar`,
   219	        })
   220	      }
   221	      return Object.freeze({ provider: entry.provider, id: entry.id, envVar: entry.envVar })
   222	    }))
   223	  }
   224	  return Object.freeze(result)
   225	}
   226	
   227	function parseSeatTiers(raw: unknown): Readonly<Record<string, string>> {
   228	  if (!isRecord(raw)) return Object.freeze({})
   229	  const models = raw.models
   230	  if (!isRecord(models)) return Object.freeze({})
   231	  const seats = models.seats
   232	  if (!isRecord(seats)) return Object.freeze({})
   233	  const result: Record<string, string> = {}
   234	  for (const [seat, tier] of Object.entries(seats)) {
   235	    if (typeof tier === 'string') result[seat] = tier
   236	  }
   237	  return Object.freeze(result)
   238	}
   239	
   240	function validateSeatTierCandidates(
   241	  seatTiers: Readonly<Record<string, string>>,
   242	  modelTierCandidates: ModelTierCandidates,
   243	  fleetConfigPath: string,
   244	  policyPath: string,
   245	): void {
   246	  for (const [seat, tier] of Object.entries(seatTiers)) {
   247	    if (modelTierCandidates[tier] === undefined) {
   248	      throw new FleetConfigError({
   249	        field: `models.tiers.${tier}`,
   250	        message: `${basename(policyPath)} models.seats.${seat} references tier ${JSON.stringify(tier)}, which is missing from ${basename(fleetConfigPath)} models.tiers`,
   251	      })
   252	    }
   253	  }
   254	}
   255	
   256	async function readYamlFile(path: string, field: string): Promise<unknown> {
   257	  const name = basename(path)
   258	  let content: string
   259	  try {
   260	    content = await readFile(path, 'utf8')
   261	  } catch (error) {
   262	    // Redact the absolute filesystem path from the diagnostic surface; the
   263	    // cause (not surfaced in messages/logs by default) retains it for
   264	    // programmatic callers that need it.
   265	    throw new FleetConfigError({ field, message: `${name} could not be read`, cause: error })
   266	  }
   267	  try {
   268	    return parseYaml(content)
   269	  } catch (error) {
   270	    throw new FleetConfigError({ field, message: `${name} is not valid YAML`, cause: error })
   271	  }
   272	}
   273	
   274	/** First configured model in `tier` whose API key is present, otherwise undefined. */
   275	export function resolveSeatModel(
   276	  tier: string | undefined,
   277	  env: NodeJS.ProcessEnv,
   278	  modelTierCandidates: ModelTierCandidates,
   279	): string | undefined {
   280	  if (tier === undefined) return undefined
   281	  const candidates = modelTierCandidates[tier]
   282	  if (!candidates) return undefined
   283	  for (const candidate of candidates) {
   284	    if (env[candidate.envVar]) return `${candidate.provider}:${candidate.id}`
   285	  }
   286	  return undefined
   287	}
   288	
   289	async function readVerifiedSkillContent(
   290	  root: string,
   291	  reference: string,
   292	  skill: FleetSkillBinding,
   293	): Promise<string> {
   294	  const rootTarget = await realpath(root)
   295	  let candidate = resolve(rootTarget, reference)
   296	  const candidateStat = await lstat(candidate)
   297	  if (candidateStat.isDirectory()) candidate = resolve(candidate, 'SKILL.md')
   298	  const fileStat = await lstat(candidate)
   299	  if (!fileStat.isFile() || fileStat.isSymbolicLink()) throw new Error('skill source is not a regular file')
   300	  const target = await realpath(candidate)
   301	  if (!isCanonicalPathInside(rootTarget, target)) throw new Error('skill source resolves outside its admitted root')
   302	  const content = await readFile(target, 'utf8')
   303	  if (await sha256(content) !== skill.digest) throw new Error('skill digest mismatch')
   304	  return content
   305	}
   306	
   307	async function canonicalSkillContent(skillsRoot: string, skill: FleetSkillBinding): Promise<string> {
   308	  try {
   309	    return await readVerifiedSkillContent(skillsRoot, `${skill.name}/SKILL.md`, skill)
   310	  } catch {
   311	    throw new Error(`canonical skill "${skill.name}" is unavailable`)
   312	  }
   313	}
   314	
   315	async function packageSkillContent(packageRoot: string, skill: FleetSkillBinding): Promise<string> {
   316	  try {
   317	    return await readVerifiedSkillContent(packageRoot, skill.name, skill)
   318	  } catch {
   319	    throw new Error(`package skill "${skill.name}" is unavailable`)
   320	  }
   321	}
