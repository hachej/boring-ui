   145	type RequestScope = 'body' | 'params' | 'query'
   146	
   147	function sendValidationError(
   148	  reply: FastifyReply,
   149	  scope: RequestScope,
   150	  issue?: z.ZodIssue,
   151	): FastifyReply {
   152	  const field = issue?.path.length
   153	    ? `${scope}.${issue.path.map(String).join('.')}`
   154	    : scope
   155	  return reply.code(400).send({
   156	    error: {
   157	      code: AgentGatewayErrorCode.AGENT_COMMAND_INVALID_STATE,
   158	      message: issue?.message ?? 'invalid request',
   159	      details: { field },
   160	    },
   161	  })
   162	}
   163	
   164	function parseWithSchema<T>(
   165	  schema: z.ZodType<T, z.ZodTypeDef, unknown>,
   166	  value: unknown,
   167	  reply: FastifyReply,
   168	  scope: RequestScope,
   169	): T | undefined {
   170	  const parsed = schema.safeParse(value)
   171	  if (parsed.success) return parsed.data
   172	  sendValidationError(reply, scope, parsed.error.issues[0])
   173	  return undefined
   174	}
   175	
   176	function statusForGatewayError(code: string): number {
   177	  if (code === AgentGatewayErrorCode.AGENT_SCOPE_DENIED) return 403
   178	  if (code === AgentGatewayErrorCode.AGENT_SESSION_NOT_FOUND || code === AgentGatewayErrorCode.AGENT_TYPE_UNKNOWN) return 404
   179	  if (
   180	    code === AgentGatewayErrorCode.AGENT_REQUEST_CONFLICT
   181	    || code === AgentGatewayErrorCode.AGENT_REQUEST_IN_PROGRESS
   182	    || code === AgentGatewayErrorCode.AGENT_REQUEST_OUTCOME_UNKNOWN
   183	    || code === AgentGatewayErrorCode.AGENT_RUNTIME_RESTART_REQUIRED
   184	    || code === AgentGatewayErrorCode.AGENT_COMMAND_INVALID_STATE
   185	    || code === AgentGatewayErrorCode.AGENT_SESSION_RUNTIME_SCOPE_MISMATCH
   186	    || code.includes('CURSOR')
   187	    || code.includes('REPLAY')
   188	  ) return 409
   189	  if (
   190	    code === AgentGatewayErrorCode.AGENT_GATEWAY_CLOSED
   191	    || code === AgentGatewayErrorCode.AGENT_SHARED_ENVIRONMENT_UNAVAILABLE
   192	  ) return 503
   193	  return 400
   194	}
   195	
   196	function sendError(reply: FastifyReply, error: unknown): FastifyReply {
   197	  if (error instanceof AgentGatewayError) {
   198	    return reply.code(statusForGatewayError(error.code)).send({ error: error.toJSON() })
   199	  }
   200	  const stable = projectStableServiceError(error)
   201	  if (stable) {
   202	    return reply.code(stable.statusCode).send({ error: stable.error })
   203	  }
   204	  throw error
   205	}
