   301	      claim,
   302	      'session.create',
   303	      target,
   304	      input.requestId,
   305	      {
   306	        agentTypeId: input.agentTypeId,
   307	        title: input.title ?? null,
   308	        resumeSessionId: input.resumeSessionId ?? null,
   309	      },
   310	      async () => {
   311	        const preparedBinding = binding
   312	        if (!preparedBinding) throw new TypeError('session creation executed before binding preflight')
   313	        return await this.runtime.runBindingOperation(preparedBinding.key, async () => {
   314	          if (input.resumeSessionId) {
   315	            const candidateRef = { agentTypeId: input.agentTypeId, sessionId: input.resumeSessionId }
   316	            const authority = await this.runtime.resolveSessionRuntime(
   317	              input.agentTypeId,
   318	              input.scope,
   319	              claim,
   320	              input.resumeSessionId,
   321	            ).catch(() => undefined)
   322	            if (authority?.runtimeScopeIdentity === preparedBinding.scope.identity) {
   323	              const rows = await preparedBinding.composition.service.listSessions?.(
   324	                context(claim, input.requestId, preparedBinding.scope.identity),
   325	                { includeId: input.resumeSessionId, includeEmpty: true },
   326	              ) ?? []
   327	              const candidate = rows.find((row) => row.id === input.resumeSessionId)
   328	              if (candidate?.turnCount === 0) {
   329	                this.pins.set(agentSessionKey(claim.workspaceScopeId, candidateRef), preparedBinding.scope.identity)
   330	                this.runtime.activity.set(claim.workspaceScopeId, candidateRef, 'idle')
   331	                return candidateRef
   332	              }
   333	            }
   334	          }
   335	
   336	          const created = await preparedBinding.composition.service.createSession!(
   337	            context(claim, input.requestId, preparedBinding.scope.identity),
   338	            { title: input.title },
   339	          )
   340	          const ref = { agentTypeId: input.agentTypeId, sessionId: created.id }
   341	          this.pins.set(agentSessionKey(claim.workspaceScopeId, ref), preparedBinding.scope.identity)
   342	          this.runtime.activity.set(claim.workspaceScopeId, ref, 'idle')
