   273	export function createGovernanceFilesystemBindings(
   274	  service: GovernanceService,
   275	  options: CreateGovernanceFilesystemBindingsOptions = {},
   276	): NonNullable<CreateCoreWorkspaceAgentServerOptions['getFilesystemBindings']> {
   277	  return async (ctx) => {
   278	    if (!service.isEnabled()) return undefined
   279	    const user = userFromContext(ctx)
   280	    if (!user?.id) return []
   281	    const policyAccess = service.companyContextAccessForUser(user)
   282	    const accessMode = policyAccess === 'readwrite' && options.allowAdminMutations !== true ? 'readonly' : policyAccess
   283	    const companyContextWorkspaceId = service.companyContextWorkspaceId()
   284	    if (!companyContextWorkspaceId || accessMode === 'none') return []
   285	    if (ctx.workspaceId === companyContextWorkspaceId) return []
   286	
   287	    const sourceRoot = await resolveCompanyContextSourceRoot(ctx, companyContextWorkspaceId, options.resolveCompanyContextRoot)
   288	    if (!sourceRoot) return []
   289	
   290	    if (accessMode === 'readwrite') {
   291	      const store = await CompanyContextStore.open(sourceRoot)
   292	      const operations: RuntimeFilesystemBindingOperations = {
   293	        read: (descriptor) => store.read(descriptor.path),
   294	        list: (descriptor) => store.list(descriptor.path),
   295	        find: (descriptor, pattern, opOptions) => store.find(descriptor.path, pattern, opOptions),
   296	        grep: (descriptor, pattern, opOptions) => store.grep(descriptor.path, pattern, opOptions),
   297	        stat: async (descriptor) => {
   298	          const result = await store.stat(descriptor.path)
   299	          return { isDirectory: result.isDirectory, metadata: { mtimeMs: result.mtimeMs } }
   300	        },
   301	        write: (descriptor) => store.write(descriptor.path, descriptor.content, descriptor.expectedMtimeMs),
   302	        delete: async (descriptor) => { await store.delete(descriptor.path); return {} },
   303	        move: async (descriptor) => { await store.move(descriptor.from, descriptor.to); return {} },
   304	        mkdir: async (descriptor) => { await store.mkdir(descriptor.path, descriptor.recursive); return {} },
   305	        rejectMutation(operation): never {
   306	          throw new Error(`company_context ${operation} operation is unavailable`)
   307	        },
   308	      }
   309	      return [{
   310	        filesystem: COMPANY_CONTEXT_FILESYSTEM_ID,
   311	        access: 'readwrite',
   312	        operations,
   313	      } satisfies RuntimeFilesystemBinding]
   314	    }
   315	
   316	    const rules = service.companyContextRules(user)
   317	    const projectionRootParent = options.projectionRootParent ?? os.tmpdir()
   318	    const binding: FilesystemBinding = {
   319	      filesystem: COMPANY_CONTEXT_FILESYSTEM_ID,
   320	      access: 'readonly',
   321	      mountPath: COMPANY_CONTEXT_MOUNT_PATH,
   322	      projection: 'policy-filtered',
   323	    }
   324	    const boundCtx: BoundFilesystemContext = {
   325	      humanUserId: user.id,
   326	      agentId: `agent:${ctx.sessionId ?? ctx.requestId ?? 'request'}`,
   327	      sessionId: ctx.sessionId ?? ctx.requestId ?? 'request',
   328	      workspaceId: ctx.workspaceId,
   329	      requestId: ctx.requestId ?? ctx.sessionId ?? 'request',
   330	    }
   331	    const provider = new RegexFilteredCompanyContextProvider(sourceRoot, compileRules(rules), projectionRootParent)
   332	    const manager = new ScopedFilesystemRuntimeBindingManager({
   333	      resolver: { resolveBindings: async () => [binding] },
   334	      providers: { [COMPANY_CONTEXT_FILESYSTEM_ID]: provider },
   335	    })
   336	
   337	    async function withReadonlyOperations<T>(fn: (ops: ReadonlyProjectionOperations) => Promise<T>): Promise<T> {
   338	      const plan = await manager.prepareRuntime(boundCtx)
   339	      try {
   340	        const prepared = plan.bindings.find((entry) => entry.binding.filesystem === COMPANY_CONTEXT_FILESYSTEM_ID)
   341	        if (!prepared) throw new Error('company_context binding was not prepared')
   342	        return await fn(createReadonlyProjectionOperations(prepared.handle as RegexProjectionHandle))
   343	      } finally {
   344	        await manager.disposeRuntime(boundCtx)
   345	      }
   346	    }
   347	
   348	    const operations: RuntimeFilesystemBindingOperations = {
   349	      read: (descriptor) => withReadonlyOperations((ops) => ops.read(descriptor)),
   350	      list: (descriptor) => withReadonlyOperations((ops) => ops.list(descriptor)),
   351	      find: (descriptor, pattern, opOptions) => withReadonlyOperations((ops) => ops.find(descriptor, pattern, opOptions)),
   352	      grep: (descriptor, pattern, opOptions) => withReadonlyOperations((ops) => ops.grep(descriptor, pattern, opOptions)),
   353	      stat: (descriptor) => withReadonlyOperations((ops) => ops.stat(descriptor)),
   354	      rejectMutation(operation, descriptor): never {
   355	        // Reuse boring-bash readonly error shape for deterministic UX. This method is synchronous by RuntimeFilesystemBindingOperations contract.
   356	        return asRuntimeOperations(createReadonlyProjectionOperations({ filesystem: COMPANY_CONTEXT_FILESYSTEM_ID, projectionRoot: sourceRoot }))
   357	          .rejectMutation(operation, descriptor)
   358	      },
   359	    }
   360	
   361	    return [{
   362	      filesystem: COMPANY_CONTEXT_FILESYSTEM_ID,
   363	      access: 'readonly',
   364	      operations,
   365	    } satisfies RuntimeFilesystemBinding]
   366	  }
   367	}
