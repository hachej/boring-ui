    73	
    74	  private enabledPolicy(): GovernancePolicy | null {
    75	    if (!this.loaded.enabled) return null
    76	    if (!this.loaded.policy) return null
    77	    return this.loaded.policy
    78	  }
    79	
    80	  private userPolicy(user: GovernanceUserLike | null | undefined): GovernanceUserPolicy | null {
    81	    const policy = this.enabledPolicy()
    82	    if (!policy || !user?.email || user.emailVerified !== true) return null
    83	    return policy.usersByEmail.get(normalizePolicyEmail(user.email)) ?? null
