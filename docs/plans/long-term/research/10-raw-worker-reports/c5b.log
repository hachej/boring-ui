     4	export interface RuntimeScopeIdentityInput {
     5	  readonly artifacts: readonly {
     6	    readonly pluginId: string
     7	    readonly digest: string
     8	  }[]
     9	  readonly validatedConfig: JsonValue
    10	  readonly grants: readonly string[]
    11	  /** Stable semantic placement class; never an absolute root or lease key. */
    12	  readonly placementClassIdentity: string
    13	  readonly isolationMode: string
    14	  readonly toolContractDigests: readonly string[]
    15	  /** Stable semantic provisioning contract. */
    16	  readonly provisioningIdentity: string
    17	  readonly bindingInputs?: JsonValue
    18	}
    19	
    20	export interface EnvironmentProvisioningIdentityInput {
    21	  readonly placementIdentity: string
    22	  readonly providerDigest: string
    23	  readonly provisioningArtifactDigests: readonly string[]
    24	  readonly provisioningGeneration: string
    25	  readonly templateDigest?: string
    26	}
    27	
    28	/** Canonical JSON projection used only for app-resolved identity material. */
    29	function canonicalJson(value: JsonValue): string {
    30	  if (value === null || typeof value !== 'object') return JSON.stringify(value)
    31	  if (Array.isArray(value)) return `[${value.map(canonicalJson).join(',')}]`
    32	  return `{${Object.keys(value).sort().map((key) => (
    33	    `${JSON.stringify(key)}:${canonicalJson((value as Readonly<Record<string, JsonValue>>)[key]!)}`
    34	  )).join(',')}}`
    35	}
    36	
    37	function digest(value: JsonValue): string {
    38	  return createHash('sha256').update(canonicalJson(value)).digest('hex')
    39	}
    40	
    41	/**
    42	 * Produces the complete Agent-binding identity. Grants intentionally
    43	 * participate here even though they do not participate in Environment
    44	 * provisioning identity.
    45	 */
    46	export function createResolvedRuntimeScopeIdentity(
    47	  input: RuntimeScopeIdentityInput,
    48	): string {
    49	  return digest({
    50	    schemaVersion: 2,
    51	    artifacts: [...input.artifacts]
    52	      .map((artifact) => ({ pluginId: artifact.pluginId, digest: artifact.digest }))
    53	      .sort((a, b) => a.pluginId.localeCompare(b.pluginId) || a.digest.localeCompare(b.digest)),
    54	    validatedConfig: input.validatedConfig,
    55	    grants: [...input.grants].sort(),
    56	    placementClassIdentity: input.placementClassIdentity,
    57	    isolationMode: input.isolationMode,
    58	    toolContractDigests: [...input.toolContractDigests].sort(),
    59	    provisioningIdentity: input.provisioningIdentity,
    60	    ...(input.bindingInputs === undefined ? {} : { bindingInputs: input.bindingInputs }),
    61	  })
    62	}
    63	
    64	/**
    65	 * Produces only the Environment-mutating identity. Contribution grants and
    66	 * tool contracts are deliberately absent, so grant-only changes share the
    67	 * same canonical Environment lease.
    68	 */
    69	export function createEnvironmentProvisioningFingerprint(
    70	  input: EnvironmentProvisioningIdentityInput,
    71	): string {
    72	  return digest({
    73	    placementIdentity: input.placementIdentity,
    74	    providerDigest: input.providerDigest,
    75	    provisioningArtifactDigests: [...input.provisioningArtifactDigests].sort(),
    76	    provisioningGeneration: input.provisioningGeneration,
    77	    ...(input.templateDigest === undefined ? {} : { templateDigest: input.templateDigest }),
    78	  })
    79	}
