    25	export interface SkillSummary {
    26	  name: string
    27	  description: string
    28	  /** Browser-safe locator for opening a supported skill source. */
    29	  resource?: AgentSkillResource
    30	  /** False for management-only rows that Pi did not retain as invocable. */
    31	  invocable?: boolean
    32	  /** Human-readable source/scope label for diagnostics and disabled rows. */
    33	  source?: string
    34	}
    35	
    36	export interface AgentSkillResourceSnapshot {
    37	  readonly generation: string
    38	  readonly managedSkills: readonly SkillSummary[]
    39	  locateSkill(filePath: string): AgentSkillResource | undefined
