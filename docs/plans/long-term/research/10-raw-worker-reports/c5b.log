   252	      const resolved = await options.resolveAuthorizedAgentRuntimeScope({
   253	        authorizedScope: scope,
   254	        verifiedClaim: claim,
   255	        agentTypeId,
   256	        intent: {
   257	          kind: 'agent-binding',
   258	          operation,
   259	          requestId,
   260	          ...(sessionId ? { sessionId } : {}),
   261	        },
