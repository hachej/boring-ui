    97	  const claim = await runtime.verify(request.authorizedScope)
    98	  if (claim.authSubjectId !== request.context.userId.trim()) {
    99	    throw new AgentGatewayError(
   100	      AgentGatewayErrorCode.AGENT_SCOPE_DENIED,
