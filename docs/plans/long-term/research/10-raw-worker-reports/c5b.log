   102	    )
   103	  }
   104	  const resolved = await runtime.resolveAgentRuntimeScope(
   105	    request.agentTypeId,
   106	    request.authorizedScope,
   107	    claim,
   108	    'new-binding',
   109	    requestId,
   110	  )
   111	  const runtimeBinding = await runtime.resolveBinding(
   112	    request.agentTypeId,
   113	    request.authorizedScope,
   114	    claim,
   115	    resolved,
   116	  )
   117	  const operationEnvironment = await runtime.acquireResolvedEnvironment(
   118	    claim.workspaceScopeId,
   119	    runtimeBinding.scope.environment,
   120	  )
   121	  const abort = new AbortController()
   122	  let accepting = true
   123	  let revoked = false
   124	  let unregister = () => {}
   125	  const operations = new Set<Promise<unknown>>()
   126	  const cleanups = new Set<() => void>()
