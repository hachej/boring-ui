    16	  getAgentDir,
    17	  loadSkills,
    18	} from '@mariozechner/pi-coding-agent'
    19	import type { PiPackageSource } from '../../piPackages'
    20	import type { AgentSkillResource } from '../../../shared/skill-resource'
    21	import { ErrorCode } from '../../../shared/error-codes'
