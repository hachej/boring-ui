   555	function wildcardMatch(pattern: string, value: string): boolean {
   556	  if (!pattern.includes("*")) return pattern === value
   557	  const escaped = pattern.replace(/[.+?^${}()|[\]\\]/g, "\\$&").replace(/\*/g, ".*")
   558	  return new RegExp(`^${escaped}$`, "i").test(value)
   559	}
   560	
   561	export function classifyMcpTool(template: McpProviderTemplate, toolName: string): McpToolDecision {
   562	  validateMcpToolName(toolName)
   563	  if (template.deniedTools.some((pattern) => wildcardMatch(pattern, toolName))) {
   564	    return { allowed: false, risk: "write", reason: "Tool matches a denied write/admin pattern" }
   565	  }
   566	  if (template.allowedTools.some((pattern) => wildcardMatch(pattern, toolName))) {
   567	    return { allowed: true, risk: "read", reason: "Tool is on the read-only allowlist" }
   568	  }
   569	  return { allowed: false, risk: "unknown", reason: "Tool is not on the read-only allowlist" }
   570	}
   571	
