    11	export function bindingDisposedError(): Error & { readonly code: string } {
    12	  return Object.assign(new Error('Agent Host lease has been released'), {
    13	    code: ErrorCode.enum.AGENT_BINDING_DISPOSED,
    14	  })
    15	}
    16	
    17	export function guardMethods<T extends object>(
    18	  value: T,
    19	  assertActive: () => void,
    20	  track?: <R>(operation: Promise<R>) => Promise<R>,
    21	  registerCleanup?: (cleanup: () => void) => () => void,
    22	): T {
    23	  return new Proxy(value, {
    24	    get(target, property, receiver) {
    25	      const member = Reflect.get(target, property, receiver) as unknown
    26	      if (typeof member !== 'function') return member
    27	      return (...args: unknown[]) => {
    28	        assertActive()
    29	        if (property === 'watch' && registerCleanup) {
    30	          const watcher = Reflect.apply(member, target, args) as import('../../shared/workspace').WorkspaceWatcher
    31	          return Object.freeze({
    32	            subscribe(
    33	              listener: (event: import('../../shared/workspace').WorkspaceChangeEvent) => void,
    34	              options?: import('../../shared/workspace').WorkspaceWatchSubscribeOptions,
    35	            ) {
    36	              assertActive()
    37	              let subscribed = true
    38	              const unsubscribe = watcher.subscribe((event) => {
    39	                if (!subscribed) return
    40	                try { assertActive() } catch { return }
    41	                listener(event)
    42	              }, options?.onControlEvent
    43	                ? {
    44	                    onControlEvent(event) {
    45	                      if (!subscribed) return
    46	                      try { assertActive() } catch { return }
    47	                      options.onControlEvent!(event)
    48	                    },
    49	                  }
    50	                : undefined)
    51	              const unregisterCleanup = registerCleanup(() => {
    52	                if (!subscribed) return
    53	                subscribed = false
    54	                unsubscribe()
    55	              })
    56	              return () => {
    57	                if (!subscribed) return
    58	                subscribed = false
    59	                unregisterCleanup()
    60	                unsubscribe()
    61	              }
    62	            },
    63	            whenReady: watcher.whenReady
    64	              ? () => {
    65	                  assertActive()
    66	                  const ready = watcher.whenReady!()
    67	                  return track ? track(ready) : ready
    68	                }
    69	              : undefined,
    70	            close() {
    71	              throw new TypeError('callback leases cannot close the provider-owned workspace watcher')
    72	            },
    73	          })
    74	        }
    75	        const result = Reflect.apply(member, target, args)
    76	        if (result && typeof (result as { then?: unknown }).then === 'function') {
    77	          return track ? track(Promise.resolve(result)) : result
    78	        }
    79	        if (property !== 'watch' || !result || typeof result !== 'object') return result
    80	        return guardMethods(result as object, assertActive, track, registerCleanup)
    81	      }
    82	    },
    83	  })
    84	}
