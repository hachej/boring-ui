+```ts
+interface SessionInitOptions {
+  name: string;
+  conversation: ReducedConversationState;
+  config: AgentConfig;
+  conversationWriter: ConversationRecordWriter;
+  attachmentStore: AttachmentStore;
+  hookState?: HookStateBuffer;
