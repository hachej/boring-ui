    51	export function formatOffset(seq: number): string {
    52	  if (seq === -1) return '-1'
    53	  if (!Number.isInteger(seq) || seq < -1) {
    54	    throw new EventStreamStoreError(`Invalid event stream sequence: ${seq}.`)
    55	  }
    56	  return `${ZERO_COMPONENT}_${String(seq).padStart(COMPONENT_PAD, '0')}`
    57	}
    58	
    59	export function parseOffset(offset: string): number {
    60	  if (offset === '-1') return -1
    61	  const match = /^\d+_(\d+)$/.exec(offset)
    62	  const sequence = match?.[1]
    63	  if (!sequence) {
    64	    throw new EventStreamStoreError(`Invalid event stream offset: "${offset}".`)
    65	  }
    66	  return parseInt(sequence, 10)
    67	}
