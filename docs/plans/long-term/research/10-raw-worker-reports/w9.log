  1273	    const count = afterCounts.get(text) ?? 0
  1274	    if (count > 0) {
  1275	      afterCounts.set(text, count - 1)
  1276	      continue
  1277	    }
  1278	    removed.push(text)
  1279	  }
  1280	  return removed
