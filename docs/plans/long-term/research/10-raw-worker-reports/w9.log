  1246	function detectPromptImageMimeType(bytes: Uint8Array): string | null {
  1247	  const buffer = Buffer.from(bytes)
  1248	  if (buffer.length >= 8 && buffer.subarray(0, 8).equals(Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]))) {
  1249	    return 'image/png'
  1250	  }
  1251	  if (buffer.length >= 3 && buffer[0] === 0xff && buffer[1] === 0xd8 && buffer[2] === 0xff) {
  1252	    return 'image/jpeg'
  1253	  }
  1254	  if (buffer.length >= 6) {
  1255	    const gif = buffer.subarray(0, 6).toString('ascii')
  1256	    if (gif === 'GIF87a' || gif === 'GIF89a') return 'image/gif'
  1257	  }
  1258	  if (buffer.length >= 12 && buffer.subarray(0, 4).toString('ascii') === 'RIFF' && buffer.subarray(8, 12).toString('ascii') === 'WEBP') {
  1259	    return 'image/webp'
  1260	  }
  1261	  if (buffer.length >= 12 && buffer.subarray(4, 8).toString('ascii') === 'ftyp') {
  1262	    const brand = buffer.subarray(8, 12).toString('ascii')
  1263	    if (brand === 'avif' || brand === 'avis') return 'image/avif'
  1264	  }
  1265	  return null
  1266	}
