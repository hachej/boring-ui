     8	// DatabaseSync cannot yield while SQLite's busy handler waits. Keep each
     9	// synchronous lock wait short; write callers retry asynchronously so the
    10	// event loop can serve reads and unrelated work between attempts.
    11	export const SQLITE_BUSY_TIMEOUT_MS = 25
    12	
    13	export interface SqlResult {
    14	  toArray(): Array<Record<string, unknown>>
    15	}
    16	
    17	export interface SqlStorage {
    18	  exec(query: string, ...bindings: unknown[]): SqlResult
    19	}
    20	
    21	/**
    22	 * `deferred` (SQLite's plain `BEGIN`) postpones acquiring any lock until the
    23	 * first read or write inside the transaction. That is fine for read-only
    24	 * transactions, but a transaction that reads THEN writes (e.g. a
    25	 * check-then-insert) starts under a read lock and must upgrade to a write
    26	 * lock mid-transaction — and SQLite refuses that upgrade with SQLITE_BUSY
    27	 * immediately if another connection holds the write lock, WITHOUT honoring
    28	 * `busy_timeout` (the busy handler only runs for the initial lock
    29	 * acquisition, not a lock *upgrade*). `immediate` (`BEGIN IMMEDIATE`)
    30	 * acquires the write lock up front, so `busy_timeout` applies normally and
    31	 * a concurrent writer simply waits instead of erroring. Use `immediate` for
    32	 * any transaction that writes — especially read-then-write — and reserve
    33	 * `deferred` for genuinely read-only transactions.
    34	 */
    35	export type SqlTransactionMode = 'deferred' | 'immediate'
    36	
    37	export type RunTransaction = <T>(fn: () => T, mode?: SqlTransactionMode) => T
    38	
    39	export interface OpenDatabaseResult {
    40	  db: DatabaseSync
    41	  sql: SqlStorage
    42	  runTransaction: RunTransaction
    43	}
    44	
    45	export function createNodeSqlStorage(db: DatabaseSync): SqlStorage {
    46	  return {
    47	    exec(query: string, ...bindings: unknown[]): SqlResult {
    48	      const stmt = db.prepare(query)
    49	      const expectsRows = queryExpectsRows(query)
    50	      const rows = expectsRows
    51	        ? stmt.all(...(bindings as never[])) as Array<Record<string, unknown>>
    52	        : []
    53	      if (!expectsRows) {
    54	        stmt.run(...(bindings as never[]))
    55	      }
    56	      return {
    57	        toArray() {
    58	          return rows
    59	        },
    60	      }
    61	    },
    62	  }
    63	}
    64	
    65	export function createNodeTransactionSync(db: DatabaseSync): RunTransaction {
    66	  return <T>(fn: () => T, mode: SqlTransactionMode = 'deferred'): T => runTransaction(db, fn, mode)
    67	}
    68	
    69	export function runTransaction<T>(db: DatabaseSync, fn: () => T, mode: SqlTransactionMode = 'deferred'): T {
    70	  db.exec(mode === 'immediate' ? 'BEGIN IMMEDIATE' : 'BEGIN')
    71	  try {
    72	    const result = fn()
    73	    db.exec('COMMIT')
    74	    return result
    75	  } catch (error) {
    76	    db.exec('ROLLBACK')
    77	    throw error
    78	  }
    79	}
    80	
    81	export function openDatabase(path: string): OpenDatabaseResult {
    82	  if (path !== ':memory:') {
    83	    mkdirSync(dirname(path), { recursive: true })
    84	  }
    85	
    86	  const { DatabaseSync: SqliteDatabaseSync } = require('node:sqlite') as typeof import('node:sqlite')
    87	  const db = new SqliteDatabaseSync(path)
    88	  if (path !== ':memory:') {
    89	    // WAL lets readers and the writer proceed concurrently. Keep the native
    90	    // busy handler short because DatabaseSync occupies the event loop while
    91	    // waiting; EventStreamStore retries transient writer contention
    92	    // asynchronously instead of allowing one call to block for seconds.
    93	    // Set the timeout before journal_mode so initialization is bounded too.
    94	    db.exec(`PRAGMA busy_timeout=${SQLITE_BUSY_TIMEOUT_MS}; PRAGMA journal_mode=WAL;`)
    95	  }
    96	
    97	  return {
    98	    db,
    99	    sql: createNodeSqlStorage(db),
   100	    runTransaction: createNodeTransactionSync(db),
   101	  }
   102	}
   103	
   104	function queryExpectsRows(query: string): boolean {
   105	  const trimmed = query.trimStart().toUpperCase()
   106	  if (trimmed.startsWith('SELECT') || trimmed.startsWith('WITH') || trimmed.startsWith('PRAGMA')) return true
   107	  return /\bRETURNING\b/i.test(query)
   108	}
