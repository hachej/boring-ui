   191	            }
   192	          }
   193	
   194	          const seq = this.allocateSeq(path)
   195	          const envelope: AgentEvent = {
   196	            v: 1,
   197	            eventIndex: seq,
   198	            timestamp: Date.now(),
   199	            sessionId,
   200	            chunk,
