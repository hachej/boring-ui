   165	      return offset
   166	    } catch (error) {
   167	      const existing = this.readIdempotencyKey(path, key)
   168	      if (existing) {
   169	        if (existing.data !== data) {
   170	          throw new EventStreamStoreError(`Event key "${key}" already has a conflicting payload.`)
   171	        }
   172	        return formatOffset(existing.seq)
   173	      }
   174	      throw error
   175	    }
   176	  }
