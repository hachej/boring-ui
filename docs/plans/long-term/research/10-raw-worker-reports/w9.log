  1204	async function promptImagesFromAttachments(
  1205	  attachments: PromptPayload['attachments'],
  1206	  workspace?: Workspace,
  1207	): Promise<Array<{ type: 'image'; mimeType: string; data: string }>> {
  1208	  const images: Array<{ type: 'image'; mimeType: string; data: string }> = []
  1209	  for (const attachment of attachments ?? []) {
  1210	    const match = attachment.url.match(/^data:(image\/[^;]+);base64,(.+)$/)
  1211	    if (match) {
  1212	      const [, mimeType, data] = match
  1213	      images.push({ type: 'image', mimeType, data })
  1214	      continue
  1215	    }
  1216	
  1217	    if (!workspace?.readBinaryFile || !isWorkspaceImageAttachment(attachment)) continue
  1218	    try {
  1219	      const stat = await workspace.stat(attachment.path)
  1220	      if (stat.kind !== 'file' || stat.size <= 0 || stat.size > MAX_PROMPT_IMAGE_BYTES) continue
  1221	      const bytes = await workspace.readBinaryFile(attachment.path)
  1222	      if (bytes.byteLength <= 0 || bytes.byteLength > MAX_PROMPT_IMAGE_BYTES) continue
  1223	      const detectedMimeType = detectPromptImageMimeType(bytes)
  1224	      if (!detectedMimeType) continue
  1225	      images.push({
  1226	        type: 'image',
  1227	        mimeType: detectedMimeType,
  1228	        data: Buffer.from(bytes).toString('base64'),
  1229	      })
  1230	    } catch {
  1231	      // Best effort: the enriched prompt still points the agent at the
  1232	      // workspace path, so a transient read miss must not reject the turn.
  1233	    }
  1234	  }
  1235	  return images
  1236	}
