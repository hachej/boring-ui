   924	  private async assertSessionIncarnation(
   925	    sessionKey: string,
   926	    generation: number,
   927	    adapter: PiAgentSessionAdapter,
   928	  ): Promise<void> {
   929	    if (this.generationOf(sessionKey) === generation) return
   930	    await this.lifecycle.rejectLateAdapter(
   931	      adapter,
   932	      codedError('session not found', ErrorCode.enum.SESSION_NOT_FOUND, 404),
   933	    )
   934	  }
