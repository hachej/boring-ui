   268	    const events = page.map((row) => ({
   269	      data: JSON.parse(row.data as string) as unknown,
   270	      offset: formatOffset(row.seq as number),
   271	    }))
   272	    const lastRow = page.at(-1)
   273	    const lastSeq = lastRow ? lastRow.seq as number : startAfter
   274	
   275	    return {
   276	      events,
   277	      nextOffset: formatOffset(lastSeq),
   278	      upToDate: rows.length <= limit,
   279	      closed: meta.closed,
   280	    }
   281	  }
   282	
   283	  async closeStream(path: string): Promise<void> {
   284	    await this.retryBusy(() => {
   285	      this.sql.exec(`UPDATE boring_event_streams SET closed = 1 WHERE path = ?`, path)
   286	    })
   287	    this.notifyListeners(path)
   288	  }
   289	
   290	  async getStreamMeta(path: string): Promise<EventStreamMeta | null> {
   291	    return this.getStreamMetaSync(path)
   292	  }
   293	
   294	  subscribe(path: string, listener: () => void): () => void {
   295	    let bucket = this.listeners.get(path)
   296	    if (!bucket) {
   297	      bucket = new Set()
   298	      this.listeners.set(path, bucket)
