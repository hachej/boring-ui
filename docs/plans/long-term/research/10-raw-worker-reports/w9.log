   206	            path,
   207	            seq,
   208	            data,
   209	          )
   210	          if (opts.idempotencyKey !== undefined) {
   211	            this.sql.exec(
   212	              `INSERT INTO boring_event_stream_keys (path, idempotency_key, seq, data) VALUES (?, ?, ?, ?)`,
   213	              path,
   214	              opts.idempotencyKey,
   215	              seq,
   216	              keyData,
   217	            )
   218	          }
   219	          inserted = true
   220	          return formatOffset(seq)
   221	        }, 'immediate')
   222	      })
