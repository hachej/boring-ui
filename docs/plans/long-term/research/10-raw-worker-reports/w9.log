  1071	  /**
  1072	   * Validate the persisted session identity and instantiate its lazily-created
  1073	   * Pi adapter under the same full cache key. This is intentionally a narrow
  1074	   * trusted-host seam rather than another browser route.
  1075	   */
  1076	  async ensurePiSessionBound(
  1077	    ctx: PiSessionRequestContext,
  1078	    sessionId: string,
  1079	  ): Promise<void> {
  1080	    this.lifecycle.assertOpen()
  1081	    await this.assertCanAccessSession(ctx, sessionId)
  1082	    const adapter = await this.getAdapter(ctx, sessionId, '', { authorize: false })
  1083	    await this.ensureChannel(ctx, sessionId, adapter)
  1084	    this.lifecycle.assertOpen()
  1085	  }
