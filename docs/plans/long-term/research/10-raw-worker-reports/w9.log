    35	/**
    36	 * Per-session follow-up queue bookkeeping layered over pi's native queue.
    37	 * Owned by the session adapter (one instance per pi session): nonce-dedupes
    38	 * repeated posts and supports selective removal, which pi does not expose.
    39	 */
    40	export interface PiFollowUpQueueCompat {
    41	  /**
    42	   * Records a follow-up post. Returns false when the post is a duplicate of
    43	   * one already seen this session (same client nonce) and must not re-queue.
    44	   */
    45	  record(text: string, options?: PiFollowUpQueueOptions): boolean;
    46	  clear(piSession: PiAgentSessionLike, options?: PiFollowUpSelector): void;
    47	}
    48	
    49	export function createPiFollowUpQueueCompat(): PiFollowUpQueueCompat {
    50	  let queue: NativeFollowUpRequest[] = [];
    51	  // Client nonces seen this session. Survives consumption so a retried post of
    52	  // an already-drained follow-up is dropped.
    53	  const seenNonces = new Set<string>();
    54	
    55	  function record(text: string, options?: PiFollowUpQueueOptions): boolean {
    56	    const nonce = options?.clientNonce;
    57	    if (nonce && seenNonces.has(nonce)) return false;
    58	
    59	    queue.push({
    60	      text,
    61	      displayText: options?.displayText ?? text,
    62	      clientNonce: options?.clientNonce,
    63	      clientSeq: options?.clientSeq,
    64	    });
    65	    if (nonce) seenNonces.add(nonce);
