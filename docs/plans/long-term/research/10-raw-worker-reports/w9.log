   360	  private assertSameAgentIdempotencyPayload(key: string, existingData: string, chunk: PiChatEvent): void {
   361	    if (existingData !== JSON.stringify(chunk)) {
   362	      throw new EventStreamStoreError(`Agent event key "${key}" already has a conflicting payload.`)
   363	    }
   364	  }
