   397	function isSqliteBusy(error: unknown): boolean {
   398	  if (!(error instanceof Error)) return false
   399	  const code = (error as Error & { code?: unknown }).code
   400	  return (code === 'SQLITE_BUSY' || code === 'ERR_SQLITE_ERROR') && /busy|lock/i.test(error.message)
   401	}
   402	
   403	function delay(ms: number): Promise<void> {
   404	  return new Promise((resolve) => setTimeout(resolve, ms))
   405	}
   406	
   407	function clampLimit(value: number | undefined, defaultValue: number, maxValue: number): number {
   408	  if (value === undefined) return defaultValue
   409	  const normalized = Math.floor(value)
   410	  if (!Number.isFinite(normalized) || normalized < 1) return defaultValue
   411	  return Math.min(normalized, maxValue)
   412	}
