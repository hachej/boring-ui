   148	            `INSERT INTO boring_event_stream_entries (path, seq, data) VALUES (?, ?, ?)`,
   149	            path,
   150	            seq,
   151	            data,
   152	          )
   153	          this.sql.exec(
   154	            `INSERT INTO boring_event_stream_keys (path, idempotency_key, seq, data) VALUES (?, ?, ?, ?)`,
   155	            path,
   156	            key,
   157	            seq,
   158	            data,
   159	          )
   160	          inserted = true
   161	          return formatOffset(seq)
   162	        }, 'immediate')
   163	      })
