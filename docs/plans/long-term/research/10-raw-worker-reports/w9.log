   854	      sessionId,
   855	      content: message,
   856	      message,
   857	      ctx: toSessionCtx(ctx),
   858	      ...(typeof input !== 'string' && input.model ? { model: input.model } : {}),
   859	      ...(typeof input !== 'string' && input.thinkingLevel ? { thinkingLevel: input.thinkingLevel } : {}),
   860	      ...(typeof input !== 'string' && input.attachments ? { attachments: input.attachments } : {}),
   861	    }
