   378	    return {
   379	      nextOffset: formatOffset((row.next_offset as number) - 1),
   380	      closed: (row.closed as number) === 1,
   381	    }
   382	  }
   383	
   384	  private notifyListeners(path: string): void {
   385	    const bucket = this.listeners.get(path)
   386	    if (!bucket) return
