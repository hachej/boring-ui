   178	  async appendAgentEvent(sessionId: string, chunk: PiChatEvent, opts: { idempotencyKey?: string; streamPath?: string } = {}): Promise<string> {
   179	    const path = opts.streamPath ?? sessionStreamPath(sessionId)
