   895	  /** Coalesce concurrent cold callers so only one adapter subscription wins. */
   896	  private async createChannelOnce(
   897	    sessionKey: string,
   898	    sessionId: string,
   899	    generation: number,
   900	    resolveAdapter: () => Promise<PiAgentSessionAdapter>,
   901	  ): Promise<LiveSessionChannel> {
   902	    const inFlight = this.channelCreations.get(sessionKey)
   903	    if (inFlight) return inFlight
   904	    const creation = (async () => {
   905	      const existing = this.channels.get(sessionKey)
   906	      if (existing) return existing
   907	      const adapter = await resolveAdapter()
   908	      await this.lifecycle.assertAdapterOwned(adapter)
   909	      await this.assertSessionIncarnation(sessionKey, generation, adapter)
   910	      return this.buildChannel(sessionKey, sessionId, adapter, generation)
   911	    })()
   912	    this.channelCreations.set(sessionKey, creation)
   913	    try {
   914	      return await creation
   915	    } finally {
   916	      if (this.channelCreations.get(sessionKey) === creation) this.channelCreations.delete(sessionKey)
   917	    }
   918	  }
   919	
   920	  private generationOf(sessionKey: string): number {
   921	    return this.sessionGenerations.get(sessionKey) ?? 0
   922	  }
