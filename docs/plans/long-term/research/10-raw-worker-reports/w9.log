   130	      // the same transaction — must be BEGIN IMMEDIATE. A deferred BEGIN
   131	      // starts under a read lock and SQLite refuses the mid-transaction
   132	      // upgrade to a write lock with SQLITE_BUSY immediately, WITHOUT
   133	      // honoring busy_timeout, whenever another connection holds the write
   134	      // lock. See SqlTransactionMode in sqlStorage.ts.
   135	      const offset = await this.retryBusy(() => {
   136	        inserted = false
   137	        return this.runTransaction(() => {
   138	          const existing = this.readIdempotencyKey(path, key)
   139	          if (existing) {
   140	            if (existing.data !== data) {
   141	              throw new EventStreamStoreError(`Event key "${key}" already has a conflicting payload.`)
   142	            }
   143	            return formatOffset(existing.seq)
   144	          }
   145	
   146	          const seq = this.allocateSeq(path)
