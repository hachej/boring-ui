   842	  private async getAdapter(
   843	    ctx: PiSessionRequestContext,
   844	    sessionId: string,
   845	    input: string | PromptPayload,
   846	    options?: { authorize?: boolean },
   847	  ): Promise<PiAgentSessionAdapter> {
   848	    this.lifecycle.assertOpen()
   849	    if (!this.harness.getPiSessionAdapter) throw new Error('pi-native harness adapter unavailable')
   850	    if (options?.authorize !== false) await this.assertCanAccessSession(ctx, sessionId)
