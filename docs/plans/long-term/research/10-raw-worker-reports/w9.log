     3	export const BORING_EVENT_STREAM_SCHEMA_VERSION = 1
     4	
     5	export class EventStreamSchemaVersionError extends Error {
     6	  readonly code = 'INTERNAL_ERROR'
     7	
     8	  constructor(readonly storedVersion: string, readonly supportedVersion = BORING_EVENT_STREAM_SCHEMA_VERSION) {
     9	    super(`Unsupported event stream schema version "${storedVersion}" (expected "${supportedVersion}").`)
    10	    this.name = 'EventStreamSchemaVersionError'
    11	  }
    12	}
    13	
    14	export function assertSupportedEventStreamSchemaVersion(storedVersion: string): void {
    15	  if (storedVersion === String(BORING_EVENT_STREAM_SCHEMA_VERSION)) return
    16	  throw new EventStreamSchemaVersionError(storedVersion)
    17	}
    18	
    19	export function migrateEventStreamSqlSchema(sql: SqlStorage, ensureCurrentSchema: () => void): void {
    20	  sql.exec(`
    21	    CREATE TABLE IF NOT EXISTS boring_event_stream_meta (
    22	      key TEXT PRIMARY KEY,
    23	      value TEXT NOT NULL
    24	    )
    25	  `)
    26	
    27	  const stored = sql.exec(
    28	    `SELECT value FROM boring_event_stream_meta WHERE key = 'schema_version'`,
    29	  ).toArray()[0]?.value
    30	
    31	  if (stored !== undefined && stored !== null) {
    32	    assertSupportedEventStreamSchemaVersion(String(stored))
    33	  } else {
    34	    const existing = sql.exec(`
    35	      SELECT name FROM sqlite_master
    36	      WHERE type = 'table'
    37	        AND name LIKE 'boring_event_stream%'
    38	        AND name <> 'boring_event_stream_meta'
    39	      LIMIT 1
    40	    `).toArray()[0]
    41	    if (existing) {
    42	      throw new EventStreamSchemaVersionError('unversioned')
    43	    }
    44	  }
    45	
    46	  ensureCurrentSchema()
    47	
    48	  sql.exec(`
    49	    INSERT INTO boring_event_stream_meta (key, value)
    50	    VALUES ('schema_version', ?)
    51	    ON CONFLICT(key) DO UPDATE SET value = excluded.value
    52	  `, String(BORING_EVENT_STREAM_SCHEMA_VERSION))
    53	
    54	  const persisted = sql.exec(
    55	    `SELECT value FROM boring_event_stream_meta WHERE key = 'schema_version'`,
    56	  ).toArray()[0]?.value
    57	  assertSupportedEventStreamSchemaVersion(String(persisted))
    58	}

