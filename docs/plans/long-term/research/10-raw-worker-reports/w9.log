   787	  private publishPromptRunError(sessionKey: string, sessionId: string, channel: LiveSessionChannel | undefined, payload: PromptPayload, error: unknown): void {
   788	    if (!channel) return
   789	    const createdAt = new Date().toISOString()
   790	    const messageId = `prompt-error:${payload.clientNonce}:user`
   791	    const message = promptPayloadMessage(payload, messageId, createdAt, channel.activeTurnId)
   792	    const messageEvent = channel.mapper.mapSynthetic({
   793	      type: 'message-start',
   794	      messageId,
   795	      role: 'user' as const,
   796	      clientNonce: payload.clientNonce,
   797	      text: payload.displayMessage ?? payload.message,
   798	      files: promptPayloadFileParts(payload, messageId),
   799	      createdAt,
   800	    })
   801	    const promptError: ChatError = {
   802	      code: ErrorCode.enum.INTERNAL_ERROR,
   803	      message: error instanceof Error && error.message ? error.message : 'Prompt failed before the agent run completed.',
   804	      retryable: false,
   805	    }
   806	    const errorEvent = channel.mapper.mapSynthetic({
   807	      type: 'error',
   808	      turnId: channel.activeTurnId,
   809	      retryable: false,
   810	      error: promptError,
   811	    })
   812	    this.publishChannelEvents(sessionId, channel, [messageEvent, errorEvent], () => {
   813	      const failures = this.syntheticPromptFailures.get(sessionKey) ?? []
   814	      failures.push({ message, error: promptError })
   815	      this.syntheticPromptFailures.set(sessionKey, failures)
   816	      this.activeSyntheticPromptErrors.set(sessionKey, promptError)
   817	      channel.activeTurnId = undefined
   818	    })
   819	  }
