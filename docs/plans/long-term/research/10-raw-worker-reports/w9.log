   387	  async subscribe(ctx: PiSessionRequestContext, sessionId: string, cursor: number, subscriber: PiChatEventSubscriber): Promise<PiChatEventStreamResult> {
   388	    return this.lifecycle.run(() => this.subscribeBeforeDispose(ctx, sessionId, cursor, subscriber))
   389	  }
   390	
   391	  private async subscribeBeforeDispose(ctx: PiSessionRequestContext, sessionId: string, cursor: number, subscriber: PiChatEventSubscriber): Promise<PiChatEventStreamResult> {
   392	    const channel = await this.getChannel(ctx, sessionId)
   393	    this.lifecycle.assertOpen()
   394	    const result = channel.buffer.subscribe(cursor, subscriber)
   395	    if (result.type !== 'ok') return result
   396	    return { type: 'ok', unsubscribe: result.unsubscribe, closed: channel.closed }
   397	  }
   398	
   399	  async prompt(ctx: PiSessionRequestContext, sessionId: string, payload: PromptPayload): Promise<PromptReceipt> {
   400	    return this.lifecycle.run(() => this.promptBeforeDispose(ctx, sessionId, payload))
   401	  }
   402	
   403	  private async promptBeforeDispose(ctx: PiSessionRequestContext, sessionId: string, payload: PromptPayload): Promise<PromptReceipt> {
   404	    const sessionKey = this.sessionKey(ctx, sessionId)
   405	    const adapter = await this.getAdapter(ctx, sessionId, payload)
   406	    const channel = await this.ensureChannel(ctx, sessionId, adapter)
   407	    // Reservation is the dedup authority and must settle before model execution.
   408	    const outcome = (await this.metering?.reservePrompt({
   409	      workspaceId: ctx.workspaceId,
   410	      userId: ctx.authSubject,
   411	      userEmail: ctx.authEmail,
   412	      userEmailVerified: ctx.authEmailVerified,
   413	      sessionId,
   414	      stateKey: sessionKey,
   415	      clientNonce: payload.clientNonce,
   416	      message: payload.message,
   417	      model: adapter.currentModel?.() ?? payload.model,
   418	    })) ?? 'created'
   419	    if (outcome === 'duplicate') {
   420	      return {
   421	        accepted: true,
   422	        cursor: this.channels.get(sessionKey)?.buffer.latestSeq ?? 0,
   423	        clientNonce: payload.clientNonce,
   424	        duplicate: true,
   425	      }
   426	    }
   427	    if (outcome === 'cancelled') throw promptCancelledError()
   428	    this.messageMetadata.recordPrompt(sessionKey, payload)
   429	    const receiptCursor = nextPromptReceiptCursor(channel)
   430	    try {
   431	      const input = await toPiPromptInput(payload, this.workspace)
   432	      this.lifecycle.assertOpen()
   433	      const run = this.trackActiveRun(sessionKey, this.runAndDrainPublishQueue(channel, adapter.prompt(input)))
   434	      run.catch((error) => {
   435	        this.metering?.failPromptRun(sessionId, payload.clientNonce, sessionKey)
   436	        if (!this.messageMetadata.hasPrompt(sessionKey, { clientNonce: payload.clientNonce, displayText: payload.displayMessage ?? payload.message })) return
   437	        this.publishPromptRunError(sessionKey, sessionId, channel, payload, error)
   438	      })
   439	    } catch (err) {
   440	      this.metering?.failPromptRun(sessionId, payload.clientNonce, sessionKey)
   441	      this.messageMetadata.removePrompt(sessionKey, { clientNonce: payload.clientNonce })
   442	      throw err
   443	    }
   444	    return { accepted: true, cursor: receiptCursor, clientNonce: payload.clientNonce }
   445	  }
   446	
   447	  async followUp(ctx: PiSessionRequestContext, sessionId: string, payload: FollowUpPayload): Promise<FollowUpReceipt> {
   448	    return this.lifecycle.run(() => this.followUpBeforeDispose(ctx, sessionId, payload))
   449	  }
   450	
   451	  private async followUpBeforeDispose(ctx: PiSessionRequestContext, sessionId: string, payload: FollowUpPayload): Promise<FollowUpReceipt> {
   452	    const sessionKey = this.sessionKey(ctx, sessionId)
   453	    const adapter = await this.getAdapter(ctx, sessionId, payload.message)
   454	    const channel = await this.ensureChannel(ctx, sessionId, adapter)
   455	    // Reserve before enqueueing so duplicates cannot take a second hold.
   456	    const outcome = (await this.metering?.reserveFollowUp({
   457	      workspaceId: ctx.workspaceId,
   458	      userId: ctx.authSubject,
   459	      userEmail: ctx.authEmail,
   460	      userEmailVerified: ctx.authEmailVerified,
   461	      sessionId,
   462	      stateKey: sessionKey,
   463	      clientNonce: payload.clientNonce,
   464	      clientSeq: payload.clientSeq,
   465	      message: payload.message,
   466	      model: adapter.currentModel?.(),
   467	    })) ?? 'created'
   468	    if (outcome === 'duplicate') {
   469	      return {
   470	        accepted: true,
   471	        queued: true,
   472	        cursor: this.channels.get(sessionKey)?.buffer.latestSeq ?? 0,
   473	        clientNonce: payload.clientNonce,
   474	        clientSeq: payload.clientSeq,
   475	        duplicate: true,
   476	      }
   477	    }
   478	    if (outcome === 'cancelled') throw promptCancelledError()
   479	    this.messageMetadata.recordFollowUp(sessionKey, payload)
   480	    try {
   481	      this.lifecycle.assertOpen()
   482	      await adapter.followUp(payload.message, {
   483	        displayText: payload.displayMessage ?? payload.message,
   484	        clientNonce: payload.clientNonce,
   485	        clientSeq: payload.clientSeq,
   486	      })
   487	    } catch (err) {
   488	      this.metering?.failFollowUpRun(sessionKey, payload)
   489	      this.messageMetadata.removeFollowUp(sessionKey, payload)
   490	      throw err
   491	    }
   492	    await this.drainPublishQueue(channel)
   493	    return { accepted: true, queued: true, cursor: this.channels.get(sessionKey)?.buffer.latestSeq ?? 0, clientNonce: payload.clientNonce, clientSeq: payload.clientSeq }
   494	  }
   495	
   496	  async clearQueue(ctx: PiSessionRequestContext, sessionId: string, payload: QueueClearPayload): Promise<QueueClearReceipt> {
   497	    return this.lifecycle.run(() => this.clearQueueBeforeDispose(ctx, sessionId, payload))
   498	  }
   499	
   500	  private async clearQueueBeforeDispose(ctx: PiSessionRequestContext, sessionId: string, payload: QueueClearPayload): Promise<QueueClearReceipt> {
   501	    const sessionKey = this.sessionKey(ctx, sessionId)
   502	    const adapter = await this.getAdapter(ctx, sessionId, '')
   503	    if (hasFollowUpSelector(payload)) {
   504	      const before = adapter.readSnapshot().followUpMessages.length
   505	      adapter.clearFollowUp(payload)
   506	      await this.drainPublishQueue(this.channels.get(sessionKey))
   507	      const after = adapter.readSnapshot().followUpMessages.length
   508	      if (after < before) {
   509	        this.messageMetadata.removeFollowUp(sessionKey, payload)
   510	        this.metering?.releaseQueued(sessionKey, payload)
   511	      }
   512	      return { accepted: true, cursor: this.channels.get(sessionKey)?.buffer.latestSeq ?? 0, cleared: Math.max(0, before - after) }
   513	    }
   514	    const clearedQueue = this.clearAllFollowUps(adapter, sessionId, sessionKey)
   515	    await this.drainPublishQueue(this.channels.get(sessionKey))
   516	    this.metering?.releaseQueued(sessionKey)
   517	    return { accepted: true, cursor: this.channels.get(sessionKey)?.buffer.latestSeq ?? 0, cleared: clearedQueue.length }
   518	  }
   519	
   520	  async interrupt(ctx: PiSessionRequestContext, sessionId: string, _payload: InterruptPayload): Promise<{ accepted: true; cursor: number }> {
   521	    return this.lifecycle.run(() => this.interruptBeforeDispose(ctx, sessionId))
   522	  }
   523	
   524	  private async interruptBeforeDispose(ctx: PiSessionRequestContext, sessionId: string): Promise<{ accepted: true; cursor: number }> {
   525	    const sessionKey = this.sessionKey(ctx, sessionId)
   526	    const adapter = await this.getAdapter(ctx, sessionId, '')
   527	    const snapshot = adapter.readSnapshot()
   528	    const wasActive = snapshot.isStreaming || snapshot.isRetrying
   529	    const nextFollowUp = wasActive ? this.nextFollowUpForInterrupt(sessionId, sessionKey, adapter) : undefined
   530	    const activeRun = this.activePromptRuns.get(sessionKey)
   531	    adapter.abortRetry?.()
   532	    if (wasActive) await adapter.abort()
   533	    await this.drainPublishQueue(this.channels.get(sessionKey))
   534	    await activeRun?.catch(() => {})
   535	    // Release prompt reservations stranded before agent-start.
   536	    this.metering?.releasePending(sessionKey)
   537	    if (nextFollowUp) {
   538	      this.lifecycle.assertOpen()
   539	      await this.autoPostInterruptedFollowUp(sessionId, sessionKey, adapter, nextFollowUp)
   540	    }
   541	    return { accepted: true, cursor: this.channels.get(sessionKey)?.buffer.latestSeq ?? 0 }
   542	  }
   543	
   544	  async stop(ctx: PiSessionRequestContext, sessionId: string, _payload: StopPayload): Promise<StopReceipt> {
   545	    return this.lifecycle.run(() => this.stopBeforeDispose(ctx, sessionId))
   546	  }
   547	
   548	  private async stopBeforeDispose(ctx: PiSessionRequestContext, sessionId: string): Promise<StopReceipt> {
   549	    const sessionKey = this.sessionKey(ctx, sessionId)
   550	    const adapter = await this.getAdapter(ctx, sessionId, '')
   551	    const clearedQueue = this.clearAllFollowUps(adapter, sessionId, sessionKey)
   552	    // The active run settles/releases via the native aborted agent-end; queued
   553	    // and not-yet-started prompt reservations are released here so they don't
   554	    // hold the user's balance until TTL. Mark the active run user-stopped BEFORE
   555	    // the abort so its terminal accounting releases the hold (voluntary cancel is
   556	    // never charged the fallback), even if pi reports the aborted run as a no-usage
   557	    // success. Real usage recorded before the stop is still settled.
   558	    this.metering?.markActiveStopped(sessionKey)
   559	    this.metering?.releaseQueued(sessionKey)
   560	    this.metering?.releasePending(sessionKey)
   561	    await adapter.abort()
   562	    await this.drainPublishQueue(this.channels.get(sessionKey))
   563	    return { accepted: true, stopped: true, cursor: this.channels.get(sessionKey)?.buffer.latestSeq ?? 0, clearedQueue: buildPiChatQueuedFollowUps(sessionId, clearedQueue) }
   564	  }
   565	
   566	  private clearAllFollowUps(adapter: PiAgentSessionAdapter, sessionId: string, sessionKey: string): string[] {
   567	    const before = [...adapter.readSnapshot().followUpMessages]
   568	    adapter.clearFollowUp()
   569	    const after = adapter.readSnapshot().followUpMessages
   570	    this.messageMetadata.syncFromTexts(sessionKey, after)
   571	    return removedFollowUps(before, after)
   572	  }
   573	
   574	  private nextFollowUpForInterrupt(sessionId: string, sessionKey: string, adapter: PiAgentSessionAdapter): QueuedUserMessage | undefined {
   575	    const followUps = this.messageMetadata.enrichQueuedFollowUps(
   576	      sessionKey,
   577	      buildPiChatQueuedFollowUps(sessionId, adapter.readSnapshot().followUpMessages),
   578	    )
   579	    return followUps[0]
   580	  }
   581	
   582	  private async autoPostInterruptedFollowUp(
   583	    sessionId: string,
   584	    sessionKey: string,
   585	    adapter: PiAgentSessionAdapter,
   586	    followUp: QueuedUserMessage,
   587	  ): Promise<void> {
   588	    const metadata = this.messageMetadata.findFollowUpForQueueItem(sessionKey, followUp)
   589	    this.messageMetadata.recordConsumingFollowUp(sessionKey, followUp, metadata?.serverText)
   590	    if (adapter.continueQueuedFollowUp) {
   591	      try {
   592	        const channel = this.channels.get(sessionKey)
   593	        const run = this.trackActiveRun(
   594	          sessionKey,
   595	          this.runAndDrainPublishQueue(channel, adapter.continueQueuedFollowUp()),
   596	        )
   597	        // Native continuation owns the whole replacement turn. Keep tracking it
   598	        // for Stop/disposal, but do not hold the interrupt command open until the
   599	        // assistant finishes: UI commands may be ordered behind that receipt.
   600	        // This mirrors prompt(), whose receipt acknowledges turn acceptance.
   601	        void run.catch((error) => {
   602	          // Rejected before Pi consumed the follow-up; release its reservation.
   603	          // A no-op if it was already consumed (the run left the queue).
   604	          this.metering?.failFollowUpRun(sessionKey, followUp)
   605	          if (!this.messageMetadata.findFollowUpForQueueItem(sessionKey, followUp)) return
   606	          this.publishAutoPostedFollowUpRunError(sessionKey, sessionId, channel, error)
   607	        })
   608	        // Preserve the interrupt receipt cursor by flushing any synchronously
   609	        // emitted replacement-turn events before acknowledging the command.
   610	        // Closing must still be able to advance to adapter abortion if a durable
   611	        // event append has stalled this queue.
   612	        await Promise.race([
   613	          this.drainPublishQueue(channel),
   614	          this.lifecycle.closingPromise,
   615	        ])
   616	      } catch (err) {
   617	        this.metering?.failFollowUpRun(sessionKey, followUp)
   618	        throw err
   619	      }
   620	      return
   621	    }
   622	    if (!this.canClearAutoPostedFollowUpForFallback(adapter, followUp)) {
   623	      throw new AutoPostFollowUpError('Cannot auto-post queued follow-up because this runtime cannot safely remove only the consumed queued item.')
   624	    }
   625	    // Fallback re-posts the follow-up as a plain prompt; no followup-consumed
   626	    // event will fire, so remove it from Pi's native follow-up queue before
   627	    // prompting. Pi 0.80 drains native follow-ups during prompt/continue, so
   628	    // clearing after the repost would duplicate the queued user turn.
   629	    this.clearAutoPostedFollowUpForFallback(sessionId, sessionKey, adapter, followUp)
   630	    this.metering?.promoteQueuedToPrompt(sessionKey, followUp)
   631	    try {
   632	      await this.runPrompt(sessionKey, adapter, metadata?.serverText ?? followUp.displayText)
   633	    } catch (err) {
   634	      // The repost rejected before agent-start; release the promoted hold so
   635	      // it doesn't strand in pendingPrompts and misattribute later usage, then
   636	      // restore the queue item because fallback reposting never consumed it.
   637	      this.metering?.failPromotedFollowUp(sessionId, followUp, sessionKey)
   638	      this.lifecycle.assertOpen()
   639	      await adapter.followUp(metadata?.serverText ?? followUp.displayText, {
   640	        displayText: followUp.displayText,
   641	        clientNonce: followUp.clientNonce,
   642	        clientSeq: followUp.clientSeq,
   643	      })
   644	      if (followUp.clientNonce && followUp.clientSeq !== undefined) {
   645	        this.messageMetadata.recordFollowUp(sessionKey, {
   646	          message: metadata?.serverText ?? followUp.displayText,
   647	          displayMessage: followUp.displayText,
   648	          clientNonce: followUp.clientNonce,
   649	          clientSeq: followUp.clientSeq,
   650	        })
   651	      }
   652	      throw err
   653	    }
   654	  }
   655	
   656	  private async runPrompt(sessionKey: string, adapter: PiAgentSessionAdapter, input: PiAgentPromptInput): Promise<void> {
   657	    await Promise.race([
   658	      this.trackActiveRun(sessionKey, this.runAndDrainPublishQueue(this.channels.get(sessionKey), adapter.prompt(input))),
   659	      this.lifecycle.closingPromise,
   660	    ])
   661	  }
   662	
   663	  private async trackActiveRun(sessionKey: string, run: Promise<void>): Promise<void> {
   664	    this.activePromptRuns.set(sessionKey, run)
   665	    try {
   666	      await run
   667	    } finally {
   668	      if (this.activePromptRuns.get(sessionKey) === run) this.activePromptRuns.delete(sessionKey)
   669	    }
   670	  }
   671	
   672	  private clearAutoPostedFollowUpForFallback(
   673	    sessionId: string,
   674	    sessionKey: string,
   675	    adapter: PiAgentSessionAdapter,
   676	    followUp: QueuedUserMessage,
   677	  ): boolean {
   678	    if (adapter.readSnapshot().followUpMessages.length <= 1) {
   679	      this.clearAllFollowUps(adapter, sessionId, sessionKey)
   680	      return true
   681	    }
   682	    if (hasFollowUpSelector(followUp)) {
   683	      adapter.clearFollowUp(followUpSelector(followUp))
   684	      return true
   685	    }
   686	    return false
   687	  }
   688	
   689	  private canClearAutoPostedFollowUpForFallback(adapter: PiAgentSessionAdapter, followUp: QueuedUserMessage): boolean {
   690	    return hasFollowUpSelector(followUp) || adapter.readSnapshot().followUpMessages.length <= 1
   691	  }
   692	
   693	  private enrichSyntheticPromptFailures(sessionKey: string, snapshot: PiChatSnapshot): PiChatSnapshot {
   694	    const failures = this.syntheticPromptFailures.get(sessionKey) ?? []
   695	    const activeError = this.activeSyntheticPromptErrors.get(sessionKey)
   696	    if (failures.length === 0 && !activeError) return snapshot
   697	    return {
   698	      ...snapshot,
   699	      status: activeError ? 'error' : snapshot.status,
   700	      error: activeError ?? snapshot.error,
   701	      messages: mergeSyntheticMessages(snapshot.messages, failures.map((failure) => failure.message)),
   702	    }
   703	  }
   704	
   705	  private publishAutoPostedFollowUpRunError(
   706	    sessionKey: string,
   707	    sessionId: string,
   708	    channel: LiveSessionChannel | undefined,
   709	    error: unknown,
   710	  ): void {
   711	    if (!channel) return
   712	    const followUpError: ChatError = {
   713	      code: ErrorCode.enum.INTERNAL_ERROR,
   714	      message: error instanceof Error && error.message
   715	        ? error.message
   716	        : 'Queued follow-up failed before the agent run started.',
   717	      retryable: false,
   718	    }
   719	    const errorEvent = channel.mapper.mapSynthetic({
   720	      type: 'error',
   721	      turnId: channel.activeTurnId,
   722	      retryable: false,
   723	      error: followUpError,
   724	    })
   725	    this.publishChannelEvents(sessionId, channel, [errorEvent], () => {
   726	      this.activeSyntheticPromptErrors.set(sessionKey, followUpError)
   727	      channel.activeTurnId = undefined
   728	    })
   729	  }
   730	
   731	  private publishChannelEvents(
   732	    sessionId: string,
   733	    channel: LiveSessionChannel,
   734	    events: PiChatEvent[],
   735	    afterPublish?: (publishedEvents: PiChatEvent[]) => void,
   736	  ): void {
   737	    if (!this.eventStore) {
   738	      const publishedEvents: PiChatEvent[] = []
   739	      for (const event of events) {
   740	        const enriched = this.messageMetadata.enrichEvent(channel.sessionKey, event)
   741	        publishedEvents.push(enriched)
   742	        this.publishChannelEventSync(sessionId, channel, enriched)
   743	      }
   744	      afterPublish?.(publishedEvents)
   745	      return
   746	    }
   747	
   748	    const next = channel.publishQueue.then(async () => {
   749	      const publishedEvents: PiChatEvent[] = []
   750	      for (const event of events) {
   751	        const enriched = this.messageMetadata.enrichEvent(channel.sessionKey, event)
   752	        publishedEvents.push(enriched)
   753	        await this.eventStore?.appendAgentEvent(sessionId, enriched, { idempotencyKey: String(enriched.seq), streamPath: channel.streamPath })
   754	        this.publishChannelEventSync(sessionId, channel, enriched)
   755	      }
   756	      afterPublish?.(publishedEvents)
   757	    }).catch((error) => {
   758	      channel.rejectClosed(error)
   759	      throw error
   760	    })
   761	    // A failed durable append intentionally poisons this live channel: later
   762	    // chunks cannot skip the failed PiChatEvent seq and still satisfy replay
   763	    // authority, so callers that await the queue must see the same failure.
   764	    channel.publishQueue = next
   765	    next.catch(() => {})
   766	  }
   767	
   768	  private publishChannelEventSync(sessionId: string, channel: LiveSessionChannel, event: PiChatEvent): void {
   769	    const sessionKey = channel.sessionKey
   770	    if (event.type === 'agent-start') {
   771	      channel.activeTurnId = event.turnId
   772	      this.activeSyntheticPromptErrors.delete(sessionKey)
   773	    }
   774	    if (event.type === 'message-start' && channel.activeTurnId) {
   775	      channel.messageTurnIds.set(event.messageId, channel.activeTurnId)
   776	    }
   777	    if (event.type === 'message-end' && channel.activeTurnId) {
   778	      channel.messageTurnIds.set(event.messageId, channel.activeTurnId)
   779	      channel.messageTurnIds.set(event.final.id, channel.activeTurnId)
   780	    }
   781	    if (event.type === 'agent-end' && channel.activeTurnId === event.turnId) channel.activeTurnId = undefined
   782	    this.messageMetadata.consumeEvent(sessionKey, event)
   783	    this.onEvent?.(sessionId, event)
