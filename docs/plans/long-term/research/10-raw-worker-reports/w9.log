   145	  }
   146	  if (queue.followUpMessages) {
   147	    removeFirstMatchingOrdinal(queue.followUpMessages, (message) => message === text, textOrdinal);
   148	  }
   149	  queue.emitUpdate();
   150	}
   151	
   152	function readPiQueuedFollowUpTexts(piSession: PiAgentSessionLike): string[] {
   153	  const queue = piQueueAccess(piSession);
