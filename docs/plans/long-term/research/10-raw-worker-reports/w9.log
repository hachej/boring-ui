   237	  async readEvents(path: string, opts: { offset?: string; limit?: number } = {}): Promise<EventStreamReadResult> {
   238	    const meta = this.getStreamMetaSync(path)
   239	    if (!meta) {
   240	      return { events: [], nextOffset: formatOffset(-1), upToDate: true, closed: false }
   241	    }
   242	
   243	    const rawOffset = opts.offset ?? '-1'
   244	    const limit = clampLimit(opts.limit, DEFAULT_READ_LIMIT, MAX_READ_LIMIT)
   245	    let startAfter: number
   246	    if (rawOffset === '-1') {
   247	      startAfter = -1
   248	    } else if (rawOffset === 'now') {
   249	      return {
   250	        events: [],
   251	        nextOffset: meta.nextOffset,
   252	        upToDate: true,
   253	        closed: meta.closed,
   254	      }
   255	    } else {
   256	      startAfter = parseOffset(rawOffset)
   257	    }
   258	    const tailSeq = parseOffset(meta.nextOffset)
   259	    if (startAfter > tailSeq) startAfter = tailSeq
   260	
   261	    const rows = this.sql.exec(`
   262	      SELECT seq, data FROM boring_event_stream_entries
   263	      WHERE path = ? AND seq > ?
   264	      ORDER BY seq ASC
   265	      LIMIT ?
   266	    `, path, startAfter, limit + 1).toArray()
