   868	      sessionCtx: toSessionCtx(ctx),
   869	      userEmail: ctx.authEmail,
   870	      userEmailVerified: ctx.authEmailVerified,
   871	    })
   872	    await this.lifecycle.assertAdapterOwned(adapter)
