   339	   * the run's ops chain so a concurrent release/settle is ordered strictly
   340	   * after the reservation row exists. Returns 'cancelled' (skip execution) when
   341	   * a concurrent stop/interrupt/delete terminated the run while the reserve was
   342	   * in flight; throws (fail closed) when the sink rejects.
   343	   */
   344	  private async materializeReservation(
   345	    state: SessionMeteringState,
   346	    run: MeteringRun,
   347	    input: ReservePromptInput,
   348	    stateKey: string,
   349	  ): Promise<ReserveOutcome> {
   350	    run.reservation = this.applyReservation(run, input)
   351	    const reserveOp = run.reservation.catch(() => {})
   352	    run.ops = reserveOp
   353	    this.inflightOps.add(reserveOp)
   354	    void reserveOp.finally(() => this.inflightOps.delete(reserveOp))
   355	    try {
   356	      await run.reservation
   357	    } catch (err) {
   358	      this.removeReservingRun(state, run, stateKey)
   359	      throw err
   360	    }
   361	    // Cancelled mid-reserve: the release is already queued behind the reserve on
   362	    // run.ops, so the hold is cleaned up — just don't execute.
   363	    return run.terminal ? 'cancelled' : 'created'
   364	  }
   365	
   366	  /** True while a non-terminal prompt run exists for this nonce (accept →
   367	   * agent-end). Used to suppress duplicate-nonce execution for the full run
   368	   * lifetime, not just until the user message-start is consumed. */
   369	  hasPromptRun(sessionId: string, clientNonce: string): boolean {
   370	    const state = this.sessions.get(sessionId)
   371	    if (!state) return false
   372	    const run = this.findRun(state, promptRunId(sessionId, clientNonce))
   373	    return run !== undefined && !run.terminal
   374	  }
   375	
   376	  /** True while a non-terminal follow-up run exists for this selector (queued
   377	   * or consumed-and-active). Used to suppress duplicate follow-up enqueues. */
   378	  hasFollowUpRun(sessionId: string, selector: FollowUpSelector): boolean {
   379	    const state = this.sessions.get(sessionId)
   380	    if (!state) return false
   381	    if (selector.clientNonce !== undefined && state.consumedFollowUpNonces.has(selector.clientNonce)) return true
   382	    if (state.queued.some((run) => followUpMatches(run, selector))) return true
   383	    const active = state.active
   384	    return active !== undefined && !active.terminal && active.followUp !== undefined && followUpMatches(active, selector)
   385	  }
   386	
   387	  /** The accepted prompt failed before/without running (sync throw or run rejection). */
   388	  failPromptRun(sessionId: string, clientNonce: string, stateKey = sessionId): void {
   389	    const state = this.sessions.get(stateKey)
   390	    if (!state) return
   391	    const runId = promptRunId(sessionId, clientNonce)
   392	    const pendingIndex = state.pendingPrompts.findIndex((run) => run.scope.runId === runId)
   393	    if (pendingIndex >= 0) {
   394	      const [run] = state.pendingPrompts.splice(pendingIndex, 1)
   395	      if (run) this.finishRun(run, 'error')
   396	    } else if (state.active?.scope.runId === runId) {
   397	      this.finishRun(state.active, 'error')
   398	      state.active = undefined
   399	    }
   400	    this.pruneSession(stateKey, state)
   401	  }
   402	
   403	  /** A queued follow-up was rejected by the adapter before being queued. */
   404	  failFollowUpRun(sessionId: string, selector: FollowUpSelector): void {
   405	    const state = this.sessions.get(sessionId)
   406	    if (!state) return
   407	    const run = takeQueuedFollowUp(state, selector)
   408	    if (!run) return
   409	    this.release(run, 'run-rejected')
   410	    this.pruneSession(sessionId, state)
   411	  }
   412	
   413	  /**
   414	   * A queued follow-up is being re-posted as a plain prompt (interrupt
   415	   * fallback for runtimes without continueQueuedFollowUp). No
   416	   * `followup-consumed` event will arrive, so bind its reservation to the
   417	   * next agent-start instead.
   418	   */
   419	  promoteQueuedToPrompt(sessionId: string, selector: FollowUpSelector): void {
   420	    const state = this.sessions.get(sessionId)
   421	    if (!state) return
   422	    const run = takeQueuedFollowUp(state, selector)
   423	    if (!run) return
   424	    state.pendingPrompts.push(run)
   425	  }
   426	
   427	  /**
   428	   * A promoted-to-prompt follow-up failed before agent-start (the fallback
   429	   * repost rejected). Release its reservation instead of stranding it in
   430	   * pendingPrompts, where a later agent-start would otherwise misattribute
   431	   * usage to it.
   432	   */
   433	  failPromotedFollowUp(sessionId: string, selector: { clientNonce?: string; clientSeq?: number }, stateKey = sessionId): void {
   434	    const state = this.sessions.get(stateKey)
   435	    if (!state || selector.clientNonce === undefined || selector.clientSeq === undefined) return
   436	    const runId = followUpRunId(sessionId, selector.clientNonce, selector.clientSeq)
   437	    const index = state.pendingPrompts.findIndex((run) => run.scope.runId === runId)
   438	    if (index < 0) return
   439	    const [run] = state.pendingPrompts.splice(index, 1)
   440	    if (run) this.release(run, 'run-rejected')
   441	    this.pruneSession(stateKey, state)
   442	  }
   443	
   444	  /**
   445	   * Mark the currently-active run as voluntarily user-stopped (the /stop button),
   446	   * so its terminal accounting RELEASES the hold instead of charging the fallback.
   447	   * Must be called before the abort so the flag is set when the native aborted
   448	   * agent-end is observed. Runs with real usage recorded before the stop still
   449	   * settle that usage; only the unused remainder of the hold is released. No-op if
   450	   * there is no active run (e.g. the stop landed before agent-start — releasePending
   451	   * handles that case).
   452	   */
   453	  markActiveStopped(sessionId: string): void {
   454	    const active = this.sessions.get(sessionId)?.active
   455	    if (active && !active.terminal) active.userStopped = true
   456	  }
   457	
   458	  /**
   459	   * Release prompt runs reserved but not yet bound to an agent-start —
   460	   * e.g. a stop/interrupt landing in the window between acceptance and the
   461	   * native agent_start. Without this they would sit `active` in the store
   462	   * until their TTL, holding the user's balance. No charge.
   463	   */
   464	  releasePending(sessionId: string): void {
   465	    const state = this.sessions.get(sessionId)
   466	    if (!state) return
   467	    for (const run of state.pendingPrompts) this.release(run, 'cancelled')
   468	    state.pendingPrompts = []
   469	    this.pruneSession(sessionId, state)
   470	  }
   471	
   472	  /** Queue cleared via selector or entirely; release affected reservations. */
   473	  releaseQueued(sessionId: string, selector?: FollowUpSelector): void {
   474	    const state = this.sessions.get(sessionId)
   475	    if (!state) return
   476	    if (selector) {
   477	      const run = takeQueuedFollowUp(state, selector)
   478	      if (run) this.release(run, 'queue-cleared')
   479	    } else {
   480	      for (const run of state.queued) this.release(run, 'queue-cleared')
   481	      state.queued = []
   482	    }
   483	    this.pruneSession(sessionId, state)
   484	  }
   485	
   486	  /** Session deleted: tear down every non-terminal run without charging. */
   487	  releaseSession(sessionId: string): void {
   488	    const state = this.sessions.get(sessionId)
   489	    if (!state) return
   490	    for (const run of state.queued) this.release(run, 'cancelled')
   491	    for (const run of state.pendingPrompts) this.release(run, 'cancelled')
   492	    if (state.active) this.finishRun(state.active, 'aborted')
   493	    this.sessions.delete(sessionId)
   494	  }
   495	
   496	  /**
   497	   * Feed one native adapter event and its mapped PiChatEvents through the
   498	   * correlation state machine. Must be called after the mapped events were
   499	   * published (the mapper assigns turn ids during mapping).
   500	   */
   501	  observe(sessionId: string, nativeEvent: unknown, mappedEvents: readonly PiChatEvent[]): void {
   502	    const state = this.sessions.get(sessionId)
   503	    if (!state) return
   504	
   505	    for (const event of mappedEvents) {
   506	      switch (event.type) {
   507	        case 'agent-start': {
   508	          // Skip pending runs already released (e.g. raced with stop) so usage
   509	          // is never attributed to a terminal run.
   510	          let next = state.pendingPrompts.shift()
   511	          while (next && next.terminal) next = state.pendingPrompts.shift()
   512	          if (next) {
   513	            if (state.active && !state.active.terminal) this.finishRun(state.active, 'ok')
   514	            state.active = next
   515	          }
   516	          break
   517	        }
   518	        case 'message-start': {
   519	          // Production consumption signal: an enriched user message-start
   520	          // carrying a follow-up selector (clientSeq present). Idempotent with
   521	          // the explicit followup-consumed event below — whichever lands first
   522	          // removes the run from the queue.
   523	          if (event.role === 'user' && event.clientSeq !== undefined) {
   524	            this.consumeFollowUp(state, event)
   525	          }
   526	          break
   527	        }
   528	        case 'followup-consumed': {
   529	          this.consumeFollowUp(state, event)
   530	          break
   531	        }
   532	        case 'auto-retry-start': {
   533	          // New attempt for the same run: reset per-attempt usage dedup so the
   534	          // next attempt's usage (notably id-less) meters independently.
   535	          if (state.active) {
   536	            state.active.recordedMessageIds.clear()
   537	            state.active.lastIdlessUsageKey = undefined
   538	          }
   539	          break
   540	        }
   541	        case 'agent-end': {
   542	          // Harvest authoritative usage riding on agent_end first (deduped by
   543	          // message id) — a willRetry attempt may still carry real, billed
   544	          // token usage for the failed attempt.
   545	          this.harvestAgentEndUsage(state, nativeEvent)
   546	          // Pi auto-retries inside the same run (agent_end with willRetry,
   547	          // then auto_retry_* events, then the retried stream — without a new
   548	          // agent_start). Don't terminate: the run continues for the retry.
   549	          if (isRecord(nativeEvent) && nativeEvent.willRetry === true) break
   550	          if (state.active && !state.active.terminal) this.finishRun(state.active, event.status)
   551	          state.active = undefined
   552	          break
   553	        }
   554	        default:
   555	          break
   556	      }
   557	    }
   558	
   559	    this.observeMessageEndUsage(state, nativeEvent)
   560	    this.pruneSession(sessionId, state)
   561	  }
   562	
   563	  /** Promote a queued follow-up to the active run, settling the previous one. */
   564	  private consumeFollowUp(state: SessionMeteringState, selector: FollowUpSelector): void {
   565	    const run = takeQueuedFollowUp(state, selector)
   566	    if (!run) return
   567	    if (run.followUp?.clientNonce) state.consumedFollowUpNonces.add(run.followUp.clientNonce)
   568	    if (state.active && !state.active.terminal) this.finishRun(state.active, 'ok')
   569	    state.active = run
   570	  }
   571	
   572	  /** Test/diagnostic hook: resolves after every queued sink call settles. */
   573	  async flush(): Promise<void> {
   574	    // Sink calls can enqueue while we await (usage then settle), so drain
   575	    // until the in-flight set is stable.
   576	    while (this.inflightOps.size > 0) {
   577	      await Promise.all([...this.inflightOps])
   578	    }
   579	  }
   580	
   581	  private observeMessageEndUsage(state: SessionMeteringState, nativeEvent: unknown): void {
   582	    if (!isRecord(nativeEvent) || nativeEvent.type !== 'message_end') return
   583	    this.recordAssistantUsage(state, nativeEvent.message)
   584	  }
   585	
   586	  /**
   587	   * Some failure/abort paths never emit message_end; the final assistant
   588	   * message (and its usage) only rides on agent_end's messages array. Runs
   589	   * with already-recorded usage dedupe via recordedMessageIds.
   590	   */
   591	  private harvestAgentEndUsage(state: SessionMeteringState, nativeEvent: unknown): void {
   592	    if (!isRecord(nativeEvent) || !Array.isArray(nativeEvent.messages)) return
   593	    for (let index = nativeEvent.messages.length - 1; index >= 0; index -= 1) {
   594	      const message = nativeEvent.messages[index]
   595	      if (!isRecord(message) || message.role !== 'assistant') continue
   596	      this.recordAssistantUsage(state, message, { isAgentEndFinal: true })
   597	      return
   598	    }
   599	  }
   600	
   601	  private recordAssistantUsage(
   602	    state: SessionMeteringState,
   603	    message: unknown,
   604	    opts: { isAgentEndFinal?: boolean } = {},
   605	  ): void {
   606	    if (!isRecord(message) || message.role !== 'assistant') return
   607	    const usage = normalizeMeteringUsage(message.usage)
   608	    if (!usage) return
   609	
   610	    const run = state.active ?? state.pendingPrompts[0]
   611	    if (!run || run.terminal) {
   612	      this.logError('assistant usage arrived with no reserved run; usage not metered', { messageRole: 'assistant' })
   613	      return
   614	    }
   615	
   616	    const messageId = typeof message.id === 'string' && message.id.length > 0 ? message.id : undefined
   617	    if (messageId) {
   618	      // id-ful: exact dedup of a repeat message_end and the agent_end echo.
   619	      if (run.recordedMessageIds.has(messageId)) return
   620	      run.recordedMessageIds.add(messageId)
   621	    } else {
   622	      // id-less: a message_end records unconditionally (distinct tool-loop calls
   623	      // can share a usage signature). Only the agent_end ECHO of the most
   624	      // recent id-less message is skipped.
   625	      const stopReason = typeof message.stopReason === 'string' ? message.stopReason : ''
   626	      const signature = `sig:${usage.input}:${usage.output}:${usage.cacheRead}:${usage.cacheWrite}:${usage.cost.total}:${stopReason}`
   627	      if (opts.isAgentEndFinal && signature === run.lastIdlessUsageKey) return
   628	      run.lastIdlessUsageKey = signature
   629	    }
   630	
   631	    run.usageCount += 1
   632	    const model = typeof message.model === 'string' && message.model.length > 0 ? message.model : undefined
   633	    const provider = typeof message.provider === 'string' && message.provider.length > 0 ? message.provider : undefined
   634	    const stopReason = typeof message.stopReason === 'string' ? message.stopReason : undefined
   635	    // Stable usage id for ledger idempotency. Native id when present. Otherwise
   636	    // prefer the persisted reservationId: it's DB-assigned (stable across
   637	    // process restarts) and distinct per reserve — and the store's idempotent
   638	    // reserve hands a crash-retry of the same runId back the SAME reservation,
   639	    // so the retried usage id matches and is deduped rather than double-billed.
   640	    // Only when the sink returns no reservationId do we fall back to the
   641	    // process-local run instance (best effort).
   642	    // The reservationId is carried in the usage metadata, so the store's
   643	    // recordUsage verifies it on an id collision: a reused session:message id from
   644	    // a DIFFERENT reservation (client-nonce replay) fails the match and throws,
   645	    // routing the run to the fallback hold charge instead of settling it free.
   646	    const usageId = messageId
   647	      ? `pi-usage:${run.scope.sessionId}:message:${messageId}`
   648	      : run.reservationId
   649	        ? `pi-usage:reservation:${run.reservationId}:${run.usageCount}`
   650	        : `pi-usage:${run.scope.runId}:${run.instanceId}:${run.usageCount}`
   651	
   652	    this.enqueue(run, async () => {
   653	      try {
   654	        const result = await this.sink.recordUsage({
   655	          ...run.scope,
   656	          reservationId: run.reservationId,
   657	          usageId,
   658	          messageId,
   659	          model: model || provider ? { provider, id: model } : undefined,
   660	          usage,
   661	          stopReason,
   662	        })
   663	        // Count billability from the ACTUAL billed amount, not raw provider fields:
   664	        // a row that priced to 0 (e.g. cost-only usage the pricing doesn't trust)
   665	        // is NOT billable, so finishRun won't settle a free hold; a row that billed
   666	        // a positive amount IS, so it won't be fallback-charged on top of its debit.
   667	        if (result.billedMicros > 0) run.billableUsageCount += 1
   668	      } catch (error) {
   669	        // A FAILED write only counts as lost paid work (→ fallback hold charge) if
   670	        // the row could actually have billed a positive amount: positive tokens, or a
   671	        // positive provider cost that pricing MIGHT bill. An all-zero usage row prices
   672	        // to 0 regardless, so a failed write for it must NOT charge the hold — the
   673	        // successfully-written same row is released free, and the two must agree (else
   674	        // a transient write failure over-charges a non-billable aborted run). We can't
   675	        // read the real billed amount here (the write threw), so use the conservative
   676	        // could-bill heuristic: charge on positive/unknown, free on definitely-zero.
   677	        const couldBill = usage.input + usage.output + usage.cacheRead + usage.cacheWrite > 0 || usage.cost.total > 0
   678	        if (couldBill) run.usageWriteFailed = true
   679	        throw error
   680	      }
   681	    },
   682	      'recordUsage failed',
   683	    )
   684	  }
   685	
   686	  /** Build a run synchronously (no await) so it can be registered before the
   687	   * reserve sink call, closing the concurrent-duplicate race. */
   688	  private createRun(input: ReservePromptInput, kind: MeteringRunKind, runId: string): MeteringRun {
   689	    return {
   690	      scope: {
   691	        workspaceId: input.workspaceId,
   692	        userId: input.userId,
   693	        userEmail: input.userEmail,
   694	        userEmailVerified: input.userEmailVerified,
   695	        sessionId: input.sessionId,
   696	        runId,
   697	        source: 'pi-chat',
   698	      },
   699	      kind,
   700	      reservationId: undefined,
   701	      instanceId: (this.runInstances += 1),
   702	      usageCount: 0,
   703	      billableUsageCount: 0,
   704	      recordedMessageIds: new Set(),
   705	      lastIdlessUsageKey: undefined,
   706	      usageWriteFailed: false,
   707	      userStopped: false,
   708	      reservation: Promise.resolve(),
   709	      terminal: false,
   710	      ops: Promise.resolve(),
   711	    }
   712	  }
   713	
   714	  /** Acquire the host reservation; throws (fail closed) on a rejecting sink. */
   715	  private async applyReservation(run: MeteringRun, input: ReservePromptInput): Promise<void> {
   716	    const result = await this.sink.reserveRun({
   717	      ...run.scope,
   718	      kind: run.kind,
   719	      message: input.message,
   720	      model: input.model,
   721	    })
   722	    run.reservationId = result?.reservationId
   723	  }
   724	
   725	  /** Remove a still-reserving run whose reservation failed, from either list. */
   726	  private removeReservingRun(state: SessionMeteringState, run: MeteringRun, sessionId: string): void {
   727	    const pendingIndex = state.pendingPrompts.indexOf(run)
   728	    if (pendingIndex >= 0) state.pendingPrompts.splice(pendingIndex, 1)
   729	    const queuedIndex = state.queued.indexOf(run)
   730	    if (queuedIndex >= 0) state.queued.splice(queuedIndex, 1)
   731	    this.pruneSession(sessionId, state)
   732	  }
   733	
   734	  private findRun(state: SessionMeteringState, runId: string): MeteringRun | undefined {
   735	    if (state.active && !state.active.terminal && state.active.scope.runId === runId) return state.active
   736	    const pending = state.pendingPrompts.find((run) => run.scope.runId === runId)
   737	    if (pending) return pending
   738	    return state.queued.find((run) => run.scope.runId === runId)
   739	  }
   740	
   741	  private finishRun(run: MeteringRun, status: MeteringRunStatus): void {
   742	    if (run.terminal) return
   743	    run.terminal = true
   744	    // Decide settle vs fallback-charge vs free-release INSIDE the op so it observes
   745	    // every usage write queued ahead of it on the chain (billableUsageCount and
   746	    // usageWriteFailed are then final).
   747	    this.enqueue(run, () => {
   748	      // A usage write was ATTEMPTED but FAILED → there's no ledger row, so settling
   749	      // would close a paid hold for free. Charge the fallback hold (real tokens,
   750	      // lost). Highest precedence: this run did paid work we couldn't persist.
   751	      if (run.usageWriteFailed) {
   752	        return this.sink.releaseRun({ ...run.scope, reservationId: run.reservationId, reason: 'usage-write-failed' })
   753	      }
   754	      // Real debits were written for this attempt → settle the hold against them,
   755	      // INCLUDING an errored run that produced billable usage. Pi reports a failed
   756	      // call's usage on agent_end (harvestAgentEndUsage captures it), so a started
   757	      // error's provider work is reflected in billableUsageCount — settling at the
   758	      // captured usage is correct. We deliberately do NOT top a billed errored run up
   759	      // to the full hold: that would over-charge the common cases (a local tool crash
   760	      // with no extra provider cost, or an error whose usage was already harvested)
   761	      // up to the worst-case reservation. The residual undercharge — a provider that
   762	      // billed for a failed call whose usage Pi never reported at all — is a narrow,
   763	      // accepted limitation, the symmetric cost of not over-charging errored runs.
   764	      if (run.billableUsageCount > 0) {
   765	        return this.sink.settleRun({ ...run.scope, reservationId: run.reservationId, status })
   766	      }
   767	      // No billable usage written and no failed write. Charge the fallback hold ONLY
   768	      // for a SUCCESSFUL run that reported no/zero usage: a normal completion produces
   769	      // a usage row, so its absence suggests a reporting gap (uncaptured paid work) —
   770	      // don't return a paid hold free. An ERROR with no billable usage is FREED: Pi
   771	      // harvests a failed provider call's usage onto agent_end (so real paid work shows
   772	      // as billable usage above), which means a no-usage error is most likely
   773	      // non-billable — a pre-provider/config/auth failure (e.g. missing API key) that
   774	      // did no provider work. Charging the full worst-case hold for those would grossly
   775	      // over-charge a failed run that consumed nothing. (Residual: a provider that
   776	      // billed for a failed call whose usage Pi never reported at all goes free — a
   777	      // narrow under-charge, the symmetric cost of not over-charging config failures.)
   778	      // A VOLUNTARY user stop is never charged the fallback hold: the user cancelled
   779	      // before any billable usage, so the worst-case hold must be released, not billed.
   780	      // This holds even if pi reports the aborted run as a no-usage success (status
   781	      // 'ok') instead of 'aborted' — the explicit stop signal is authoritative.
   782	      const didPaidWork = status === 'ok' && !run.userStopped
   783	      if (didPaidWork) {
   784	        return this.sink.releaseRun({ ...run.scope, reservationId: run.reservationId, reason: 'fallback-hold-charge' })
   785	      }
   786	      return this.sink.releaseRun({
   787	        ...run.scope,
   788	        reservationId: run.reservationId,
   789	        reason: status === 'error' ? 'error-before-usage' : 'cancelled',
   790	      })
   791	    },
   792	      'finishRun failed',
   793	    )
   794	  }
   795	
   796	  private release(run: MeteringRun, reason: MeteringReleaseReason): void {
   797	    if (run.terminal) return
   798	    run.terminal = true
   799	    this.enqueue(run, () =>
   800	      this.sink.releaseRun({ ...run.scope, reservationId: run.reservationId, reason }),
   801	      'releaseRun failed',
   802	    )
   803	  }
   804	
   805	  private enqueue(run: MeteringRun, op: () => Promise<void>, failureMessage: string): void {
   806	    const chained = run.ops.then(op).catch((error) => {
   807	      this.logError(`${failureMessage} (run ${run.scope.runId})`, error)
   808	    })
   809	    run.ops = chained
   810	    this.inflightOps.add(chained)
   811	    void chained.finally(() => this.inflightOps.delete(chained))
   812	  }
   813	
   814	  private sessionState(sessionId: string): SessionMeteringState {
   815	    let state = this.sessions.get(sessionId)
   816	    if (!state) {
