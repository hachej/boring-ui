   326	export function deriveSourcePlugin(sourceInfo: SlashCommandInfo["sourceInfo"] | undefined): string | undefined {
   327	  if (!sourceInfo) return undefined;
   328	  const path = typeof sourceInfo.path === "string" ? sourceInfo.path : "";
   329	  const source = typeof sourceInfo.source === "string" ? sourceInfo.source : "";
   330	  // Boring runtime plugin: .pi/extensions/<name>/...
   331	  const runtimePlugin = path.match(/[/\\]\.pi[/\\]extensions[/\\]([^/\\]+)/);
   332	  if (runtimePlugin) return runtimePlugin[1];
   333	  // Provisioned plugin skill: .boring-agent/skills/<plugin>/<skill>/SKILL.md
   334	  const provisionedSkill = path.match(/[/\\]\.boring-agent[/\\]skills[/\\]([^/\\]+)/);
   335	  if (provisionedSkill) return provisionedSkill[1];
   336	  // npm package source: "npm:<pkg>"
   337	  if (source.startsWith("npm:")) return source.slice(4) || undefined;
   338	  // git source: "git/<host>/<owner>/<repo>" -> repo
   339	  if (source.startsWith("git/")) return source.split("/").filter(Boolean).pop();
   340	  // User-global single-file extension: .../extensions/<file>.ts
   341	  const fileExtension = path.match(/[/\\]extensions[/\\]([^/\\]+)\.[cm]?[tj]sx?$/);
   342	  if (fileExtension) return fileExtension[1];
   343	  return undefined;
   344	}
