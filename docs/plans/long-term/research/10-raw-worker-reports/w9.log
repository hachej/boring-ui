   371	  const originalFollowUp = agent.followUp;
   372	  const wrappedFollowUp = function (this: PiAgentWithFollowUp, message: unknown) {
   373	    const ctx = getRunContext();
   374	    if (ctx && message && typeof message === "object") state.queuedFollowUpContexts.set(message, ctx);
   375	    return originalFollowUp.call(this, message);
   376	  };
   377	  agent.followUp = wrappedFollowUp;
   378	  return () => {
   379	    if (agent.followUp === wrappedFollowUp) agent.followUp = originalFollowUp;
   380	  };
