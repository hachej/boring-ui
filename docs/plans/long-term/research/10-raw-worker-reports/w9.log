   991	  /** Cheap cold-snapshot seq lookup (no buffer hydration) — see {@link hydrateDurableReplayBuffer} for the live-channel path. */
   992	  private async readDurableLatestPiChatSeq(streamPath: string): Promise<number> {
   993	    if (!this.eventStore) return 0
   994	    const meta = await this.eventStore.getStreamMeta(streamPath)
   995	    if (!meta) return 0
   996	    const tailIndex = parseOffset(meta.nextOffset)
   997	    if (tailIndex < 0) return 0
   998	    const tail = await this.eventStore.readEvents(streamPath, {
   999	      offset: formatOffset(tailIndex - 1),
  1000	      limit: 1,
  1001	    })
  1002	    const envelope = tail.events[0]?.data as Partial<AgentEvent> | undefined
  1003	    const seq = envelope?.chunk?.seq
  1004	    return typeof seq === 'number' && Number.isInteger(seq) && seq >= 0 ? seq : tailIndex + 1
  1005	  }
  1006	
  1007	  /**
  1008	   * On cold channel construction, rehydrate a fresh {@link PiChatReplayBuffer}
  1009	   * from the durable event store (when present) so resuming clients replay
  1010	   * genuinely — not merely resume seq counting from a high-water-mark with an
  1011	   * empty buffer, which forces every behind-the-tip cursor into
  1012	   * `PI_CHAT_REPLAY_GAP`. Reads at most the buffer's own retention window
  1013	   * (`DEFAULT_REPLAY_BUFFER_MAX_EVENTS`) worth of trailing entries — older
  1014	   * history is already outside what the in-memory buffer would retain even
  1015	   * across a live process, so this preserves prior semantics for very long
  1016	   * streams while fixing the common "just restarted" resume case.
  1017	   */
  1018	  private async hydrateDurableReplayBuffer(streamPath: string): Promise<PiChatReplayBuffer> {
  1019	    if (!this.eventStore) return new PiChatReplayBuffer()
  1020	    const meta = await this.eventStore.getStreamMeta(streamPath)
  1021	    if (!meta) return new PiChatReplayBuffer()
  1022	    // Despite the field's name, `meta.nextOffset` is already the LAST
  1023	    // entry's own seq (see SqliteEventStreamStore#getStreamMetaSync:
  1024	    // `formatOffset(next_offset - 1)`), not one-past-the-end. `readEvents`'s
  1025	    // `offset` is an exclusive lower bound (returns seq > offset), so the
  1026	    // window [tailSeq - hydrationLimit, tailSeq] with that exclusive bound
  1027	    // yields exactly `hydrationLimit` entries — verified by
  1028	    // `hydrates exactly hydrationLimit trailing envelopes at the window
  1029	    // boundary, no off-by-one` below. Do not "correct" this to
  1030	    // `tailIndex - hydrationLimit + 1`: that shifts the exclusive bound one
  1031	    // seq forward and drops the oldest entry in the window instead.
  1032	    const tailIndex = parseOffset(meta.nextOffset)
  1033	    if (tailIndex < 0) return new PiChatReplayBuffer()
  1034	
  1035	    const hydrationLimit = Math.min(DEFAULT_REPLAY_BUFFER_MAX_EVENTS, MAX_READ_LIMIT)
  1036	    const windowStart = Math.max(-1, tailIndex - hydrationLimit)
  1037	    const page = await this.eventStore.readEvents(streamPath, {
  1038	      offset: formatOffset(windowStart),
  1039	      limit: hydrationLimit,
  1040	    })
  1041	    const chunks = page.events
  1042	      .map((event) => (event.data as Partial<AgentEvent> | undefined)?.chunk)
  1043	      .filter((chunk): chunk is PiChatEvent => Boolean(chunk) && typeof chunk?.seq === 'number')
  1044	
  1045	    const buffer = new PiChatReplayBuffer()
  1046	    let lastSeq = -1
  1047	    for (const chunk of chunks) {
  1048	      // Defensive: a durable stream must yield strictly increasing seq. If it
  1049	      // doesn't (corrupt/foreign data), stop hydrating rather than throw —
  1050	      // the caller still gets a working buffer, just without full replay.
  1051	      if (chunk.seq <= lastSeq) break
  1052	      buffer.publish(chunk)
  1053	      lastSeq = chunk.seq
  1054	    }
  1055	
  1056	    if (buffer.latestSeq > 0) return buffer
  1057	
  1058	    // No usable chunks were hydrated (e.g. legacy/foreign envelopes without a
  1059	    // `chunk.seq`, per the pre-existing `seeds restart PiChatEvent seq from
  1060	    // the durable tail chunk instead of eventIndex` contract). Fall back to
  1061	    // seq-only continuity from the raw tail envelope so numbering still
  1062	    // advances monotonically, even though replay for behind-the-tip cursors
  1063	    // will report a gap in that legacy-data case.
  1064	    const tail = page.events.at(-1)
  1065	    const envelope = tail?.data as Partial<AgentEvent> | undefined
  1066	    const seq = envelope?.chunk?.seq
  1067	    const fallbackSeq = typeof seq === 'number' && Number.isInteger(seq) && seq >= 0 ? seq : tailIndex + 1
  1068	    return fallbackSeq > 0 ? new PiChatReplayBuffer({ initialLatestSeq: fallbackSeq }) : buffer
  1069	  }
