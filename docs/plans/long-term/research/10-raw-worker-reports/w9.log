   308	  private async retryBusy<T>(operation: () => T): Promise<T> {
   309	    const deadline = Date.now() + SQLITE_BUSY_RETRY_WINDOW_MS
   310	    let backoffMs = SQLITE_BUSY_BACKOFF_START_MS
