   287	            // already-rendered live events. The transcript snapshot includes
   288	            // those turns, so its cursor must fence their in-memory replay.
   289	            seq: Math.max(persisted.seq, liveSeq),
   290	          }),
   291	        )
   292	      }
   293	    }
   294	
   295	    const snapshot = this.messageMetadata.enrichSnapshot(sessionKey, buildPiChatSnapshot(adapter, {
   296	      seq: channel?.buffer.latestSeq ?? 0,
   297	      sessionId,
   298	      activeTurnId: channel?.activeTurnId,
   299	      messageTurnIds: channel?.messageTurnIds,
   300	      attachmentUrl: this.attachmentUrlFor(sessionId),
   301	    }))
   302	    return this.enrichSyntheticPromptFailures(sessionKey, snapshot)
   303	  }
   304	
   305	  /**
   306	   * The persisted transcript can lag the live adapter: transcript writes are
   307	   * asynchronous, and some harnesses never persist transcripts at all. A
   308	   * persisted refresh whose seq fences the live replay buffer while its
   309	   * messages are missing would permanently hide those turns from a hydrating
   310	   * client (it starts "caught up" at that seq with an empty timeline), so
   311	   * refresh from persisted state only when it carries at least as much
   312	   * rendered history as the live adapter.
   313	   */
   314	  private persistedStateDropsLiveMessages(
   315	    persisted: PiChatSnapshot,
   316	    adapter: PiAgentSessionAdapter,
   317	    sessionId: string,
   318	  ): boolean {
   319	    const liveCount = buildPiChatHistory(adapter.readSnapshot().messages, { sessionId }).length
   320	    return persisted.messages.length < liveCount
   321	  }
   322	
   323	  private canRefreshFromPersistedState(sessionKey: string, adapter: PiAgentSessionAdapter): boolean {
   324	    if (this.activePromptRuns.has(sessionKey)) return false
   325	    const snapshot = adapter.readSnapshot()
   326	    return !snapshot.isStreaming
   327	      && !snapshot.isRetrying
   328	      && snapshot.pendingMessageCount === 0
   329	      && snapshot.steeringMessages.length === 0
   330	      && snapshot.followUpMessages.length === 0
   331	  }
   332	
   333	  private harnessMayHaveLiveSession(ctx: PiSessionRequestContext, sessionId: string): boolean {
   334	    return typeof this.harness.hasPiSession === 'function'
   335	      ? this.harness.hasPiSession(sessionId, toSessionCtx(ctx))
   336	      : true
   337	  }
   338	
   339	  private attachmentUrlFor(sessionId: string) {
   340	    return ({ messageId, index, data, mediaType, filename }: {
   341	      messageId: string
   342	      index: number
   343	      data?: string
   344	      mediaType?: string
   345	      filename?: string
   346	    }) => {
   347	      const bytes = attachmentBytes(data)
   348	      if (bytes) {
   349	        this.liveAttachments.set(liveAttachmentKey(sessionId, messageId, index), {
   350	          data: bytes,
   351	          mediaType: mediaType ?? 'application/octet-stream',
   352	          ...(filename ? { filename } : {}),
   353	        })
   354	      }
   355	      return this.attachmentUrl?.({
   356	      sessionId,
   357	      messageId,
   358	      index,
   359	        ...(data ? { data } : {}),
   360	        ...(mediaType ? { mediaType } : {}),
   361	        ...(filename ? { filename } : {}),
   362	      }) ?? `/api/v1/agents/default/sessions/${encodeURIComponent(sessionId)}/attachments/${encodeURIComponent(messageId)}/${index}`
   363	    }
   364	  }
   365	
   366	  private async readPersistedState(ctx: PiSessionRequestContext, sessionId: string): Promise<PiChatSnapshot | null> {
   367	    if (!this.sessionStore.loadEntries) return null
   368	    try {
   369	      const { id, messages } = await this.sessionStore.loadEntries(toSessionCtx(ctx), sessionId)
   370	      return {
   371	        protocolVersion: 1,
   372	        sessionId: id,
   373	        seq: await this.readDurableLatestPiChatSeq(sessionStreamPath(this.sessionKey(ctx, id))),
   374	        status: 'idle',
   375	        messages: buildPiChatHistory(messages, {
   376	          sessionId: id,
   377	          attachmentUrl: this.attachmentUrlFor(id),
   378	        }),
   379	        queue: { followUps: [] },
   380	        followUpMode: 'one-at-a-time',
   381	      }
   382	    } catch {
   383	      return null
   384	    }
   385	  }
