   876	  private async getChannel(ctx: PiSessionRequestContext, sessionId: string): Promise<LiveSessionChannel> {
   877	    const sessionKey = this.sessionKey(ctx, sessionId)
   878	    // Pin the incarnation before authorization: the entire cold open belongs
   879	    // to the session generation that existed when the caller arrived.
   880	    const generation = this.generationOf(sessionKey)
   881	    await this.assertCanAccessSession(ctx, sessionId)
   882	    const existing = this.channels.get(sessionKey)
   883	    if (existing) return existing
   884	    return this.createChannelOnce(sessionKey, sessionId, generation, () => this.getAdapter(ctx, sessionId, '', { authorize: false }))
   885	  }
   886	
   887	  private async ensureChannel(ctx: PiSessionRequestContext, sessionId: string, adapter: PiAgentSessionAdapter): Promise<LiveSessionChannel> {
   888	    const sessionKey = this.sessionKey(ctx, sessionId)
   889	    const generation = this.generationOf(sessionKey)
   890	    const existing = this.channels.get(sessionKey)
   891	    if (existing) return existing
   892	    return this.createChannelOnce(sessionKey, sessionId, generation, async () => adapter)
   893	  }
