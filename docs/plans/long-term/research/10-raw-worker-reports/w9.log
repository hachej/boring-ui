   936	  private async buildChannel(
   937	    sessionKey: string,
   938	    sessionId: string,
   939	    adapter: PiAgentSessionAdapter,
   940	    generation: number,
   941	  ): Promise<LiveSessionChannel> {
   942	    const existing = this.channels.get(sessionKey)
   943	    if (existing) return existing
   944	    const streamPath = sessionStreamPath(sessionKey)
   945	    let buffer: PiChatReplayBuffer
   946	    try {
   947	      await this.eventStore?.createStream(streamPath)
   948	      buffer = await this.hydrateDurableReplayBuffer(streamPath)
   949	    } catch (error) {
   950	      if (this.lifecycle.isClosing) await this.lifecycle.rejectLateAdapter(adapter, error)
   951	      throw error
   952	    }
   953	    await this.lifecycle.assertAdapterOwned(adapter)
   954	    // Durable stream setup is another await window deletion can cross.
   955	    await this.assertSessionIncarnation(sessionKey, generation, adapter)
   956	    const mapper = new PiChatEventMapper({
   957	      sessionId,
   958	      initialSeq: buffer.latestSeq,
   959	      attachmentUrl: this.attachmentUrlFor(sessionId),
   960	    })
   961	    const closed = deferred<void>()
   962	    closed.promise.catch(() => {})
   963	    const channel: LiveSessionChannel = {
   964	      sessionKey,
   965	      streamPath,
   966	      buffer,
   967	      adapter,
   968	      unsubscribe: () => {},
   969	      mapper,
   970	      publishQueue: Promise.resolve(),
   971	      closed: closed.promise,
   972	      resolveClosed: () => closed.resolve(),
   973	      rejectClosed: closed.reject,
   974	      messageTurnIds: new Map(),
   975	    }
   976	    const unsubscribe = adapter.subscribe((event) => {
   977	      const mappedEvents = mapper.map(event)
   978	      // Metering observes the ENRICHED events: in production the native Pi
   979	      // message for a consumed follow-up carries no clientNonce/clientSeq —
   980	      // those selectors are recovered here by enrichEvent, and the metering
   981	      // coordinator needs them to attribute the follow-up's usage correctly.
   982	      this.publishChannelEvents(sessionId, channel, mappedEvents, (enrichedEvents) => {
   983	        this.metering?.observe(sessionKey, event, enrichedEvents)
   984	      })
   985	    })
   986	    channel.unsubscribe = unsubscribe
   987	    this.channels.set(sessionKey, channel)
   988	    return channel
   989	  }
