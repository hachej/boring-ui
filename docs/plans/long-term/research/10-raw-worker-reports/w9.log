   312	    while (true) {
   313	      try {
   314	        return operation()
   315	      } catch (error) {
   316	        if (!isSqliteBusy(error)) throw error
   317	        const remainingMs = deadline - Date.now()
   318	        if (remainingMs <= 0) throw error
   319	        await delay(Math.min(backoffMs, remainingMs))
   320	        backoffMs = Math.min(backoffMs * 2, SQLITE_BUSY_BACKOFF_MAX_MS)
   321	      }
   322	    }
   323	  }
   324	
   325	  private appendSerializedEvent(path: string, data: string | undefined): string {
   326	    const seq = this.allocateSeq(path)
   327	    this.sql.exec(
   328	      `INSERT INTO boring_event_stream_entries (path, seq, data) VALUES (?, ?, ?)`,
   329	      path,
   330	      seq,
   331	      data,
   332	    )
