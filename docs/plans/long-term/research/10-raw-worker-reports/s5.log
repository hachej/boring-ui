+import { DatabaseSync } from "node:sqlite";
+import { createLegacyEventFixture, decodeEventPath, planEventPromotion } from "./event-store-migration.ts";
+
+const db = new DatabaseSync(":memory:");
+createLegacyEventFixture(db);
+const paths = (db.prepare("SELECT path FROM boring_event_streams ORDER BY path").all() as Array<{ path: string }>).map((row) => row.path);
+const results = paths.map((path) => {
+  const decoded = decodeEventPath(path);
+  try {
+    return { path, decoded, promotion: planEventPromotion(db, path) };
+  } catch (error) {
+    return { path, decoded, error: (error as Error).message };
+  }
+});
