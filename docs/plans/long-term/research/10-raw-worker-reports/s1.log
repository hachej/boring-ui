+++ b/spike-l0-schema/test/v5-tenancy.test.ts
@@ -0,0 +1,28 @@
+import { describe, expect, it } from 'vitest';
+import { admitOne, claimOne, databasePath, openStore, seedSession } from './helpers.js';
+
+describe('V5 A6 Tenancy', () => {
+  it('FATAL a forgotten tenant predicate cannot return another tenant row through the adapter', () => {
+    const path = databasePath();
+    const alice = openStore(path, 'alice', 'shared'); const bob = openStore(path, 'bob', 'shared');
+    for (const store of [alice, bob]) { seedSession(store); admitOne(store); claimOne(store); }
+    alice.appendBatch({ sessionId: 'session-1', submissionId: 'submission-1', attemptId: 'attempt-1',
+      producerId: 'worker-a', producerEpoch: 7, producerSequence: 0, contentDigest: 'alice-batch', now: 1_050,
+      records: [{ recordId: 'same-record-id', kind: 'message', payload: { owner: 'alice' } }] });
+    bob.appendBatch({ sessionId: 'session-1', submissionId: 'submission-1', attemptId: 'attempt-1',
+      producerId: 'worker-a', producerEpoch: 7, producerSequence: 0, contentDigest: 'bob-batch', now: 1_050,
+      records: [{ recordId: 'same-record-id', kind: 'message', payload: { owner: 'bob' } }] });
+    expect(alice.getRecord('same-record-id')?.payload).toEqual({ owner: 'alice' });
+    expect(bob.getRecord('same-record-id')?.payload).toEqual({ owner: 'bob' });
+    alice.close(); bob.close();
+  });
+
+  it('SQLite raw-SQL escape hatch is absent from the public adapter API', () => {
+    const store = openStore(databasePath());
+    expect(Object.getOwnPropertyNames(Object.getPrototypeOf(store))).not.toEqual(
+      expect.arrayContaining(['db', 'database', 'exec', 'prepare', 'query', 'raw']),
+    );
+    expect(Object.keys(store)).toEqual([]);
+    store.close();
+  });
+});

