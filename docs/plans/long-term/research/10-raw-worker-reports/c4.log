   502	function params<T>(schema: z.ZodType<T>, request: FastifyRequest, reply: FastifyReply): T | undefined {
   503	  const parsed = schema.safeParse(request.params)
   504	  if (parsed.success) return parsed.data
   505	  reply.code(400).send({
   506	    error: {
   507	      code: AgentGatewayErrorCode.AGENT_COMMAND_INVALID_STATE,
   508	      message: parsed.error.issues[0]?.message ?? 'invalid params',
   509	    },
   510	  })
   511	  return undefined
   512	}
   513	
   514	function body<T>(schema: z.ZodType<T>, request: FastifyRequest, reply: FastifyReply): T | undefined {
   515	  const parsed = schema.safeParse(request.body)
   516	  if (parsed.success) return parsed.data
   517	  reply.code(400).send({
   518	    error: {
   519	      code: AgentGatewayErrorCode.AGENT_COMMAND_INVALID_STATE,
   520	      message: parsed.error.issues[0]?.message ?? 'invalid body',
   521	    },
   522	  })
   523	  return undefined
   524	}
   525	
   526	function statusFor(error: AgentGatewayError): number {
   527	  if (error.code === AgentGatewayErrorCode.AGENT_SCOPE_DENIED) return 403
   528	  if (
   529	    error.code === AgentGatewayErrorCode.AGENT_TYPE_UNKNOWN
   530	    || error.code === AgentGatewayErrorCode.AGENT_SESSION_NOT_FOUND
   531	  ) return 404
   532	  if (
   533	    error.code === AgentGatewayErrorCode.AGENT_REQUEST_CONFLICT
   534	    || error.code === AgentGatewayErrorCode.AGENT_REQUEST_IN_PROGRESS
   535	    || error.code === AgentGatewayErrorCode.AGENT_REQUEST_OUTCOME_UNKNOWN
   536	    || error.code === AgentGatewayErrorCode.AGENT_RUNTIME_RESTART_REQUIRED
   537	    || error.code === AgentGatewayErrorCode.AGENT_COMMAND_INVALID_STATE
   538	    || error.code === AgentGatewayErrorCode.AGENT_SESSION_RUNTIME_SCOPE_MISMATCH
   539	  ) return 409
   540	  if (error.code === AgentGatewayErrorCode.AGENT_GATEWAY_CLOSED) return 503
   541	  return 400
   542	}
   543	
   544	function sendError(reply: FastifyReply, error: unknown): FastifyReply {
   545	  if (error instanceof AgentGatewayError) {
   546	    return reply.code(statusFor(error)).send({ error: error.toJSON() })
   547	  }
   548	  const stable = projectStableServiceError(error)
   549	  if (stable) {
   550	    return reply.code(stable.statusCode).send({ error: stable.error })
   551	  }
   552	  throw error
   553	}
