   555	function wildcardMatch(pattern: string, value: string): boolean {
   556	  if (!pattern.includes("*")) return pattern === value
   557	  const escaped = pattern.replace(/[.+?^${}()|[\]\\]/g, "\\$&").replace(/\*/g, ".*")
   558	  return new RegExp(`^${escaped}$`, "i").test(value)
   559	}
