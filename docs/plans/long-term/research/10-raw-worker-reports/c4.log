   134	function readInfomaniakBaseUrl(): string | undefined {
   135	  const explicit = clean(getEnv('BORING_AGENT_INFOMANIAK_BASE_URL'))
   136	  if (explicit) return explicit
   137	
   138	  const productId = clean(getEnv('BORING_AGENT_INFOMANIAK_PRODUCT_ID'))
   139	  if (!productId) return undefined
   140	  return `${INFOMANIAK_API_BASE}/2/ai/${productId}/openai/v1`
   141	}
   142	
   143	function readInfomaniakModelIds(): string[] {
   144	  const configured = clean(getEnv('BORING_AGENT_INFOMANIAK_MODELS'))
   145	    ?.split(',')
   146	    .map((part) => part.trim())
   147	    .filter(Boolean)
   148	  const ids = configured?.length ? configured : [...DEFAULT_INFOMANIAK_MODELS]
   149	  const legacyModel = clean(getEnv('BORING_AGENT_INFOMANIAK_MODEL'))
   150	  if (legacyModel && !ids.includes(legacyModel)) ids.push(legacyModel)
   151	  return Array.from(new Set(ids))
   152	}
