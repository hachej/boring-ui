    66	 * underlying store's `config` field is optional/nullable in practice (older
    67	 * rows, other writers, or a bad migration can leave it `null`/`undefined`).
    68	 * A single such row must not crash `listGrants` for the whole workspace —
    69	 * that would be a self-DoS on the authority path (every Agent in the
    70	 * workspace loses every grant because of one bad row). Skip malformed rows
    71	 * with a stable diagnostic instead of throwing.
    72	 */
    73	function toGrant(resource: WorkspaceRuntimeResourceLike): { grant: McpGrant } | { diagnostic: McpGrantDiagnostic } {
    74	  const config = resource.config as Record<string, unknown> | null | undefined
    75	  if (!config || typeof config !== 'object' || !Array.isArray(config.allowedTools)) {
    76	    return {
    77	      diagnostic: {
    78	        code: ErrorCode.enum.AGENT_MCP_GRANT_RECORD_MALFORMED,
    79	        connectorId: resource.provider,
    80	        message: `MCP grant record for connector '${resource.provider}' (agentTypeId '${resource.purpose}') has a missing or malformed config and was skipped.`,
    81	      },
    82	    }
    83	  }
    84	  const allowedTools = config.allowedTools.filter((tool): tool is string => typeof tool === 'string')
