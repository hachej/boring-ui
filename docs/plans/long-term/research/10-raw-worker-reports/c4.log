   117	        kind: MCP_GRANT_RESOURCE_KIND,
   118	        purpose: grant.agentTypeId,
   119	        provider: grant.connectorId,
   120	        handleKind: 'mcp-grant',
   121	        state: 'active',
   122	        persistenceMode: 'durable',
   123	        config: { allowedTools: [...grant.allowedTools] },
   124	      })
   125	    },
