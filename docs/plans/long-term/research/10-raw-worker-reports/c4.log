   152	/** Builds the Host-owned runtime capability adapter without acquiring bindings during route registration. */
   153	export function createAgentHostRuntimeCapabilityProjection(input: {
   154	  readonly runtime: AgentHostRuntime
   155	  readonly gateway: EmbeddedAgentGateway
   156	  readonly options: Pick<
   157	    AgentHostDirectProjectionOptions,
   158	    'authorizeAgentRequest' | 'defaultSessionId' | 'filterModels' | 'sessionChangesTracker'
   159	  >
   160	  readonly mcpGrants?: AgentHostRuntimeCapabilityMcpGrantsOptions
   161	}): AgentHostRuntimeCapabilityProjection {
   162	  const { runtime, gateway, options, mcpGrants } = input
   163	  const authorized = new WeakMap<FastifyRequest, Promise<{
   164	    scope: import('../../shared/index').AuthorizedAgentScope
   165	    claim: import('../../shared/index').VerifiedAgentScopeClaim
   166	  }>>()
   167	  const authorize = (request: FastifyRequest) => {
   168	    let result = authorized.get(request)
   169	    if (!result) {
   170	      result = (async () => {
   171	        const scope = await options.authorizeAgentRequest(request)
   172	        const claim = await runtime.verify(scope)
   173	        return { scope, claim }
   174	      })()
   175	      authorized.set(request, result)
   176	    }
   177	    return result
   178	  }
   179	  /**
   180	   * The per-agent authorization decision, shared by every per-agent route.
   181	   * `runtime.resolveAgentRuntimeScope` invokes the host's
   182	   * `resolveAuthorizedAgentRuntimeScope` hook, which is the ONLY seam where a
   183	   * host can deny THIS subject access to THIS agentTypeId — workspace-scope
   184	   * authorization alone does not answer that question. Read-only projections
   185	   * stop here; routes that actually drive the harness continue into
   186	   * `resolveBinding`.
   187	   */
   188	  const authorizeAgentAccess = async (request: FastifyRequest, agentTypeId: string) => {
   189	    const { scope, claim } = await authorize(request)
   190	    const resolved = await runtime.resolveAgentRuntimeScope(
   191	      agentTypeId,
   192	      scope,
   193	      claim,
   194	      'new-binding',
   195	      request.id,
   196	    )
   197	    return { scope, claim, resolved }
   198	  }
   199	  const resolve = async (request: FastifyRequest, agentTypeId: string, sessionId?: string) => {
   200	    if (sessionId) {
   201	      const { scope } = await authorize(request)
   202	      const pinned = await gateway.resolveHostSessionBinding(scope, { agentTypeId, sessionId })
   203	      return { scope, claim: pinned.claim, binding: pinned.binding }
   204	    }
   205	    const { scope, claim, resolved } = await authorizeAgentAccess(request, agentTypeId)
   206	    const binding = await runtime.resolveBinding(agentTypeId, scope, claim, resolved)
   207	    return { scope, claim, binding }
   208	  }
   209	  return {
   210	    filterModels: options.filterModels,
   211	    sessionChangesTracker: options.sessionChangesTracker,
   212	    metering: runtime.options.metering,
   213	    registerSubscription: runtime.registerSubscription,
   214	    async authorizeRequest({ request, agentTypeId }) {
   215	      await authorize(request)
   216	      if (!runtime.compiledById.has(agentTypeId)) {
   217	        throw new AgentGatewayError(AgentGatewayErrorCode.AGENT_TYPE_UNKNOWN, 'agent type is not available')
   218	      }
   219	    },
   220	    async resolveBinding({ request, agentTypeId, sessionId }) {
   221	      const { claim, binding } = await resolve(request, agentTypeId, sessionId)
   222	      // Start the (host-implemented, effectively synchronous) skill-resource
   223	      // read and immediately read hot-reloadable pi resources in the same
   224	      // synchronous tick — no `await` sits between the two calls, so a
   225	      // concurrent reload cannot swap the host's registry generation in
   226	      // between them (Option A: one immutable snapshot per read). Awaiting
   227	      // afterwards only unwraps a promise that has already settled.
   228	      const skillResourceSnapshotPromise = binding.scope.getSkillResourceSnapshot?.({
   229	        scope: claim,
   230	        sessionId,
   231	        requestId: request.id,
   232	      })
   233	      const hotResources = binding.scope.pi?.getHotReloadableResources?.()
   234	      const skillResourceSnapshot = await skillResourceSnapshotPromise
   235	      const pi = hotResources
   236	        ? {
   237	            ...binding.scope.pi,
   238	            additionalSkillPaths: [
   239	              ...(binding.scope.pi?.additionalSkillPaths ?? []),
   240	              ...(hotResources.additionalSkillPaths ?? []),
   241	            ],
   242	            packages: [
   243	              ...(binding.scope.pi?.packages ?? []),
   244	              ...(hotResources.packages ?? []),
   245	            ],
   246	            extensionPaths: [
   247	              ...(binding.scope.pi?.extensionPaths ?? []),
   248	              ...(hotResources.extensionPaths ?? []),
   249	            ],
   250	          }
   251	        : binding.scope.pi
   252	      const user = (request as typeof request & {
   253	        user?: { id?: unknown; email?: unknown; emailVerified?: unknown } | null
   254	      }).user
   255	      let resolvedMcpGrants: readonly ResolvedMcpConnectorGrant[] | undefined
   256	      let mcpGrantDiagnostics: readonly McpGrantDiagnostic[] | undefined
   257	      if (mcpGrants) {
   258	        const refs = mcpGrants.getMcpServerRefs(agentTypeId) ?? []
   259	        const listed = refs.length > 0
   260	          ? await mcpGrants.store.listGrants(claim.workspaceScopeId)
   261	          : { grants: [], diagnostics: [] }
   262	        const resolved = resolveAgentMcpGrants({
   263	          workspaceId: claim.workspaceScopeId,
   264	          agentTypeId,
   265	          mcpServerRefs: refs,
   266	          grants: listed.grants,
   267	          catalog: mcpGrants.catalog,
   268	        })
   269	        resolvedMcpGrants = resolved.connectors
   270	        mcpGrantDiagnostics = [...listed.diagnostics, ...resolved.diagnostics]
   271	      }
   272	      return {
   273	        harness: binding.composition.harness,
   274	        tools: binding.composition.tools,
   275	        mcpGrants: resolvedMcpGrants,
   276	        mcpGrantDiagnostics,
   277	        workspace: binding.composition.runtimeBundle.workspace,
   278	        readyTracker: binding.composition.readyTracker,
   279	        pi,
   280	        additionalSkillPaths: binding.environmentLease.provisioning?.skillPaths,
   281	        skillResourceSnapshot,
   282	        runContext: {
   283	          abortSignal: new AbortController().signal,
   284	          workdir: binding.composition.runtimeBundle.workspace.root,
   285	          workspaceId: claim.workspaceScopeId,
   286	          requestId: request.id,
   287	          userId: claim.authSubjectId,
   288	          sessionCtx: {
   289	            workspaceId: claim.workspaceScopeId,
   290	            runtimeScopeIdentity: binding.scope.identity,
   291	          },
   292	          ...(typeof user?.email === 'string' && user.email.trim()
   293	            ? { userEmail: user.email.trim() }
   294	            : {}),
   295	          userEmailVerified: user?.emailVerified === true,
   296	        },
   297	      }
   298	    },
   299	    async describeAgent({ request, agentTypeId }) {
   300	      // Authorize BEFORE looking the agent up, matching `resolve()` and every
   301	      // sibling route. Checking existence first turns an unauthorized request
   302	      // into an agent-existence oracle: unknown vs denied are distinguishable
   303	      // without any right to ask.
   304	      const { claim } = await authorizeAgentAccess(request, agentTypeId)
   305	      const spec = runtime.compiledById.get(agentTypeId)
   306	      if (!spec) {
   307	        throw new AgentGatewayError(AgentGatewayErrorCode.AGENT_TYPE_UNKNOWN, 'agent type is not available')
   308	      }
   309	      const legacy = 'legacyDefault' in spec
   310	      let mcpServers: AgentHostAgentDescription['mcpServers'] = []
   311	      if (mcpGrants) {
   312	        const refs = mcpGrants.getMcpServerRefs(agentTypeId) ?? []
   313	        if (refs.length > 0) {
   314	          const listed = await mcpGrants.store.listGrants(claim.workspaceScopeId)
   315	          const resolved = resolveAgentMcpGrants({
   316	            workspaceId: claim.workspaceScopeId,
   317	            agentTypeId,
   318	            mcpServerRefs: refs,
   319	            grants: listed.grants,
   320	            catalog: mcpGrants.catalog,
   321	          })
   322	          mcpServers = resolved.connectors.map((connector) => ({
   323	            id: connector.connectorId,
   324	            tools: connector.allowedTools,
   325	          }))
   326	        }
   327	      }
   328	      return {
   329	        agentTypeId,
   330	        model: legacy ? null : spec.model?.preferred ?? null,
   331	        instructionFiles: legacy ? [] : spec.instructionFiles ?? [],
   332	        mcpServers,
   333	      }
   334	    },
   335	    async executeCommand({ request, agentTypeId, requestId, sessionId, name, args }) {
   336	      const { scope, binding } = await resolve(request, agentTypeId, sessionId)
   337	      if (!binding.composition.harness.executeSlashCommand) {
   338	        throw new AgentGatewayError(
   339	          AgentGatewayErrorCode.AGENT_COMMAND_INVALID_STATE,
   340	          'Command execution is not supported by this Agent',
   341	        )
   342	      }
   343	      const target = { kind: 'session' as const, ref: { agentTypeId, sessionId } }
   344	      return await gateway.runHostEffect({
   345	        scope,
   346	        operation: 'session.command.execute',
   347	        target,
   348	        requestId,
   349	        payload: { ref: target.ref, name, args },
   350	        action: () => runtime.runBindingOperation(binding.key, async () => {
   351	          await binding.composition.harness.executeSlashCommand!(sessionId, name, args, {
   352	            abortSignal: new AbortController().signal,
   353	            workdir: binding.composition.runtimeBundle.workspace.root,
   354	            workspaceId: scope.workspaceScopeId,
   355	            requestId,
   356	            userId: scope.authSubjectId,
   357	            sessionCtx: {
   358	              workspaceId: scope.workspaceScopeId,
   359	              runtimeScopeIdentity: binding.scope.identity,
   360	            },
   361	          })
   362	          return { ok: true, sessionId, name }
   363	        }),
   364	      })
   365	    },
   366	    async reload({ request, agentTypeId, requestId, sessionId }) {
   367	      const { scope, claim } = await authorize(request)
   368	      const candidate = await runtime.resolveAgentRuntimeScope(
   369	        agentTypeId,
   370	        scope,
   371	        claim,
   372	        'reload',
   373	        requestId,
   374	        sessionId,
   375	      )
   376	      if (!candidate.resourceInputDigest?.trim()) {
   377	        throw new TypeError('reload candidate requires an immutable resourceInputDigest')
   378	      }
   379	      const candidateIdentity = canonicalDigest(candidate.identity)
   380	      const candidateFingerprint = canonicalDigest(candidate.environment.provisioningFingerprint)
   381	      const candidatePhysicalBinding = canonicalDigest(candidate.physicalBindingIdentity ?? candidate.identity)
   382	      const target = { kind: 'agent' as const, agentTypeId }
   383	      const reloadSessionId = sessionId ?? options.defaultSessionId ?? 'default'
   384	      let binding: RuntimeBinding | undefined
   385	      return await gateway.runHostEffect({
   386	        scope,
   387	        operation: 'agent.reload',
   388	        target,
   389	        requestId,
   390	        payload: {
   391	          target,
   392	          sessionId: sessionId ?? null,
   393	          candidateIdentity,
   394	          candidateFingerprint,
   395	          candidatePhysicalBinding,
   396	          candidateInputDigest: candidate.resourceInputDigest,
   397	        },
   398	        classify: async () => {
   399	          const current = runtime.findPublishedCurrentBinding(
   400	            agentTypeId,
   401	            claim.workspaceScopeId,
   402	            candidate.physicalBindingIdentity ?? candidate.identity,
   403	            candidate.identity,
   404	            candidate.environment.provisioningFingerprint,
   405	          )
   406	          if (sessionId) {
   407	            const pinned = (await gateway.inspectPublishedSessionBinding(scope, { agentTypeId, sessionId })).binding
   408	            if (current && pinned.generation !== current.generation) {
   409	              return {
   410	                kind: 'reject' as const,
   411	                error: {
   412	                  code: AgentGatewayErrorCode.AGENT_RUNTIME_RESTART_REQUIRED,
   413	                  message: 'Session is pinned to a retired Agent runtime; restart is required',
   414	                },
   415	              }
   416	            }
   417	          }
   418	          binding = current
   419	          if (!binding) {
   420	            return {
   421	              kind: 'reject' as const,
   422	              error: new AgentGatewayError(
   423	                AgentGatewayErrorCode.AGENT_COMMAND_INVALID_STATE,
   424	                'Agent runtime binding is not currently published',
   425	              ).toJSON(),
   426	            }
   427	          }
   428	          const currentIdentity = canonicalDigest(binding.scope.identity)
   429	          const currentFingerprint = canonicalDigest(binding.scope.environment.provisioningFingerprint)
   430	          const currentPhysicalBinding = canonicalDigest(binding.scope.physicalBindingIdentity ?? binding.scope.identity)
   431	          if (
   432	            currentIdentity !== candidateIdentity
   433	            || currentFingerprint !== candidateFingerprint
   434	            || currentPhysicalBinding !== candidatePhysicalBinding
   435	          ) {
   436	            return {
   437	              kind: 'reject' as const,
   438	              error: {
   439	                code: AgentGatewayErrorCode.AGENT_RUNTIME_RESTART_REQUIRED,
   440	                message: 'Agent runtime identity changed; restart is required',
   441	                details: {
   442	                  currentIdentity,
   443	                  candidateIdentity,
   444	                  currentFingerprint,
   445	                  candidateFingerprint,
   446	                  currentPhysicalBinding,
   447	                  candidatePhysicalBinding,
   448	                },
   449	              },
   450	            }
   451	          }
   452	          await candidate.revalidateResourceInputs?.()
   453	          return { kind: 'execute' as const }
   454	        },
   455	        action: async () => {
   456	          const current = binding
   457	          if (!current) throw new TypeError('reload executed before binding classification')
   458	          return await runtime.runBindingOperation(current.key, async () => {
   459	            // Admission is asynchronous and occurs after classification. Fence
   460	            // again before the first external reload mutation; failures from
   461	            // this post-begin point intentionally remain outcome-unknown.
   462	            await candidate.revalidateResourceInputs?.()
   463	            if (!current.composition.harness.reloadSession) {
   464	              throw new AgentGatewayError(
   465	                AgentGatewayErrorCode.AGENT_COMMAND_INVALID_STATE,
   466	                'Agent harness does not support reload',
   467	              )
   468	            }
   469	            const applied = await candidate.applyReload?.({
   470	              runtimeBundle: current.composition.runtimeBundle,
   471	            })
   472	            await candidate.revalidateResourceInputs?.()
   473	            const reloaded = await current.composition.harness.reloadSession(reloadSessionId)
   474	            await candidate.revalidateResourceInputs?.()
   475	            const diagnostics = (current.composition.harness.getResourceDiagnostics?.(reloadSessionId) ?? [])
   476	              .map((entry) => ({ source: entry.source, message: entry.message }))
   477	            const mergedDiagnostics = [
   478	              ...(candidate.reloadMetadata?.diagnostics ?? []),
   479	              ...(applied?.diagnostics ?? []),
   480	              ...diagnostics,
   481	            ]
   482	            const restartWarnings = [
   483	              ...(candidate.reloadMetadata?.restartWarnings ?? []),
   484	              ...(applied?.restartWarnings ?? []),
   485	            ]
   486	            return {
   487	              ok: true,
   488	              ...(sessionId ? { sessionId } : {}),
   489	              reloaded,
   490	              ...(mergedDiagnostics.length > 0 ? { diagnostics: mergedDiagnostics } : {}),
   491	              ...(restartWarnings.length
   492	                ? { restartWarnings }
   493	                : {}),
   494	            }
   495	          })
   496	        },
   497	      })
   498	    },
   499	  }
   500	}
