   747	  async incrementInviteFailedAttempts(inviteId: string): Promise<{ failedAttempts: number; lockedUntil: string | null }> {
   748	    const rows = await this.db
   749	      .update(workspaceInvites)
   750	      .set({
   751	        failedAttempts: sql`${workspaceInvites.failedAttempts} + 1`,
   752	        lockedUntil: sql`CASE WHEN ${workspaceInvites.failedAttempts} + 1 >= 50 THEN now() + interval '1 hour' ELSE ${workspaceInvites.lockedUntil} END`,
   753	      })
   754	      .where(eq(workspaceInvites.id, inviteId))
   755	      .returning({
   756	        failedAttempts: workspaceInvites.failedAttempts,
   757	        lockedUntil: workspaceInvites.lockedUntil,
   758	      })
   759	
   760	    if (rows.length === 0) return { failedAttempts: 0, lockedUntil: null }
   761	    return {
   762	      failedAttempts: rows[0].failedAttempts,
   763	      lockedUntil: toIso(rows[0].lockedUntil),
