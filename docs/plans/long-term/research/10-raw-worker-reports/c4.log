    27	function createStreamWritable(
    28	  collector: StreamCollector,
    29	  shared: CaptureState,
    30	  onChunk?: (chunk: Uint8Array) => void,
    31	): Writable {
    32	  return new Writable({
    33	    write(chunk: Buffer, _enc, cb) {
    34	      const remaining = shared.maxBytes - shared.totalBytes
    35	      if (remaining <= 0) {
    36	        shared.truncated = true
    37	        cb()
    38	        return
    39	      }
    40	
    41	      if (chunk.length > remaining) {
    42	        const partial = chunk.subarray(0, remaining)
    43	        collector.chunks.push(partial)
    44	        shared.totalBytes += remaining
    45	        shared.truncated = true
    46	        onChunk?.(new Uint8Array(partial))
    47	        cb()
    48	        return
    49	      }
    50	
    51	      collector.chunks.push(chunk)
    52	      shared.totalBytes += chunk.length
    53	      onChunk?.(new Uint8Array(chunk))
    54	      cb()
    55	    },
    56	  })
    57	}
