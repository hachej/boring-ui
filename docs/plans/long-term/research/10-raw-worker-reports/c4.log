   142	        if (opts?.onHeartbeat) {
   143	          heartbeatHandle = setInterval(() => {
   144	            opts.onHeartbeat?.(Date.now() - start)
   145	          }, 1_000)
   146	        }
   147	
   148	        const result = await sandbox.runCommand({
   149	          cmd: 'sh',
   150	          args: ['-c', cmd],
   151	          cwd: normalizeVercelCwd(opts?.cwd),
   152	          env: toRemoteEnv(opts?.env),
