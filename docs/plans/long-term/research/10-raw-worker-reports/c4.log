     8	  editor: 1,
     9	  owner: 2,
    10	}
    11	
    12	const WORKSPACE_ID_RE = /^[A-Za-z0-9_-]{1,128}$/
    13	
    14	export function requireWorkspaceMember(
    15	  minimumRole?: MemberRole,
    16	): preHandlerHookHandler {
    17	  return async function (request, _reply) {
    18	    const user = request.user
    19	    if (!user) {
    20	      throw new Error(
    21	        'requireWorkspaceMember: request.user is null — authHook must run before this hook',
    22	      )
    23	    }
    24	
    25	    const workspaceId = (request.params as { id?: string }).id
    26	    if (!workspaceId) {
    27	      throw new Error(
    28	        'requireWorkspaceMember: missing :id param — route must include :id',
    29	      )
    30	    }
    31	
    32	    if (await authorizeRequestScopedWorkspace(request, workspaceId, minimumRole) !== null) return
    33	
    34	    if (!WORKSPACE_ID_RE.test(workspaceId)) {
    35	      throw new HttpError({
    36	        status: 400,
    37	        code: ERROR_CODES.VALIDATION_FAILED,
    38	        message: 'Invalid workspace id',
    39	        requestId: request.id,
    40	      })
    41	    }
    42	
    43	    const workspace = await request.server.workspaceStore.get(workspaceId)
    44	    if (!workspace || workspace.appId !== request.server.config.appId) {
    45	      throw new HttpError({
    46	        status: 404,
    47	        code: ERROR_CODES.NOT_FOUND,
    48	        message: 'Workspace not found',
    49	        requestId: request.id,
    50	      })
    51	    }
    52	
    53	    const role = await request.server.workspaceStore.getMemberRole(
    54	      workspaceId,
    55	      user.id,
    56	    )
    57	
    58	    if (!role) {
    59	      throw new HttpError({
    60	        status: 403,
    61	        code: ERROR_CODES.NOT_MEMBER,
    62	        message: 'Not a member of this workspace',
    63	        requestId: request.id,
    64	      })
    65	    }
    66	
    67	    if (minimumRole && ROLE_LEVELS[role] < ROLE_LEVELS[minimumRole]) {
    68	      throw new HttpError({
    69	        status: 403,
    70	        code: ERROR_CODES.FORBIDDEN,
    71	        message: `Requires ${minimumRole} role or higher`,
    72	        requestId: request.id,
    73	      })
    74	    }
    75	  }
    76	}
