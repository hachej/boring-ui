   170	export function createBoringMcpReadonlyCaller(options: BoringMcpReadonlyCallOptions): BoringMcpReadonlyCaller {
   171	  const catalog = createBoringMcpToolCatalog({ ...options, cache: options.catalogCache })
   172	  const maxInputBytes = options.maxInputBytes ?? DEFAULT_MAX_INPUT_BYTES
   173	
   174	  async function record(event: McpReadonlyCallAuditEvent): Promise<void> {
   175	    try {
   176	      await options.audit?.record(event)
   177	    } catch {
   178	      // Audit is metadata-only and must not mask security decisions or successful provider calls.
   179	    }
   180	  }
   181	
   182	  return {
   183	    async callReadonly(actor, input) {
   184	      const raw: Record<string, unknown> = isPlainRecord(input) ? input : {}
   185	      let request: Pick<McpReadonlyCallInput, "sourceId" | "toolName" | "expectedSchemaHash"> = {
   186	        sourceId: auditSourceId(raw.sourceId),
   187	        toolName: auditToolName(raw.toolName),
   188	        expectedSchemaHash: auditSchemaHash(raw.expectedSchemaHash),
   189	      }
   190	      let audited = false
   191	      try {
   192	        const parsed = parseReadonlyCall(input, maxInputBytes)
   193	        request = parsed
   194	        const source = await requireActorOwnedMcpSource(options.registry, actor, parsed.sourceId)
   195	        if (source.status !== "connected") throw new McpError(MCP_ERROR_CODES.SOURCE_UNAVAILABLE, "MCP source is not connected")
   196	
   197	        // Deny before provider discovery: only pre-approved read tools may reach listTools/callTool.
   198	        assertTemplateAllowsReadonly(source.provider, parsed.toolName, options.templates)
   199	
   200	        const described = await catalog.describeTool(actor, {
   201	          sourceId: parsed.sourceId,
   202	          toolName: parsed.toolName,
   203	          expectedSchemaHash: parsed.expectedSchemaHash,
   204	          refresh: true,
   205	          providerRefresh: Boolean(parsed.expectedSchemaHash),
   206	        })
   207	        assertReadOnlyTool(described.tool)
   208	        assertSchemaCurrent(described.tool, parsed.expectedSchemaHash)
   209	
   210	        let providerResult: unknown
   211	        try {
   212	          providerResult = await options.transport.callTool(source, parsed.toolName, parsed.toolInput)
   213	        } catch (error) {
   214	          if (error instanceof McpError) {
   215	            const safeMessage = containsMcpSecret(error.message) ? "MCP provider tool call failed" : error.message
   216	            await record(auditEvent(actor, request, "failure", error.code))
   217	            audited = true
   218	            throw new McpError(error.code, safeMessage, redactMcpSecrets(error.details))
   219	          }
   220	          const redacted = redactMcpSecrets(error instanceof Error ? { name: error.name, message: error.message } : error)
   221	          await record(auditEvent(actor, request, "failure", MCP_ERROR_CODES.PROVIDER_ERROR))
   222	          audited = true
   223	          throw new McpError(MCP_ERROR_CODES.PROVIDER_ERROR, "MCP provider tool call failed", redacted)
   224	        }
   225	
   226	        const redacted = redactMcpSecrets(providerResult)
   227	        if (containsMcpSecret(providerResult)) {
   228	          await record(auditEvent(actor, request, "failure", MCP_ERROR_CODES.SECRET_LEAK_GUARD))
   229	          audited = true
   230	          throw new McpError(MCP_ERROR_CODES.SECRET_LEAK_GUARD, "MCP provider response looked like it contained a secret")
   231	        }
   232	        const response = { content: redacted }
   233	        assertMcpPublicPayloadSecretFree(response)
   234	        await record(auditEvent(actor, request, "success"))
   235	        audited = true
   236	        return response
   237	      } catch (error) {
   238	        const code = toErrorCode(error)
   239	        if (!audited) {
   240	          await record(auditEvent(actor, request, "blocked", code))
   241	        }
