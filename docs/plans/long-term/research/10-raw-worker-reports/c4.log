     1	/**
     2	 * GET /api/v1/agents/:agentTypeId/models
     3	 *
     4	 * Returns the list of models pi-coding-agent has auth for (i.e. where
     5	 * the corresponding provider API key is present in the environment or
     6	 * `~/.pi/agent/auth.json`). Consumers — including the shadcn example
     7	 * ChatPanel — fetch this endpoint to populate the model-selector dropdown
     8	 * instead of hardcoding a short alias list.
     9	 *
    10	 * Shape:
    11	 *   {
    12	 *     models: [
    13	 *       { provider: "anthropic", id: "claude-sonnet-4-6", label: "Claude Sonnet 4.6", available: true },
    14	 *       ...
    15	 *     ]
    16	 *   }
    17	 *
    18	 * Safe to call unauthenticated — we only report {provider, id, label,
    19	 * available}, never any key material.
    20	 */
    21	import type { FastifyInstance, FastifyRequest } from 'fastify'
    22	import { AuthStorage, ModelRegistry } from '@mariozechner/pi-coding-agent'
    23	import {
    24	  readConfiguredDefaultModel,
    25	  registerConfiguredModelProviders,
    26	  type AgentModelSelection,
    27	} from '../../models/modelConfig.js'
    28	
    29	export interface ModelSummary {
    30	  provider: string
    31	  id: string
    32	  label: string
    33	  available: boolean
    34	}
    35	
    36	export interface ModelsResponse {
    37	  models: ModelSummary[]
    38	  defaultModel?: AgentModelSelection
    39	}
    40	
    41	export interface ModelFilterContext {
    42	  request: FastifyRequest
    43	  workspaceId?: string
    44	}
    45	
    46	export type ModelFilterResult = {
    47	  models: readonly ModelSummary[]
    48	  defaultModel?: AgentModelSelection
    49	}
    50	
    51	export interface ModelsRoutesOptions {
    52	  path?: string
    53	  authorizeRequest?: (request: FastifyRequest) => void | Promise<void>
    54	  filterModels?: (
    55	    ctx: ModelFilterContext,
    56	    models: readonly ModelSummary[],
    57	    defaultModel: AgentModelSelection | undefined,
    58	  ) => ModelFilterResult | Promise<ModelFilterResult>
    59	}
    60	
    61	export function modelsRoutes(
    62	  app: FastifyInstance,
    63	  opts: ModelsRoutesOptions,
    64	  done: (err?: Error) => void,
    65	): void {
    66	  // Build one registry per process — reads env + ~/.pi/agent/auth.json.
    67	  // Cached so repeated GETs don't re-scan auth every request.
    68	  const authStorage = AuthStorage.create()
    69	  const registry = ModelRegistry.create(authStorage)
    70	  const configuredModels = registerConfiguredModelProviders(registry)
    71	  const configuredModelSet = new Set(
    72	    configuredModels.map((model) => `${model.provider}:${model.id}`),
    73	  )
    74	  app.get(opts.path ?? '/api/v1/agents/:agentTypeId/models', async (request, reply) => {
    75	    await opts.authorizeRequest?.(request)
    76	    const availableModels = registry.getAvailable()
    77	    const availableSet = new Set(
    78	      availableModels.map((m) => `${m.provider}:${m.id}`),
    79	    )
    80	    const allModels = configuredModelSet.size > 0
    81	      ? registry.getAll().filter((m) => configuredModelSet.has(`${m.provider}:${m.id}`))
    82	      : registry.getAll()
    83	    const models: ModelSummary[] = allModels.map((m) => ({
    84	      provider: m.provider,
    85	      id: m.id,
    86	      label: (m as unknown as { label?: string }).label ?? m.id,
    87	      // Keep this endpoint cheap: it is fetched on chat mount, so it must never
    88	      // block workspace load on deep provider auth resolution. ModelRegistry's
    89	      // available set is already derived from configured auth sources. When
    90	      // hosts configure launch/custom providers, those configured models are an
    91	      // allowlist: do not leak the built-in registry's unavailable catalog.
    92	      available: availableSet.has(`${m.provider}:${m.id}`),
    93	    }))
    94	    // Stable order: available first, then alphabetically by (provider, id).
    95	    models.sort((a, b) => {
    96	      if (a.available !== b.available) return a.available ? -1 : 1
    97	      if (a.provider !== b.provider) return a.provider.localeCompare(b.provider)
    98	      return a.id.localeCompare(b.id)
    99	    })
   100	    const configuredDefaultModel = readConfiguredDefaultModel()
   101	    const defaultModel = configuredDefaultModel
   102	      && models.some((m) => m.available && m.provider === configuredDefaultModel.provider && m.id === configuredDefaultModel.id)
   103	      ? configuredDefaultModel
   104	      : undefined
   105	    const filtered = opts.filterModels
   106	      ? await opts.filterModels(
   107	        { request, workspaceId: request.workspaceContext?.workspaceId },
   108	        models.map((model) => ({ ...model })),
   109	        defaultModel ? { provider: defaultModel.provider, id: defaultModel.id } : undefined,
   110	      )
   111	      : { models, defaultModel }
   112	    const responseModels = filtered.models.map((model) => ({ ...model }))
   113	    const fallbackDefault = responseModels.find((model) => model.available)
   114	    const responseDefault = filtered.defaultModel
   115	      && responseModels.some((m) => m.available && m.provider === filtered.defaultModel?.provider && m.id === filtered.defaultModel.id)
   116	      ? { provider: filtered.defaultModel.provider, id: filtered.defaultModel.id }
   117	      : fallbackDefault ? { provider: fallbackDefault.provider, id: fallbackDefault.id } : undefined
   118	    const payload: ModelsResponse = responseDefault
   119	      ? { models: responseModels, defaultModel: responseDefault }
   120	      : { models: responseModels }
   121	    return reply.code(200).send(payload)
   122	  })
   123	
   124	  done()
   125	}
