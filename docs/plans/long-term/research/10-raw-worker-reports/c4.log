   102	export function createWorkspaceRuntimeResourceMcpGrantStore(host: WorkspaceRuntimeResourceHost): McpGrantStore {
   103	  return {
   104	    async listGrants(workspaceId) {
   105	      const resources = await host.listWorkspaceRuntimeResources(workspaceId)
   106	      const grants: McpGrant[] = []
   107	      const diagnostics: McpGrantDiagnostic[] = []
   108	      for (const outcome of resources.filter(isMcpGrantResource).map(toGrant)) {
   109	        if ('grant' in outcome) grants.push(outcome.grant)
   110	        else diagnostics.push(outcome.diagnostic)
   111	      }
   112	      return { grants, diagnostics }
   113	    },
