    43	function readPositiveInt(name: string, fallback: number): number {
    44	  const raw = clean(getEnv(name))
    45	  if (!raw) return fallback
    46	  const parsed = Number(raw)
    47	  return Number.isFinite(parsed) && parsed > 0 ? Math.floor(parsed) : fallback
