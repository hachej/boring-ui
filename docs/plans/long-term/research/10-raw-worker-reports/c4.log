   619	  async acceptInvite(
   620	    workspaceId: string,
   621	    inviteId: string,
   622	    userId: string,
   623	  ): Promise<{ invite: WorkspaceInvite; member: WorkspaceMember }> {
   624	    return this.db.transaction(async (tx) => {
   625	      const inviteRows = await tx
   626	        .select()
   627	        .from(workspaceInvites)
   628	        .where(
   629	          and(
   630	            eq(workspaceInvites.workspaceId, workspaceId),
   631	            eq(workspaceInvites.id, inviteId),
   632	          ),
   633	        )
   634	        .limit(1)
   635	
   636	      const invite = inviteRows[0]
   637	      if (!invite) {
   638	        throw new HttpError({
   639	          status: 404,
   640	          code: ERROR_CODES.INVITE_NOT_FOUND,
   641	          message: 'Invite not found',
   642	        })
   643	      }
   644	
   645	      if (invite.acceptedAt) {
   646	        throw new HttpError({
   647	          status: 410,
   648	          code: ERROR_CODES.INVITE_ALREADY_ACCEPTED,
   649	          message: 'Invite already accepted',
   650	        })
   651	      }
   652	
   653	      if (invite.expiresAt.getTime() <= Date.now()) {
   654	        throw new HttpError({
   655	          status: 410,
   656	          code: ERROR_CODES.INVITE_EXPIRED,
   657	          message: 'Invite expired',
   658	        })
   659	      }
   660	
   661	      const userRows = await tx
   662	        .select({ email: users.email })
   663	        .from(users)
   664	        .where(eq(users.id, userId))
   665	        .limit(1)
   666	
   667	      const user = userRows[0]
   668	      const userEmail = user ? normalizeEmail(user.email) : null
   669	      if (!userEmail || userEmail !== normalizeEmail(invite.email)) {
   670	        throw new HttpError({
   671	          status: 403,
   672	          code: ERROR_CODES.INVITE_EMAIL_MISMATCH,
   673	          message: 'Invite email mismatch',
   674	        })
   675	      }
   676	
   677	      const acceptedRows = await tx
   678	        .update(workspaceInvites)
   679	        .set({ acceptedAt: new Date() })
   680	        .where(
   681	          and(
   682	            eq(workspaceInvites.workspaceId, workspaceId),
   683	            eq(workspaceInvites.id, inviteId),
   684	            isNull(workspaceInvites.acceptedAt),
   685	          ),
   686	        )
   687	        .returning()
   688	
   689	      if (acceptedRows.length === 0) {
   690	        const refreshedRows = await tx
   691	          .select()
   692	          .from(workspaceInvites)
   693	          .where(
   694	            and(
   695	              eq(workspaceInvites.workspaceId, workspaceId),
   696	              eq(workspaceInvites.id, inviteId),
   697	            ),
   698	          )
   699	          .limit(1)
   700	
   701	        const refreshed = refreshedRows[0]
   702	        if (!refreshed) {
   703	          throw new HttpError({
   704	            status: 404,
   705	            code: ERROR_CODES.INVITE_NOT_FOUND,
   706	            message: 'Invite not found',
   707	          })
   708	        }
   709	
   710	        throw new HttpError({
   711	          status: 410,
   712	          code: ERROR_CODES.INVITE_ALREADY_ACCEPTED,
   713	          message: 'Invite already accepted',
   714	        })
   715	      }
   716	
   717	      const memberRows = await tx
   718	        .insert(workspaceMembers)
   719	        .values({
   720	          workspaceId,
   721	          userId,
   722	          role: invite.role as MemberRole,
   723	        })
   724	        .onConflictDoUpdate({
   725	          target: [workspaceMembers.workspaceId, workspaceMembers.userId],
   726	          set: { role: invite.role as MemberRole },
   727	        })
   728	        .returning()
   729	
   730	      const acceptedInvite = acceptedRows[0]
   731	      const member = memberRows[0]
   732	      if (!acceptedInvite || !member) {
   733	        throw new HttpError({
   734	          status: 500,
   735	          code: ERROR_CODES.INTERNAL_ERROR,
   736	          message: 'Failed to accept invite',
   737	        })
   738	      }
   739	
   740	      return {
   741	        invite: toWorkspaceInvite(acceptedInvite),
   742	        member: toWorkspaceMember(member),
   743	      }
   744	    })
   745	  }
