    45	const SAFE_REQUEST_ID = /^[A-Za-z0-9._:-]+$/
    46	const AgentParams = z.object({ agentTypeId: z.string().min(1).max(128) }).passthrough()
    47	const ReloadBody = z.object({
    48	  requestId: z.string().trim().min(1).max(128).regex(SAFE_REQUEST_ID),
    49	  sessionId: z.string().trim().min(1).max(128).optional(),
    50	}).strict()
    51	const CommandBody = z.object({
    52	  requestId: z.string().trim().min(1).max(128).regex(SAFE_REQUEST_ID),
    53	  sessionId: z.string().trim().min(1).max(128),
    54	  name: z.string().trim().min(1).max(256),
    55	  args: z.string().max(1_000_000),
    56	}).strict()
