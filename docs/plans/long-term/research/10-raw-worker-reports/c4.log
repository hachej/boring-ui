    34	export function createPostHogTelemetryFromEnv(
    35	  env: NodeJS.ProcessEnv = process.env,
    36	): TelemetrySink {
    37	  if (env.BORING_TELEMETRY_ENABLED !== 'true') return noopTelemetry
    38	
    39	  const posthogKey = env.POSTHOG_KEY
    40	  if (!posthogKey) {
    41	    console.warn('PostHog telemetry is enabled but POSTHOG_KEY is missing; using noop telemetry.')
    42	    return noopTelemetry
    43	  }
    44	
    45	  const posthog = new PostHog(posthogKey, {
    46	    host: env.POSTHOG_HOST ?? DEFAULT_POSTHOG_HOST,
    47	  })
    48	  const project = parseTelemetryProject(env.BORING_TELEMETRY_PROJECT)
    49	
    50	  return {
    51	    capture(event: TelemetryEvent) {
    52	      const eventName = parseTelemetryEventName(event.name)
    53	      if (!eventName) return
    54	
    55	      const properties = sanitizeTelemetryProperties(event.properties)
    56	      if (project) properties.boringProject = project
    57	      properties.eventName = eventName
    58	
    59	      try {
    60	        void Promise.resolve(posthog.capture({
    61	          distinctId: sanitizeTelemetryDistinctId(event.distinctId),
    62	          event: project ? `${project}.${eventName}` : eventName,
    63	          properties,
    64	        })).catch(() => {})
    65	      } catch {}
    66	    },
    67	    async flush() {
    68	      await Promise.resolve(posthog.shutdown())
    69	    },
    70	  }
    71	}
