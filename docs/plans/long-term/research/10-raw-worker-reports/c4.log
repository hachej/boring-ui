   743	/**
   744	 * Build the full set of boring-mcp server bindings for a host app from a single
   745	 * config object. Every member is pre-bound to `config`, so a host wires MCP with
   746	 * ~15 lines of configuration instead of re-copying the forwarding glue.
   747	 */
   748	export function createBoringMcpAppBindings(config: BoringMcpAppBindingsConfig): BoringMcpAppBindings {
   749	  return {
   750	    readConfig: (env) => readBoringMcpServerConfig(env, { secretEnvVars: config.secretEnvVars }),
   751	    createSecretResolver: (env) =>
   752	      createManagedConnectorSecretResolver({ env, configs: config.connectorConfigs, secretEnvVars: config.secretEnvVars }),
   753	    createConnectorAdapter: (options) =>
   754	      createBoringMcpManagedConnectorAdapter({ config, registry: options.registry, env: options.env, provider: options.provider }),
   755	    agentSessionNamespace: boringMcpAgentSessionNamespace,
   756	    createMcpSourceRegistry: createUserSettingsMcpSourceRegistry,
   757	    createAgentTools: (app, actor, options = {}) =>
   758	      createBoringMcpAppAgentTools(app, actor, { config, env: options.env, transport: options.transport }),
   759	    createAgentToolsForRequest: (app, ctx, options = {}) =>
   760	      createBoringMcpAppAgentToolsForRequest(app, ctx, { config, env: options.env, transport: options.transport }),
   761	    registerRoutes: (app, options = {}) =>
   762	      registerBoringMcpRoutes(app, {
   763	        config,
   764	        whenDisabled: config.whenDisabled,
   765	        provider: options.provider,
   766	        env: options.env,
   767	        transport: options.transport,
   768	        resolveTrustedWorkspaceId: options.resolveTrustedWorkspaceId ?? config.resolveTrustedWorkspaceId,
   769	      }),
   770	    createServerPlugins: (env = process.env) => {
   771	      if (!readBoringMcpServerConfig(env, { secretEnvVars: config.secretEnvVars }).enabled) return []
   772	      return [createBoringMcpServerPlugin({ systemPrompt: config.systemPrompt })]
   773	    },
   774	  }
   775	}

