    29	function clean(value: string | undefined): string | undefined {
    30	  const trimmed = value?.trim()
    31	  return trimmed && trimmed.length > 0 ? trimmed : undefined
    32	}
    33	
    34	export function parseEncodedModelSelection(value: string | undefined): AgentModelSelection | undefined {
    35	  const encoded = clean(value)
    36	  if (!encoded) return undefined
    37	  const idx = encoded.indexOf(':')
    38	  return idx > 0 && idx < encoded.length - 1
    39	    ? { provider: encoded.slice(0, idx), id: encoded.slice(idx + 1) }
    40	    : undefined
    41	}
