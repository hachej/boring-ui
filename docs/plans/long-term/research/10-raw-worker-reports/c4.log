    93	    ...(network === 'shared' ? ['--share-net'] : []),
    94	    '--die-with-parent',
    95	    ...(options?.newSession === false ? [] : ['--new-session']),
    96	    ...(options?.dropAllCapabilities ? ['--cap-drop', 'ALL'] : []),
    97	    '--tmpfs', '/',
    98	    '--proc', '/proc',
    99	    '--dev', '/dev',
   100	    '--tmpfs', '/tmp',
   101	  ]
   102	
   103	  for (const dir of RO_BIND_DIRS) {
   104	    args.push('--ro-bind', dir, dir)
   105	  }
   106	
   107	  for (const dir of RO_BIND_TRY_DIRS) {
   108	    args.push('--ro-bind-try', dir, dir)
   109	  }
   110	
   111	  if (options?.extraArgs) {
   112	    args.push(...options.extraArgs)
   113	  }
   114	
   115	  args.push(
   116	    '--bind',
   117	    workspaceRoot,
   118	    SANDBOX_HOME,
   119	    '--chdir',
   120	    SANDBOX_HOME,
   121	    '--setenv',
   122	    'HOME',
   123	    SANDBOX_HOME,
   124	  )
