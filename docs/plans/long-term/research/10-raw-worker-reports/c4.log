    21	type OpenAICompletionsCompatDefaults = Partial<{
    22	  supportsStore: boolean
    23	  supportsDeveloperRole: boolean
    24	  supportsReasoningEffort: boolean
    25	  supportsUsageInStreaming: boolean
    26	  maxTokensField: 'max_tokens' | 'max_completion_tokens'
