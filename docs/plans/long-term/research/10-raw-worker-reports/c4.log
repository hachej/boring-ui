    84	    supportsStore: readBoolean(`${envPrefix}_SUPPORTS_STORE`, defaults.supportsStore ?? false),
    85	    supportsDeveloperRole: readBoolean(`${envPrefix}_SUPPORTS_DEVELOPER_ROLE`, defaults.supportsDeveloperRole ?? true),
    86	    supportsReasoningEffort: readBoolean(`${envPrefix}_SUPPORTS_REASONING_EFFORT`, defaults.supportsReasoningEffort ?? true),
    87	    supportsUsageInStreaming: readBoolean(`${envPrefix}_SUPPORTS_USAGE_IN_STREAMING`, defaults.supportsUsageInStreaming ?? true),
    88	    maxTokensField: readMaxTokensField(`${envPrefix}_MAX_TOKENS_FIELD`, defaults.maxTokensField),
    89	  }
    90	}
    91	
    92	function readApiKeyEnv(candidates: string[]): string | undefined {
    93	  for (const candidate of candidates) {
    94	    const envName = clean(candidate)
    95	    if (envName && clean(getEnv(envName))) return envName
    96	  }
    97	  return undefined
    98	}
