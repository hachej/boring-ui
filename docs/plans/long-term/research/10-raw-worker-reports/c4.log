    64	  | typeof ErrorCode.enum.AGENT_MCP_GRANT_RECORD_MALFORMED
    65	  | typeof ErrorCode.enum.AGENT_MCP_GRANT_CONNECTOR_UNKNOWN
    66	  | typeof ErrorCode.enum.AGENT_MCP_GRANT_TOOL_NAME_INVALID
