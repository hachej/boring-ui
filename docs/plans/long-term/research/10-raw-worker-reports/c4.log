   623	export class McpAccessFacade {
   624	  constructor(
   625	    private readonly params: {
   626	      store: McpSourceStore
   627	      transport: McpTransportClient
   628	      templates?: readonly McpProviderTemplate[]
   629	      maxInputBytes?: number
   630	      accessPolicy?: McpSourceAccessPolicy
   631	    },
   632	  ) {}
   633	
   634	  async listSources(actor: McpActor): Promise<McpSource[]> {
   635	    return (await this.params.store.listSources(actor)).filter((source) => this.canAccessSource(actor, source))
   636	  }
   637	
   638	  async probeSource(actor: McpActor, sourceId: string): Promise<McpProbeResult> {
   639	    const source = await this.requireAccessibleSource(actor, sourceId)
   640	    this.requireConnectedSource(source)
   641	    const template = this.requireTemplate(source)
   642	    const [tools, resources] = await Promise.all([
   643	      this.params.transport.listTools(source),
   644	      this.params.transport.listResources(source),
   645	    ])
   646	    return {
   647	      sourceId: source.id,
   648	      provider: source.provider,
   649	      tools: classifyMcpTools(template, tools),
   650	      resources,
   651	    }
   652	  }
   653	
   654	
   655	  private async requireAccessibleSource(actor: McpActor, sourceId: string): Promise<McpSource> {
   656	    const source = await this.params.store.getSource(sourceId)
   657	    if (!source || source.workspaceId !== actor.workspaceId) {
   658	      throw new McpError(MCP_ERROR_CODES.SOURCE_NOT_FOUND, "MCP source not found")
   659	    }
   660	    if (!this.canAccessSource(actor, source)) throw new McpError(MCP_ERROR_CODES.SOURCE_NOT_FOUND, "MCP source not found")
   661	    return source
   662	  }
   663	
   664	  private canAccessSource(actor: McpActor, source: McpSource): boolean {
   665	    if (source.workspaceId !== actor.workspaceId) return false
   666	    return this.params.accessPolicy?.canAccessSource(actor, source)
   667	      ?? (source.ownerKind === "user" && source.userId === actor.userId)
   668	  }
   669	
   670	  private requireConnectedSource(source: McpSource): void {
   671	    if (source.status !== "connected") throw new McpError(MCP_ERROR_CODES.SOURCE_UNAVAILABLE, "MCP source is not connected")
   672	  }
   673	
   674	  private requireTemplate(source: McpSource): McpProviderTemplate {
   675	    const template = getMcpProviderTemplate(source.provider, this.params.templates)
   676	    if (!template) throw new McpError(MCP_ERROR_CODES.PROVIDER_CONFIG_INVALID, "Unknown MCP provider")
   677	    return template
   678	  }
   679	}

