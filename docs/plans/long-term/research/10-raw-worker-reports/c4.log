   408	      return legacySource ? normalizeStoredSourceId(actorScope, legacySource) : undefined
   409	    },
   410	    async upsertSource(actor, source) {
   411	      const now = new Date().toISOString()
   412	      const currentSettings = await app.userStore.getUserSettings(actor.userId, app.config.appId)
   413	      const current = readStoredSources(currentSettings.settings, actor)
   414	      const rawSources = readRawStoredSources(currentSettings.settings, actor)
   415	      const existing = current.find((item) => item.id === source.id)
   416	      const next = preserveUserRegistration(source, { ...source, updatedAt: now, createdAt: source.createdAt ?? existing?.createdAt ?? now })
   417	      const legacyId = existingLegacySourceIdFor(actor, next, rawSources)
   418	      await saveStoredSource(app, actor, next, legacyId ? [legacyId] : [])
   419	      return next
   420	    },
   421	    async disconnectSource(actor, sourceId) {
   422	      const currentSettings = await app.userStore.getUserSettings(actor.userId, app.config.appId)
   423	      const source = readStoredSources(currentSettings.settings, actor).find((item) => item.id === sourceId)
   424	        ?? (() => {
   425	          const legacySource = readRawStoredSources(currentSettings.settings, actor).find((item) => item.id === sourceId)
   426	          return legacySource ? normalizeStoredSourceId(actor, legacySource) : undefined
   427	        })()
   428	      if (!source) return undefined
   429	      const disconnected = preserveUserRegistration(source, { ...source, status: 'revoked' as const, updatedAt: new Date().toISOString() })
   430	      const legacyId = existingLegacySourceIdFor(actor, disconnected, readRawStoredSources(currentSettings.settings, actor))
   431	      await saveStoredSource(app, actor, disconnected, legacyId ? [legacyId] : [])
   432	      return disconnected
   433	    },
   434	  }
   435	}
