   121	/**
   122	 * Whether a workspace-relative path is safe to publish to a client.
   123	 *
   124	 * Deliberately the SAME shape as the browser-side guard every openable
   125	 * resource passes through (`isSafePluginRelativePath` +
   126	 * `openableFileResource` in @hachej/boring-workspace): no NUL, no backslash,
   127	 * percent-encoded dot/slash/backslash, scheme prefix, absolute path, or
   128	 * `..`/empty/bare-dot segment. An allowlist regex here was stricter than the
   129	 * guard downstream, so an ordinary seat name containing a space permanently
   130	 * lost its link for no security reason.
   131	 */
   132	function isPublishableWorkspacePath(value: string): boolean {
   133	  return value.length > 0
   134	    && !value.includes('\0')
   135	    && !value.includes('\\')
   136	    && !value.startsWith('/')
   137	    && !/^[A-Za-z]:[\\/]/.test(value)
   138	    && !/%(?:2e|2f|5c)/i.test(value)
   139	    && !/^[A-Za-z][A-Za-z0-9+.-]*:/.test(value)
   140	    && !value.split('/').some((segment) => segment === '' || segment === '.' || segment === '..')
   141	}
