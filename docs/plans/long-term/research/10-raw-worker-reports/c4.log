    58	export interface AgentHostRuntimeCapabilityBinding {
    59	  readonly harness: AgentHarness
    60	  readonly tools: readonly AgentTool[]
    61	  readonly workspace: Workspace
    62	  readonly readyTracker: ReadyStatusTracker
    63	  readonly pi?: PiHarnessOptions
    64	  readonly additionalSkillPaths?: readonly string[]
    65	  /**
    66	   * Skill-resource locator/catalog snapshot for the current reload
    67	   * generation, sourced from `ResolvedAgentRuntimeScope.getSkillResourceSnapshot`.
    68	   * Carries package-managed skill locators through the capability-projection
    69	   * path (Option A) rather than through the legacy path-shaped
    70	   * `additionalSkillPaths` hot-reload API, which #970 retires.
    71	   */
    72	  readonly skillResourceSnapshot?: AgentSkillResourceSnapshot
    73	  readonly runContext: RunContext
    74	  /**
    75	   * Connectors/tools this Agent is actually granted, resolved through
    76	   * per-agent MCP grants (gh-1087). Undefined when no grant seam is
    77	   * configured on this projection; empty array is default-deny (declared
    78	   * refs exist but nothing was granted).
    79	   */
    80	  readonly mcpGrants?: readonly ResolvedMcpConnectorGrant[]
    81	  /** Stable-coded diagnostics for any declared `mcpServerRefs` entry that was dropped during resolution. */
    82	  readonly mcpGrantDiagnostics?: readonly McpGrantDiagnostic[]
    83	}
    84	
    85	/**
    86	 * User-facing "what can this agent do?" description. Authorized at the same
    87	 * per-agent bar as every sibling route, but served without materializing a
    88	 * runtime binding: everything here comes from the compiled fleet spec plus
    89	 * the MCP grant seam.
    90	 *
    91	 * Deliberately NARROW: only what needs the compiled spec or the grant seam.
    92	 * Identity (`label`) and `pluginIds` already come from the fleet list route,
    93	 * and duplicating them here forced the client to reconcile two shapes for the
    94	 * same fact.
    95	 *
    96	 * The composed `systemPrompt` used to ship here too. Its ONLY consumer was the
    97	 * Agent details "System prompt" section, which the owner removed as unhelpful:
    98	 * a wall of composed text nobody could act on. Serving a whole agent's
    99	 * instructions to every details open with no reader left is pure payload, so
   100	 * the field went with the section. `instructionFiles` is what survives — the
   101	 * authored sources, which the operator can actually open and edit.
   102	 */
   103	export interface AgentHostAgentDescription {
   104	  readonly agentTypeId: string
   105	  /** Preferred model id from the agent definition, when pinned. */
   106	  readonly model: string | null
   107	  /**
   108	   * Authored instruction sources behind this agent's instructions. The Host is the only
   109	   * component that knows these locations (seat and agentTypeId are unrelated
   110	   * fleet.yaml fields), so clients render what they are given rather than
   111	   * guessing a persona directory.
   112	   */
   113	  readonly instructionFiles: readonly AgentInstructionFileRef[]
   114	  /** MCP connectors this agent is actually granted (default-deny). */
   115	  readonly mcpServers: readonly { readonly id: string; readonly tools: readonly string[] }[]
   116	}
