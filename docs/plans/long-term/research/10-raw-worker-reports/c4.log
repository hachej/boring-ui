   127	      await host.deleteWorkspaceRuntimeResource(workspaceId, {
   128	        kind: MCP_GRANT_RESOURCE_KIND,
   129	        purpose: agentTypeId,
   130	        provider: connectorId,
   131	      })
   132	    },
   133	  }
   134	}
