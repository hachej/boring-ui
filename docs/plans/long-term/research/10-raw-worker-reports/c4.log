    53	  if (['1', 'true', 'yes', 'on'].includes(raw)) return true
    54	  if (['0', 'false', 'no', 'off'].includes(raw)) return false
    55	  return fallback
    56	}
    57	
    58	function readModelInput(name: string): Array<'text' | 'image'> {
    59	  const raw = clean(getEnv(name))
    60	  if (!raw) return ['text']
    61	  const parsed = raw
    62	    .split(',')
    63	    .map((part) => part.trim())
    64	    .filter((part): part is 'text' | 'image' => part === 'text' || part === 'image')
