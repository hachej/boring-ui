   146	export class RunscSessionRuntimeV1 {
   147	  private readonly sessions = new Map<string, SessionRecordV1>();
   148	  private readonly leaseBindings = new Map<string, SessionRecordV1>();
   149	  private readonly workspaceBindings = new Map<string, SessionRecordV1>();
   150	  private readonly pendingWorkspaceCreates = new Set<string>();
   151	  private readonly pendingCreates = new Map<
   152	    string,
   153	    { digest: `sha256:${string}`; promise: Promise<RunscSessionLeaseV1> }
   154	  >();
   155	  private readonly pendingOperations = new Set<Promise<unknown>>();
   156	  private readonly workspace: RunscWorkspaceHelperClientV1;
   157	  private readonly retirement: RunscSessionRetirementManagerV1<SessionRecordV1>;
   158	  private readonly now: () => number;
   159	  private readonly runtimeIdFactory: () => string;
   160	  private readonly maxConcurrentCreates: number;
