   166	  constructor(private readonly options: RunscSessionRuntimeOptionsV1) {
   167	    this.workspace = new RunscWorkspaceHelperClientV1(options.runner);
   168	    this.retirement = new RunscSessionRetirementManagerV1({
   169	      runner: options.runner,
   170	      detach: (record) => this.detach(record),
   171	      onRetire: options.onRetire,
   172	    });
   173	    this.now = options.now ?? Date.now;
   174	    this.runtimeIdFactory = options.runtimeIdFactory ?? runtimeId;
   175	    this.maxConcurrentCreates = boundedPositiveInteger(
   176	      options.maxConcurrentCreates ?? 4,
   177	      1_000,
   178	      "create concurrency",
   179	    );
   180	    this.maxConcurrentExecs = boundedPositiveInteger(
   181	      options.maxConcurrentExecs ?? 16,
   182	      10_000,
   183	      "exec concurrency",
   184	    );
   185	  }
