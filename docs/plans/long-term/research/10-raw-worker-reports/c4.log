   156	        })
   157	
   158	        return {
   159	          stdout: new Uint8Array(Buffer.concat(stdoutCollector.chunks)),
   160	          stderr: new Uint8Array(Buffer.concat(stderrCollector.chunks)),
   161	          exitCode: result.exitCode ?? 1,
   162	          durationMs: Date.now() - start,
   163	          truncated: captureState.truncated,
   164	          stdoutEncoding: 'utf-8',
   165	          stderrEncoding: 'utf-8',
   166	        }
