    74	export function computeSandboxCwd(workspaceRoot: string, runtimeCwd: string, cwd?: string): string {
    75	  if (!cwd) return runtimeCwd
    76	  const normalizedRuntimeCwd = posix.normalize(runtimeCwd).replace(/\/+$/, '') || '/'
    77	  if (cwd === normalizedRuntimeCwd) return normalizedRuntimeCwd
    78	  if (cwd.startsWith(`${normalizedRuntimeCwd}/`)) {
    79	    const normalizedCwd = posix.normalize(cwd)
    80	    if (normalizedCwd === normalizedRuntimeCwd) return normalizedRuntimeCwd
    81	    if (normalizedCwd.startsWith(`${normalizedRuntimeCwd}/`)) return normalizedCwd
    82	    throw new Error('cwd must stay within workspace root')
    83	  }
    84	
    85	  const absoluteCwd = isAbsolute(cwd) ? cwd : resolve(workspaceRoot, cwd)
    86	  const relPath = relative(workspaceRoot, absoluteCwd)
    87	  if (relPath === '') return normalizedRuntimeCwd
    88	  if (relPath === '..' || relPath.startsWith(`..${sep}`)) {
    89	    throw new Error('cwd must stay within workspace root')
    90	  }
    91	
    92	  const posixRelPath = relPath.split(sep).join('/')
    93	  return `${normalizedRuntimeCwd}/${posixRelPath}`
    94	}
