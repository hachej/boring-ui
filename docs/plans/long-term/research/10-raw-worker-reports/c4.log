     4	import { ConfigValidationError } from '../../shared/errors.js'
     5	
     6	const MAX_SECRET_BYTES = 64 * 1024
     7	const SECRET_PAIRS = [
     8	  ['DATABASE_URL', 'DATABASE_URL_FILE'],
     9	  ['BETTER_AUTH_SECRET', 'BETTER_AUTH_SECRET_FILE'],
    10	  ['WORKSPACE_SETTINGS_ENCRYPTION_KEY', 'WORKSPACE_SETTINGS_ENCRYPTION_KEY_FILE'],
    11	] as const
    12	
    13	type SecretVariable = (typeof SECRET_PAIRS)[number][0]
    14	export type FileSecretVariable = (typeof SECRET_PAIRS)[number][1]
    15	
    16	function invalid(variable: FileSecretVariable, message = 'secret file is invalid'): never {
    17	  throw new ConfigValidationError([{ message, path: ['env', variable] }])
    18	}
    19	
    20	function decodeSecret(bytes: Uint8Array): string | undefined {
    21	  let value: string
    22	  try {
    23	    value = new TextDecoder('utf-8', { fatal: true }).decode(bytes)
    24	  } catch {
    25	    return undefined
    26	  }
    27	  if (value.endsWith('\n')) value = value.slice(0, -1)
    28	  if (!value || /[\0\r\n]/.test(value)) return undefined
    29	  return value
    30	}
    31	
    32	export function readConfigFileSecret(
    33	  variable: FileSecretVariable,
    34	  filePath: string,
    35	  options: { readonly expectedOwnerUid?: number } = {},
    36	): string {
    37	  if (!path.isAbsolute(filePath) || path.normalize(filePath) !== filePath || /[\0-\x1f\x7f]/.test(filePath)) invalid(variable)
    38	  const expectedOwnerUid = options.expectedOwnerUid ?? (typeof process.geteuid === 'function' ? process.geteuid() : -1)
    39	  if (!Number.isSafeInteger(expectedOwnerUid) || expectedOwnerUid < 0) invalid(variable)
    40	
    41	  let fd: number | undefined
    42	  let failure = false
    43	  let value: string | undefined
    44	  try {
    45	    fd = openSync(filePath, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK)
    46	    const stat = fstatSync(fd)
    47	    if (
    48	      !stat.isFile() ||
    49	      stat.nlink !== 1 ||
    50	      stat.uid !== expectedOwnerUid ||
    51	      (stat.mode & 0o7777) !== 0o400 ||
    52	      stat.size > MAX_SECRET_BYTES
    53	    ) {
    54	      failure = true
    55	    } else {
    56	      const buffer = Buffer.allocUnsafe(MAX_SECRET_BYTES + 1)
    57	      let length = 0
    58	      while (length <= MAX_SECRET_BYTES) {
    59	        const read = readSync(fd, buffer, length, buffer.length - length, null)
    60	        if (read === 0) break
    61	        length += read
    62	      }
    63	      if (length > MAX_SECRET_BYTES) failure = true
    64	      else {
    65	        value = decodeSecret(buffer.subarray(0, length))
    66	        if (value === undefined) failure = true
    67	      }
    68	    }
    69	  } catch {
    70	    failure = true
    71	  } finally {
    72	    if (fd !== undefined) try { closeSync(fd) } catch { failure = true }
    73	  }
    74	  if (failure || value === undefined) invalid(variable)
    75	  return value
    76	}
    77	
    78	export function resolveConfigFileSecrets(env: Readonly<Record<string, string | undefined>>): Readonly<Partial<Record<SecretVariable, string>>> {
    79	  const values: Partial<Record<SecretVariable, string>> = {}
    80	  for (const [variable, fileVariable] of SECRET_PAIRS) {
    81	    if (env[variable] !== undefined && env[fileVariable] !== undefined) {
    82	      invalid(fileVariable, `${variable} and ${fileVariable} cannot both be set`)
    83	    }
    84	    if (env[fileVariable] !== undefined)
    85	      values[variable] = readConfigFileSecret(fileVariable, env[fileVariable])
    86	  }
    87	  return Object.freeze(values)
    88	}
