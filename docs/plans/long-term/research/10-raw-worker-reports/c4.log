    53	func supervise() error {
    54		if os.Getpid() != 1 {
    55			return errors.New("supervisor must be pid 1")
    56		}
    57		_, _, errno := syscall.RawSyscall6(syscall.SYS_PRCTL, prSetChildSubreaper, 1, 0, 0, 0, 0)
    58		if errno != 0 {
    59			return errno
    60		}
    61		if err := prepareControlDirectory(); err != nil {
    62			return err
    63		}
    64		if err := os.Remove(socketPath); err != nil && !errors.Is(err, os.ErrNotExist) {
    65			return err
    66		}
    67		listener, err := net.Listen("unix", socketPath)
    68		if err != nil {
    69			return err
    70		}
    71		defer listener.Close()
    72		if err := os.Chmod(socketPath, 0o600); err != nil {
    73			return err
    74		}
    75		stop := make(chan os.Signal, 1)
    76		signal.Notify(stop, syscall.SIGTERM, syscall.SIGINT)
    77		go func() {
    78			<-stop
    79			listener.Close()
    80		}()
    81		for {
    82			connection, acceptErr := listener.Accept()
    83			if acceptErr != nil {
    84				select {
    85				case <-stop:
    86					return nil
    87				default:
    88					return acceptErr
    89				}
    90			}
    91			handleInvocation(connection)
    92		}
    93	}
    94	
    95	func handleInvocation(connection net.Conn) {
    96		defer connection.Close()
    97		if err := connection.SetReadDeadline(time.Now().Add(5 * time.Second)); err != nil {
    98			return
    99		}
   100		peer, err := unixPeerCredential(connection)
   101		if err != nil || !authorizedSupervisorPeer(peer, peerProcessAlive) {
   102			return
   103		}
   104		request, err := readFramed(connection, maxEnvelopeBytes)
   105		if err != nil {
   106			return
   107		}
   108		defer zero(request)
   109		if !authorizedSupervisorPeer(peer, peerProcessAlive) {
   110			return
   111		}
   112		metadata, credentials, err := decodeInvocationFrame(request)
   113		if err != nil {
   114			return
   115		}
   116		var envelope invocationEnvelope
   117		if err := decodeStrictJSON(metadata, &envelope); err != nil {
   118			return
   119		}
   120		if err := connection.SetDeadline(time.Now().Add(16 * time.Minute)); err != nil {
   121			return
   122		}
   123		if envelope.Control == "baseline" {
   124			clean := cleanupTenantProcesses(int(peer.Pid), 2*time.Second)
   125			_ = json.NewEncoder(connection).Encode(map[string]bool{"ok": clean})
   126			return
   127		}
   128		response := runInvocation(&envelope, credentials, int(peer.Pid))
   129		clearEnvelope(&envelope)
   130		_ = json.NewEncoder(connection).Encode(response)
   131	}
   132	
   133	func runInvocation(
   134		envelope *invocationEnvelope,
   135		credentials []byte,
   136		peerPID int,
   137	) invocationResponse {
   138		started := time.Now()
   139		response := invocationResponse{OK: true, ExitCode: -1}
   140		if err := validateInvocation(envelope); err != nil {
   141			response.CleanupProven = cleanupTenantProcesses(peerPID, 2*time.Second)
   142			return response
   143		}
   144		if !cleanupTenantProcesses(peerPID, time.Duration(envelope.GraceMillis)*time.Millisecond) {
   145			return response
   146		}
   147	
   148		output := &boundedOutput{remaining: envelope.MaxOutputBytes}
   149		command := exec.Command("/bin/sh", "-c", envelope.Command)
   150		command.Dir = envelope.Cwd
   151		command.Env = []string{
   152			"HOME=/workspace",
   153			"LANG=C.UTF-8",
   154			"PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
   155			"TMPDIR=/tmp",
   156		}
   157		command.Stdout = streamWriter{output: output}
   158		command.Stderr = streamWriter{output: output, stderr: true}
   159		command.SysProcAttr = tenantProcessAttributes()
   160		var credentialReader *os.File
   161		var credentialWriter *os.File
   162		if len(credentials) > 0 {
   163			var pipeErr error
   164			credentialReader, credentialWriter, pipeErr = os.Pipe()
   165			if pipeErr != nil {
   166				response.CleanupProven = cleanupTenantProcesses(peerPID, 2*time.Second)
   167				return response
   168			}
   169			command.ExtraFiles = []*os.File{credentialReader}
   170		}
   171		if err := command.Start(); err != nil {
   172			if credentialReader != nil {
   173				credentialReader.Close()
   174				credentialWriter.Close()
   175			}
   176			response.CleanupProven = cleanupTenantProcesses(peerPID, 2*time.Second)
   177			return response
   178		}
   179		var credentialWriteDone chan struct{}
   180		if credentialReader != nil {
   181			credentialReader.Close()
   182			credentialWriteDone = make(chan struct{})
   183			go func() {
   184				defer close(credentialWriteDone)
   185				defer credentialWriter.Close()
   186				remaining := credentials
   187				for len(remaining) > 0 {
   188					written, err := credentialWriter.Write(remaining)
   189					if err != nil || written <= 0 {
   190						return
   191					}
   192					remaining = remaining[written:]
   193				}
   194			}()
   195		}
   196	
   197		done := make(chan error, 1)
   198		go func() { done <- command.Wait() }()
   199		timer := time.NewTimer(time.Duration(envelope.TimeoutMillis) * time.Millisecond)
   200		var waitErr error
   201		preWaitCleanupProven := true
   202		select {
   203		case waitErr = <-done:
   204			terminateProcessGroup(
   205				command.Process.Pid,
   206				time.Duration(envelope.GraceMillis)*time.Millisecond,
   207			)
   208		case <-timer.C:
   209			response.TimedOut = true
   210			_ = syscall.Kill(-command.Process.Pid, syscall.SIGTERM)
   211			grace := time.NewTimer(time.Duration(envelope.GraceMillis) * time.Millisecond)
   212			select {
   213			case waitErr = <-done:
   214				if !grace.Stop() {
   215					<-grace.C
   216				}
   217			case <-grace.C:
   218				_ = syscall.Kill(-command.Process.Pid, syscall.SIGKILL)
   219				preWaitCleanupProven = cleanupTenantProcesses(
   220					peerPID,
   221					time.Duration(envelope.GraceMillis)*time.Millisecond,
   222				)
   223				select {
   224				case waitErr = <-done:
   225				case <-time.After(time.Duration(envelope.GraceMillis) * time.Millisecond):
   226					if credentialWriter != nil {
   227						credentialWriter.Close()
   228						<-credentialWriteDone
   229					}
   230					response.DurationMillis = time.Since(started).Milliseconds()
   231					response.ExitCode = 124
   232					response.CleanupProven = false
   233					return response
   234				}
   235			}
   236		}
   237		if !timer.Stop() {
   238			select {
   239			case <-timer.C:
   240			default:
   241			}
   242		}
   243	
   244		response.ExitCode = exitCode(waitErr, response.TimedOut)
   245		response.DurationMillis = time.Since(started).Milliseconds()
   246		output.mu.Lock()
   247		response.StdoutBase64 = base64.StdEncoding.EncodeToString(output.stdout.Bytes())
   248		response.StderrBase64 = base64.StdEncoding.EncodeToString(output.stderr.Bytes())
   249		response.Truncated = output.truncated
   250		output.mu.Unlock()
   251		response.CleanupProven = preWaitCleanupProven && cleanupTenantProcesses(
   252			peerPID,
   253			time.Duration(envelope.GraceMillis)*time.Millisecond,
   254		)
   255		if credentialWriter != nil {
   256			credentialWriter.Close()
   257			<-credentialWriteDone
   258		}
   259		return response
   260	}
   261	
   262	func tenantProcessAttributes() *syscall.SysProcAttr {
   263		return &syscall.SysProcAttr{
   264			Setpgid:   true,
   265			Pdeathsig: syscall.SIGKILL,
   266			Credential: &syscall.Credential{
   267				Uid:    tenantUID,
   268				Gid:    tenantGID,
   269				Groups: []uint32{},
   270			},
   271		}
   272	}
   273	
   274	func prepareControlDirectory() error {
   275		if err := os.Mkdir(controlDirectory, 0o700); err != nil && !errors.Is(err, os.ErrExist) {
   276			return err
   277		}
   278		info, err := os.Lstat(controlDirectory)
   279		if err != nil || !info.IsDir() || info.Mode().Perm() != 0o700 {
   280			return errors.New("invalid supervisor control directory")
   281		}
   282		stat, ok := info.Sys().(*syscall.Stat_t)
   283		if !ok || stat.Uid != supervisorUID || stat.Gid != supervisorGID {
   284			return errors.New("invalid supervisor control directory owner")
   285		}
   286		return nil
   287	}
   288	
   289	func validateInvocation(envelope *invocationEnvelope) error {
   290		if envelope.Version != 1 || len(envelope.Command) == 0 || len(envelope.Command) > maxCommandBytes {
   291			return errors.New("invalid command")
   292		}
   293		if !workspaceCwd(envelope.Cwd) {
   294			return errors.New("invalid cwd")
   295		}
   296		if envelope.TimeoutMillis <= 0 || envelope.TimeoutMillis > maxTimeoutMillis ||
   297			envelope.GraceMillis <= 0 || envelope.GraceMillis > maxGraceMillis ||
   298			envelope.MaxOutputBytes <= 0 || envelope.MaxOutputBytes > maxOutputBytes {
   299			return errors.New("invalid limits")
   300		}
   301		return nil
   302	}
   303	
   304	func workspaceCwd(value string) bool {
   305		if len(value) == 0 || len(value) > maxPathBytes || strings.ContainsRune(value, 0) {
   306			return false
   307		}
   308		if value != workspaceRoot && !strings.HasPrefix(value, workspaceRoot+"/") {
   309			return false
   310		}
   311		for _, component := range strings.Split(value, "/") {
   312			if component == ".." {
   313				return false
   314			}
   315		}
   316		return true
   317	}
   318	
   319	func cleanupTenantProcesses(excludedPID int, grace time.Duration) bool {
   320		pids, err := tenantPIDs(excludedPID)
   321		if err != nil {
   322			return false
   323		}
   324		for _, pid := range pids {
   325			_ = syscall.Kill(pid, syscall.SIGTERM)
   326		}
   327		deadline := time.Now().Add(grace)
   328		for time.Now().Before(deadline) {
   329			reapChildren()
   330			remaining, listErr := tenantPIDs(excludedPID)
   331			if listErr != nil {
   332				return false
   333			}
   334			if len(remaining) == 0 {
   335				return true
   336			}
   337			time.Sleep(10 * time.Millisecond)
   338		}
   339		remaining, err := tenantPIDs(excludedPID)
   340		if err != nil {
   341			return false
   342		}
   343		for _, pid := range remaining {
   344			_ = syscall.Kill(pid, syscall.SIGKILL)
   345		}
   346		for attempt := 0; attempt < 200; attempt++ {
   347			reapChildren()
   348			remaining, err = tenantPIDs(excludedPID)
   349			if err != nil {
   350				return false
   351			}
   352			if len(remaining) == 0 {
   353				return true
   354			}
   355			time.Sleep(10 * time.Millisecond)
   356		}
   357		return false
   358	}
   359	
   360	func tenantPIDs(excludedPID int) ([]int, error) {
   361		entries, err := os.ReadDir("/proc")
   362		if err != nil {
   363			return nil, err
   364		}
   365		var pids []int
   366		for _, entry := range entries {
   367			var pid int
   368			if _, scanErr := fmt.Sscanf(entry.Name(), "%d", &pid); scanErr != nil {
   369				continue
   370			}
   371			if pid > 1 && pid != excludedPID {
   372				pids = append(pids, pid)
   373			}
   374		}
   375		return pids, nil
   376	}
