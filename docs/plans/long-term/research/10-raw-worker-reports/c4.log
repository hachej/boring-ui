   536	  async createInvite(
   537	    workspaceId: string,
   538	    email: string,
   539	    role: MemberRole,
   540	    invitedBy: string | null,
   541	    opts?: { ttlDays?: number },
   542	  ): Promise<{ invite: WorkspaceInvite; rawToken: string }> {
   543	    const rawToken = randomBytes(32).toString('base64url')
   544	    const tokenHash = createHash('sha256').update(rawToken).digest('hex')
   545	
   546	    const ttlDays = opts?.ttlDays ?? 7
   547	    const expiresAt = new Date(Date.now() + ttlDays * 24 * 60 * 60 * 1000)
   548	
   549	    const rows = await this.db
   550	      .insert(workspaceInvites)
   551	      .values({
   552	        workspaceId,
   553	        email: normalizeEmail(email),
   554	        tokenHash,
   555	        role,
   556	        expiresAt,
   557	        createdBy: invitedBy,
   558	      })
   559	      .returning()
   560	
   561	    return {
   562	      invite: toWorkspaceInvite(rows[0]),
   563	      rawToken,
   564	    }
   565	  }
