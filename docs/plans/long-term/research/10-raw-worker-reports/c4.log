    32	/**
    33	 * Optional per-agent MCP grant resolution, wired into the capability
    34	 * projection so `mcpServerRefs` resolve through this seam and no parallel
    35	 * authorization path. Omitting this entirely preserves prior behavior
    36	 * (no MCP connectors surfaced through this binding).
    37	 */
    38	export interface AgentHostRuntimeCapabilityMcpGrantsOptions {
    39	  readonly store: McpGrantStore
    40	  readonly catalog?: McpConnectorCatalog
    41	  /** The Agent definition's declared `mcpServerRefs` for a given agentTypeId, treated as connector ids. */
    42	  getMcpServerRefs(agentTypeId: string): readonly string[] | undefined
    43	}
