    63	   * workspace mount, so spawned shells cannot mutate protected paths that the
    64	   * Operations layer already refuses to mutate.
    65	   */
    66	  readonlyPaths?: readonly string[]
    67	}
    68	
    69	function normalizeReadonlyPath(input: string): string {
    70	  if (typeof input !== 'string' || input.length === 0) {
    71	    throw new Error('readonly path must be a non-empty workspace-relative path')
    72	  }
    73	  if (input.includes('\0') || input.includes('\n') || input.includes('\r')) {
    74	    throw new Error('readonly path must not contain null bytes or newlines')
    75	  }
    76	  const normalized = input.replace(/\\/g, '/')
    77	  if (normalized.startsWith('/')) {
    78	    throw new Error('readonly path must be workspace-relative')
    79	  }
    80	  const segments = normalized.split('/').filter((segment) => segment !== '' && segment !== '.')
    81	  if (segments.length === 0 || segments.includes('..')) {
    82	    throw new Error('readonly path must not be empty or contain traversal segments')
    83	  }
    84	  return segments.join('/')
    85	}
