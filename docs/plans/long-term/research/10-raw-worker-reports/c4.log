   100	function buildOpenAICompatibleProviderConfig(opts: {
   101	  models: Array<{ id: string; name?: string }>
   102	  apiKeyEnv: string
   103	  baseUrl: string
   104	  envPrefix: string
   105	  compatDefaults?: OpenAICompletionsCompatDefaults
   106	}): ProviderConfigInput {
   107	  return {
   108	    baseUrl: opts.baseUrl,
   109	    // pi-coding-agent 0.80.7 resolves `$ENV_VAR` config references through
   110	    // the provider environment. A bare name is a literal API key, which would
   111	    // send "INFOMANIAK_API_TOKEN" as the bearer token and cause provider 401s.
   112	    apiKey: `$${opts.apiKeyEnv}`,
   113	    api: 'openai-completions',
   114	    models: opts.models.map((model) => ({
   115	      id: model.id,
   116	      name: model.name ?? model.id,
   117	      api: 'openai-completions',
   118	      reasoning: readBoolean(`${opts.envPrefix}_REASONING`, true),
   119	      input: readModelInput(`${opts.envPrefix}_INPUT`),
   120	      cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
   121	      contextWindow: readPositiveInt(
   122	        `${opts.envPrefix}_CONTEXT_WINDOW`,
   123	        DEFAULT_CUSTOM_MODEL_CONTEXT_WINDOW,
   124	      ),
   125	      maxTokens: readPositiveInt(
   126	        `${opts.envPrefix}_MAX_TOKENS`,
   127	        DEFAULT_CUSTOM_MODEL_MAX_TOKENS,
   128	      ),
   129	      compat: buildOpenAICompletionsCompat(opts.envPrefix, opts.compatDefaults),
   130	    })),
   131	  }
   132	}
