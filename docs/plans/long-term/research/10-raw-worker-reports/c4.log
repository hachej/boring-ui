   160	  private async getWorkspaceAppId(workspaceId: string): Promise<string | null> {
   161	    const rows = await this.db
   162	      .select({ appId: workspaces.appId })
   163	      .from(workspaces)
   164	      .where(and(eq(workspaces.id, workspaceId), isNull(workspaces.deletedAt)))
