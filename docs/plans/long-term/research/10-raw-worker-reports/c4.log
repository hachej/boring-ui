    15	export function unmarkToolResultErrorDetails(details: unknown): { isMarked: boolean; details: unknown } {
    16	  if (!details || typeof details !== 'object' || Array.isArray(details)) return { isMarked: false, details }
    17	  const record = { ...(details as Record<string, unknown>) }
    18	  if (record[BORING_TOOL_ERROR_MARKER] !== true) return { isMarked: false, details }
    19	  delete record[BORING_TOOL_ERROR_MARKER]
    20	  if (Object.keys(record).length === 1 && 'details' in record) return { isMarked: true, details: record.details }
