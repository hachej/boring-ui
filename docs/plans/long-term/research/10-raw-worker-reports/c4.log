    34	/** Throws {@link McpGrantToolNameInvalidError} if any tool name in `allowedTools` contains a glob metacharacter (`*`, `?`, `[`, `]`). Call before persisting a grant. */
    35	export function assertValidGrantToolNames(allowedTools: readonly string[]): void {
    36	  for (const tool of allowedTools) {
    37	    if (GLOB_METACHARACTER_PATTERN.test(tool)) throw new McpGrantToolNameInvalidError(tool)
    38	  }
    39	}
