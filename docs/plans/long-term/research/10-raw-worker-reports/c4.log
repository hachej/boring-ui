   118	export interface AgentHostRuntimeCapabilityProjection {
   119	  readonly filterModels?: ModelsRoutesOptions['filterModels']
   120	  readonly sessionChangesTracker?: SessionChangesTracker
   121	  readonly metering?: Pick<AgentMeteringSink, 'isEnabled'>
   122	  registerSubscription(close: () => void | Promise<void>): () => void
   123	  authorizeRequest(input: {
   124	    readonly request: FastifyRequest
   125	    readonly agentTypeId: string
   126	  }): Promise<void>
   127	  resolveBinding(input: {
   128	    readonly request: FastifyRequest
   129	    readonly agentTypeId: string
   130	    readonly sessionId?: string
   131	  }): Promise<AgentHostRuntimeCapabilityBinding>
   132	  describeAgent(input: {
   133	    readonly request: FastifyRequest
   134	    readonly agentTypeId: string
   135	  }): Promise<AgentHostAgentDescription>
   136	  reload(input: {
   137	    readonly request: FastifyRequest
   138	    readonly agentTypeId: string
   139	    readonly requestId: string
   140	    readonly sessionId?: string
   141	  }): Promise<unknown>
   142	  executeCommand(input: {
   143	    readonly request: FastifyRequest
   144	    readonly agentTypeId: string
   145	    readonly requestId: string
   146	    readonly sessionId: string
   147	    readonly name: string
   148	    readonly args: string
   149	  }): Promise<unknown>
   150	}
