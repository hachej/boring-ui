   213	  async list(userId: string, appId: string): Promise<Workspace[]> {
   214	    const rows = await this.db
   215	      .select({ ws: workspaces })
   216	      .from(workspaces)
   217	      .innerJoin(
   218	        workspaceMembers,
   219	        and(
   220	          eq(workspaceMembers.workspaceId, workspaces.id),
   221	          eq(workspaceMembers.userId, userId),
   222	        ),
   223	      )
   224	      .where(and(eq(workspaces.appId, appId), isNull(workspaces.deletedAt)))
   225	      .orderBy(desc(workspaces.isDefault), desc(workspaces.createdAt))
   226	
   227	    return rows.map((r) => toWorkspace(r.ws))
   228	  }
