    60	function formatDisplayName(name: string): string {
    61	  const trimmed = name.trim().replace(/[<>]/g, '')
    62	  if (/^[A-Za-z0-9 ._-]+$/.test(trimmed)) return trimmed
    63	  return `"${trimmed.replace(/["\\]/g, '\\$&')}"`
    64	}
    65	
    66	function isDefaultBoringDisplayName(name: string): boolean {
    67	  return name.toLowerCase().replace(/[\s._-]+/g, '') === 'boringui'
    68	}
    69	
    70	function normalizeMailFrom(appName: string, rawFrom: string): string {
    71	  const from = rawFrom.trim()
    72	  const addressWithDisplay = from.match(/^(.*?)\s*<([^>]+)>$/)
    73	  if (addressWithDisplay) {
    74	    const displayName = addressWithDisplay[1].trim().replace(/^"(.*)"$/, '$1')
    75	    const address = addressWithDisplay[2].trim()
    76	    if (!displayName || isDefaultBoringDisplayName(displayName)) {
    77	      return `${formatDisplayName(appName)} <${address}>`
    78	    }
    79	    return from
    80	  }
    81	
    82	  if (/^[^\s@<>]+@[^\s@<>]+$/.test(from)) {
    83	    return `${formatDisplayName(appName)} <${from}>`
    84	  }
    85	
    86	  return from
    87	}
