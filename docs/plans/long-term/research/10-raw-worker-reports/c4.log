   173	
   174	  async create(userId: string, name: string, appId: string, opts?: WorkspaceStoreCreateOptions): Promise<Workspace> {
   175	    const workspaceTypeId = parseTrustedWorkspaceTypeId(opts?.workspaceTypeId)
   176	    const defaultAgentTypeId = parseTrustedDefaultAgentTypeId(opts?.defaultAgentTypeId)
   177	    return this.db.transaction(async (tx) => {
   178	      const insert = tx
   179	        .insert(workspaces)
   180	        .values({
   181	          ...(opts?.id ? { id: opts.id } : {}),
   182	          appId,
   183	          workspaceTypeId,
   184	          name,
   185	          createdBy: userId,
   186	          isDefault: opts?.isDefault ?? false,
   187	          managedBy: opts?.managedBy ?? null,
   188	          defaultAgentTypeId,
   189	        })
   190	
   191	      const insertedRows = opts?.id
   192	        ? await insert.onConflictDoNothing().returning()
   193	        : await insert.returning()
   194	
   195	      const row = insertedRows[0] ?? (opts?.id
   196	        ? (await tx.select().from(workspaces).where(eq(workspaces.id, opts.id)).limit(1))[0]
   197	        : undefined)
   198	      if (!row) throw new Error(`Workspace ${opts?.id ?? name} was not created`)
   199	      assertWorkspaceTypeIdMatches(row.workspaceTypeId, workspaceTypeId)
   200	
   201	      if (insertedRows.length > 0) {
   202	        await tx.insert(workspaceMembers).values({
   203	          workspaceId: row.id,
   204	          userId,
   205	          role: 'owner',
   206	        })
   207	      }
   208	
   209	      return toWorkspace(row)
   210	    })
   211	  }
