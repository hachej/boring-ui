     7	const BORING_TOOL_ERROR_MARKER = '__boringToolError'
     8	
     9	export function markToolResultErrorDetails(details: unknown): Record<string, unknown> {
    10	  return details && typeof details === 'object' && !Array.isArray(details)
    11	    ? { ...(details as Record<string, unknown>), [BORING_TOOL_ERROR_MARKER]: true }
    12	    : { [BORING_TOOL_ERROR_MARKER]: true, details }
    13	}
    14	
    15	export function unmarkToolResultErrorDetails(details: unknown): { isMarked: boolean; details: unknown } {
    16	  if (!details || typeof details !== 'object' || Array.isArray(details)) return { isMarked: false, details }
    17	  const record = { ...(details as Record<string, unknown>) }
    18	  if (record[BORING_TOOL_ERROR_MARKER] !== true) return { isMarked: false, details }
    19	  delete record[BORING_TOOL_ERROR_MARKER]
    20	  if (Object.keys(record).length === 1 && 'details' in record) return { isMarked: true, details: record.details }
    21	  return { isMarked: true, details: record }
    22	}
    23	
    24	function toolTelemetryProperties(
    25	  toolName: string,
    26	  sessionId: string | undefined,
    27	  status: 'ok' | 'error',
    28	  startedAt: number,
    29	  result?: ToolResult,
    30	): Record<string, string | number> {
    31	  const properties: Record<string, string | number> = {
    32	    toolName,
    33	    status,
    34	    durationMs: Date.now() - startedAt,
    35	  }
    36	  if (sessionId) properties.sessionId = sessionId
    37	  const errorCode = (result?.details as { code?: unknown } | undefined)?.code
    38	  if (status === 'error') {
    39	    properties.errorCode = ErrorCode.safeParse(errorCode).success
    40	      ? (errorCode as string)
    41	      : ErrorCode.enum.TOOL_EXECUTION_ERROR
    42	  }
    43	  return properties
    44	}
    45	
    46	export function adaptToolForPi(tool: AgentTool, sessionId?: string, telemetry: TelemetrySink = noopTelemetry, getRunContext?: () => RunContext | undefined): ToolDefinition {
    47	  return {
    48	    name: tool.name,
    49	    label: tool.name,
    50	    description: tool.description,
    51	    parameters: tool.parameters as any,
    52	    promptSnippet: tool.promptSnippet ?? tool.description,
    53	    async execute(toolCallId, params, signal, onUpdate, _ctx) {
    54	      const startedAt = Date.now();
    55	      let emittedFailure = false;
    56	      try {
    57	        const runContext = getRunContext?.();
    58	        const result = await tool.execute(params as Record<string, unknown>, {
    59	          toolCallId,
    60	          abortSignal: signal ?? new AbortController().signal,
    61	          onUpdate: onUpdate
    62	            ? (partial) => onUpdate({ content: [{ type: "text", text: partial }], details: undefined })
    63	            : undefined,
    64	          sessionId,
    65	          userId: runContext?.userId,
    66	          userEmail: runContext?.userEmail,
    67	          userEmailVerified: runContext?.userEmailVerified,
    68	          workspaceId: runContext?.workspaceId,
    69	          requestId: runContext?.requestId,
    70	        });
    71	        safeCapture(telemetry, {
    72	          name: result.isError ? 'agent.tool.failed' : 'agent.tool.completed',
    73	          properties: toolTelemetryProperties(
    74	            tool.name,
    75	            sessionId,
    76	            result.isError ? 'error' : 'ok',
    77	            startedAt,
    78	            result,
    79	          ),
    80	        });
    81	        if (result.isError) {
    82	          emittedFailure = true;
    83	          return {
    84	            content: result.content,
    85	            details: markToolResultErrorDetails(result.details),
    86	          };
    87	        }
    88	        return {
    89	          content: result.content,
    90	          details: result.details,
    91	        };
    92	      } catch (error) {
    93	        if (!emittedFailure) {
    94	          safeCapture(telemetry, {
    95	            name: 'agent.tool.failed',
    96	            properties: toolTelemetryProperties(tool.name, sessionId, 'error', startedAt),
    97	          });
    98	        }
    99	        throw error;
   100	      }
   101	    },
   102	  } as ToolDefinition;
   103	}
