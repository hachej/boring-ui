   773	
   774	  async decryptSetting(
   775	    workspaceId: string,
   776	    key: string,
   777	    db: DbLike = this.db,
   778	  ): Promise<string | null> {
   779	    try {
   780	      const rows = await db
   781	        .select({
   782	          plaintext: sql<string>`pgp_sym_decrypt(${workspaceSettings.value}, ${this.workspaceSettingsKey})::text`,
   783	        })
   784	        .from(workspaceSettings)
   785	        .where(
   786	          and(
   787	            eq(workspaceSettings.workspaceId, workspaceId),
   788	            eq(workspaceSettings.key, key),
   789	          ),
   790	        )
   791	        .limit(1)
   792	
   793	      return rows[0]?.plaintext ?? null
   794	    } catch (err) {
   795	      const code = err instanceof Error ? err.constructor.name : 'unknown'
   796	      console.error(`[workspace-store] decryptSetting failed for key="${key}" workspace="${workspaceId}": ${code}`)
   797	      return null
   798	    }
   799	  }
   800	
   801	  async encryptAndPut(
   802	    workspaceId: string,
   803	    key: string,
   804	    value: string,
   805	    db: DbLike = this.db,
   806	  ): Promise<void> {
   807	    if (!this.workspaceSettingsKey) {
   808	      throw new Error('WORKSPACE_SETTINGS_ENCRYPTION_KEY is not configured — cannot store encrypted settings')
   809	    }
   810	    await db.execute(sql`
   811	      INSERT INTO workspace_settings (workspace_id, key, value, updated_at)
   812	      VALUES (${workspaceId}::uuid, ${key}, pgp_sym_encrypt(${value}, ${this.workspaceSettingsKey}), NOW())
   813	      ON CONFLICT (workspace_id, key)
   814	      DO UPDATE SET value = pgp_sym_encrypt(${value}, ${this.workspaceSettingsKey}), updated_at = NOW()
   815	    `)
   816	  }
   817	
   818	  async getWorkspaceSettings(
   819	    workspaceId: string,
   820	  ): Promise<Array<{ key: string; configured: boolean; updated_at: string }>> {
   821	    const rows = await this.db
   822	      .select({ key: workspaceSettings.key, updatedAt: workspaceSettings.updatedAt })
   823	      .from(workspaceSettings)
   824	      .where(eq(workspaceSettings.workspaceId, workspaceId))
   825	      .orderBy(workspaceSettings.key)
   826	
   827	    const metadata: Array<{ key: string; configured: boolean; updated_at: string }> = []
   828	
   829	    for (const row of rows) {
   830	      const decrypted = await this.decryptSetting(workspaceId, row.key)
   831	      metadata.push({
   832	        key: row.key,
   833	        configured: decrypted !== null,
   834	        updated_at: row.updatedAt.toISOString(),
   835	      })
   836	    }
   837	
   838	    return metadata
   839	  }
   840	
   841	  async putWorkspaceSettings(
   842	    workspaceId: string,
   843	    settings: Record<string, string>,
   844	  ): Promise<Array<{ key: string; configured: boolean; updated_at: string }>> {
   845	    await this.db.transaction(async (tx) => {
   846	      for (const [key, value] of Object.entries(settings)) {
   847	        await this.encryptAndPut(workspaceId, key, value, tx)
   848	      }
   849	    })
   850	
   851	    return this.getWorkspaceSettings(workspaceId)
   852	  }
