   136	/** In-memory reference implementation, useful for tests and for hosts with no persistent workspace store wired yet. Default-deny still holds: no grants means no connectors. */
   137	export function createInMemoryMcpGrantStore(seed: readonly McpGrant[] = []): McpGrantStore {
   138	  const grants = new Map<string, McpGrant>()
   139	  const key = (g: Pick<McpGrant, 'workspaceId' | 'agentTypeId' | 'connectorId'>) =>
   140	    `${g.workspaceId}:${g.agentTypeId}:${g.connectorId}`
   141	  for (const grant of seed) grants.set(key(grant), grant)
   142	  return {
   143	    async listGrants(workspaceId) {
   144	      return { grants: Array.from(grants.values()).filter((g) => g.workspaceId === workspaceId), diagnostics: [] }
   145	    },
   146	    async putGrant(grant) {
   147	      assertValidGrantToolNames(grant.allowedTools)
   148	      grants.set(key(grant), grant)
   149	    },
   150	    async deleteGrant(input) {
   151	      grants.delete(key(input))
   152	    },
   153	  }
   154	}
