   411	      | typeof ERROR_CODES.LAST_OWNER
   412	      | typeof ERROR_CODES.NOT_MEMBER
   413	      | typeof ERROR_CODES.AGENT_HOST_MANAGED_WORKSPACE_MUTATION_FORBIDDEN
   414	  }> {
   415	    return this.db.transaction(async (tx) => {
   416	      await tx.execute(sql`
   417	        SELECT user_id
   418	        FROM workspace_members
   419	        WHERE workspace_id = ${workspaceId}
   420	        FOR UPDATE
   421	      `)
   422	
   423	      const memberRows = await tx
   424	        .select({ role: workspaceMembers.role })
   425	        .from(workspaceMembers)
   426	        .where(
   427	          and(
   428	            eq(workspaceMembers.workspaceId, workspaceId),
   429	            eq(workspaceMembers.userId, userId),
   430	          ),
   431	        )
   432	        .limit(1)
   433	      const currentRole = memberRows[0]?.role as MemberRole | undefined
   434	      if (!currentRole) return { code: ERROR_CODES.NOT_MEMBER }
   435	      if (opts?.forbidExistingOwnerMutation && currentRole === 'owner' && role !== 'owner') return { code: ERROR_CODES.AGENT_HOST_MANAGED_WORKSPACE_MUTATION_FORBIDDEN }
   436	
   437	      if (currentRole === 'owner' && role !== 'owner') {
   438	        const [{ count }] = await tx
   439	          .select({ count: sql<number>`count(*)::int` })
   440	          .from(workspaceMembers)
   441	          .where(
   442	            and(
   443	              eq(workspaceMembers.workspaceId, workspaceId),
   444	              eq(workspaceMembers.role, sql`'owner'`),
   445	            ),
   446	          )
   447	        if (Number(count) <= 1) {
   448	          return { code: ERROR_CODES.LAST_OWNER }
   449	        }
   450	      }
   451	
   452	      const [updated] = await tx
   453	        .update(workspaceMembers)
   454	        .set({ role })
   455	        .where(
   456	          and(
   457	            eq(workspaceMembers.workspaceId, workspaceId),
   458	            eq(workspaceMembers.userId, userId),
   459	          ),
   460	        )
   461	        .returning()
   462	      return { member: toWorkspaceMember(updated) }
   463	    })
   464	  }
   465	
   466	  async removeMember(
   467	    workspaceId: string,
   468	    userId: string,
   469	    opts?: { allowLastOwner?: boolean; forbidExistingOwnerMutation?: boolean },
   470	  ): Promise<{
   471	    removed: boolean
   472	    code?:
   473	      | typeof ERROR_CODES.LAST_OWNER
   474	      | typeof ERROR_CODES.NOT_MEMBER
   475	      | typeof ERROR_CODES.AGENT_HOST_MANAGED_WORKSPACE_MUTATION_FORBIDDEN
   476	  }> {
   477	    return this.db.transaction(async (tx) => {
   478	      await tx.execute(sql`
   479	        SELECT user_id
   480	        FROM workspace_members
   481	        WHERE workspace_id = ${workspaceId}
   482	          ${opts?.forbidExistingOwnerMutation ? sql`` : sql`AND role = 'owner'`}
   483	        FOR UPDATE
   484	      `)
   485	
   486	      const memberRows = await tx
   487	        .select({ role: workspaceMembers.role })
   488	        .from(workspaceMembers)
   489	        .where(
   490	          and(
   491	            eq(workspaceMembers.workspaceId, workspaceId),
   492	            eq(workspaceMembers.userId, userId),
   493	          ),
   494	        )
   495	        .limit(1)
   496	      const role = memberRows[0]?.role as MemberRole | undefined
   497	      if (!role) return { removed: false, code: ERROR_CODES.NOT_MEMBER }
   498	      if (opts?.forbidExistingOwnerMutation && role === 'owner') return { removed: false, code: ERROR_CODES.AGENT_HOST_MANAGED_WORKSPACE_MUTATION_FORBIDDEN }
   499	
   500	      if (!opts?.allowLastOwner && role === 'owner') {
   501	        const [{ count }] = await tx
   502	          .select({ count: sql<number>`count(*)::int` })
   503	          .from(workspaceMembers)
   504	          .where(
   505	            and(
   506	              eq(workspaceMembers.workspaceId, workspaceId),
   507	              eq(workspaceMembers.role, sql`'owner'`),
   508	            ),
   509	          )
   510	        if (Number(count) <= 1) {
   511	          return { removed: false, code: ERROR_CODES.LAST_OWNER }
   512	        }
   513	      }
   514	
   515	      const deletedRows = await tx
   516	        .delete(workspaceMembers)
   517	        .where(
   518	          and(
   519	            eq(workspaceMembers.workspaceId, workspaceId),
   520	            eq(workspaceMembers.userId, userId),
   521	          ),
   522	        )
   523	        .returning({ userId: workspaceMembers.userId })
   524	      if (deletedRows.length === 0) {
   525	        return { removed: false, code: ERROR_CODES.NOT_MEMBER }
   526	      }
   527	
   528	      return { removed: true }
   529	    })
   530	  }
