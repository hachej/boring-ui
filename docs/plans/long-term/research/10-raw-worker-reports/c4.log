   854	  async getWorkspaceRuntime(workspaceId: string): Promise<WorkspaceRuntime | null> {
   855	    const appId = await this.getWorkspaceAppId(workspaceId)
   856	    if (!appId) return null
   857	
   858	    const existingRows = await this.db
   859	      .select()
   860	      .from(workspaceRuntimes)
   861	      .where(eq(workspaceRuntimes.workspaceId, workspaceId))
   862	      .limit(1)
   863	
   864	    if (existingRows.length > 0) {
   865	      return toWorkspaceRuntime(existingRows[0])
   866	    }
   867	
   868	    await this.db
   869	      .insert(workspaceRuntimes)
   870	      .values({
   871	        workspaceId,
   872	        spriteUrl: null,
   873	        spriteName: null,
   874	        state: 'ready',
   875	        lastError: null,
   876	        sandboxProvider: null,
   877	        sandboxId: null,
   878	        sandboxStatus: null,
   879	        sandboxSnapshotId: null,
   880	        sandboxCreatedAt: null,
   881	        sandboxLastUsedAt: null,
   882	        sandboxLastSeenAt: null,
   883	        sandboxExpiresAt: null,
   884	        provisioningStep: null,
   885	        stepStartedAt: null,
   886	        updatedAt: new Date(),
   887	      })
   888	      .onConflictDoNothing()
   889	
   890	    const createdRows = await this.db
   891	      .select()
   892	      .from(workspaceRuntimes)
   893	      .where(eq(workspaceRuntimes.workspaceId, workspaceId))
   894	      .limit(1)
   895	
   896	    if (createdRows.length === 0) return null
   897	    return toWorkspaceRuntime(createdRows[0])
   898	  }
