   539	function normalizeSnapshotMessages(messages: BoringChatMessage[]): BoringChatMessage[] {
   540	  const normalized: BoringChatMessage[] = []
   541	  for (const message of messages) {
   542	    const next = normalizeChatMessage(message)
   543	    const previous = normalized[normalized.length - 1]
   544	    if (previous?.role === 'assistant' && next.role === 'assistant' && shouldMergeAssistantSnapshotMessages(previous, next)) {
   545	      normalized[normalized.length - 1] = mergeAssistantSnapshotMessages(previous, next)
   546	    } else {
   547	      normalized.push(next)
   548	    }
   549	  }
   550	  return normalized
   551	}
   552	
   553	function shouldMergeAssistantSnapshotMessages(previous: BoringChatMessage, next: BoringChatMessage): boolean {
   554	  if (previous.turnId && next.turnId && previous.turnId !== next.turnId) return false
   555	  if (previous.id === next.id) return true
   556	  return Boolean(previous.turnId && next.turnId && previous.turnId === next.turnId)
   557	}
