   150	function readLatestSeq(value: unknown): number | undefined {
   151	  if (typeof value !== 'object' || value === null) return undefined
   152	  const record = value as Record<string, unknown>
   153	  if (typeof record.latestSeq === 'number' && Number.isInteger(record.latestSeq) && record.latestSeq >= 0) return record.latestSeq
   154	  const details = record.details
   155	  if (typeof details === 'object' && details !== null) {
   156	    const latestSeq = (details as Record<string, unknown>).latestSeq
   157	    if (typeof latestSeq === 'number' && Number.isInteger(latestSeq) && latestSeq >= 0) return latestSeq
   158	  }
   159	  return undefined
   160	}
