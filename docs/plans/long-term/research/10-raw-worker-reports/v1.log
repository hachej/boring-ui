   162	export function parsePiChatReplayRangeError(status: number, body: unknown): PiChatReplayRangeError | null {
   163	  if (status !== 409 || typeof body !== 'object' || body === null) return null
   164	  const record = body as Record<string, unknown>
   165	  const payload = typeof record.error === 'object' && record.error !== null ? (record.error as Record<string, unknown>) : record
   166	  const details = typeof payload.details === 'object' && payload.details !== null ? payload.details as Record<string, unknown> : undefined
   167	  const gatewayReason = payload.code === 'AGENT_SESSION_REPLAY_GAP'
   168	    ? PI_CHAT_REPLAY_GAP_CODE
   169	    : payload.code === 'AGENT_SESSION_CURSOR_AHEAD'
   170	      ? PI_CHAT_CURSOR_AHEAD_CODE
   171	      : undefined
   172	  const reason = gatewayReason ?? (payload.code === PI_CHAT_REPLAY_GAP_CODE || payload.code === PI_CHAT_CURSOR_AHEAD_CODE
   173	    ? payload.code
   174	    : payload.message === PI_CHAT_REPLAY_GAP_CODE || payload.message === PI_CHAT_CURSOR_AHEAD_CODE
   175	      ? payload.message
   176	      : details?.reason === PI_CHAT_REPLAY_GAP_CODE || details?.reason === PI_CHAT_CURSOR_AHEAD_CODE
   177	        ? details.reason
   178	        : undefined)
   179	  if (reason !== PI_CHAT_REPLAY_GAP_CODE && reason !== PI_CHAT_CURSOR_AHEAD_CODE) return null
   180	  const latestSeq = readLatestSeq(payload) ?? readLatestSeq(record)
   181	  if (latestSeq === undefined) return null
   182	  return { type: reason, latestSeq }
   183	}
