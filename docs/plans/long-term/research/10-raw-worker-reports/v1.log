   824	    const candidate = messages[candidateIndex]
   825	    if (candidate?.id === message.id && candidate.turnId === message.turnId) {
   826	      index = candidateIndex
   827	      break
   828	    }
   829	  }
   830	  if (index < 0) return [...messages, message]
   831	  const next = [...messages]
   832	  next[index] = message
   833	  return next
   834	}
