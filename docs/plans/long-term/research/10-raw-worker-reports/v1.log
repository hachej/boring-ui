    41	export function parsePiChatNdjsonLine(line: string): PiChatStreamParseResult {
    42	  const trimmed = line.trim()
    43	  if (!trimmed) return { type: 'blank' }
    44	
    45	  let value: unknown
    46	  try {
    47	    value = JSON.parse(trimmed)
    48	  } catch (error) {
    49	    return { type: 'malformed-json', line, error }
    50	  }
    51	
    52	  let frameValue = value
    53	  if (
    54	    typeof value === 'object'
    55	    && value !== null
    56	    && 'ref' in value
    57	    && 'seq' in value
    58	    && 'event' in value
    59	  ) {
    60	    const envelope = value as { seq?: unknown; event?: unknown }
    61	    const eventSeq = typeof envelope.event === 'object' && envelope.event !== null
    62	      ? (envelope.event as { seq?: unknown }).seq
    63	      : undefined
    64	    if (typeof envelope.seq !== 'number' || envelope.seq !== eventSeq) {
    65	      return { type: 'schema-error', line, error: new Error('addressed event envelope seq mismatch') }
    66	    }
    67	    frameValue = envelope.event
    68	  }
    69	
    70	  const parsed = PiChatStreamFrameSchema.safeParse(frameValue)
    71	  if (!parsed.success) {
    72	    return { type: 'schema-error', line, error: parsed.error }
    73	  }
    74	
    75	  return { type: 'frame', frame: parsed.data }
    76	}
