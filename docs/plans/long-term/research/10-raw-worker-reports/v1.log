    78	export async function readPiChatNdjsonStream(stream: ReadableStream<Uint8Array>, handlers: PiChatStreamHandlers): Promise<void> {
    79	  const reader = stream.getReader()
    80	  const decoder = new TextDecoder()
    81	  let buffered = ''
    82	
    83	  const processLine = (line: string) => {
    84	    const result = parsePiChatNdjsonLine(line)
    85	    if (result.type === 'frame') {
    86	      handlers.onFrame?.(result.frame)
    87	      return
    88	    }
    89	    if (result.type !== 'blank') {
    90	      handlers.onProtocolError?.(result)
    91	    }
    92	  }
    93	
    94	  try {
    95	    while (true) {
    96	      const { value, done } = await reader.read()
    97	      if (done) break
    98	      buffered += decoder.decode(value, { stream: true })
    99	
   100	      let newlineIndex = buffered.indexOf('\n')
   101	      while (newlineIndex >= 0) {
   102	        const line = buffered.slice(0, newlineIndex)
   103	        buffered = buffered.slice(newlineIndex + 1)
   104	        processLine(line)
   105	        newlineIndex = buffered.indexOf('\n')
   106	      }
   107	    }
   108	
   109	    buffered += decoder.decode()
   110	    if (buffered.length > 0) processLine(buffered)
   111	  } finally {
   112	    reader.releaseLock()
   113	  }
   114	}
