   618	): { state: PiChatState; message: BoringChatMessage } {
   619	  const message: BoringChatMessage = {
   620	    id: messageId,
   621	    role: 'assistant',
   622	    status: 'streaming',
   623	    createdAt: options.createdAt,
   624	    turnId: state.turnId,
