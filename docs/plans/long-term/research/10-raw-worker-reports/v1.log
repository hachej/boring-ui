   123	export function createPiChatFrameProcessor(initialSeq: number, handlers: PiChatFrameProcessorHandlers) {
   124	  let lastSeq = initialSeq
   125	
   126	  return {
   127	    getLastSeq() {
   128	      return lastSeq
   129	    },
   130	    handle(frame: PiChatStreamFrame): PiChatStreamSeqResult | { type: 'heartbeat' } {
   131	      if (frame.type === 'heartbeat') {
   132	        handlers.onHeartbeat?.(frame)
   133	        return { type: 'heartbeat' }
   134	      }
   135	
   136	      const result = processPiChatSequencedEvent(lastSeq, frame)
   137	      if (result.type === 'applied') {
