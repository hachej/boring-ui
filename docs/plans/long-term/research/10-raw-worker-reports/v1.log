   495	type ToolCallTarget = { type: 'streaming' } | { type: 'committed'; index: number }
   496	
   497	function findToolCallTarget(state: PiChatState, toolCallId: string): ToolCallTarget | undefined {
   498	  if (state.streamingMessage?.parts.some((part) => part.type === 'tool-call' && part.id === toolCallId)) return { type: 'streaming' }
   499	  const committedIndex = findLatestCommittedMessageIndexWithToolCall(state.committedMessages, toolCallId)
   500	  return committedIndex >= 0 ? { type: 'committed', index: committedIndex } : undefined
   501	}
   502	
   503	function findLatestCommittedMessageIndexWithToolCall(messages: BoringChatMessage[], toolCallId: string): number {
   504	  for (let index = messages.length - 1; index >= 0; index -= 1) {
   505	    const message = messages[index]
   506	    if (message?.parts.some((part) => part.type === 'tool-call' && part.id === toolCallId)) return index
   507	  }
   508	  return -1
   509	}
   510	
   511	function updateToolCallTarget(
   512	  state: PiChatState,
   513	  target: ToolCallTarget,
   514	  toolCallId: string,
   515	  update: (part: Extract<BoringChatPart, { type: 'tool-call' }>) => BoringChatPart,
   516	): PiChatState {
   517	  if (target.type === 'streaming') {
   518	    return state.streamingMessage
   519	      ? { ...state, streamingMessage: updateToolPart(state.streamingMessage, toolCallId, update) }
   520	      : state
   521	  }
   522	  const message = state.committedMessages[target.index]
   523	  if (!message) return state
   524	  const nextCommitted = [...state.committedMessages]
   525	  nextCommitted[target.index] = updateToolPart(message, toolCallId, update)
   526	  return { ...state, committedMessages: nextCommitted }
   527	}
