import { DatabaseSync } from 'node:sqlite';
import { describe, expect, it } from 'vitest';
import { admitOne, claimOne, databasePath, openStore, seedSession } from './helpers.js';

function setup() {
  const store = openStore(databasePath()); seedSession(store); admitOne(store); claimOne(store); return store;
}

function settle(store: ReturnType<typeof openStore>, overrides: Record<string, unknown> = {}) {
  return store.settle({ sessionId: 'session-1', submissionId: 'submission-1', attemptId: 'attempt-1',
    ownerId: 'worker-a', ownerEpoch: 7, now: 1_050, outcome: 'completed',
    payload: { answer: 'ok' }, payloadDigest: 'settlement-1', recordId: 'settlement-record-1', ...overrides });
}

describe('V5 A1/A3 Settle', () => {
  it('FATAL reservation, terminal record, and final binding commit as one transaction', () => {
    const store = setup();
    expect(settle(store)).toMatchObject({ status: 'settled', settlementRecordId: 'settlement-record-1' });
    expect(store.listRecords('session-1').filter(r => r.kind === 'submission_settled')).toHaveLength(1);
    store.close();
  });

  it('FATAL concurrent logical settles produce exactly one canonical terminal outcome', () => {
    const store = setup(); settle(store);
    expect(() => settle(store, { outcome: 'failed', payloadDigest: 'settlement-2',
      recordId: 'settlement-record-2' })).toThrow(/settlement conflict/i);
    expect(store.listRecords('session-1').filter(r => r.kind === 'submission_settled')).toMatchObject([
      { recordId: 'settlement-record-1', payload: { outcome: 'completed', value: { answer: 'ok' } } },
    ]);
    store.close();
  });

  it('FATAL the schema rejects an unreserved generic terminal record', () => {
    const path = databasePath();
    const store = openStore(path); seedSession(store); admitOne(store); claimOne(store); store.close();
    const raw = new DatabaseSync(path); raw.exec('PRAGMA foreign_keys=ON');
    raw.prepare(`INSERT INTO stream_batches
      (tenant_id, workspace_id, stream_id, session_id, incarnation_uid, batch_no, producer_id,
       producer_epoch, producer_sequence, submission_id, attempt_id, record_count, content_digest, committed_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`).run(
      'tenant-a', 'workspace-a', 'stream:session-1', 'session-1', 'incarnation:session-1', 0,
      'worker-a', 7, 0, 'submission-1', 'attempt-1', 1, 'forged', 1_050,
    );
    expect(() => raw.prepare(`INSERT INTO stream_records
      (tenant_id, workspace_id, stream_id, session_id, batch_no, record_index, record_id, kind,
       payload, payload_digest, submission_id, attempt_id, committed_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, 'submission_settled', ?, ?, ?, ?, ?)`).run(
      'tenant-a', 'workspace-a', 'stream:session-1', 'session-1', 0, 0, 'forged-terminal',
      JSON.stringify({ outcome: 'completed' }), 'forged', 'submission-1', 'attempt-1', 1_050,
    )).toThrow(/not reserved/i);
    raw.close();
  });

  it('abort intent wins over a later successful worker result', () => {
    const store = setup(); store.requestAbort({ submissionId: 'submission-1', now: 1_040, principalId: 'user-1', reason: 'stop' });
    expect(settle(store).settlementOutcome).toBe('aborted');
    expect(store.listRecords('session-1').at(-1)?.payload).toMatchObject({ outcome: 'aborted' });
    store.close();
  });

  it('FATAL an expired owner can be reclaimed and then reach one terminal outcome', () => {
    const store = setup();
    store.claim({ sessionId: 'session-1', ownerId: 'worker-b', ownerEpoch: 8,
      attemptId: 'attempt-2', now: 1_101, leaseDurationMs: 100 });
    expect(store.settle({ sessionId: 'session-1', submissionId: 'submission-1', attemptId: 'attempt-2',
      ownerId: 'worker-b', ownerEpoch: 8, now: 1_150, outcome: 'failed', payload: { reason: 'retry' },
      payloadDigest: 'settlement-retry', recordId: 'settlement-record-retry' }).status).toBe('settled');
    expect(store.listRecords('session-1').filter(r => r.kind === 'submission_settled')).toHaveLength(1);
    store.close();
  });
});
import { DatabaseSync } from 'node:sqlite';
import { describe, expect, it } from 'vitest';
import { admitOne, claimOne, databasePath, openStore, seedSession } from './helpers.js';

function append(store: ReturnType<typeof openStore>, overrides: Record<string, unknown> = {}) {
  return store.appendBatch({
    sessionId: 'session-1', submissionId: 'submission-1', attemptId: 'attempt-1',
    producerId: 'worker-a', producerEpoch: 7, producerSequence: 0,
    contentDigest: 'batch-digest-1', now: 1_050,
    records: [
      { recordId: 'record-1', kind: 'assistant_delta', payload: { text: 'a' } },
      { recordId: 'record-2', kind: 'assistant_delta', payload: { text: 'b' } },
    ],
    ...overrides,
  });
}

describe('V5 A1/A2 Append batch and fencing', () => {
  it('FATAL exact retry is checked before the advanced producer sequence', () => {
    const store = openStore(databasePath()); seedSession(store); admitOne(store); claimOne(store);
    const first = append(store);
    expect(append(store)).toEqual(first);
    expect(store.listRecords('session-1')).toHaveLength(2);
    store.close();
  });

  it('FATAL retry identity includes every immutable batch input', () => {
    const store = openStore(databasePath()); seedSession(store); admitOne(store); claimOne(store);
    append(store);
    expect(() => append(store, { contentDigest: 'different' })).toThrow(/retry conflict/i);
    expect(() => append(store, { records: [
      { recordId: 'record-1', kind: 'assistant_delta', payload: { text: 'tampered' } },
      { recordId: 'record-2', kind: 'assistant_delta', payload: { text: 'b' } },
    ] })).toThrow(/retry conflict/i);
    store.close();
  });

  it('FATAL a replaced attempt cannot append after replacement commits', () => {
    const store = openStore(databasePath()); seedSession(store); admitOne(store); claimOne(store);
    store.claim({ sessionId: 'session-1', ownerId: 'worker-b', ownerEpoch: 8,
      attemptId: 'attempt-2', now: 1_101, leaseDurationMs: 100 });
    expect(() => append(store, { now: 1_102 })).toThrow(/fenced/i);
    expect(store.listRecords('session-1')).toHaveLength(0);
    store.close();
  });

  it('SERIOUS all records commit atomically at one shared batch offset', () => {
    const path = databasePath();
    const store = openStore(path); seedSession(store); admitOne(store); claimOne(store);
    const batch = append(store);
    const records = store.listRecords('session-1');
    expect(records.map(r => r.batchNo)).toEqual([batch.batchNo, batch.batchNo]);
    expect(records.map(r => r.recordIndex)).toEqual([0, 1]);
    store.close();

    const raw = new DatabaseSync(path);
    expect(() => raw.prepare(`DELETE FROM stream_records WHERE tenant_id=? AND workspace_id=? AND record_id=?`)
      .run('tenant-a', 'workspace-a', 'record-1')).toThrow(/record is immutable/i);
    raw.close();
  });
