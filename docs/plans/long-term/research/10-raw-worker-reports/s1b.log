import { mkdtempSync, rmSync } from 'node:fs';
import { join } from 'node:path';
import { tmpdir } from 'node:os';
import { afterEach } from 'vitest';
import { DurableRecordStore } from '../src/store.js';

const dirs: string[] = [];

afterEach(() => {
  for (const dir of dirs.splice(0)) rmSync(dir, { recursive: true, force: true });
});

export function databasePath(): string {
  const dir = mkdtempSync(join(tmpdir(), 'durable-record-store-'));
  dirs.push(dir);
  return join(dir, 'store.sqlite');
}

export function openStore(path: string, tenant = 'tenant-a', workspace = 'workspace-a') {
  return DurableRecordStore.open(path, { tenantId: tenant, workspaceId: workspace });
}

export function seedSession(store: DurableRecordStore, sessionId = 'session-1') {
  return store.createSession({ sessionId, instanceUid: `instance-${sessionId}`, agentType: 'pi' });
}

export function admitOne(store: DurableRecordStore, overrides: Record<string, unknown> = {}) {
  return store.admit({
    sessionId: 'session-1',
    submissionId: 'submission-1',
    requestKeyDigest: 'request-1',
    idempotencyKey: 'idempotency-1',
    payload: { prompt: 'hello' },
    payloadDigest: 'payload-1',
    agentType: 'pi',
    origin: 'test',
    ...overrides,
  });
}

export function claimOne(store: DurableRecordStore, now = 1_000) {
  return store.claim({
    sessionId: 'session-1', ownerId: 'worker-a', ownerEpoch: 7,
    attemptId: 'attempt-1', now, leaseDurationMs: 100,
  });
}
