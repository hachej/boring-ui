  ON submissions(tenant_id, workspace_id, session_id, idempotency_key)
  WHERE idempotency_key IS NOT NULL;
CREATE INDEX IF NOT EXISTS submissions_unsettled_head_idx
  ON submissions(tenant_id, workspace_id, session_id, queue_seq)
  WHERE status <> 'settled';

CREATE TABLE IF NOT EXISTS admission_outbox (
  tenant_id TEXT NOT NULL,
  workspace_id TEXT NOT NULL,
  request_key_digest TEXT NOT NULL,
  submission_id TEXT NOT NULL,
  session_id TEXT NOT NULL,
  payload_digest TEXT NOT NULL,
  state TEXT NOT NULL CHECK (state IN ('committed','projected')),
  created_at INTEGER NOT NULL,
  PRIMARY KEY (tenant_id, workspace_id, request_key_digest),
  FOREIGN KEY (tenant_id, workspace_id, session_id, submission_id)
    REFERENCES submissions(tenant_id, workspace_id, session_id, submission_id)
);

CREATE TABLE IF NOT EXISTS submission_attempts (
  tenant_id TEXT NOT NULL,
  workspace_id TEXT NOT NULL,
  session_id TEXT NOT NULL,
  attempt_id TEXT NOT NULL,
  submission_id TEXT NOT NULL,
  attempt_no INTEGER NOT NULL CHECK (attempt_no > 0),
  state TEXT NOT NULL CHECK (state IN ('running','replaced','finished')),
  owner_id TEXT NOT NULL,
  owner_epoch INTEGER NOT NULL CHECK (owner_epoch >= 0),
  lease_expires_at INTEGER NOT NULL,
  started_at INTEGER NOT NULL,
  finished_at INTEGER,
  replaced_by_attempt_id TEXT,
  PRIMARY KEY (tenant_id, workspace_id, attempt_id),
  UNIQUE (tenant_id, workspace_id, submission_id, attempt_no),
  UNIQUE (tenant_id, workspace_id, session_id, submission_id, attempt_id),
  FOREIGN KEY (tenant_id, workspace_id, session_id, submission_id)
    REFERENCES submissions(tenant_id, workspace_id, session_id, submission_id),
  FOREIGN KEY (tenant_id, workspace_id, replaced_by_attempt_id)
    REFERENCES submission_attempts(tenant_id, workspace_id, attempt_id) DEFERRABLE INITIALLY DEFERRED,
  CHECK (
    (state = 'running' AND finished_at IS NULL AND replaced_by_attempt_id IS NULL)
    OR (state = 'replaced' AND finished_at IS NOT NULL AND replaced_by_attempt_id IS NOT NULL)
    OR (state = 'finished' AND finished_at IS NOT NULL AND replaced_by_attempt_id IS NULL)
  )
);
CREATE UNIQUE INDEX IF NOT EXISTS submission_attempts_one_running_idx
  ON submission_attempts(tenant_id, workspace_id, submission_id) WHERE state = 'running';
CREATE INDEX IF NOT EXISTS submission_attempts_expired_idx
  ON submission_attempts(tenant_id, workspace_id, lease_expires_at) WHERE state = 'running';

CREATE TABLE IF NOT EXISTS stream_batches (
  tenant_id TEXT NOT NULL,
  workspace_id TEXT NOT NULL,
  stream_id TEXT NOT NULL,
  session_id TEXT NOT NULL,
  incarnation_uid TEXT NOT NULL,
  batch_no INTEGER NOT NULL CHECK (batch_no >= 0),
  producer_id TEXT NOT NULL,
  producer_epoch INTEGER NOT NULL CHECK (producer_epoch >= 0),
  producer_sequence INTEGER NOT NULL CHECK (producer_sequence >= 0),
  submission_id TEXT NOT NULL,
  attempt_id TEXT NOT NULL,
  record_count INTEGER NOT NULL CHECK (record_count > 0),
  content_digest TEXT NOT NULL,
  complete INTEGER NOT NULL DEFAULT 0 CHECK (complete IN (0,1)),
  committed_at INTEGER NOT NULL,
  PRIMARY KEY (tenant_id, workspace_id, stream_id, batch_no),
  UNIQUE (tenant_id, workspace_id, stream_id, producer_id, producer_epoch, producer_sequence),
  FOREIGN KEY (tenant_id, workspace_id, stream_id, session_id)
    REFERENCES conversation_streams(tenant_id, workspace_id, stream_id, session_id),
  FOREIGN KEY (tenant_id, workspace_id, session_id, submission_id, attempt_id)
    REFERENCES submission_attempts(tenant_id, workspace_id, session_id, submission_id, attempt_id)
);

CREATE TABLE IF NOT EXISTS stream_records (
  tenant_id TEXT NOT NULL,
  workspace_id TEXT NOT NULL,
  stream_id TEXT NOT NULL,
  session_id TEXT NOT NULL,
  batch_no INTEGER NOT NULL,
  record_index INTEGER NOT NULL CHECK (record_index >= 0),
  record_id TEXT NOT NULL,
  kind TEXT NOT NULL,
  record_schema_version INTEGER NOT NULL DEFAULT 1 CHECK (record_schema_version > 0),
  payload TEXT NOT NULL CHECK (json_valid(payload)),
  payload_digest TEXT,
  submission_id TEXT NOT NULL,
  attempt_id TEXT NOT NULL,
  committed_at INTEGER NOT NULL,
  PRIMARY KEY (tenant_id, workspace_id, stream_id, batch_no, record_index),
  UNIQUE (tenant_id, workspace_id, stream_id, record_id),
  UNIQUE (tenant_id, workspace_id, session_id, record_id),
  UNIQUE (tenant_id, workspace_id, stream_id, session_id, record_id),
  FOREIGN KEY (tenant_id, workspace_id, stream_id, batch_no)
    REFERENCES stream_batches(tenant_id, workspace_id, stream_id, batch_no),
  FOREIGN KEY (tenant_id, workspace_id, stream_id, session_id)
    REFERENCES conversation_streams(tenant_id, workspace_id, stream_id, session_id),
  FOREIGN KEY (tenant_id, workspace_id, session_id, submission_id, attempt_id)
    REFERENCES submission_attempts(tenant_id, workspace_id, session_id, submission_id, attempt_id)
);
CREATE UNIQUE INDEX IF NOT EXISTS stream_records_one_settlement_idx
  ON stream_records(tenant_id, workspace_id, submission_id) WHERE kind = 'submission_settled';

CREATE TRIGGER IF NOT EXISTS stream_batches_validate_completion
BEFORE UPDATE OF complete ON stream_batches
WHEN OLD.complete = 0 AND NEW.complete = 1
BEGIN
  SELECT CASE WHEN (
    SELECT count(*) FROM stream_records r
    WHERE r.tenant_id = NEW.tenant_id AND r.workspace_id = NEW.workspace_id
      AND r.stream_id = NEW.stream_id AND r.batch_no = NEW.batch_no
  ) <> NEW.record_count THEN RAISE(ABORT, 'batch record_count mismatch') END;
END;

CREATE TRIGGER IF NOT EXISTS stream_batches_immutable
BEFORE UPDATE ON stream_batches WHEN OLD.complete = 1
BEGIN SELECT RAISE(ABORT, 'completed batch is immutable'); END;
CREATE TRIGGER IF NOT EXISTS stream_batches_no_delete
BEFORE DELETE ON stream_batches
BEGIN SELECT RAISE(ABORT, 'batch is immutable'); END;
CREATE TRIGGER IF NOT EXISTS stream_records_no_update
BEFORE UPDATE ON stream_records
BEGIN SELECT RAISE(ABORT, 'record is immutable'); END;
CREATE TRIGGER IF NOT EXISTS stream_records_no_delete
BEFORE DELETE ON stream_records
BEGIN SELECT RAISE(ABORT, 'record is immutable'); END;
CREATE TRIGGER IF NOT EXISTS stream_records_no_insert_into_completed_batch
BEFORE INSERT ON stream_records
WHEN EXISTS (
  SELECT 1 FROM stream_batches b
  WHERE b.tenant_id=NEW.tenant_id AND b.workspace_id=NEW.workspace_id
    AND b.stream_id=NEW.stream_id AND b.batch_no=NEW.batch_no AND b.complete=1
)
BEGIN SELECT RAISE(ABORT, 'completed batch is immutable'); END;

CREATE TRIGGER IF NOT EXISTS stream_records_settlement_must_be_reserved
BEFORE INSERT ON stream_records WHEN NEW.kind = 'submission_settled'
BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM submissions s
    WHERE s.tenant_id=NEW.tenant_id AND s.workspace_id=NEW.workspace_id
      AND s.session_id=NEW.session_id AND s.submission_id=NEW.submission_id
      AND s.current_attempt_id=NEW.attempt_id AND s.status='terminalizing'
      AND s.reserved_settlement_record_id=NEW.record_id
      AND s.settlement_payload_digest=NEW.payload_digest
      AND s.settlement_outcome=json_extract(NEW.payload, '$.outcome')
  ) THEN RAISE(ABORT, 'settlement record is not reserved') END;
END;

CREATE TRIGGER IF NOT EXISTS submissions_validate_settlement
BEFORE UPDATE OF status ON submissions WHEN NEW.status = 'settled'
BEGIN
  SELECT CASE WHEN NOT EXISTS (
    SELECT 1 FROM stream_records r
    WHERE r.tenant_id = NEW.tenant_id AND r.workspace_id = NEW.workspace_id
      AND r.session_id = NEW.session_id AND r.record_id = NEW.settlement_record_id
      AND r.submission_id = NEW.submission_id AND r.attempt_id = NEW.current_attempt_id
      AND r.kind = 'submission_settled' AND r.payload_digest = NEW.settlement_payload_digest
      AND json_extract(r.payload, '$.outcome') = NEW.settlement_outcome
  ) THEN RAISE(ABORT, 'settlement record does not match reservation') END;
END;

CREATE INDEX IF NOT EXISTS submissions_terminalizing_recovery_idx
  ON submissions(tenant_id, workspace_id, terminalizing_at) WHERE status = 'terminalizing';
import { readFileSync } from 'node:fs';
import { DatabaseSync } from 'node:sqlite';

type Scope = { tenantId: string; workspaceId: string };
type Json = null | boolean | number | string | Json[] | { [key: string]: Json };

function json(value: unknown): string { return JSON.stringify(value); }
function parsed(value: unknown): Json { return JSON.parse(String(value)); }
function streamId(sessionId: string): string { return `stream:${sessionId}`; }
function incarnationId(sessionId: string): string { return `incarnation:${sessionId}`; }

export class DurableRecordStore {
  #db: DatabaseSync;
  #scope: Scope;

  private constructor(path: string, scope: Scope) {
    this.#scope = Object.freeze({ ...scope });
    this.#db = new DatabaseSync(path);
    this.#db.exec('PRAGMA foreign_keys = ON; PRAGMA busy_timeout = 1000;');
    this.#db.exec(readFileSync(new URL('./schema.sql', import.meta.url), 'utf8'));
  }

  static open(path: string, scope: Scope): DurableRecordStore {
    if (!scope.tenantId || !scope.workspaceId) throw new Error('tenant and workspace scope are required');
    return new DurableRecordStore(path, scope);
  }

  close(): void { this.#db.close(); }

  #transaction<T>(fn: () => T): T {
    this.#db.exec('BEGIN IMMEDIATE');
    try {
      const result = fn();
      this.#db.exec('COMMIT');
      return result;
    } catch (error) {
      try { this.#db.exec('ROLLBACK'); } catch { /* transaction already failed */ }
      throw error;
    }
  }

  createSession(input: { sessionId: string; instanceUid: string; agentType: string; now?: number }) {
    const now = input.now ?? Date.now();
    this.#db.prepare(`INSERT OR IGNORE INTO agent_sessions
      (tenant_id, workspace_id, session_id, instance_uid, agent_type, created_at, updated_at)
      VALUES (?, ?, ?, ?, ?, ?, ?)`).run(
      this.#scope.tenantId, this.#scope.workspaceId, input.sessionId, input.instanceUid, input.agentType, now, now,
    );
    this.#db.prepare(`INSERT OR IGNORE INTO conversation_streams
      (tenant_id, workspace_id, stream_id, session_id, incarnation_uid)
      VALUES (?, ?, ?, ?, ?)`).run(
      this.#scope.tenantId, this.#scope.workspaceId, streamId(input.sessionId), input.sessionId, incarnationId(input.sessionId),
    );
    return { sessionId: input.sessionId };
  }

  admit(input: {
    sessionId: string; submissionId: string; requestKeyDigest: string; idempotencyKey?: string;
    payload: unknown; payloadDigest: string; agentType: string; origin: string;
    payloadVersion?: number; maxAttempts?: number; timeoutAt?: number; now?: number;
  }) {
    return this.#transaction(() => {
      const replay = this.#db.prepare(`SELECT o.submission_id, o.session_id, o.payload_digest,
          s.queue_seq, s.status
        FROM admission_outbox o JOIN submissions s
          ON s.tenant_id=o.tenant_id AND s.workspace_id=o.workspace_id AND s.submission_id=o.submission_id
        WHERE o.tenant_id=? AND o.workspace_id=? AND o.request_key_digest=?`)
        .get(this.#scope.tenantId, this.#scope.workspaceId, input.requestKeyDigest) as any;
      if (replay) {
        if (replay.session_id !== input.sessionId || replay.payload_digest !== input.payloadDigest)
          throw new Error('idempotency conflict: request identity reused with different immutable input');
        return { submissionId: replay.submission_id, queueSeq: Number(replay.queue_seq), status: replay.status };
      }

      const existingKey = input.idempotencyKey && this.#db.prepare(`SELECT submission_id, payload_digest
        FROM submissions WHERE tenant_id=? AND workspace_id=? AND session_id=? AND idempotency_key=?`)
        .get(this.#scope.tenantId, this.#scope.workspaceId, input.sessionId, input.idempotencyKey) as any;
      if (existingKey) {
        if (existingKey.payload_digest !== input.payloadDigest) throw new Error('idempotency conflict');
        const row = this.#submission(existingKey.submission_id);
        const now = input.now ?? Date.now();
        this.#db.prepare(`INSERT INTO admission_outbox
          (tenant_id, workspace_id, request_key_digest, submission_id, session_id, payload_digest, state, created_at)
          VALUES (?, ?, ?, ?, ?, ?, 'committed', ?)`).run(
          this.#scope.tenantId, this.#scope.workspaceId, input.requestKeyDigest, row.submission_id,
          row.session_id, row.payload_digest, now,
        );
        return { submissionId: row.submission_id, queueSeq: Number(row.queue_seq), status: row.status };
      }

      const counter = this.#db.prepare(`UPDATE agent_sessions SET next_queue_seq=next_queue_seq+1, updated_at=?
        WHERE tenant_id=? AND workspace_id=? AND session_id=? RETURNING next_queue_seq-1 AS queue_seq`)
        .get(input.now ?? Date.now(), this.#scope.tenantId, this.#scope.workspaceId, input.sessionId) as any;
      if (!counter) throw new Error('session not found in scope');
      const now = input.now ?? Date.now();
      this.#db.prepare(`INSERT INTO submissions
        (tenant_id, workspace_id, session_id, submission_id, queue_seq, agent_type, payload_version,
         payload, payload_digest, idempotency_key, origin, admitted_at, max_attempts, timeout_at)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`).run(
        this.#scope.tenantId, this.#scope.workspaceId, input.sessionId, input.submissionId,
        counter.queue_seq, input.agentType, input.payloadVersion ?? 1, json(input.payload), input.payloadDigest,
        input.idempotencyKey ?? null, input.origin, now, input.maxAttempts ?? 10, input.timeoutAt ?? null,
      );
      this.#db.prepare(`INSERT INTO admission_outbox
        (tenant_id, workspace_id, request_key_digest, submission_id, session_id, payload_digest, state, created_at)
        VALUES (?, ?, ?, ?, ?, ?, 'committed', ?)`).run(
        this.#scope.tenantId, this.#scope.workspaceId, input.requestKeyDigest, input.submissionId,
        input.sessionId, input.payloadDigest, now,
      );
      return { submissionId: input.submissionId, queueSeq: Number(counter.queue_seq), status: 'queued' };
    });
  }

  getAdmission(requestKeyDigest: string) {
    const row = this.#db.prepare(`SELECT submission_id, payload_digest, state FROM admission_outbox
      WHERE tenant_id=? AND workspace_id=? AND request_key_digest=?`)
      .get(this.#scope.tenantId, this.#scope.workspaceId, requestKeyDigest) as any;
    return row && { submissionId: row.submission_id, payloadDigest: row.payload_digest, state: row.state };
  }

  claim(input: { sessionId: string; ownerId: string; ownerEpoch: number; attemptId: string; now: number; leaseDurationMs: number }) {
    return this.#transaction(() => {
      const submission = this.#db.prepare(`SELECT * FROM submissions
        WHERE tenant_id=? AND workspace_id=? AND session_id=? AND status <> 'settled'
        ORDER BY queue_seq LIMIT 1`).get(this.#scope.tenantId, this.#scope.workspaceId, input.sessionId) as any;
      if (!submission || submission.status === 'terminalizing') return null;
      const expires = input.now + input.leaseDurationMs;
      let attemptNo: number;
      if (submission.status === 'queued') {
        attemptNo = 1;
      } else {
        const old = this.#db.prepare(`SELECT * FROM submission_attempts
          WHERE tenant_id=? AND workspace_id=? AND submission_id=? AND attempt_id=?`)
          .get(this.#scope.tenantId, this.#scope.workspaceId, submission.submission_id, submission.current_attempt_id) as any;
        if (!old || old.state !== 'running' || Number(old.lease_expires_at) > input.now) return null;
        const timedOut = submission.timeout_at != null && Number(submission.timeout_at) <= input.now;
        if (submission.abort_requested_at != null || timedOut ||
            Number(submission.attempt_count) >= Number(submission.max_attempts)) {
          const outcome = submission.abort_requested_at != null || timedOut ? 'aborted' : 'failed';
          const reason = submission.abort_requested_at != null ? 'abort-requested'
            : timedOut ? 'submission-timeout' : 'attempt-budget-exhausted';
          return this.#recoverExpiredSubmission(submission, old, input, outcome, reason);
        }
        attemptNo = Number(submission.attempt_count) + 1;
        this.#db.prepare(`UPDATE submission_attempts SET state='replaced', finished_at=?, replaced_by_attempt_id=?
          WHERE tenant_id=? AND workspace_id=? AND attempt_id=? AND state='running'`).run(
          input.now, input.attemptId, this.#scope.tenantId, this.#scope.workspaceId, old.attempt_id,
        );
      }
      this.#db.prepare(`INSERT INTO submission_attempts
        (tenant_id, workspace_id, session_id, attempt_id, submission_id, attempt_no, state,
         owner_id, owner_epoch, lease_expires_at, started_at)
        VALUES (?, ?, ?, ?, ?, ?, 'running', ?, ?, ?, ?)`).run(
        this.#scope.tenantId, this.#scope.workspaceId, input.sessionId, input.attemptId,
        submission.submission_id, attemptNo, input.ownerId, input.ownerEpoch, expires, input.now,
      );
      this.#db.prepare(`UPDATE submissions SET status='running', current_attempt_id=?, attempt_count=?
        WHERE tenant_id=? AND workspace_id=? AND submission_id=?`).run(
        input.attemptId, attemptNo, this.#scope.tenantId, this.#scope.workspaceId, submission.submission_id,
      );
      this.#db.prepare(`UPDATE conversation_streams SET producer_id=?, producer_epoch=?,
          producer_submission_id=?, producer_attempt_id=?, next_producer_sequence=0
        WHERE tenant_id=? AND workspace_id=? AND session_id=?`).run(
        input.ownerId, input.ownerEpoch, submission.submission_id, input.attemptId,
        this.#scope.tenantId, this.#scope.workspaceId, input.sessionId,
      );
      return { submissionId: submission.submission_id, attemptId: input.attemptId, attemptNo, leaseExpiresAt: expires };
    });
  }

  #recoverExpiredSubmission(
    submission: any,
    attempt: any,
    input: { sessionId: string; ownerId: string; ownerEpoch: number; now: number; leaseDurationMs: number },
    outcome: 'failed' | 'aborted',
    reason: string,
  ) {
    const recordId = `settlement:${submission.submission_id}`;
    const payloadDigest = `recovery:${outcome}:${reason}`;
    this.#db.prepare(`UPDATE submission_attempts SET owner_id=?, owner_epoch=?, lease_expires_at=?
      WHERE tenant_id=? AND workspace_id=? AND attempt_id=? AND state='running'`).run(
      input.ownerId, input.ownerEpoch, input.now + input.leaseDurationMs,
      this.#scope.tenantId, this.#scope.workspaceId, attempt.attempt_id,
    );
    this.#db.prepare(`UPDATE conversation_streams SET producer_id=?, producer_epoch=?,
        producer_submission_id=?, producer_attempt_id=?, next_producer_sequence=0
      WHERE tenant_id=? AND workspace_id=? AND session_id=?`).run(
      input.ownerId, input.ownerEpoch, submission.submission_id, attempt.attempt_id,
      this.#scope.tenantId, this.#scope.workspaceId, input.sessionId,
    );
    this.#db.prepare(`UPDATE submissions SET status='terminalizing', reserved_settlement_record_id=?,
        settlement_outcome=?, settlement_payload_digest=?, terminalizing_at=?
      WHERE tenant_id=? AND workspace_id=? AND submission_id=? AND status='running'`).run(
      recordId, outcome, payloadDigest, input.now,
      this.#scope.tenantId, this.#scope.workspaceId, submission.submission_id,
    );
    this.#append({
      sessionId: input.sessionId, submissionId: submission.submission_id, attemptId: attempt.attempt_id,
      producerId: input.ownerId, producerEpoch: input.ownerEpoch, producerSequence: 0,
      contentDigest: `settlement:${payloadDigest}`, now: input.now,
      records: [{ recordId, kind: 'submission_settled', payload: { outcome, value: { reason } }, payloadDigest }],
    });
    this.#db.prepare(`UPDATE submissions SET status='settled', settlement_record_id=?, settled_at=?
      WHERE tenant_id=? AND workspace_id=? AND submission_id=? AND status='terminalizing'`).run(
      recordId, input.now, this.#scope.tenantId, this.#scope.workspaceId, submission.submission_id,
    );
    this.#db.prepare(`UPDATE submission_attempts SET state='finished', finished_at=?
      WHERE tenant_id=? AND workspace_id=? AND attempt_id=? AND state='running'`).run(
      input.now, this.#scope.tenantId, this.#scope.workspaceId, attempt.attempt_id,
    );
    return { submissionId: submission.submission_id, recovered: 'settled', outcome };
  }

  appendBatch(input: {
    sessionId: string; submissionId: string; attemptId: string; producerId: string; producerEpoch: number;
    producerSequence: number; contentDigest: string; now: number;
    records: Array<{ recordId: string; kind: string; payload: unknown; schemaVersion?: number }>;
  }) {
    if (input.records.some(record => record.kind === 'submission_settled'))
      throw new Error('submission_settled is reserved for settle');
    return this.#transaction(() => this.#append(input));
  }

  #append(input: {
    sessionId: string; submissionId: string; attemptId: string; producerId: string; producerEpoch: number;
    producerSequence: number; contentDigest: string; now: number;
    records: Array<{ recordId: string; kind: string; payload: unknown; schemaVersion?: number; payloadDigest?: string }>;
  }) {
    if (input.records.length === 0) throw new Error('batch must contain records');
    const sid = streamId(input.sessionId);
    const retry = this.#db.prepare(`SELECT * FROM stream_batches WHERE tenant_id=? AND workspace_id=?
      AND stream_id=? AND producer_id=? AND producer_epoch=? AND producer_sequence=?`)
      .get(this.#scope.tenantId, this.#scope.workspaceId, sid, input.producerId, input.producerEpoch, input.producerSequence) as any;
    if (retry) {
      if (retry.session_id !== input.sessionId || retry.submission_id !== input.submissionId ||
          retry.attempt_id !== input.attemptId || Number(retry.record_count) !== input.records.length ||
          retry.content_digest !== input.contentDigest) throw new Error('batch retry conflict');
      const storedRecords = this.#db.prepare(`SELECT record_id, kind, record_schema_version, payload, payload_digest
        FROM stream_records WHERE tenant_id=? AND workspace_id=? AND stream_id=? AND batch_no=?
        ORDER BY record_index`).all(
        this.#scope.tenantId, this.#scope.workspaceId, sid, retry.batch_no,
      ) as any[];
      const recordsMatch = storedRecords.length === input.records.length && input.records.every((record, index) => {
        const stored = storedRecords[index];
        return stored.record_id === record.recordId && stored.kind === record.kind
          && Number(stored.record_schema_version) === (record.schemaVersion ?? 1)
          && stored.payload === json(record.payload)
          && stored.payload_digest === (record.payloadDigest ?? null);
      });
      if (!recordsMatch) throw new Error('batch retry conflict: records differ');
      return { batchNo: Number(retry.batch_no), recordCount: Number(retry.record_count) };
    }

    const fence = this.#db.prepare(`SELECT s.status, s.current_attempt_id, a.state, a.owner_id, a.owner_epoch,
        a.lease_expires_at, cs.head_batch_no, cs.next_producer_sequence, cs.incarnation_uid,
        cs.producer_id, cs.producer_epoch, cs.producer_submission_id, cs.producer_attempt_id
      FROM conversation_streams cs
      JOIN submissions s ON s.tenant_id=cs.tenant_id AND s.workspace_id=cs.workspace_id
        AND s.session_id=cs.session_id AND s.submission_id=?
      JOIN submission_attempts a ON a.tenant_id=s.tenant_id AND a.workspace_id=s.workspace_id
        AND a.submission_id=s.submission_id AND a.attempt_id=?
      WHERE cs.tenant_id=? AND cs.workspace_id=? AND cs.stream_id=? AND cs.session_id=?`)
      .get(input.submissionId, input.attemptId, this.#scope.tenantId, this.#scope.workspaceId, sid, input.sessionId) as any;
    const valid = fence && ['running', 'terminalizing'].includes(fence.status)
      && fence.current_attempt_id === input.attemptId && fence.state === 'running'
      && fence.owner_id === input.producerId && Number(fence.owner_epoch) === input.producerEpoch
      && Number(fence.lease_expires_at) > input.now && fence.producer_id === input.producerId
      && Number(fence.producer_epoch) === input.producerEpoch
      && fence.producer_submission_id === input.submissionId && fence.producer_attempt_id === input.attemptId;
    if (!valid) throw new Error('producer fenced: attempt is not current, owned, and live');
    if (Number(fence.next_producer_sequence) !== input.producerSequence) throw new Error('unexpected producer sequence');

    const batchNo = Number(fence.head_batch_no) + 1;
    this.#db.prepare(`INSERT INTO stream_batches
      (tenant_id, workspace_id, stream_id, session_id, incarnation_uid, batch_no, producer_id,
       producer_epoch, producer_sequence, submission_id, attempt_id, record_count, content_digest, committed_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`).run(
      this.#scope.tenantId, this.#scope.workspaceId, sid, input.sessionId, fence.incarnation_uid, batchNo,
      input.producerId, input.producerEpoch, input.producerSequence, input.submissionId, input.attemptId,
      input.records.length, input.contentDigest, input.now,
    );
    const insert = this.#db.prepare(`INSERT INTO stream_records
      (tenant_id, workspace_id, stream_id, session_id, batch_no, record_index, record_id, kind,
       record_schema_version, payload, payload_digest, submission_id, attempt_id, committed_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`);
    input.records.forEach((record, index) => insert.run(
      this.#scope.tenantId, this.#scope.workspaceId, sid, input.sessionId, batchNo, index,
      record.recordId, record.kind, record.schemaVersion ?? 1, json(record.payload), record.payloadDigest ?? null,
      input.submissionId, input.attemptId, input.now,
    ));
    this.#db.prepare(`UPDATE stream_batches SET complete=1 WHERE tenant_id=? AND workspace_id=? AND stream_id=? AND batch_no=?`)
      .run(this.#scope.tenantId, this.#scope.workspaceId, sid, batchNo);
    this.#db.prepare(`UPDATE conversation_streams SET head_batch_no=?, next_producer_sequence=next_producer_sequence+1
      WHERE tenant_id=? AND workspace_id=? AND stream_id=?`).run(
      batchNo, this.#scope.tenantId, this.#scope.workspaceId, sid,
    );
    return { batchNo, recordCount: input.records.length };
  }

  requestAbort(input: { submissionId: string; now: number; principalId?: string; reason?: string }): void {
    const result = this.#db.prepare(`UPDATE submissions SET abort_requested_at=?,
        abort_requested_by_principal_id=?, abort_reason=?
      WHERE tenant_id=? AND workspace_id=? AND submission_id=? AND status <> 'settled'`).run(
      input.now, input.principalId ?? null, input.reason ?? null,
      this.#scope.tenantId, this.#scope.workspaceId, input.submissionId,
    );
    if (Number(result.changes) !== 1) throw new Error('submission not found or already settled');
  }

  settle(input: {
    sessionId: string; submissionId: string; attemptId: string; ownerId: string; ownerEpoch: number;
    now: number; outcome: 'completed' | 'failed' | 'aborted'; payload: unknown;
    payloadDigest: string; recordId: string;
  }) {
    return this.#transaction(() => {
      const submission = this.#submission(input.submissionId);
      const effectiveOutcome = submission.abort_requested_at == null ? input.outcome : 'aborted';
      if (submission.status === 'settled') {
        if (submission.settlement_outcome === effectiveOutcome &&
            submission.settlement_payload_digest === input.payloadDigest &&
            submission.settlement_record_id === input.recordId) return this.#settlementResult(submission);
        throw new Error('settlement conflict: terminal outcome already exists');
      }
      const attempt = this.#db.prepare(`SELECT * FROM submission_attempts WHERE tenant_id=? AND workspace_id=?
        AND session_id=? AND submission_id=? AND attempt_id=?`).get(
        this.#scope.tenantId, this.#scope.workspaceId, input.sessionId, input.submissionId, input.attemptId,
      ) as any;
      if (submission.status !== 'running' || submission.current_attempt_id !== input.attemptId ||
          !attempt || attempt.state !== 'running' || attempt.owner_id !== input.ownerId ||
          Number(attempt.owner_epoch) !== input.ownerEpoch || Number(attempt.lease_expires_at) <= input.now)
        throw new Error('settlement fenced: attempt is not current, owned, and live');

      this.#db.prepare(`UPDATE submissions SET status='terminalizing', reserved_settlement_record_id=?,
          settlement_outcome=?, settlement_payload_digest=?, terminalizing_at=?
        WHERE tenant_id=? AND workspace_id=? AND submission_id=? AND status='running'`).run(
        input.recordId, effectiveOutcome, input.payloadDigest, input.now,
        this.#scope.tenantId, this.#scope.workspaceId, input.submissionId,
      );
      const stream = this.#db.prepare(`SELECT next_producer_sequence FROM conversation_streams
        WHERE tenant_id=? AND workspace_id=? AND session_id=?`).get(
        this.#scope.tenantId, this.#scope.workspaceId, input.sessionId,
      ) as any;
      this.#append({
        sessionId: input.sessionId, submissionId: input.submissionId, attemptId: input.attemptId,
        producerId: input.ownerId, producerEpoch: input.ownerEpoch,
        producerSequence: Number(stream.next_producer_sequence), contentDigest: `settlement:${input.payloadDigest}`,
        now: input.now, records: [{ recordId: input.recordId, kind: 'submission_settled',
          payload: { outcome: effectiveOutcome, value: input.payload }, payloadDigest: input.payloadDigest }],
      });
      this.#db.prepare(`UPDATE submissions SET status='settled', settlement_record_id=?, settled_at=?
        WHERE tenant_id=? AND workspace_id=? AND submission_id=? AND status='terminalizing'`).run(
        input.recordId, input.now, this.#scope.tenantId, this.#scope.workspaceId, input.submissionId,
      );
      this.#db.prepare(`UPDATE submission_attempts SET state='finished', finished_at=?
        WHERE tenant_id=? AND workspace_id=? AND attempt_id=? AND state='running'`).run(
        input.now, this.#scope.tenantId, this.#scope.workspaceId, input.attemptId,
      );
      return this.#settlementResult(this.#submission(input.submissionId));
    });
  }

  #submission(submissionId: string): any {
    const row = this.#db.prepare(`SELECT * FROM submissions WHERE tenant_id=? AND workspace_id=? AND submission_id=?`)
      .get(this.#scope.tenantId, this.#scope.workspaceId, submissionId);
    if (!row) throw new Error('submission not found in scope');
    return row;
  }

  #settlementResult(row: any) {
    return { status: row.status, submissionId: row.submission_id,
      settlementRecordId: row.settlement_record_id, settlementOutcome: row.settlement_outcome };
  }

  listAttempts(submissionId: string) {
    return (this.#db.prepare(`SELECT attempt_id, attempt_no, state, replaced_by_attempt_id
      FROM submission_attempts WHERE tenant_id=? AND workspace_id=? AND submission_id=? ORDER BY attempt_no`)
      .all(this.#scope.tenantId, this.#scope.workspaceId, submissionId) as any[]).map(row => ({
        attemptId: row.attempt_id, attemptNo: Number(row.attempt_no), state: row.state,
        replacedByAttemptId: row.replaced_by_attempt_id,
      }));
