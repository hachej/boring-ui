diff --git a/spike-l0-schema/test/raw-schema-invariants.test.ts b/spike-l0-schema/test/raw-schema-invariants.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b33a850795a78cefb2003bc977c27951cc2a81b2
