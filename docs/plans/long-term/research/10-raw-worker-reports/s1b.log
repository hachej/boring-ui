index 0000000000000000000000000000000000000000..2a825d737a26b04808a1f89ee1868649c441d9cc
--- /dev/null
+++ b/spike-l0-schema/scripts/mutate.mjs
@@ -0,0 +1,56 @@
+import { spawnSync } from 'node:child_process';
+import { readFileSync, writeFileSync } from 'node:fs';
+import { resolve } from 'node:path';
+
+const mutations = [
+  {
+    name: 'drop submission_attempts_one_running_idx',
+    file: 'src/schema.sql',
+    from: `CREATE UNIQUE INDEX IF NOT EXISTS submission_attempts_one_running_idx
+  ON submission_attempts(tenant_id, workspace_id, submission_id) WHERE state = 'running';
+`,
+    to: '',
+  },
+  {
+    name: 'drop stream_records_one_settlement_idx',
+    file: 'src/schema.sql',
+    from: `CREATE UNIQUE INDEX IF NOT EXISTS stream_records_one_settlement_idx
+  ON stream_records(tenant_id, workspace_id, submission_id) WHERE kind = 'submission_settled';
+`,
+    to: '',
+  },
+  {
+    name: 'disable adapter producer fence',
+    file: 'src/store.ts',
+    from: `if (!valid) throw new Error('producer fenced: attempt is not current, owned, and live');`,
+    to: `if (false && !valid) throw new Error('producer fenced: attempt is not current, owned, and live');`,
+  },
+];
+
+let survivors = 0;
+
+for (const mutation of mutations) {
+  const path = resolve(mutation.file);
+  const original = readFileSync(path, 'utf8');
+  if (!original.includes(mutation.from)) {
+    console.error(`ERROR: mutation target not found: ${mutation.name}`);
+    process.exitCode = 1;
+    break;
+  }
+
+  console.log(`\n=== MUTATION: ${mutation.name} ===`);
+  try {
+    writeFileSync(path, original.replace(mutation.from, mutation.to));
+    const result = spawnSync('npm', ['test'], { encoding: 'utf8' });
+    if (result.stdout) process.stdout.write(result.stdout);
+    if (result.stderr) process.stderr.write(result.stderr);
+    const killed = result.status !== 0;
+    console.log(`=== RESULT: ${killed ? 'KILLED' : 'SURVIVED'} (npm test exit ${result.status ?? 'null'}) ===`);
+    if (!killed) survivors += 1;
+  } finally {
+    writeFileSync(path, original);
+  }
+}
+
+console.log(`\nMutation summary: ${mutations.length - survivors}/${mutations.length} killed; ${survivors} survived.`);
+if (survivors > 0) process.exitCode = 1;
