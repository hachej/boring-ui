+{
+  "name": "spike-durable-pause",
+  "private": true,
+  "type": "module",
+  "scripts": {
+    "test": "node ../spike-l0-schema/node_modules/vitest/vitest.mjs run --reporter=verbose",
+    "mutate": "node scripts/mutate.mjs"
+  },
+  "devDependencies": {
