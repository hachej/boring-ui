   394	  if (typeof value === 'object') {
   395	    return depth >= 2
   396	      ? [JSON.stringify(value)]
   397	      : Object.values(value as Record<string, unknown>).flatMap((v) =>
   398	          extractParamTokens(v, depth + 1),
