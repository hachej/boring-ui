+      prompt, reply: compactReply(reply), exactToolHooks: rig.exactToolHooks,
+      runtimeToolEvents: rig.runtimeToolEvents, payloads: rig.payloads,
+      assistantMessages: rig.assistantMessages,
+    };
+    await save(name, result);
+    return result;
+  } finally {
+    await rig.cleanup();
+  }
+}
+
+export async function runOffline() {
+  const direct = await one("offline-control", {
+    tools: catalogTools.slice(0, 3),
+    prompt: "Call beta_add with a=7 and b=5.",
+    fauxResponses: [
+      fauxAssistantMessage(fauxToolCall("beta_add", { a: 7, b: 5 }, { id: "offline-direct-1" }), { stopReason: "toolUse", timestamp: 1 }),
+      fauxAssistantMessage("12", { timestamp: 2 }),
+    ],
+  });
+  const dispatched = await one("offline-dispatcher", {
+    tools: [makeCallTool()],
+    prompt: "Call beta_add through call_tool with a=7 and b=5.",
+    fauxResponses: [
+      fauxAssistantMessage(fauxToolCall("call_tool", { name: "beta_add", args: { a: 7, b: 5 } }, { id: "offline-outer-1" }), { stopReason: "toolUse", timestamp: 1 }),
+      fauxAssistantMessage("12", { timestamp: 2 }),
+    ],
+  });
+  return save("offline-verdict", { direct, dispatched });
+}
+
+export async function runControlAndDispatcher() {
+  const control = await one("live-control", {
+    tools: catalogTools.slice(0, 3),
+    prompt: "You MUST call beta_add exactly once with a=7 and b=5, then report the sum.",
+  });
+  const dispatcher = await one("live-dispatcher", {
+    tools: [makeCallTool()],
+    prompt: "You MUST invoke call_tool exactly once with name beta_add and args {a:7,b:5}, then report the sum. beta_add is not a resident provider tool.",
