+  ["document_search", "Search synthetic documents for a phrase.", S({ phrase: str("Search phrase") }), ({ phrase }) => ({ phrase, hits: 3 })],
+  ["document_summarize", "Summarize synthetic document text.", S({ text: str("Document text") }), ({ text }) => ({ summary: text.slice(0, 24) })],
+  ["translation_run", "Translate synthetic text into a language.", S({ text: str("Source text"), language: str("Target language") }), (p) => ({ ...p, translated: `[${p.language}] ${p.text}` })],
+  ["sentiment_score", "Score synthetic text sentiment.", S({ text: str("Text to score") }), ({ text }) => ({ text, score: 0.7 })],
+  ["image_metadata", "Read synthetic image metadata.", S({ url: str("Image URL") }), ({ url }) => ({ url, width: 800, height: 600 })],
+  ["video_transcript", "Fetch a synthetic video transcript.", S({ videoId: str("Video identifier") }), ({ videoId }) => ({ videoId, transcript: "synthetic transcript" })],
+  ["audio_duration", "Read synthetic audio duration.", S({ url: str("Audio URL") }), ({ url }) => ({ url, seconds: 42 })],
+  ["repo_branches", "List synthetic repository branches.", S({ repo: str("Repository") }), ({ repo }) => ({ repo, branches: ["main", "dev"] })],
+  ["commit_lookup", "Find a synthetic commit by SHA.", S({ sha: str("Commit SHA") }), ({ sha }) => ({ sha, author: "Ada" })],
+  ["issue_create", "Create a synthetic issue.", S({ title: str("Issue title") }), ({ title }) => ({ title, issue: 1226 })],
+  ["pull_request_merge", "Merge a synthetic pull request.", S({ number: num("Pull request number") }), ({ number }) => ({ number, merged: true })],
+  ["build_status", "Read synthetic CI build status.", S({ buildId: str("Build identifier") }), ({ buildId }) => ({ buildId, status: "passed" })],
+  ["deployment_promote", "Promote a synthetic deployment.", S({ environment: str("Target environment") }), ({ environment }) => ({ environment, promoted: true })],
+  ["log_search", "Search synthetic application logs.", S({ query: str("Log query") }), ({ query }) => ({ query, matches: 8 })],
+  ["metric_query", "Query a synthetic numeric metric.", S({ metric: str("Metric name") }), ({ metric }) => ({ metric, value: 99.9 })],
+  ["alert_acknowledge", "Acknowledge a synthetic alert.", S({ alertId: str("Alert identifier") }), ({ alertId }) => ({ alertId, acknowledged: true })],
+  ["feature_flag_read", "Read a synthetic feature flag.", S({ key: str("Flag key") }), ({ key }) => ({ key, enabled: false })],
+  ["experiment_assign", "Assign a synthetic experiment variant.", S({ userId: str("User identifier") }), ({ userId }) => ({ userId, variant: "B" })],
+  ["database_health", "Check synthetic database health.", S({ cluster: str("Cluster name") }), ({ cluster }) => ({ cluster, healthy: true })],
+  ["cache_invalidate", "Invalidate a synthetic cache key.", S({ key: str("Cache key") }), ({ key }) => ({ key, invalidated: true })],
+  ["queue_depth", "Read synthetic queue depth.", S({ queue: str("Queue name") }), ({ queue }) => ({ queue, depth: 6 })],
+  ["secret_rotate", "Rotate a synthetic secret reference.", S({ secret: str("Secret name") }), ({ secret }) => ({ secret, version: 2 })],
+  ["policy_evaluate", "Evaluate a synthetic policy subject.", S({ subject: str("Policy subject") }), ({ subject }) => ({ subject, allowed: true })],
+  ["user_permissions", "List synthetic user permissions.", S({ userId: str("User identifier") }), ({ userId }) => ({ userId, permissions: ["read"] })],
+  ["team_members", "List synthetic team members.", S({ team: str("Team name") }), ({ team }) => ({ team, count: 5 })],
+  ["project_progress", "Read synthetic project completion percentage.", S({ project: str("Project name") }), ({ project }) => ({ project, percent: 68 })],
+  ["risk_assess", "Assess synthetic project risk.", S({ project: str("Project name") }), ({ project }) => ({ project, risk: "medium" })],
+];
+
+export const catalogTools = specs.map((spec) => tool(...spec));
+export const catalogMap = new Map(catalogTools.map((entry) => [entry.name, entry]));
+
+export function signature(toolEntry) {
+  return { name: toolEntry.name, description: toolEntry.description, parameters: toolEntry.parameters };
+}
+
+export function makeCallTool(map = catalogMap) {
+  const dispatcher = tool(
+    "call_tool",
+    "Invoke an installed host-side catalog tool by exact name and arguments.",
+    S({ name: str("Exact catalog tool name"), args: { type: "object", description: "Arguments for the target tool", additionalProperties: true } }),
+    () => null,
+  );
+  return {
+    ...dispatcher,
+    async execute(outerCallId, { name, args }, signal, onUpdate) {
+      const target = map.get(name);
+      if (!target) throw new Error(`unknown catalog tool: ${name}`);
+      const innerCallId = `${outerCallId}:child:${name}`;
+      const inner = await target.execute(innerCallId, args, signal, onUpdate);
+      return {
+        content: inner.content,
+        details: { dispatchedName: name, innerCallId, innerResult: inner },
+      };
+    },
+  };
+}
+
+export function makeSearchTools(map = catalogMap, resultBudgetBytes = 8000) {
+  const searcher = tool(
+    "search_tools",
+    "Search the host-side tool catalog. Returns matching non-resident tool signatures.",
+    S({ query: str("Words describing the capability or exact tool name") }),
+    () => null,
+  );
+  return {
+    ...searcher,
+    async execute(toolCallId, { query }) {
+      const terms = query.toLowerCase().split(/[^a-z0-9]+/).filter(Boolean);
+      const ranked = [...map.values()].map((entry) => {
+        const haystack = `${entry.name} ${entry.description}`.toLowerCase();
+        return { entry, score: terms.reduce((n, term) => n + (haystack.includes(term) ? 1 : 0), 0) };
+      }).filter(({ score }) => score > 0).sort((a, b) => b.score - a.score || a.entry.name.localeCompare(b.entry.name));
+      const matches = (ranked.length ? ranked : [...map.values()].map((entry) => ({ entry })))
+        .slice(0, 8).map(({ entry }) => signature(entry));
+      while (Buffer.byteLength(JSON.stringify(matches)) > resultBudgetBytes && matches.length > 1) matches.pop();
+      return {
+        content: [{ type: "text", text: JSON.stringify({ matches }) }],
+        details: { query, matchNames: matches.map(({ name }) => name), resultBudgetBytes },
+      };
+    },
+  };
+}
+
+export const summaryCatalog = catalogTools.map((entry) => `${entry.name}: ${entry.description}`).join("\n");
diff --git a/spike-tool-catalog/src/harness.js b/spike-tool-catalog/src/harness.js
new file mode 100644
index 0000000000000000000000000000000000000000..45c55f0986f8368c740617a4ec558301333ea1e3
--- /dev/null
+++ b/spike-tool-catalog/src/harness.js
@@ -0,0 +1,72 @@
+import { mkdir } from "node:fs/promises";
+import { join } from "node:path";
+import { AgentHarness, Session } from "@earendil-works/pi-agent-core";
+import { NodeExecutionEnv } from "@earendil-works/pi-agent-core/node";
+import { createModels } from "@earendil-works/pi-ai";
+import { builtinModels } from "@earendil-works/pi-ai/providers/all";
+import { fauxProvider } from "@earendil-works/pi-ai/providers/faux";
+import { HostSessionStorage } from "./host-session-storage.js";
+
+const clone = (value) => structuredClone(value);
+
+export async function makeHarness({ artifactDir, id, tools, systemPrompt, fauxResponses }) {
+  await mkdir(artifactDir, { recursive: true });
+  const storage = await HostSessionStorage.create(join(artifactDir, `${id}.session.jsonl`), {
+    id, createdAt: new Date().toISOString(),
+  });
+  const session = new Session(storage);
+  let models;
+  let model;
+  if (fauxResponses) {
+    const faux = fauxProvider();
+    faux.setResponses(fauxResponses);
+    models = createModels();
+    models.setProvider(faux.provider);
+    model = faux.getModel();
+  } else {
+    if (!process.env.GEMINI_API_KEY) throw new Error("GEMINI_API_KEY is required for live mode");
+    models = builtinModels();
+    model = models.getModel("google", "gemini-2.5-flash");
+    if (!model) throw new Error("google/gemini-2.5-flash missing from pinned catalog");
+  }
+  const env = new NodeExecutionEnv({ cwd: process.cwd(), shellEnv: process.env });
+  const harness = new AgentHarness({
+    env, session, models, model, tools, thinkingLevel: "off", systemPrompt,
+    streamOptions: { maxRetries: 1, timeoutMs: 60_000 },
+  });
+  const exactToolHooks = [];
+  const runtimeToolEvents = [];
+  const payloads = [];
+  const assistantMessages = [];
+
+  harness.on("tool_call", (event) => { exactToolHooks.push(clone(event)); });
+  harness.on("tool_result", (event) => { exactToolHooks.push(clone(event)); });
+  harness.on("before_provider_payload", (event) => {
+    const payload = clone(event.payload);
+    payloads.push({ payload, serializedBytes: Buffer.byteLength(JSON.stringify(payload)) });
+  });
+  harness.subscribe((event) => {
+    if (["tool_execution_start", "tool_execution_update", "tool_execution_end"].includes(event.type)) {
+      runtimeToolEvents.push(clone(event));
+    }
+    if (event.type === "message_end" && event.message?.role === "assistant") {
+      assistantMessages.push(clone(event.message));
+    }
+  });
+
+  return {
+    harness, storage, exactToolHooks, runtimeToolEvents, payloads, assistantMessages,
+    async cleanup() { await env.cleanup(); },
+  };
+}
+
+export function compactReply(reply) {
+  return {
+    content: reply.content,
+    usage: reply.usage,
+    stopReason: reply.stopReason,
+    errorMessage: reply.errorMessage,
+    provider: reply.provider,
+    model: reply.model,
+  };
+}
diff --git a/spike-tool-catalog/src/host-session-storage.js b/spike-tool-catalog/src/host-session-storage.js
new file mode 100644
index 0000000000000000000000000000000000000000..34dfa6727a5e7a6f34aa644771294abe157ebfe7
--- /dev/null
+++ b/spike-tool-catalog/src/host-session-storage.js
@@ -0,0 +1,73 @@
+import { randomUUID } from "node:crypto";
+import { appendFile, readFile } from "node:fs/promises";
+
+// Host-owned SessionStorage copied from the proven spike-pi-storage seam.
+export class HostSessionStorage {
+  constructor({ recordPath, metadata, entries = [] }) {
+    this.recordPath = recordPath;
+    this.metadata = metadata;
+    this.entries = [...entries];
+    this.byId = new Map(entries.map((entry) => [entry.id, entry]));
+    this.leafId = null;
+    for (const entry of entries) this.leafId = entry.type === "leaf" ? entry.targetId : entry.id;
+  }
+
+  static async create(recordPath, metadata) {
+    const storage = new HostSessionStorage({ recordPath, metadata });
+    await storage.write({ op: "metadata", metadata });
+    return storage;
+  }
+
+  static async open(recordPath) {
+    const records = (await readFile(recordPath, "utf8"))
+      .split("\n").filter(Boolean).map((line) => JSON.parse(line));
+    const metadata = records.find((record) => record.op === "metadata")?.metadata;
+    if (!metadata) throw new Error("host record stream has no metadata");
+    return new HostSessionStorage({
+      recordPath,
+      metadata,
+      entries: records.filter((record) => record.op === "entry").map((record) => record.entry),
+    });
+  }
+
+  async write(record) { await appendFile(this.recordPath, `${JSON.stringify(record)}\n`, "utf8"); }
+  async getMetadata() { return this.metadata; }
+  async getLeafId() { return this.leafId; }
+  async createEntryId() { return randomUUID(); }
+  async getEntry(id) { return this.byId.get(id); }
+  async findEntries(type) { return this.entries.filter((entry) => entry.type === type); }
+  async getEntries() { return [...this.entries]; }
+
+  async appendEntry(entry) {
+    this.entries.push(entry);
+    this.byId.set(entry.id, entry);
+    this.leafId = entry.type === "leaf" ? entry.targetId : entry.id;
+    await this.write({ op: "entry", entry });
+  }
+
+  async setLeafId(leafId) {
+    if (leafId !== null && !this.byId.has(leafId)) throw new Error(`missing host entry ${leafId}`);
+    await this.appendEntry({
+      type: "leaf", id: await this.createEntryId(), parentId: this.leafId,
+      timestamp: new Date().toISOString(), targetId: leafId,
+    });
+  }
+
+  async getLabel(id) {
+    return this.entries.filter((entry) => entry.type === "label" && entry.targetId === id).at(-1)?.label;
+  }
+
+  async getPathToRoot(leafId) {
+    const path = [];
+    const seen = new Set();
+    for (let cursor = leafId; cursor !== null;) {
+      if (seen.has(cursor)) throw new Error(`cycle at ${cursor}`);
+      seen.add(cursor);
+      const entry = this.byId.get(cursor);
+      if (!entry) throw new Error(`missing host entry ${cursor}`);
+      path.push(entry);
+      cursor = entry.parentId;
+    }
+    return path.reverse();
+  }
+}
diff --git a/spike-tool-catalog/src/run-spike.js b/spike-tool-catalog/src/run-spike.js
new file mode 100644
index 0000000000000000000000000000000000000000..d67bddad56a1ed2bb5db2d2c779f9eab19f2131b
--- /dev/null
+++ b/spike-tool-catalog/src/run-spike.js
@@ -0,0 +1,182 @@
+import { mkdir, writeFile } from "node:fs/promises";
+import { resolve } from "node:path";
+import { fauxAssistantMessage, fauxToolCall } from "@earendil-works/pi-ai/providers/faux";
+import {
+  catalogMap, catalogTools, makeCallTool, makeSearchTools, summaryCatalog,
+} from "./catalog.js";
+import { compactReply, makeHarness } from "./harness.js";
+
+const artifactDir = resolve("artifacts");
+await mkdir(artifactDir, { recursive: true });
+
+async function save(name, value) {
+  await writeFile(resolve(artifactDir, `${name}.json`), `${JSON.stringify(value, null, 2)}\n`);
+  return value;
+}
+
+async function one(name, { tools, prompt, systemPrompt, fauxResponses }) {
+  const rig = await makeHarness({
+    artifactDir, id: `${name}-${Date.now()}`, tools, fauxResponses,
+    systemPrompt: systemPrompt ?? "Follow the user's tool instructions exactly. Use tools when required. Answer briefly after tool results.",
+  });
+  try {
+    const reply = await rig.harness.prompt(prompt);
+    const result = {
+      prompt, reply: compactReply(reply), exactToolHooks: rig.exactToolHooks,
+      runtimeToolEvents: rig.runtimeToolEvents, payloads: rig.payloads,
+      assistantMessages: rig.assistantMessages,
+    };
+    await save(name, result);
+    return result;
+  } finally {
+    await rig.cleanup();
+  }
+}
+
+export async function runOffline() {
+  const direct = await one("offline-control", {
+    tools: catalogTools.slice(0, 3),
+    prompt: "Call beta_add with a=7 and b=5.",
+    fauxResponses: [
+      fauxAssistantMessage(fauxToolCall("beta_add", { a: 7, b: 5 }, { id: "offline-direct-1" }), { stopReason: "toolUse", timestamp: 1 }),
+      fauxAssistantMessage("12", { timestamp: 2 }),
+    ],
+  });
+  const dispatched = await one("offline-dispatcher", {
+    tools: [makeCallTool()],
+    prompt: "Call beta_add through call_tool with a=7 and b=5.",
+    fauxResponses: [
+      fauxAssistantMessage(fauxToolCall("call_tool", { name: "beta_add", args: { a: 7, b: 5 } }, { id: "offline-outer-1" }), { stopReason: "toolUse", timestamp: 1 }),
+      fauxAssistantMessage("12", { timestamp: 2 }),
+    ],
+  });
+  return save("offline-verdict", { direct, dispatched });
+}
+
+export async function runControlAndDispatcher() {
+  const control = await one("live-control", {
+    tools: catalogTools.slice(0, 3),
+    prompt: "You MUST call beta_add exactly once with a=7 and b=5, then report the sum.",
+  });
+  const dispatcher = await one("live-dispatcher", {
+    tools: [makeCallTool()],
+    prompt: "You MUST invoke call_tool exactly once with name beta_add and args {a:7,b:5}, then report the sum. beta_add is not a resident provider tool.",
+  });
+  return { control, dispatcher };
+}
+
+export async function runDiscovery() {
+  return one("live-discovery", {
+    tools: [makeSearchTools(), makeCallTool()],
+    prompt: "The needed tool is not resident. First call search_tools to find a tool that assesses project risk. Then invoke the returned tool through call_tool for project=Apollo. Do both steps; do not guess the result.",
+  });
+}
+
+function tokenMeasurement(result) {
+  return {
+    requestCount: result.payloads.length,
+    payloadBytes: result.payloads.map(({ serializedBytes }) => serializedBytes),
+    providerUsage: result.assistantMessages.map(({ usage }) => usage),
+    totalProviderInputTokens: result.assistantMessages.reduce((sum, message) => sum + (message.usage?.input ?? 0), 0),
+    totalProviderCacheReadTokens: result.assistantMessages.reduce((sum, message) => sum + (message.usage?.cacheRead ?? 0), 0),
+  };
+}
+
+export async function runTokenCosts() {
+  const prompt = "Reply with exactly OK and do not call any tool.";
+  const base = "You are measuring request size. Follow the user exactly.";
+  const allResident = await one("tokens-all-resident", { tools: catalogTools, prompt, systemPrompt: base });
+  const searchCatalog = await one("tokens-search-catalog", {
+    tools: [makeSearchTools(catalogMap, 8000), makeCallTool()], prompt,
+    systemPrompt: `${base} Search results are capped at 8,000 serialized bytes (roughly a 2,000-token result budget).`,
+  });
+  const summaryOnly = await one("tokens-summary-only", {
+    tools: [makeCallTool()], prompt,
+    systemPrompt: `${base}\nAvailable host-side tool summaries:\n${summaryCatalog}`,
+  });
+  return save("token-costs", {
+    definitions: {
+      allResident: "40 provider-resident function declarations",
+      searchCatalog: "Only search_tools and call_tool resident; catalog remains host-side; search result cap 8,000 bytes (~2,000-token budget ceiling)",
+      summaryOnly: "call_tool resident plus all 40 name/description summaries in the system instruction",
+    },
+    allResident: tokenMeasurement(allResident),
+    searchCatalog: tokenMeasurement(searchCatalog),
+    summaryOnly: tokenMeasurement(summaryOnly),
+  });
+}
+
+const repeatedTargets = [
+  ["weather_lookup", { city: "Oslo" }],
+  ["inventory_check", { sku: "SKU-7" }],
+  ["sentiment_score", { text: "excellent" }],
+  ["build_status", { buildId: "b-9" }],
+  ["queue_depth", { queue: "jobs" }],
+  ["policy_evaluate", { subject: "alice" }],
+  ["project_progress", { project: "Apollo" }],
+  ["risk_assess", { project: "Apollo" }],
+];
+
+async function repeatedSession(name, mode) {
+  const tools = mode === "catalog" ? [makeSearchTools(), makeCallTool()] : catalogTools;
+  const rig = await makeHarness({
+    artifactDir, id: `${name}-${Date.now()}`, tools,
+    systemPrompt: "Execute the requested tool workflow exactly once per named tool and answer briefly after the result.",
+  });
+  const turns = [];
+  try {
+    for (const [target, args] of repeatedTargets) {
+      const p0 = rig.payloads.length;
+      const m0 = rig.assistantMessages.length;
+      const e0 = rig.exactToolHooks.length;
+      const prompt = mode === "catalog"
+        ? `Turn ${turns.length + 1}: you MUST call search_tools for ${target}, then call the exact returned tool through call_tool with args ${JSON.stringify(args)}. Do not skip search.`
+        : `Turn ${turns.length + 1}: call ${target} directly with args ${JSON.stringify(args)}.`;
+      const reply = await rig.harness.prompt(prompt);
+      turns.push({
+        prompt, reply: compactReply(reply),
+        payloads: rig.payloads.slice(p0),
+        assistantMessages: rig.assistantMessages.slice(m0),
+        exactToolHooks: rig.exactToolHooks.slice(e0),
+      });
+    }
+    const result = {
+      mode, turns, measurement: {
+        ...tokenMeasurement(rig),
+        toolCalls: rig.exactToolHooks.filter((event) => event.type === "tool_call").map((event) => event.toolName),
+      },
+    };
+    await save(name, result);
+    return result;
+  } finally {
+    await rig.cleanup();
+  }
+}
+
+export async function runMultiTurn() {
+  const catalog = await repeatedSession("multiturn-catalog", "catalog");
+  const resident = await repeatedSession("multiturn-resident", "resident");
+  return save("multiturn-comparison", {
+    catalog: catalog.measurement,
+    resident: resident.measurement,
+    catalogPerTurn: catalog.turns.map((turn, index) => ({ turn: index + 1, ...tokenMeasurement(turn) })),
+    residentPerTurn: resident.turns.map((turn, index) => ({ turn: index + 1, ...tokenMeasurement(turn) })),
+  });
+}
+
+async function runLive() {
+  const identity = await runControlAndDispatcher();
+  const discovery = await runDiscovery();
+  const tokenCosts = await runTokenCosts();
+  const multiTurn = await runMultiTurn();
+  await save("live-summary", { identity, discovery, tokenCosts, multiTurn });
+}
+
+const command = process.argv[2] ?? "all";
+if (command === "offline") await runOffline();
+else if (command === "identity") await runControlAndDispatcher();
+else if (command === "discovery") await runDiscovery();
+else if (command === "tokens") await runTokenCosts();
+else if (command === "multiturn") await runMultiTurn();
+else if (command === "all") { await runOffline(); await runLive(); }
+else throw new Error(`unknown command: ${command}`);
diff --git a/spike-tool-catalog/test/identity.test.js b/spike-tool-catalog/test/identity.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..310f63551b51dde61b329e9db2e6c0c81ff2030a
--- /dev/null
+++ b/spike-tool-catalog/test/identity.test.js
@@ -0,0 +1,42 @@
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, describe, expect, test } from "vitest";
+import { fauxAssistantMessage, fauxToolCall } from "@earendil-works/pi-ai/providers/faux";
+import { catalogTools, makeCallTool } from "../src/catalog.js";
+import { makeHarness } from "../src/harness.js";
+
+const dirs = [];
+afterEach(async () => Promise.all(dirs.splice(0).map((dir) => rm(dir, { recursive: true, force: true }))));
+
+async function rigWith(tools, firstResponse) {
+  const artifactDir = await mkdtemp(join(tmpdir(), "tool-catalog-test-"));
+  dirs.push(artifactDir);
+  return makeHarness({
+    artifactDir, id: "test-session", tools, systemPrompt: "test",
+    fauxResponses: [firstResponse, fauxAssistantMessage("done", { timestamp: 2 })],
+  });
+}
+
+describe("tool identity", () => {
+  test("direct calls emit beta_add identity", async () => {
+    const rig = await rigWith(catalogTools.slice(0, 3),
+      fauxAssistantMessage(fauxToolCall("beta_add", { a: 7, b: 5 }, { id: "direct-1" }), { stopReason: "toolUse", timestamp: 1 }));
+    try {
+      await rig.harness.prompt("add");
+      expect(rig.exactToolHooks.map((event) => event.toolName)).toEqual(["beta_add", "beta_add"]);
+      expect(rig.exactToolHooks[1].content[0].text).toBe('{"sum":12}');
+    } finally { await rig.cleanup(); }
+  });
+
+  test("dispatcher emits only outer call_tool identity and nests the inner result", async () => {
+    const rig = await rigWith([makeCallTool()],
+      fauxAssistantMessage(fauxToolCall("call_tool", { name: "beta_add", args: { a: 7, b: 5 } }, { id: "outer-1" }), { stopReason: "toolUse", timestamp: 1 }));
+    try {
+      await rig.harness.prompt("dispatch");
+      expect(rig.exactToolHooks.map((event) => event.toolName)).toEqual(["call_tool", "call_tool"]);
+      expect(rig.exactToolHooks[1].details.dispatchedName).toBe("beta_add");
+      expect(rig.exactToolHooks.some((event) => event.toolName === "beta_add")).toBe(false);
+    } finally { await rig.cleanup(); }
+  });
+});

