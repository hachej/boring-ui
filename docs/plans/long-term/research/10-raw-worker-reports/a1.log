   325	  private finalMessageId(final: BoringChatMessage): string {
   326	    if (final.role === 'assistant' && this.activeAssistantMessageId) return this.activeAssistantMessageId
   327	    if (final.role !== 'user') return final.id
   328	
   329	    const text = messageText(final)
   330	    const exactIndex = this.pendingUserStarts.findIndex((start) => start.text === text)
   331	    const fallbackIndex = exactIndex >= 0 ? exactIndex : this.pendingUserStarts.findIndex((start) => start.text === undefined || text === undefined)
   332	    if (fallbackIndex < 0) return final.id
   333	    const [matched] = this.pendingUserStarts.splice(fallbackIndex, 1)
   334	    return matched?.messageId ?? final.id
   335	  }
