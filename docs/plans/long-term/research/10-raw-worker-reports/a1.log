     1	export interface ToolUiMetadata {
     2	  /** Renderer key registered by the app shell, e.g. `pi-subagent`. */
     3	  rendererId?: string
     4	  /** Optional grouping label for future tool timelines/summaries. */
     5	  displayGroup?: string
     6	  /** Optional icon hint. Frontends decide whether/how to honor it. */
     7	  icon?: string
     8	  /** Renderer-specific structured data. */
     9	  details?: unknown
    10	}
    11	
    12	function isRecord(value: unknown): value is Record<string, unknown> {
    13	  return typeof value === 'object' && value !== null && !Array.isArray(value)
    14	}
    15	
    16	export function isToolUiMetadata(value: unknown): value is ToolUiMetadata {
    17	  if (!isRecord(value)) return false
    18	  return (
    19	    (value.rendererId === undefined || typeof value.rendererId === 'string') &&
    20	    (value.displayGroup === undefined || typeof value.displayGroup === 'string') &&
    21	    (value.icon === undefined || typeof value.icon === 'string')
    22	  )
    23	}
    24	
    25	export function sanitizeToolUiMetadata(value: unknown): ToolUiMetadata | undefined {
    26	  if (!isToolUiMetadata(value)) return undefined
    27	  const rendererId = value.rendererId?.trim()
    28	  const displayGroup = value.displayGroup?.trim()
    29	  const icon = value.icon?.trim()
    30	  return {
    31	    ...(rendererId ? { rendererId } : {}),
    32	    ...(displayGroup ? { displayGroup } : {}),
    33	    ...(icon ? { icon } : {}),
    34	    ...(value.details !== undefined ? { details: value.details } : {}),
    35	  }
    36	}
    37	
    38	/**
    39	 * Extract structured UI metadata from a ToolResult-like output.
    40	 *
    41	 * Shape:
    42	 *   output.details.ui = { rendererId, displayGroup, icon, details }
    43	 */
    44	export function extractToolUiMetadata(output: unknown): ToolUiMetadata | undefined {
    45	  if (!isRecord(output)) return undefined
    46	  const details = output.details
    47	  if (!isRecord(details)) return undefined
    48	
    49	  return sanitizeToolUiMetadata(details.ui)
    50	}
