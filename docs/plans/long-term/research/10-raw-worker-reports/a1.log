   374	//
   375	// Custom header (not ToolHeader): the wrench icon + "exec_ui · …" prefix
   376	// from the default header is redundant for high-frequency UI commands.
   377	// We replace it with a tighter layout — a lightning glyph hints at the
   378	// "fire-and-forget UI command" semantics, the kind name reads as the
   379	// verb, and primitive param values render as mono tokens (no JSON
   380	// braces). Generic across all kinds; no per-kind branching.
   381	//
   382	// Body collapsed by default, stays consistent with bash/read/edit. On
   383	// error, errorText surfaces in the body via ToolOutput.
   384	
   385	function extractParamTokens(value: unknown, depth = 0): string[] {
   386	  if (value === null || value === undefined) return []
   387	  if (typeof value === 'string') return [value]
   388	  if (typeof value === 'number' || typeof value === 'boolean') return [String(value)]
   389	  if (Array.isArray(value)) {
   390	    return depth >= 2
   391	      ? [JSON.stringify(value)]
   392	      : value.flatMap((v) => extractParamTokens(v, depth + 1))
   393	  }
   394	  if (typeof value === 'object') {
   395	    return depth >= 2
   396	      ? [JSON.stringify(value)]
   397	      : Object.values(value as Record<string, unknown>).flatMap((v) =>
   398	          extractParamTokens(v, depth + 1),
   399	        )
   400	  }
   401	  return [String(value)]
   402	}
