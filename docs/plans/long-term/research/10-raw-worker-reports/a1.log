   297	  /**
   298	   * Surfaces a turn failure as an explicit `error` event. Some failures (e.g.
   299	   * "No API key for provider") never produce an assistant `error` stream
   300	   * event — the message only rides on agent_end's final assistant entry
   301	   * (stopReason 'error' + errorMessage), which is also where the snapshot
   302	   * reads it from. Without this, live clients see an empty assistant message
   303	   * and an error agent-end but never the error text. Skipped when pi will
   304	   * auto-retry (auto_retry_* events own that flow) or when an error event was
   305	   * already emitted for this turn.
   306	   */
   307	  private mapAgentEndError(event: RecordLike, turnId: string, status: 'ok' | 'aborted' | 'error'): PiChatEvent[] {
   308	    if (status !== 'error' || event.willRetry === true) return []
   309	    if (this.errorEmittedTurnIds.has(turnId)) return []
   310	    this.errorEmittedTurnIds.add(turnId)
   311	    return [
