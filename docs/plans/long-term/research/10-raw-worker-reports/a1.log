    31	export interface MergeToolsOptions {
    32	  standardTools: AgentTool[]
    33	  extraTools?: AgentTool[]
    34	  pluginTools?: PluginToolRegistration[]
    35	  logger?: ToolCollisionLogger
    36	  checkReadiness?: ToolReadinessCheck
    37	  collisionPolicy?: ToolCollisionPolicy
    38	}
    39	
    40	function setLastRegistered(
    41	  merged: Map<string, AgentTool>,
    42	  tool: AgentTool,
    43	): void {
    44	  merged.delete(tool.name)
    45	  merged.set(tool.name, tool)
    46	}
    47	
    48	function assertNoToolCollisions(options: MergeToolsOptions): void {
    49	  const seen = new Set<string>()
    50	  const inspect = (tool: AgentTool): void => {
    51	    if (seen.has(tool.name)) throw new ToolCatalogCollisionError()
    52	    seen.add(tool.name)
    53	  }
    54	
    55	  for (const tool of options.standardTools) inspect(tool)
    56	  for (const tool of options.extraTools ?? []) inspect(tool)
    57	  for (const plugin of options.pluginTools ?? []) {
    58	    for (const tool of plugin.tools) inspect(tool)
    59	  }
    60	}
    61	
    62	export function mergeTools(options: MergeToolsOptions): AgentTool[] {
    63	  if (options.collisionPolicy === 'error') assertNoToolCollisions(options)
    64	
    65	  const merged = new Map<string, AgentTool>()
    66	
    67	  for (const tool of options.standardTools) {
    68	    setLastRegistered(merged, tool)
    69	  }
    70	
    71	  for (const tool of options.extraTools ?? []) {
    72	    if (merged.has(tool.name)) {
    73	      options.logger?.warn(
    74	        `[catalog] Tool "${tool.name}" overridden by extraTools`,
    75	      )
    76	    }
    77	    setLastRegistered(merged, tool)
    78	  }
    79	
    80	  for (const plugin of options.pluginTools ?? []) {
    81	    for (const tool of plugin.tools) {
    82	      if (merged.has(tool.name)) {
    83	        options.logger?.warn(
    84	          `[catalog] Tool "${tool.name}" overridden by plugin ${plugin.pluginName}`,
    85	        )
    86	      }
    87	      const pluginTool = tool.readinessRequirements === undefined
    88	        ? withReadinessRequirements(tool, ['workspace-fs'] satisfies ToolReadinessRequirement[])
    89	        : tool
    90	      setLastRegistered(merged, pluginTool)
    91	    }
    92	  }
    93	
    94	  return [...merged.values()].map((tool) => wrapToolForReadiness(tool, options.checkReadiness))
    95	}

