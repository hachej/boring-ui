    59	      }
    60	      return JSON.parse(raw) as PersistedHandles
    61	    } catch (error) {
    62	      const nodeError = error as NodeJS.ErrnoException
    63	      if (nodeError.code === 'ENOENT') {
    64	        return {}
    65	      }
    66	      throw error
    67	    }
    68	  }
