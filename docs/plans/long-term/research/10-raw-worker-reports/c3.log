    74	    providerDigest: input.providerDigest,
    75	    provisioningArtifactDigests: [...input.provisioningArtifactDigests].sort(),
    76	    provisioningGeneration: input.provisioningGeneration,
    77	    ...(input.templateDigest === undefined ? {} : { templateDigest: input.templateDigest }),
    78	  })
    79	}
