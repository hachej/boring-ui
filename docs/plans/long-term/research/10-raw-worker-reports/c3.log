     9	
    10	interface CaptureState {
    11	  capturedBytes: number
    12	  maxBytes: number
    13	  truncated: boolean
    14	}
    15	
    16	function appendOutput(
    17	  chunks: Buffer[],
    18	  chunk: Buffer,
    19	  state: CaptureState,
    20	  onChunk?: (chunk: Uint8Array) => void,
    21	): void {
    22	  const remaining = state.maxBytes - state.capturedBytes
    23	  if (remaining <= 0) {
    24	    state.truncated = true
    25	    return
    26	  }
    27	
    28	  if (chunk.length > remaining) {
    29	    const partial = chunk.subarray(0, remaining)
    30	    chunks.push(partial)
    31	    state.capturedBytes += remaining
    32	    state.truncated = true
    33	    onChunk?.(new Uint8Array(partial))
    34	    return
    35	  }
    36	
    37	  chunks.push(chunk)
    38	  state.capturedBytes += chunk.length
    39	  onChunk?.(new Uint8Array(chunk))
    40	}
    41	
    42	
    43	function terminateProcess(
    44	  child: ReturnType<typeof spawn>,
    45	  signal: NodeJS.Signals,
    46	): void {
    47	  const pid = child.pid
    48	  if (!pid) return
    49	
    50	  if (process.platform !== 'win32') {
    51	    try {
    52	      process.kill(-pid, signal)
    53	      return
    54	    } catch {
    55	      // Fall back to direct child kill.
    56	    }
    57	  }
    58	
    59	  try {
    60	    child.kill(signal)
    61	  } catch {
    62	    // Process may have already exited.
    63	  }
    64	}
