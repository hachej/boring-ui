     2	import { Writable } from 'node:stream'
     3	import type { Sandbox as VercelSandbox } from '@vercel/sandbox'
     4	
     5	import type { ExecResult, Sandbox } from '@hachej/boring-agent/shared'
     6	import {
     7	  invalidateVercelSandboxWorkspaceMetadataCache,
     8	  VERCEL_SANDBOX_RUNTIME_CONTEXT,
     9	  VERCEL_SANDBOX_WORKSPACE_ROOT,
    10	} from './createVercelSandboxWorkspace'
    11	import { withWorkspacePythonEnv } from '../node-workspace/workspacePythonEnv'
    12	
    13	const DEFAULT_TIMEOUT_MS = 30_000
    14	const DEFAULT_MAX_OUTPUT_BYTES = 1_048_576
    15	const VERCEL_SANDBOX_DEFAULT_PATH = '/vercel/runtimes/node24/bin:/vercel/runtimes/node22/bin:/vercel/runtimes/python/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
    16	
    17	interface CaptureState {
    18	  totalBytes: number
    19	  maxBytes: number
    20	  truncated: boolean
    21	}
    22	
    23	interface StreamCollector {
    24	  chunks: Buffer[]
    25	}
    26	
    27	function createStreamWritable(
    28	  collector: StreamCollector,
    29	  shared: CaptureState,
    30	  onChunk?: (chunk: Uint8Array) => void,
    31	): Writable {
    32	  return new Writable({
    33	    write(chunk: Buffer, _enc, cb) {
    34	      const remaining = shared.maxBytes - shared.totalBytes
    35	      if (remaining <= 0) {
    36	        shared.truncated = true
    37	        cb()
    38	        return
    39	      }
    40	
    41	      if (chunk.length > remaining) {
    42	        const partial = chunk.subarray(0, remaining)
    43	        collector.chunks.push(partial)
    44	        shared.totalBytes += remaining
    45	        shared.truncated = true
    46	        onChunk?.(new Uint8Array(partial))
    47	        cb()
    48	        return
    49	      }
    50	
    51	      collector.chunks.push(chunk)
    52	      shared.totalBytes += chunk.length
    53	      onChunk?.(new Uint8Array(chunk))
    54	      cb()
    55	    },
    56	  })
    57	}
    58	
    59	function timeoutResult(durationMs: number): ExecResult {
    60	  return {
    61	    stdout: new Uint8Array(),
    62	    stderr: new Uint8Array(),
    63	    exitCode: 124,
    64	    durationMs,
    65	    truncated: false,
    66	    stdoutEncoding: 'utf-8',
    67	    stderrEncoding: 'utf-8',
    68	  }
    69	}
    70	
    71	function normalizeVercelCwd(cwd: string | undefined): string {
    72	  const requested = cwd ?? VERCEL_SANDBOX_WORKSPACE_ROOT
    73	  if (!posix.isAbsolute(requested)) throw new Error(`Vercel sandbox cwd must be absolute: ${requested}`)
    74	  const normalized = posix.normalize(requested)
    75	  if (normalized !== VERCEL_SANDBOX_WORKSPACE_ROOT && !normalized.startsWith(`${VERCEL_SANDBOX_WORKSPACE_ROOT}/`)) {
    76	    throw new Error(`Vercel sandbox cwd must stay under ${VERCEL_SANDBOX_WORKSPACE_ROOT}: ${requested}`)
    77	  }
    78	  return normalized
    79	}
    80	
    81	function toRemoteEnv(env: Record<string, string> | undefined): Record<string, string> {
    82	  const baseEnv = {
    83	    ...(env ?? {}),
    84	    PATH: env?.PATH ? `${env.PATH}:${VERCEL_SANDBOX_DEFAULT_PATH}` : VERCEL_SANDBOX_DEFAULT_PATH,
    85	  }
    86	  return Object.fromEntries(
    87	    Object.entries(withWorkspacePythonEnv({
    88	      workspaceRoot: VERCEL_SANDBOX_WORKSPACE_ROOT,
    89	      env: baseEnv,
    90	    })).filter((entry): entry is [string, string] => entry[1] != null),
    91	  )
    92	}
    93	
    94	export function createVercelSandboxExec(
    95	  sandbox: VercelSandbox,
    96	  execOpts: { onMutation?: () => void } = {},
    97	): Sandbox {
    98	  return {
    99	    id: 'vercel-sandbox',
   100	    placement: 'remote',
   101	    provider: 'vercel-sandbox',
   102	    capabilities: ['exec'],
   103	    runtimeContext: VERCEL_SANDBOX_RUNTIME_CONTEXT,
   104	    async init() {
   105	      // Vercel sandbox handle is already established by runtime adapter.
   106	    },
   107	    async exec(cmd, opts) {
   108	      const start = Date.now()
   109	      const timeoutMs = opts?.timeoutMs ?? DEFAULT_TIMEOUT_MS
   110	      const maxOutputBytes = opts?.maxOutputBytes ?? DEFAULT_MAX_OUTPUT_BYTES
   111	
   112	      let timedOut = false
   113	      const controller = new AbortController()
   114	      let timeoutHandle: NodeJS.Timeout | null = null
   115	      let heartbeatHandle: NodeJS.Timeout | null = null
   116	      const externalSignal = opts?.signal
   117	
   118	      const abortFromExternalSignal = () => {
   119	        controller.abort(externalSignal?.reason)
   120	      }
   121	
   122	      const captureState: CaptureState = { totalBytes: 0, maxBytes: maxOutputBytes, truncated: false }
   123	      const stdoutCollector: StreamCollector = { chunks: [] }
   124	      const stderrCollector: StreamCollector = { chunks: [] }
   125	
   126	      try {
   127	        if (externalSignal) {
   128	          if (externalSignal.aborted) {
   129	            abortFromExternalSignal()
   130	          } else {
   131	            externalSignal.addEventListener('abort', abortFromExternalSignal, {
   132	              once: true,
   133	            })
   134	          }
   135	        }
   136	
   137	        timeoutHandle = setTimeout(() => {
   138	          timedOut = true
   139	          controller.abort()
   140	        }, timeoutMs)
   141	
   142	        if (opts?.onHeartbeat) {
   143	          heartbeatHandle = setInterval(() => {
   144	            opts.onHeartbeat?.(Date.now() - start)
   145	          }, 1_000)
   146	        }
   147	
   148	        const result = await sandbox.runCommand({
   149	          cmd: 'sh',
   150	          args: ['-c', cmd],
   151	          cwd: normalizeVercelCwd(opts?.cwd),
   152	          env: toRemoteEnv(opts?.env),
   153	          signal: controller.signal,
   154	          stdout: createStreamWritable(stdoutCollector, captureState, opts?.onStdout),
   155	          stderr: createStreamWritable(stderrCollector, captureState, opts?.onStderr),
   156	        })
   157	
   158	        return {
   159	          stdout: new Uint8Array(Buffer.concat(stdoutCollector.chunks)),
   160	          stderr: new Uint8Array(Buffer.concat(stderrCollector.chunks)),
   161	          exitCode: result.exitCode ?? 1,
   162	          durationMs: Date.now() - start,
   163	          truncated: captureState.truncated,
   164	          stdoutEncoding: 'utf-8',
   165	          stderrEncoding: 'utf-8',
   166	        }
   167	      } catch (error) {
   168	        if (timedOut) {
   169	          return timeoutResult(Math.max(Date.now() - start, timeoutMs))
   170	        }
   171	        throw error
   172	      } finally {
   173	        invalidateVercelSandboxWorkspaceMetadataCache(sandbox)
   174	        execOpts.onMutation?.()
   175	        if (timeoutHandle) clearTimeout(timeoutHandle)
   176	        if (heartbeatHandle) clearInterval(heartbeatHandle)
   177	        externalSignal?.removeEventListener('abort', abortFromExternalSignal)
   178	      }
   179	    },
   180	  }
   181	}

