    77	        { placementIdentity: environment.placementIdentity },
    78	      )
    79	    }
    80	    if (!record) {
    81	      const abort = new AbortController()
    82	      const generation = this.createEnvironment(workspaceScopeId, environment, abort.signal)
    83	      record = {
    84	        key,
    85	        scope: environment,
    86	        abort,
    87	        generation,
    88	        references: 0,
    89	      }
