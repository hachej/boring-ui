    60	export async function applySnapshotRetention(
    61	  workspaceId: string,
    62	  latestSnapshot: SnapshotHandle,
    63	  snapshotsByWorkspaceId: Map<string, SnapshotHandle[]>,
    64	  opts: {
    65	    getEnvVar?: EnvGetter
    66	    signal?: AbortSignal
    67	  } = {},
    68	): Promise<void> {
    69	  const keepCount = resolveSnapshotKeepCount(opts.getEnvVar ?? getEnv)
    70	  const existing = snapshotsByWorkspaceId.get(workspaceId) ?? []
    71	  const ordered = [latestSnapshot, ...existing]
    72	  const retained = ordered.slice(0, keepCount)
    73	  const stale = ordered.slice(keepCount)
    74	  const failedDeletes: SnapshotHandle[] = []
    75	  let firstDeleteError: unknown | null = null
    76	
    77	  for (const snapshot of stale) {
    78	    try {
    79	      await snapshot.delete({ signal: opts.signal })
    80	    } catch (error) {
    81	      if (firstDeleteError === null) {
    82	        firstDeleteError = error
    83	      }
    84	      failedDeletes.push(snapshot)
    85	    }
    86	  }
    87	
    88	  snapshotsByWorkspaceId.set(workspaceId, [...retained, ...failedDeletes])
    89	  if (firstDeleteError !== null) {
    90	    throw firstDeleteError
    91	  }
    92	}
