    10	function vercelRemoteWorkspacePathOptions(options: {
    11	  remoteRoot: string
    12	  workspaceRoot: string
    13	}): RuntimeRemoteWorkspacePathOptions {
    14	  const { remoteRoot, workspaceRoot } = options
    15	  return {
    16	    rootAliases: [remoteRoot, '/vercel/sandbox'],
    17	    toRemotePath(value) {
    18	      if (value === workspaceRoot) return remoteRoot
    19	      if (value.startsWith(`${workspaceRoot}/`)) {
    20	        return `${remoteRoot}${value.slice(workspaceRoot.length)}`
    21	      }
    22	      if (value === '/vercel/sandbox') return remoteRoot
    23	      if (value.startsWith('/vercel/sandbox/')) {
    24	        return `${remoteRoot}${value.slice('/vercel/sandbox'.length)}`
    25	      }
    26	      return value
    27	    },
    28	    toRuntimePath(value) {
    29	      if (value === remoteRoot) return workspaceRoot
    30	      if (value.startsWith(`${remoteRoot}/`)) {
    31	        return `${workspaceRoot}${value.slice(remoteRoot.length)}`
    32	      }
    33	      if (value === '/vercel/sandbox') return workspaceRoot
    34	      if (value.startsWith('/vercel/sandbox/')) {
    35	        return `${workspaceRoot}${value.slice('/vercel/sandbox'.length)}`
    36	      }
    37	      return value
    38	    },
    39	    sanitizeErrorText(value) {
    40	      return value.replaceAll('/vercel/sandbox', workspaceRoot)
    41	    },
    42	  }
    43	}
