   109	    await handle.writeFile(`${fingerprint}\n`)
   110	    await handle.sync()
   111	  } finally {
   112	    await handle.close()
   113	  }
   114	
   115	  try {
   116	    await rename(tmpPath, path)
   117	  } catch (error) {
   118	    await rm(tmpPath, { force: true })
   119	    throw error
   120	  }
   121	}
