    27	
    28	/** Canonical JSON projection used only for app-resolved identity material. */
    29	function canonicalJson(value: JsonValue): string {
    30	  if (value === null || typeof value !== 'object') return JSON.stringify(value)
    31	  if (Array.isArray(value)) return `[${value.map(canonicalJson).join(',')}]`
    32	  return `{${Object.keys(value).sort().map((key) => (
    33	    `${JSON.stringify(key)}:${canonicalJson((value as Readonly<Record<string, JsonValue>>)[key]!)}`
    34	  )).join(',')}}`
    35	}
    36	
    37	function digest(value: JsonValue): string {
    38	  return createHash('sha256').update(canonicalJson(value)).digest('hex')
    39	}
    40	
    41	/**
    42	 * Produces the complete Agent-binding identity. Grants intentionally
    43	 * participate here even though they do not participate in Environment
    44	 * provisioning identity.
    45	 */
    46	export function createResolvedRuntimeScopeIdentity(
    47	  input: RuntimeScopeIdentityInput,
    48	): string {
    49	  return digest({
    50	    schemaVersion: 2,
    51	    artifacts: [...input.artifacts]
    52	      .map((artifact) => ({ pluginId: artifact.pluginId, digest: artifact.digest }))
    53	      .sort((a, b) => a.pluginId.localeCompare(b.pluginId) || a.digest.localeCompare(b.digest)),
    54	    validatedConfig: input.validatedConfig,
    55	    grants: [...input.grants].sort(),
    56	    placementClassIdentity: input.placementClassIdentity,
    57	    isolationMode: input.isolationMode,
    58	    toolContractDigests: [...input.toolContractDigests].sort(),
    59	    provisioningIdentity: input.provisioningIdentity,
    60	    ...(input.bindingInputs === undefined ? {} : { bindingInputs: input.bindingInputs }),
    61	  })
    62	}
