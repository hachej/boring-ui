   106	  const timestamp = nowIso(now)
   107	
   108	  await store.put({
   109	    workspaceId,
   110	    sandboxId: sandbox.sandboxId,
   111	    snapshotId,
   112	    createdAt: previous?.createdAt ?? timestamp,
   113	    lastUsedAt: timestamp,
   114	  })
   115	}
