   339	export async function resolveSandboxHandle(
   340	  workspaceId: string,
   341	  store: SandboxHandleStore,
   342	  vercel: VercelSandboxClient,
   343	  opts?: ResolveSandboxHandleOptions,
   344	): Promise<VercelSandboxHandle> {
   345	  const workspaceKey = workspaceId.trim()
   346	  if (workspaceKey.length === 0) {
   347	    throw new Error('workspaceId must not be empty')
   348	  }
   349	  const expiredSandboxPolicy = opts?.expiredSandboxPolicy ?? 'recreate'
   350	
   351	  const inProcess = sandboxesByWorkspaceId.get(workspaceKey)
   352	  if (inProcess && !isSandboxExpired(inProcess)) {
   353	    return inProcess
   354	  }
   355	  if (inProcess) {
   356	    sandboxesByWorkspaceId.delete(workspaceKey)
   357	  }
   358	
   359	  const inFlightResolution = inFlightResolutionsByWorkspaceId.get(workspaceKey)
   360	  if (inFlightResolution) {
   361	    return await inFlightResolution
   362	  }
   363	
   364	  const resolution = (async (): Promise<VercelSandboxHandle> => {
   365	    const maxIdleMs = opts?.maxIdleMs
   366	    const orphanGuardEnabled = Number.isFinite(maxIdleMs) && (maxIdleMs as number) > 0
   367	    const nowMs = orphanGuardEnabled
   368	      ? (opts?.now ?? Date.now)()
   369	      : 0
   370	    const persisted = await store.get(workspaceKey)
   371	
   372	    if (persisted?.sandboxId) {
   373	      try {
   374	        const sandbox = await vercel.get({ name: persisted.sandboxId, sandboxId: persisted.sandboxId, resume: true })
   375	        if (!isSandboxExpired(sandbox)) {
   376	          if (!isPersistentSandbox(sandbox)) {
   377	            const reason = 'sandbox is not persistent'
   378	            const snapshotId = selectSnapshotForRecreate(
   379	              workspaceKey,
   380	              persisted,
   381	              reason,
   382	              opts?.logger,
   383	              sandbox,
   384	            )
   385	            opts?.logger?.warn?.('[sandbox] migrating non-persistent sandbox to persistent sandbox', {
   386	              workspaceId: workspaceKey,
   387	              sandboxId: getSandboxIdentifier(sandbox),
   388	              persistent: false,
   389	              snapshotId: snapshotId ?? null,
   390	            })
   391	            return await createFresh(
   392	              workspaceKey,
   393	              snapshotId,
   394	              opts?.tarballUrl,
   395	              persisted,
   396	              store,
   397	              vercel,
   398	              opts?.logger,
   399	            )
   400	          }
   401	
   402	          const idle = orphanGuardEnabled
   403	            ? shouldRecycleFromIdle(persisted, nowMs, maxIdleMs as number)
   404	            : { stale: false, idleMs: null }
   405	          if (idle.stale) {
   406	            opts?.logger?.warn?.('[sandbox] orphan-guard stale sandbox detected', {
   407	              workspaceId: workspaceKey,
   408	              sandboxId: getSandboxIdentifier(sandbox),
   409	              idleMs: idle.idleMs,
   410	              maxIdleMs,
   411	              lastUsedAt: persisted.lastUsedAt,
   412	            })
   413	            const snapshotId = persisted.snapshotId
   414	            if (!snapshotId) {
   415	              opts?.logger?.warn?.('[sandbox] orphan-guard skipped; no snapshot available', {
   416	                workspaceId: workspaceKey,
   417	                sandboxId: getSandboxIdentifier(sandbox),
   418	                idleMs: idle.idleMs,
   419	                maxIdleMs,
   420	              })
   421	              return await persistAndCache(workspaceKey, sandbox, persisted, store)
   422	            }
   423	            const stopResult = await stopSandboxForOrphanGuard(sandbox)
   424	            if (stopResult.stopped) {
   425	              logSandboxStop(opts?.logger, {
   426	                workspaceId: workspaceKey,
   427	                sandboxId: getSandboxIdentifier(sandbox),
   428	                reason: 'orphan-guard-idle',
   429	                idleMs: idle.idleMs,
   430	                maxIdleMs,
   431	              })
   432	              return await createFresh(
   433	                workspaceKey,
   434	                snapshotId,
   435	                opts?.tarballUrl,
   436	                persisted,
   437	                store,
   438	                vercel,
   439	                opts?.logger,
   440	              )
   441	            }
   442	
   443	            opts?.logger?.warn?.('[sandbox] orphan-guard stop failed; reusing sandbox', {
   444	              workspaceId: workspaceKey,
   445	              sandboxId: getSandboxIdentifier(sandbox),
   446	              idleMs: idle.idleMs,
   447	              maxIdleMs,
   448	              error: stopResult.error instanceof Error
   449	                ? stopResult.error.message
   450	                : String(stopResult.error),
   451	            })
   452	          }
   453	          return await persistAndCache(workspaceKey, sandbox, persisted, store)
   454	        }
   455	        const reason = `sandbox status is ${getSandboxStatus(sandbox) ?? 'expired'}`
   456	        if (expiredSandboxPolicy === 'error') {
   457	          throwUnavailable(
   458	            workspaceKey,
   459	            persisted,
   460	            reason,
   461	          )
   462	        }
   463	        const snapshotId = selectSnapshotForRecreate(
   464	          workspaceKey,
   465	          persisted,
   466	          reason,
   467	          opts?.logger,
   468	          sandbox,
   469	        )
   470	        return await createFresh(
   471	          workspaceKey,
   472	          snapshotId,
   473	          opts?.tarballUrl,
   474	          persisted,
   475	          store,
   476	          vercel,
   477	          opts?.logger,
   478	        )
   479	      } catch (error) {
   480	        if (!shouldRecreateFromSnapshot(error)) {
   481	          throw error
   482	        }
   483	        const reason = `sandbox lookup returned HTTP ${extractHttpStatus(error) ?? 'unknown'}`
   484	        if (expiredSandboxPolicy === 'error') {
   485	          throwUnavailable(
   486	            workspaceKey,
   487	            persisted,
   488	            reason,
   489	            error,
   490	          )
   491	        }
   492	        const snapshotId = selectSnapshotForRecreate(
   493	          workspaceKey,
   494	          persisted,
   495	          reason,
   496	          opts?.logger,
   497	        )
   498	        return await createFresh(
   499	          workspaceKey,
   500	          snapshotId,
   501	          opts?.tarballUrl,
   502	          persisted,
   503	          store,
   504	          vercel,
   505	          opts?.logger,
   506	        )
   507	      }
   508	    }
   509	
   510	    return await createFresh(
   511	      workspaceKey,
   512	      persisted?.snapshotId,
   513	      opts?.tarballUrl,
   514	      persisted,
   515	      store,
   516	      vercel,
   517	      opts?.logger,
   518	    )
   519	  })()
