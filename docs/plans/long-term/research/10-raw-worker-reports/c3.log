    72	  let runtimeContext = opts.runtimeContext ?? { runtimeCwd: process.cwd() }
    73	
    74	  return {
    75	    id: 'direct',
    76	    placement: 'server',
    77	    provider: 'direct',
    78	    capabilities: ['exec'],
    79	    get runtimeContext() {
    80	      return runtimeContext
    81	    },
    82	    async init(ctx) {
    83	      workspace = ctx.workspace
    84	      runtimeContext = opts.runtimeContext ?? ctx.workspace.runtimeContext
    85	    },
    86	    async exec(cmd, opts) {
    87	      if (!workspace) {
    88	        throw new Error('DirectSandbox not initialized')
    89	      }
    90	
    91	      const start = Date.now()
    92	      const timeoutMs = opts?.timeoutMs ?? DEFAULT_TIMEOUT_MS
    93	      const maxOutputBytes = opts?.maxOutputBytes ?? DEFAULT_MAX_OUTPUT_BYTES
    94	      const workspaceRoot = runtimeContext.runtimeCwd
    95	      const cwd = opts?.cwd ?? workspaceRoot
    96	
    97	      return await new Promise((resolve, reject) => {
    98	        const child = spawn(cmd, {
    99	          cwd,
   100	          env: withWorkspacePythonEnv({ workspaceRoot, env: opts?.env, preserveHostHome: true }),
   101	          shell: true,
   102	          windowsHide: true,
   103	          detached: process.platform !== 'win32',
   104	        })
   105	
   106	        const stdoutChunks: Buffer[] = []
   107	        const stderrChunks: Buffer[] = []
   108	        const captureState: CaptureState = {
   109	          capturedBytes: 0,
   110	          maxBytes: maxOutputBytes,
   111	          truncated: false,
   112	        }
   113	
   114	        let timeoutHandle: NodeJS.Timeout | null = null
   115	        let killHandle: NodeJS.Timeout | null = null
   116	        let heartbeatHandle: NodeJS.Timeout | null = null
   117	        let timedOut = false
   118	        let settled = false
   119	
   120	        const cleanup = (): void => {
   121	          if (timeoutHandle) clearTimeout(timeoutHandle)
   122	          if (killHandle) clearTimeout(killHandle)
   123	          if (heartbeatHandle) clearInterval(heartbeatHandle)
   124	        }
   125	
   126	        const settle = (exitCode: number | null): void => {
   127	          if (settled) return
   128	          settled = true
   129	          cleanup()
   130	
   131	          resolve({
   132	            stdout: new Uint8Array(Buffer.concat(stdoutChunks)),
   133	            stderr: new Uint8Array(Buffer.concat(stderrChunks)),
   134	            exitCode: typeof exitCode === 'number' ? exitCode : timedOut ? 124 : 1,
   135	            durationMs: Date.now() - start,
   136	            truncated: captureState.truncated,
   137	            stdoutEncoding: 'utf-8',
   138	            stderrEncoding: 'utf-8',
   139	          })
   140	        }
   141	
   142	        child.stdout?.on('data', (chunk: Buffer) => {
   143	          appendOutput(stdoutChunks, chunk, captureState, opts?.onStdout)
   144	        })
   145	        child.stderr?.on('data', (chunk: Buffer) => {
   146	          appendOutput(stderrChunks, chunk, captureState, opts?.onStderr)
   147	        })
   148	
   149	        child.on('error', (error) => {
   150	          if (settled) return
   151	          settled = true
