    51	          cachedBindingHealthCheck: {
    52	            intervalMs: options.healthCheckIntervalMs,
    53	            async check({ runtimeBundle }) {
    54	              const pair = (runtimeBundle as Partial<ProviderRuntimeBundle>)[runtimePair]
    55	              return await pair?.checkHealth?.() ?? { state: 'ok' as const }
