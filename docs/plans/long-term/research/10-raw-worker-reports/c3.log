   163	          killHandle = setTimeout(() => {
   164	            if (!settled) terminateProcess(child, 'SIGKILL')
   165	          }, TERMINATION_GRACE_MS)
   166	        }, timeoutMs)
   167	
   168	        if (opts?.onHeartbeat) {
   169	          heartbeatHandle = setInterval(() => {
   170	            opts.onHeartbeat?.(Date.now() - start)
   171	          }, 1_000)
   172	        }
   173	
   174	        if (opts?.signal) {
   175	          const abort = (): void => {
   176	            terminateProcess(child, 'SIGTERM')
   177	            killHandle = setTimeout(() => {
   178	              if (!settled) terminateProcess(child, 'SIGKILL')
   179	            }, TERMINATION_GRACE_MS)
   180	          }
   181	
   182	          if (opts.signal.aborted) {
   183	            abort()
   184	          } else {
   185	            opts.signal.addEventListener('abort', abort, { once: true })
