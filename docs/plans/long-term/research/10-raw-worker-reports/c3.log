   117	export function createPeriodicSnapshotScheduler(
   118	  opts: PeriodicSnapshotSchedulerOptions = {},
   119	): PeriodicSnapshotScheduler {
   120	  const intervalMs = opts.intervalMs ?? DEFAULT_SNAPSHOT_INTERVAL_MS
   121	  const now = opts.now ?? Date.now
   122	  const jobsByWorkspaceId = new Map<string, TrackedSnapshotJob>()
   123	
   124	  function stopWorkspaceInternal(workspaceId: string): void {
   125	    const existing = jobsByWorkspaceId.get(workspaceId)
   126	    if (!existing) return
   127	    clearInterval(existing.timer)
   128	    jobsByWorkspaceId.delete(workspaceId)
   129	  }
   130	
   131	  async function tick(workspaceId: string, job: TrackedSnapshotJob): Promise<void> {
   132	    if (job.inFlightPromise || !job.dirty) {
   133	      return
   134	    }
   135	
   136	    job.dirty = false
   137	    const inFlight = (async () => {
   138	      try {
   139	        const snapshot = await job.sandbox.snapshot()
   140	        await persistLatestSnapshot(
   141	          workspaceId,
   142	          job.sandbox,
   143	          snapshot.snapshotId,
   144	          job.store,
   145	          now,
   146	        )
   147	      } catch (error) {
   148	        job.dirty = true
   149	        opts.logger?.warn?.('[vercel-sandbox:snapshot-cron] snapshot failed', {
   150	          workspaceId,
   151	          error: error instanceof Error ? error.message : String(error),
   152	        })
   153	      }
   154	    })()
   155	    job.inFlightPromise = inFlight
   156	    try {
   157	      await inFlight
   158	    } finally {
   159	      if (job.inFlightPromise === inFlight) {
   160	        job.inFlightPromise = null
   161	      }
   162	    }
   163	  }
   164	
   165	  return {
   166	    trackWorkspace({ workspaceId, sandbox, store }) {
   167	      stopWorkspaceInternal(workspaceId)
   168	
   169	      const job: TrackedSnapshotJob = {
   170	        timer: setInterval(() => {
   171	          void tick(workspaceId, job)
   172	        }, intervalMs),
   173	        dirty: false,
   174	        inFlightPromise: null,
   175	        sandbox,
   176	        store,
   177	      }
   178	      const timer = job.timer as NodeJS.Timeout
   179	      timer.unref?.()
   180	      jobsByWorkspaceId.set(workspaceId, job)
   181	    },
   182	    markDirty(workspaceId) {
   183	      const job = jobsByWorkspaceId.get(workspaceId)
   184	      if (!job) return
   185	      job.dirty = true
   186	    },
   187	    stopWorkspace(workspaceId) {
   188	      stopWorkspaceInternal(workspaceId)
   189	    },
   190	    async shutdown() {
   191	      const inFlight: Promise<void>[] = []
   192	      for (const job of jobsByWorkspaceId.values()) {
   193	        clearInterval(job.timer)
   194	        if (job.inFlightPromise) {
   195	          inFlight.push(job.inFlightPromise)
   196	        }
   197	      }
   198	      jobsByWorkspaceId.clear()
   199	      if (inFlight.length > 0) {
   200	        await Promise.allSettled(inFlight)
   201	      }
   202	    },
   203	  }
   204	}
