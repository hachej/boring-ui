   164	  private closed = false;
   165	
   166	  constructor(private readonly options: RunscSessionRuntimeOptionsV1) {
   167	    this.workspace = new RunscWorkspaceHelperClientV1(options.runner);
   168	    this.retirement = new RunscSessionRetirementManagerV1({
   169	      runner: options.runner,
   170	      detach: (record) => this.detach(record),
   171	      onRetire: options.onRetire,
   172	    });
   173	    this.now = options.now ?? Date.now;
   174	    this.runtimeIdFactory = options.runtimeIdFactory ?? runtimeId;
   175	    this.maxConcurrentCreates = boundedPositiveInteger(
   176	      options.maxConcurrentCreates ?? 4,
   177	      1_000,
   178	      "create concurrency",
   179	    );
   180	    this.maxConcurrentExecs = boundedPositiveInteger(
   181	      options.maxConcurrentExecs ?? 16,
   182	      10_000,
   183	      "exec concurrency",
   184	    );
   185	  }
   186	
   187	  async startupSweep(): Promise<void> {
   188	    if (this.closed) this.unavailable();
   189	    const listed = await runDockerChecked(this.options.runner, {
   190	      argv: buildDockerOwnedContainerListArgv(),
   191	      timeoutMs: RUNSC_RUNTIME_LIMITS_V1.disposeTimeoutMs,
   192	      maxOutputBytes: 128 * 1024,
   193	    });
   194	    const containerIds = new TextDecoder()
   195	      .decode(listed.stdout)
   196	      .trim()
   197	      .split(/\s+/)
   198	      .filter(Boolean);
   199	    if (
   200	      containerIds.length > RUNSC_RUNTIME_LIMITS_V1.maxStartupSweepContainers
   201	    ) {
   202	      throw runscRuntimeError(
   203	        REMOTE_WORKER_ERROR_CODES_V1.incompleteCleanup,
   204	        "remote-worker startup cleanup exceeds its bound",
   205	      );
   206	    }
   207	    for (const containerId of containerIds) {
   208	      await runDockerChecked(this.options.runner, {
   209	        argv: buildDockerRemoveOwnedIdArgv(containerId),
   210	        timeoutMs: RUNSC_RUNTIME_LIMITS_V1.disposeTimeoutMs,
   211	        maxOutputBytes: 64 * 1024,
   212	      });
   213	    }
   214	  }
   215	
   216	  create(input: CreateRunscSessionInputV1): Promise<RunscSessionLeaseV1> {
   217	    if (this.closed) this.unavailable();
   218	    safeOpaqueId(input.sandboxId, "sandbox id");
   219	    safeOpaqueId(input.clientLeaseId, "client lease id");
   220	    const digest = remoteWorkerRequestDigestV1({
   221	      sandboxId: input.sandboxId,
   222	      clientLeaseId: input.clientLeaseId,
   223	      workspaceId: input.workspaceId,
   224	      workspaceMountSource: input.workspaceMountSource,
   225	      image: input.image,
   226	      idleTtlMs: input.idleTtlMs,
   227	      hardLifetimeMs: input.hardLifetimeMs,
   228	    });
   229	    const existing = this.leaseBindings.get(input.clientLeaseId);
   230	    if (existing) {
   231	      if (existing.createDigest !== digest) this.idempotencyConflict();
   232	      if (existing.retirement) this.incompleteCleanup();
   233	      return Promise.resolve(this.lease(existing));
   234	    }
   235	    const pending = this.pendingCreates.get(input.clientLeaseId);
   236	    if (pending) {
   237	      if (pending.digest !== digest) this.idempotencyConflict();
   238	      return pending.promise;
   239	    }
   240	    if (
   241	      this.workspaceBindings.has(input.workspaceId) ||
   242	      this.pendingWorkspaceCreates.has(input.workspaceId)
   243	    ) {
   244	      this.idempotencyConflict();
   245	    }
   246	    if (this.activeCreates >= this.maxConcurrentCreates) {
   247	      throw runscRuntimeError(
   248	        REMOTE_WORKER_ERROR_CODES_V1.createConcurrencyExhausted,
   249	        "remote-worker create concurrency is exhausted",
   250	      );
   251	    }
   252	    this.activeCreates += 1;
   253	    this.pendingWorkspaceCreates.add(input.workspaceId);
   254	    const operation = this.track(this.createNew(input, digest));
   255	    this.pendingCreates.set(input.clientLeaseId, {
   256	      digest,
   257	      promise: operation,
   258	    });
   259	    const finishCreate = (): void => {
   260	      this.activeCreates -= 1;
   261	      this.pendingCreates.delete(input.clientLeaseId);
   262	      this.pendingWorkspaceCreates.delete(input.workspaceId);
   263	    };
   264	    void operation.then(finishCreate, finishCreate);
   265	    return operation;
   266	  }
   267	
   268	  private async createNew(
   269	    input: CreateRunscSessionInputV1,
   270	    digest: `sha256:${string}`,
   271	  ): Promise<RunscSessionLeaseV1> {
   272	    if (this.sessions.has(input.sandboxId)) this.idempotencyConflict();
   273	    const idleTtlMs = boundedPositiveInteger(
   274	      input.idleTtlMs ?? RUNSC_RUNTIME_LIMITS_V1.idleTtlMs,
   275	      RUNSC_RUNTIME_LIMITS_V1.idleTtlMs,
   276	      "idle TTL",
   277	    );
   278	    const hardLifetimeMs = boundedPositiveInteger(
   279	      input.hardLifetimeMs ?? RUNSC_RUNTIME_LIMITS_V1.hardLifetimeMs,
   280	      RUNSC_RUNTIME_LIMITS_V1.hardLifetimeMs,
   281	      "hard lifetime",
   282	    );
   283	    await this.options.quota.apply(input.workspaceId);
   284	    await this.options.quota.check(input.workspaceId);
   285	    const createdAtMs = this.now();
   286	    const record: SessionRecordV1 = {
   287	      sandboxId: input.sandboxId,
   288	      clientLeaseId: input.clientLeaseId,
   289	      createDigest: digest,
   290	      workspaceId: input.workspaceId,
   291	      workspaceMountSource: input.workspaceMountSource,
   292	      image: input.image,
   293	      createdAtMs,
   294	      hardExpiresAtMs: createdAtMs + hardLifetimeMs,
   295	      idleTtlMs,
   296	      runtimeId: this.nextRuntimeId(),
   297	      leaseExpiresAtMs: Math.min(
   298	        createdAtMs + idleTtlMs,
   299	        createdAtMs + hardLifetimeMs,
   300	      ),
   301	      timer: setTimeout(() => undefined, 1),
   302	      activeExec: false,
   303	      activeFs: false,
   304	      invocations: new Map(),
   305	    };
   306	    clearTimeout(record.timer);
   307	    try {
   308	      await this.startContainer(record);
   309	    } catch (error) {
   310	      await this.retireFailedCreate(record);
   311	      throw error;
   312	    }
   313	    if (this.closed) {
   314	      await this.retireFailedCreate(record);
   315	      this.unavailable();
   316	    }
   317	    this.bind(record);
   318	    this.armTimer(record);
   319	    return this.lease(record);
   320	  }
   321	
   322	  async exec(
   323	    sandboxId: string,
   324	    workspaceId: string,
   325	    requestInput: RemoteWorkerExecRequestV1,
   326	    signal?: AbortSignal,
   327	    credentialScope?: AuthorizedWorkspaceCredentialScopeV1,
   328	  ): Promise<RemoteWorkerExecResponseV1> {
   329	    const record = await this.activeSession(sandboxId);
   330	    if (record.workspaceId !== workspaceId) {
   331	      throw runscRuntimeError(
   332	        REMOTE_WORKER_ERROR_CODES_V1.sandboxWorkspaceMismatch,
   333	        "remote-worker sandbox binding does not match the authorized workspace",
   334	      );
   335	    }
   336	    const parsedRequest =
   337	      RemoteWorkerExecRequestSchemaV1.safeParse(requestInput);
   338	    if (!parsedRequest.success) {
   339	      throw runscRuntimeError(
   340	        REMOTE_WORKER_ERROR_CODES_V1.requestInvalid,
   341	        "remote-worker invocation failed strict validation",
   342	      );
   343	    }
   344	    const request = parsedRequest.data;
   345	    const digest = remoteWorkerRequestDigestV1(request);
   346	    const prior = record.invocations.get(request.invocationId);
   347	    if (prior) {
   348	      if (prior.digest !== digest) this.idempotencyConflict();
   349	      if (prior.state === "running") {
   350	        throw runscRuntimeError(
   351	          REMOTE_WORKER_ERROR_CODES_V1.execInProgress,
   352	          "remote-worker invocation is already running",
   353	        );
   354	      }
   355	      if (prior.state === "secret-terminal") {
   356	        throw runscRuntimeError(
   357	          REMOTE_WORKER_ERROR_CODES_V1.secretInvocationNotReplayable,
   358	          "remote-worker secret-bearing invocation is not replayable",
   359	        );
   360	      }
   361	      return prior.result as RemoteWorkerExecResponseV1;
   362	    }
   363	    if (
   364	      record.activeExec ||
   365	      record.activeFs ||
   366	      this.activeExecs >= this.maxConcurrentExecs
   367	    ) {
   368	      throw runscRuntimeError(
   369	        REMOTE_WORKER_ERROR_CODES_V1.execConcurrencyExhausted,
   370	        "remote-worker exec concurrency is exhausted",
   371	      );
   372	    }
   373	    await this.requireInvocationCapacity(record);
   374	    const invocation: InvocationRecordV1 = { digest, state: "running" };
   375	    record.invocations.set(request.invocationId, invocation);
   376	    record.activeExec = true;
   377	    this.activeExecs += 1;
   378	    this.touch(record);
   379	
   380	    const operation = this.track(
   381	      this.executeInvocation(
   382	        record,
   383	        request.invocationId,
   384	        invocation,
   385	        request,
   386	        signal,
   387	        credentialScope,
   388	      ),
   389	    );
   390	    return await operation;
   391	  }
   392	
   393	  private async executeInvocation(
   394	    record: SessionRecordV1,
   395	    invocationId: string,
   396	    invocation: InvocationRecordV1,
   397	    request: RemoteWorkerExecRequestV1,
   398	    signal?: AbortSignal,
   399	    credentialScope?: AuthorizedWorkspaceCredentialScopeV1,
   400	  ): Promise<RemoteWorkerExecResponseV1> {
   401	    let secretExecutionStarted = false;
   402	    let envelope: ReturnType<typeof prepareInvocationEnvelopeV1> | undefined;
   403	    let credentialLeases: readonly SandboxCredentialSecretPayloadLeaseV1[] = [];
   404	    try {
   405	      const resolved =
   406	        request.credentialRefs && request.credentialRefs.length > 0
   407	          ? await this.resolveInvocationCredentials(
   408	              record,
   409	              request,
   410	              credentialScope,
   411	            )
   412	          : { fields: [], leases: [] };
   413	      credentialLeases = resolved.leases;
   414	      secretExecutionStarted = resolved.leases.length > 0;
   415	      envelope = prepareInvocationEnvelopeV1({
   416	        workspaceId: record.workspaceId,
   417	        request,
   418	        resolvedCredentialFields: resolved.fields,
   419	      });
   420	      if (envelope.secretBearing) await this.replaceContainer(record, true);
   421	      const result = await this.runInvocation(record, envelope, signal);
   422	      if (envelope.secretBearing) {
   423	        await this.replaceContainer(record, false);
   424	        invocation.state = "secret-terminal";
   425	      } else {
   426	        invocation.state = "complete";
   427	        invocation.result = result;
   428	      }
   429	      return result;
   430	    } catch (error) {
   431	      await this.recoverInvocationFailure(
   432	        record,
   433	        invocationId,
   434	        invocation,
   435	        secretExecutionStarted,
   436	        signal?.aborted === true,
   437	      );
   438	      if (signal?.aborted) {
   439	        throw runscRuntimeError(
   440	          REMOTE_WORKER_ERROR_CODES_V1.execAborted,
   441	          "remote-worker invocation was aborted",
   442	        );
   443	      }
   444	      throw error;
   445	    } finally {
   446	      envelope?.bytes.fill(0);
   447	      for (const lease of credentialLeases) {
   448	        try {
   449	          lease.dispose();
   450	        } catch {
   451	          // Lease disposal is best effort and must never expose credential data.
   452	        }
   453	      }
   454	      record.activeExec = false;
   455	      this.activeExecs -= 1;
   456	      if (this.sessions.get(record.sandboxId) === record) this.touch(record);
   457	    }
   458	  }
   459	
   460	  private async resolveInvocationCredentials(
   461	    record: SessionRecordV1,
   462	    request: RemoteWorkerExecRequestV1,
   463	    credentialScope?: AuthorizedWorkspaceCredentialScopeV1,
   464	  ): Promise<ResolvedRunscInvocationCredentialsV1> {
   465	    const references = request.credentialRefs ?? [];
   466	    if (references.length === 0) return { fields: [], leases: [] };
   467	    const resolver = this.options.invocationCredentials;
   468	    if (!credentialScope || !resolver) {
   469	      throw runscRuntimeError(
   470	        REMOTE_WORKER_ERROR_CODES_V1.secretReferenceRejected,
   471	        "remote-worker credential delivery is unavailable",
   472	      );
   473	    }
   474	    return await resolver.resolve({
   475	      workspaceId: record.workspaceId,
   476	      sandboxId: record.sandboxId,
   477	      invocationId: request.invocationId,
   478	      references,
   479	      credentialScope,
   480	      nowMs: this.now(),
   481	    });
   482	  }
   483	
   484	  private async recoverInvocationFailure(
   485	    record: SessionRecordV1,
   486	    invocationId: string,
   487	    invocation: InvocationRecordV1,
   488	    secretExecutionStarted: boolean,
   489	    aborted: boolean,
   490	  ): Promise<void> {
   491	    if (secretExecutionStarted) {
   492	      invocation.state = "secret-terminal";
   493	      if (this.sessions.get(record.sandboxId) === record) {
   494	        const cleaned = await this.replaceAfterUnprovenExecution(record);
   495	        if (!cleaned) {
   496	          try {
   497	            await this.retire(record, "cleanup");
   498	          } catch {
   499	            // retire() retains ownership and schedules a bounded retry.
   500	          }
   501	          this.incompleteCleanup();
   502	        }
   503	      }
   504	      return;
   505	    }
   506	    if (invocation.state === "running") {
   507	      record.invocations.delete(invocationId);
   508	    }
   509	    if (aborted) {
   510	      const cleaned = await this.replaceAfterUnprovenExecution(record);
   511	      if (!cleaned) this.incompleteCleanup();
   512	    }
   513	  }
   514	
   515	  async fs(
   516	    sandboxId: string,
   517	    operation: RemoteWorkerWorkspaceOperationV1,
   518	  ): Promise<RemoteWorkerWorkspaceResultV1> {
   519	    const record = await this.activeSession(sandboxId);
   520	    if (record.activeExec || record.activeFs) {
   521	      throw runscRuntimeError(
   522	        REMOTE_WORKER_ERROR_CODES_V1.execInProgress,
   523	        "remote-worker session operation is already running",
   524	      );
   525	    }
   526	    record.activeFs = true;
   527	    try {
   528	      const result = await this.workspace.execute(record.runtimeId, operation);
   529	      this.touch(record);
   530	      return result;
   531	    } finally {
   532	      record.activeFs = false;
   533	    }
   534	  }
   535	
   536	  async renew(
   537	    sandboxId: string,
   538	    idleTtlMs: number,
   539	  ): Promise<RunscSessionLeaseV1> {
   540	    const record = await this.activeSession(sandboxId);
   541	    const bounded = boundedPositiveInteger(
   542	      idleTtlMs,
   543	      RUNSC_RUNTIME_LIMITS_V1.idleTtlMs,
   544	      "idle TTL",
   545	    );
   546	    record.leaseExpiresAtMs = Math.min(
   547	      this.now() + bounded,
   548	      record.hardExpiresAtMs,
   549	    );
   550	    this.armTimer(record);
   551	    return this.lease(record);
   552	  }
   553	
   554	  async dispose(sandboxId: string): Promise<void> {
   555	    const record = this.sessions.get(sandboxId);
   556	    if (!record) return;
   557	    await this.retire(record, "cleanup", false);
   558	  }
   559	
   560	  async shutdown(): Promise<void> {
   561	    if (this.closed) return;
   562	    this.closed = true;
   563	    for (const record of this.sessions.values()) clearTimeout(record.timer);
   564	    const drain = Promise.allSettled([...this.pendingOperations]);
   565	    await Promise.race([
   566	      drain,
   567	      new Promise<void>((resolve) =>
   568	        setTimeout(resolve, RUNSC_RUNTIME_LIMITS_V1.shutdownDrainMs),
   569	      ),
   570	    ]);
   571	    const records = [...this.sessions.values()];
   572	    const retirements = await Promise.allSettled(
   573	      records.map(async (record) => await this.retire(record, "shutdown")),
   574	    );
   575	    const failure = retirements.find(
   576	      (result): result is PromiseRejectedResult => result.status === "rejected",
   577	    );
   578	    if (failure) {
   579	      throw failure.reason;
   580	    }
   581	  }
   582	
   583	  private async runInvocation(
   584	    record: SessionRecordV1,
   585	    envelope: ReturnType<typeof prepareInvocationEnvelopeV1>,
   586	    signal?: AbortSignal,
   587	  ): Promise<RemoteWorkerExecResponseV1> {
   588	    let dockerResult: DockerCommandResult;
   589	    try {
   590	      dockerResult = await this.options.runner.run({
   591	        argv: buildDockerExecArgv(record.runtimeId, "invoke"),
   592	        stdin: envelope.bytes,
   593	        timeoutMs:
   594	          envelope.timeoutMs +
   595	          RUNSC_RUNTIME_LIMITS_V1.processGroupGraceMs +
   596	          30_000,
   597	        maxOutputBytes:
   598	          Math.ceil((envelope.maxOutputBytes * 4) / 3) + 128 * 1024,
   599	        signal,
   600	      });
   601	    } catch (error) {
   602	      await this.resetOrRetireAfterUnknown(record);
   603	      throw runscRuntimeError(
   604	        REMOTE_WORKER_ERROR_CODES_V1.incompleteCleanup,
   605	        "remote-worker invocation cleanup could not be proven",
   606	        error,
   607	      );
   608	    }
   609	    if (
   610	      dockerResult.timedOut ||
   611	      dockerResult.aborted ||
   612	      dockerResult.exitCode !== 0 ||
   613	      dockerResult.truncated
   614	    ) {
   615	      await this.resetOrRetireAfterUnknown(record);
   616	      throw runscRuntimeError(
   617	        REMOTE_WORKER_ERROR_CODES_V1.incompleteCleanup,
   618	        "remote-worker invocation cleanup could not be proven",
   619	      );
   620	    }
   621	    const parsed = decodeBoundedJson(dockerResult.stdout, 8 * 1024 * 1024);
   622	    if (!isHelperResponse(parsed) || !parsed.cleanupProven) {
   623	      await this.resetOrRetireAfterUnknown(record);
   624	      this.incompleteCleanup();
   625	    }
   626	    let response: RemoteWorkerExecResponseV1;
   627	    try {
   628	      response = RemoteWorkerExecResponseSchemaV1.parse({
   629	        stdoutBase64: parsed.stdoutBase64,
   630	        stderrBase64: parsed.stderrBase64,
   631	        exitCode: parsed.exitCode,
   632	        durationMs: parsed.durationMs,
   633	        truncated: parsed.truncated,
   634	      });
   635	      const outputBytes =
   636	        Buffer.from(response.stdoutBase64, "base64").byteLength +
   637	        Buffer.from(response.stderrBase64, "base64").byteLength;
   638	      if (outputBytes > envelope.maxOutputBytes)
   639	        throw new Error("output bound");
   640	    } catch (error) {
   641	      throw runscRuntimeError(
   642	        REMOTE_WORKER_ERROR_CODES_V1.responseInvalid,
   643	        "remote-worker invocation wrapper returned an invalid result",
   644	        error,
   645	      );
   646	    }
   647	    if (parsed.timedOut) {
   648	      throw runscRuntimeError(
   649	        REMOTE_WORKER_ERROR_CODES_V1.timeout,
   650	        "remote-worker invocation timed out",
   651	      );
   652	    }
   653	    return response;
   654	  }
   655	
   656	  private async startContainer(
   657	    record: SessionRecordV1,
   658	    workspaceReadOnly = false,
   659	  ): Promise<void> {
   660	    await runDockerChecked(this.options.runner, {
   661	      argv: buildDockerRunArgv({
   662	        runtimeId: record.runtimeId,
   663	        workspaceMountSource: record.workspaceMountSource,
   664	        workspaceReadOnly,
   665	        image: record.image,
   666	      }),
   667	      timeoutMs: RUNSC_RUNTIME_LIMITS_V1.createTimeoutMs,
   668	      maxOutputBytes: 64 * 1024,
   669	    });
   670	    await this.workspace.probe(record.runtimeId);
   671	  }
   672	
   673	  private async replaceContainer(
   674	    record: SessionRecordV1,
   675	    workspaceReadOnly = false,
   676	  ): Promise<void> {
   677	    await runDockerChecked(this.options.runner, {
   678	      argv: buildDockerRemoveArgv(record.runtimeId),
   679	      timeoutMs: RUNSC_RUNTIME_LIMITS_V1.disposeTimeoutMs,
   680	      maxOutputBytes: 64 * 1024,
   681	    });
   682	    record.runtimeId = this.nextRuntimeId();
   683	    try {
   684	      await this.startContainer(record, workspaceReadOnly);
   685	    } catch (error) {
   686	      await this.retire(record, "cleanup");
   687	      throw runscRuntimeError(
   688	        REMOTE_WORKER_ERROR_CODES_V1.incompleteCleanup,
   689	        "remote-worker clean container replacement failed",
   690	        error,
   691	      );
   692	    }
   693	  }
   694	
   695	  private async replaceAfterUnprovenExecution(
   696	    record: SessionRecordV1,
   697	  ): Promise<boolean> {
   698	    try {
   699	      await this.replaceContainer(record);
   700	      return true;
   701	    } catch {
   702	      return false;
   703	    }
   704	  }
   705	
   706	  private async resetOrRetireAfterUnknown(
   707	    record: SessionRecordV1,
   708	  ): Promise<void> {
   709	    if (!(await this.replaceAfterUnprovenExecution(record))) {
   710	      await this.retire(record, "cleanup");
   711	    }
   712	  }
   713	
   714	  private async activeSession(sandboxId: string): Promise<SessionRecordV1> {
   715	    if (this.closed) this.unavailable();
   716	    const record = this.sessions.get(sandboxId);
   717	    if (!record) {
   718	      await this.notifyMissing(sandboxId);
   719	      throw runscRuntimeError(
   720	        REMOTE_WORKER_ERROR_CODES_V1.sandboxNotFound,
   721	        "remote-worker sandbox was not found",
   722	      );
   723	    }
   724	    if (record.retirement) {
   725	      throw runscRuntimeError(
   726	        REMOTE_WORKER_ERROR_CODES_V1.sandboxDisposed,
   727	        "remote-worker sandbox retirement is in progress",
   728	      );
   729	    }
   730	    const nowMs = this.now();
   731	    if (record.hardExpiresAtMs <= nowMs || record.leaseExpiresAtMs <= nowMs) {
   732	      const hard = record.hardExpiresAtMs <= nowMs;
   733	      await this.retire(record, hard ? "hard-expiry" : "idle");
   734	      throw runscRuntimeError(
   735	        REMOTE_WORKER_ERROR_CODES_V1.sandboxExpired,
   736	        "remote-worker sandbox expired",
   737	      );
   738	    }
   739	    return record;
   740	  }
   741	
   742	  private armTimer(record: SessionRecordV1): void {
   743	    clearTimeout(record.timer);
   744	    if (record.retirement) return;
   745	    const deadline = Math.min(record.leaseExpiresAtMs, record.hardExpiresAtMs);
   746	    record.timer = setTimeout(
   747	      () => {
   748	        const reason: RunscSessionRetirementReasonV1 =
   749	          record.hardExpiresAtMs <= this.now() ? "hard-expiry" : "idle";
   750	        void this.retire(record, reason).catch(() => undefined);
   751	      },
