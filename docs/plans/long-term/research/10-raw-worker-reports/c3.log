    68	      await options.prepare?.(context)
    69	      const pair = await options.provider.create(context)
    70	      try {
    71	        const runtimeBundle: ProviderRuntimeBundle = {
    72	          [runtimePair]: pair,
    73	          runtimeContext: pair.workspace.runtimeContext,
    74	          storageRoot: options.storageRoot?.(context),
    75	          workspace: pair.workspace,
