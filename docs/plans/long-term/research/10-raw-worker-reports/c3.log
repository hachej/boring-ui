    75	
    76	    let tmpWritten = false
    77	    let renamed = false
    78	
    79	    try {
    80	      await writeFile(tmpPath, content, { encoding: 'utf8', mode: 0o600 })
    81	      tmpWritten = true
    82	      await chmod(tmpPath, 0o600)
    83	
    84	      await rename(tmpPath, this.storePath)
    85	      renamed = true
    86	      await chmod(this.storePath, 0o600)
    87	    } finally {
    88	      if (tmpWritten && !renamed) {
    89	        try {
    90	          await unlink(tmpPath)
    91	        } catch {
    92	          // tmp may already be gone.
    93	        }
    94	      }
    95	    }
