    97	  properties?: Record<string, unknown>,
    98	): void {
    99	  if (!telemetry) return
   100	  safeCapture(telemetry, {
   101	    name,
   102	    properties: sandboxTelemetryProperties(ctx, properties),
   103	  })
   104	}
   105	
   106	async function runSandboxSetupStep<T>(options: {
   107	  telemetry?: TelemetrySink
   108	  ctx?: SandboxProviderCreateContextV1
   109	  phase: string
   110	  run: () => Promise<T>
   111	}): Promise<T> {
   112	  const startedAt = Date.now()
   113	  try {
   114	    const result = await options.run()
   115	    captureSandboxSetupEvent(options.telemetry, options.ctx, 'agent.runtime.sandbox.setup.step', {
   116	      phase: options.phase,
   117	      status: 'ok' satisfies SandboxSetupStatus,
   118	      durationMs: Date.now() - startedAt,
   119	    })
   120	    return result
   121	  } catch (error) {
   122	    const code = (error as { code?: unknown } | null)?.code
   123	    captureSandboxSetupEvent(options.telemetry, options.ctx, 'agent.runtime.sandbox.setup.step', {
   124	      phase: options.phase,
   125	      status: 'error' satisfies SandboxSetupStatus,
   126	      durationMs: Date.now() - startedAt,
   127	      ...(typeof code === 'string' ? { errorCode: code } : {}),
   128	    })
   129	    throw error
   130	  }
   131	}
   132	
   133	function createDefaultVercelClient(
   134	  auth: VercelAuthConfig,
   135	  opts: { timeoutMs?: number; runtime?: string } = {},
   136	): VercelSandboxClient {
   137	  const credentials = {
   138	    token: auth.token,
   139	    teamId: auth.teamId,
   140	    ...(auth.projectId ? { projectId: auth.projectId } : {}),
   141	  }
   142	  const createOptions = opts.timeoutMs
   143	    ? { ...credentials, timeout: opts.timeoutMs }
   144	    : credentials
   145	
   146	  return {
   147	    async create(params) {
   148	      const base = {
   149	        ...createOptions,
   150	        ...(params?.name ? { name: params.name } : {}),
   151	        ...(opts.runtime ? { runtime: opts.runtime } : {}),
   152	        persistent: params?.persistent ?? true,
   153	        snapshotExpiration: params?.snapshotExpiration ?? 0,
   154	      }
   155	      if (params?.source?.type === 'snapshot') {
   156	        const { runtime: _runtime, ...snapshotBase } = base
   157	        return await VercelSandbox.create({
   158	          ...snapshotBase,
   159	          source: { type: 'snapshot', snapshotId: params.source.snapshotId },
   160	        })
   161	      }
   162	      if (params?.source?.type === 'tarball') {
   163	        return await VercelSandbox.create({
   164	          ...base,
   165	          source: { type: 'tarball', url: params.source.url },
   166	        })
   167	      }
   168	      return await VercelSandbox.create(base)
   169	    },
   170	    async get(params) {
   171	      const getParams = {
   172	        ...credentials,
   173	        name: params.name ?? params.sandboxId ?? '',
   174	        resume: params.resume ?? true,
   175	      } as unknown as Parameters<typeof VercelSandbox.get>[0] & { name?: string }
   176	      return await VercelSandbox.get(getParams)
   177	    },
   178	  }
   179	}
   180	
   181	type VercelSandboxWithRunCommand = VercelSandbox & {
   182	  fs?: { mkdir(path: string, opts?: { recursive?: boolean }): Promise<unknown> }
   183	  mkDir?: (path: string) => Promise<void>
   184	  runCommand?: (params: { cmd: string; args?: string[] }) => Promise<{ exitCode?: number }>
   185	}
   186	
   187	/**
   188	 * Build the shell snippet that ensures the workspace root exists in the sandbox.
   189	 *
   190	 * When `remoteRoot` and `workspaceRoot` are the same path (the default), linking
   191	 * one to the other would create a self-referential symlink (or a nested
   192	 * `workspace/workspace`), so the symlink is only created when they differ. Any
   193	 * stale symlink left at the workspace root by an earlier buggy run is cleared
   194	 * first so the root is always a real directory.
   195	 */
   196	export function buildWorkspaceRootSetupScript(remoteRoot: string, workspaceRoot: string): string {
   197	  return [
   198	    `if [ -L ${workspaceRoot} ]; then rm -f ${workspaceRoot}; fi`,
   199	    `mkdir -p ${remoteRoot}`,
   200	    `if [ ${remoteRoot} != ${workspaceRoot} ]; then ln -sfn ${remoteRoot} ${workspaceRoot} 2>/dev/null || true; fi`,
   201	  ].join('; ')
   202	}
   203	
   204	async function ensureVercelWorkspaceRoot(sandbox: VercelSandboxWithRunCommand): Promise<void> {
   205	  let rootCreated = false
   206	  if (sandbox.fs?.mkdir) {
   207	    await sandbox.fs.mkdir(VERCEL_SANDBOX_REMOTE_ROOT, { recursive: true })
   208	    rootCreated = true
   209	  } else if (sandbox.mkDir) {
   210	    try {
   211	      await sandbox.mkDir(VERCEL_SANDBOX_REMOTE_ROOT)
   212	      rootCreated = true
   213	    } catch {
   214	      // Fall through to mkdir -p for already-existing parents or SDK variants.
   215	    }
   216	  }
   217	  if (!sandbox.runCommand) {
   218	    if (rootCreated) return
   219	    throw new Error(`failed to initialize ${VERCEL_SANDBOX_REMOTE_ROOT}: sandbox runCommand is unavailable`)
   220	  }
   221	  const result = await sandbox.runCommand({
   222	    cmd: 'sh',
   223	    args: ['-c', buildWorkspaceRootSetupScript(VERCEL_SANDBOX_REMOTE_ROOT, VERCEL_SANDBOX_WORKSPACE_ROOT)],
   224	  })
   225	  if ((result.exitCode ?? 1) !== 0) {
   226	    throw new Error(`failed to initialize ${VERCEL_SANDBOX_REMOTE_ROOT} (exit ${result.exitCode ?? 'unknown'})`)
   227	  }
   228	}
   229	
   230	/**
   231	 * Install/verify the low-level runtime primitives provisioning needs (Layer A).
   232	 * Vercel `node*` runtimes ship node/npm/pnpm + python3 but NO pip/uv, so this
   233	 * installs Astral uv via its standalone installer (no pip/dnf — ~1.3s). It is
   234	 * idempotent (skips when uv is already present) and runs on the SAME sandbox
   235	 * provisioning will use, so `provisionWorkspaceRuntime()` finds uv at the
   236	 * explicit `VERCEL_UV_BIN`. Without this, a fresh (no-snapshot) workspace cannot
   237	 * provision the Python runtime at all.
   238	 */
   239	async function ensureVercelRuntimePrimitives(
   240	  sandbox: VercelSandboxWithRunCommand,
   241	  runtime: string | undefined,
   242	): Promise<void> {
   243	  if (!sandbox.runCommand) return
   244	  const script = uvSetupCommandsForRuntime(runtime).join(' && ')
   245	  const result = await sandbox.runCommand({ cmd: 'sh', args: ['-c', script] })
   246	  if ((result.exitCode ?? 1) !== 0) {
   247	    throw new Error(`runtime bootstrap (uv) failed (exit ${result.exitCode ?? 'unknown'})`)
   248	  }
   249	  // Provisioning invokes uv by explicit path (correctness must not depend on the
   250	  // non-interactive exec PATH). Default BORING_AGENT_UV_BIN to the `.boring-agent`
   251	  // uv installed by the Node bootstrap; an explicit deploy-config value still wins. Routed
   252	  // through config/env so we never touch process.env directly (invariant).
   253	  if (isNodeFamilyRuntime(runtime)) {
   254	    setEnvDefault('BORING_AGENT_UV_BIN', VERCEL_UV_BIN)
   255	  }
   256	}
   257	
   258	async function seedTemplateIntoVercelWorkspace(
   259	  workspace: {
   260	    stat(path: string): Promise<unknown>
   261	    writeFile(path: string, data: string): Promise<void>
   262	    writeBinaryFile?: (path: string, data: Uint8Array) => Promise<void>
   263	  },
   264	  templatePath: string,
   265	  logger: ModeLogger,
   266	): Promise<void> {
   267	  const files = await collectFiles(templatePath)
   268	  const hash = computeTemplateHash(files)
   269	  const markerPath = `.boring-agent/templates/${hash}.json`
   270	
   271	  try {
   272	    await workspace.stat(markerPath)
   273	    logger.info('[vercel-sandbox:mode] template already seeded', {
   274	      hash,
   275	      fileCount: files.length,
   276	    })
   277	    return
   278	  } catch {
   279	    // Missing marker means this sandbox predates the template or was created
   280	    // from an empty handle. Seed below without deleting user files.
   281	  }
   282	
   283	  for (const file of files) {
   284	    if (workspace.writeBinaryFile) {
   285	      await workspace.writeBinaryFile(file.rel, new Uint8Array(file.content))
   286	    } else {
   287	      await workspace.writeFile(file.rel, file.content.toString('utf-8'))
   288	    }
   289	  }
   290	  await workspace.writeFile(markerPath, JSON.stringify({ hash, seededAt: new Date().toISOString() }, null, 2))
   291	  logger.info('[vercel-sandbox:mode] template seeded into workspace', {
   292	    hash,
   293	    fileCount: files.length,
   294	  })
   295	}
   296	
   297	function provisioningSourceToPath(source: string | URL): string {
   298	  return source instanceof URL ? fileURLToPath(source) : source
   299	}
   300	
   301	function shellSingleQuote(value: string): string {
   302	  return `'${value.replace(/'/g, `'\\''`)}'`
   303	}
   304	
   305	async function copyHostPathToVercelWorkspace(options: {
   306	  workspace: ReturnType<typeof createVercelSandboxWorkspace>
   307	  source: string | URL
   308	  targetRel: string
   309	}): Promise<void> {
   310	  const sourcePath = provisioningSourceToPath(options.source)
   311	  const sourceStat = await stat(sourcePath)
   312	  if (sourceStat.isDirectory()) {
   313	    await options.workspace.mkdir(options.targetRel, { recursive: true })
   314	    for (const entry of await readdir(sourcePath, { withFileTypes: true })) {
   315	      await copyHostPathToVercelWorkspace({
   316	        workspace: options.workspace,
   317	        source: join(sourcePath, entry.name),
   318	        targetRel: `${options.targetRel}/${entry.name}`,
   319	      })
   320	    }
   321	    return
   322	  }
   323	  if (!sourceStat.isFile()) return
   324	
   325	  const bytes = new Uint8Array(await readFile(sourcePath))
   326	  if (options.workspace.writeBinaryFile) await options.workspace.writeBinaryFile(options.targetRel, bytes)
   327	  else await options.workspace.writeFile(options.targetRel, Buffer.from(bytes).toString('utf8'))
   328	}
   329	
   330	function isMissingWorkspacePathError(error: unknown): boolean {
   331	  if ((error as { code?: string }).code === 'ENOENT') return true
   332	  const message = error instanceof Error ? error.message : String(error)
   333	  return /\bENOENT\b|no such file|file not found/i.test(message)
   334	}
   335	
   336	function createVercelWorkspaceFs(options: {
   337	  workspace: ReturnType<typeof createVercelSandboxWorkspace>
   338	  sandbox: VercelSandboxWithRunCommand
   339	}): SandboxProvisioningOperationsV1['workspaceFs'] {
   340	  const exists = async (rel: string): Promise<boolean> => {
   341	    try {
   342	      await options.workspace.stat(rel)
   343	      return true
   344	    } catch (error: unknown) {
   345	      if (isMissingWorkspacePathError(error)) return false
   346	      throw error
   347	    }
   348	  }
   349	
   350	  return {
   351	    exists,
   352	    async rm(rel) {
   353	      const targetExists = await exists(rel)
   354	      if (!targetExists) return
   355	      const target = `${VERCEL_SANDBOX_REMOTE_ROOT}/${rel.replace(/^\/+/, '')}`
   356	      const result = await options.sandbox.runCommand({
   357	        cmd: 'sh',
   358	        args: ['-c', `rm -rf -- ${shellSingleQuote(target)}`],
   359	      })
   360	      if ((result.exitCode ?? 1) !== 0) {
   361	        const err = await (result.stderr?.() ?? Promise.resolve(''))
   362	        throw new Error(err || `failed to remove ${rel}`)
   363	      }
   364	    },
   365	    async mkdir(rel) {
   366	      await options.workspace.mkdir(rel, { recursive: true })
   367	    },
   368	    async writeText(rel, content) {
   369	      await options.workspace.writeFile(rel, content)
   370	    },
   371	    async readText(rel) {
   372	      try {
   373	        return await options.workspace.readFile(rel)
   374	      } catch (error: unknown) {
   375	        if (isMissingWorkspacePathError(error)) return null
   376	        throw error
   377	      }
   378	    },
   379	    async copyFromHost(source, targetRel) {
   380	      await copyHostPathToVercelWorkspace({ workspace: options.workspace, source, targetRel })
   381	    },
   382	  }
   383	}
   384	
   385	async function ensureTemplateExecutables(sandbox: VercelSandboxWithRunCommand): Promise<void> {
   386	  if (!sandbox.runCommand) return
   387	  await sandbox.runCommand({
   388	    cmd: 'sh',
   389	    args: ['-c', `chmod +x ${VERCEL_SANDBOX_REMOTE_ROOT}/.boring-agent/bin/* 2>/dev/null || true`],
   390	  })
   391	}
   392	
   393	const DEFAULT_MODE_LOGGER: ModeLogger = {
   394	  info(message, metadata) {
   395	    process.stderr.write(`${message} ${JSON.stringify(metadata)}\n`)
   396	  },
   397	}
   398	
   399	function extractHttpStatus(error: unknown): number | null {
   400	  const statusCode = (error as { statusCode?: unknown } | null)?.statusCode
   401	  if (typeof statusCode === 'number') return statusCode
   402	
   403	  const status = (error as { status?: unknown } | null)?.status
   404	  if (typeof status === 'number') return status
   405	
   406	  const responseStatus = (error as { response?: { status?: unknown } } | null)?.response?.status
   407	  return typeof responseStatus === 'number' ? responseStatus : null
   408	}
   409	
   410	function isExpiredSandboxRuntimeError(error: unknown): boolean {
   411	  const code = (error as { code?: unknown } | null)?.code
   412	  if (code === 'SANDBOX_EXPIRED') return true
   413	
   414	  const status = extractHttpStatus(error)
   415	  if (status === 404 || status === 410) return true
   416	
   417	  const message = error instanceof Error ? error.message : String(error)
   418	  return /status code (404|410) is not ok/i.test(message)
   419	}
   420	
   421	const PRESERVED_VERCEL_ERROR_CODES: ReadonlySet<ErrorCode> = new Set([
   422	  'ABORTED',
   423	  'CIRCUIT_OPEN',
   424	  'CONFIG_INVALID',
   425	  'OIDC_REFRESH_FAILED',
   426	  'PROVISIONING_ARTIFACT_FAILED',
   427	  'PROVISIONING_UV_BOOTSTRAP_FAILED',
   428	  'RUNTIME_PROVISIONING_FAILED',
   429	  'SANDBOX_EXPIRED',
   430	  'SANDBOX_NOT_READY',
   431	  'VERCEL_API_ERROR',
   432	  'VERCEL_AUTH_FAILED',
   433	])
   434	
   435	function hasStableErrorCode(
   436	  error: unknown,
   437	): error is Error & { code: ErrorCode } {
   438	  if (!(error instanceof Error)) return false
   439	  const code = (error as Error & { code?: unknown }).code
   440	  return typeof code === 'string'
   441	    && PRESERVED_VERCEL_ERROR_CODES.has(code as ErrorCode)
   442	}
   443	
   444	function normalizeVercelProviderError(error: unknown): Error {
   445	  if (hasStableErrorCode(error)) return error
   446	  const message = error instanceof Error ? error.message : String(error)
   447	  return new SandboxProviderError('VERCEL_API_ERROR', message, { cause: error })
   448	}
   449	
   450	function requireEnvVar(name: string, getEnvVar: EnvGetter): string {
   451	  const value = getEnvVar(name)?.trim()
   452	  if (!value) {
   453	    throw new SandboxProviderError('VERCEL_AUTH_FAILED', `${name} is required for vercel-sandbox mode`)
   454	  }
   455	  return value
   456	}
   457	
   458	function readOptionalPositiveIntegerEnv(
   459	  name: string,
   460	  getEnvVar: EnvGetter,
   461	): number | undefined {
   462	  const raw = getEnvVar(name)?.trim()
   463	  if (!raw) return undefined
   464	  const parsed = Number(raw)
   465	  if (!Number.isSafeInteger(parsed) || parsed <= 0) {
   466	    throw new SandboxProviderError('CONFIG_INVALID', `${name} must be a positive integer`)
   467	  }
   468	  return parsed
   469	}
   470	
   471	function resolveVercelAuth(getEnvVar: EnvGetter): { token: string; source: 'VERCEL_OIDC_TOKEN' | 'VERCEL_ACCESS_TOKEN' | 'VERCEL_TOKEN' } {
   472	  const oidc = getEnvVar('VERCEL_OIDC_TOKEN')?.trim()
   473	  if (oidc) {
   474	    return { token: oidc, source: 'VERCEL_OIDC_TOKEN' }
   475	  }
   476	
   477	  const accessToken = getEnvVar('VERCEL_ACCESS_TOKEN')?.trim()
   478	  if (accessToken) {
   479	    return { token: accessToken, source: 'VERCEL_ACCESS_TOKEN' }
   480	  }
   481	
   482	  const apiToken = getEnvVar('VERCEL_TOKEN')?.trim()
   483	  if (apiToken) {
   484	    return { token: apiToken, source: 'VERCEL_TOKEN' }
   485	  }
   486	
   487	  throw new SandboxProviderError('VERCEL_AUTH_FAILED', 'VERCEL_OIDC_TOKEN or VERCEL_ACCESS_TOKEN or VERCEL_TOKEN is required for vercel-sandbox mode')
   488	}
   489	
   490	export function createVercelSandboxProvider(
   491	  opts: VercelSandboxProviderOptions = {},
   492	): SandboxProviderV1 {
   493	  const store = opts.store ?? new FileHandleStore()
   494	  const getEnvVar = opts.getEnvVar ?? getEnv
   495	  const logger = opts.logger ?? DEFAULT_MODE_LOGGER
   496	  // @vercel/sandbox@beta persistent sandboxes auto-snapshot when their
   497	  // session stops and auto-resume on the next command. Do not run the old
   498	  // periodic snapshotter here: sandbox.snapshot() stops the active session.
   499	  const snapshotScheduler = opts.snapshotScheduler ?? null
   500	
   501	  return {
   502	    contractVersion: PROVIDER_CONTRACT_VERSION,
   503	    providerId: 'vercel-sandbox',
   504	    capabilities: PROVIDER_CAPABILITIES['vercel-sandbox'],
   505	    resolveRuntimeRoot() {
   506	      return VERCEL_SANDBOX_WORKSPACE_ROOT
   507	    },
   508	    invalidate({ workspaceId }) {
   509	      evictSandboxHandleCacheForWorkspace(workspaceId)
   510	    },
   511	    async close() {
   512	      await snapshotScheduler?.shutdown()
   513	    },
   514	    async create(ctx): Promise<WorkspaceSandboxPairV1> {
   515	      const telemetry = ctx.telemetry
   516	      const totalStartedAt = Date.now()
   517	      captureSandboxSetupEvent(telemetry, ctx, 'agent.runtime.sandbox.setup.started', {
   518	        status: 'started',
   519	      })
   520	      const auth = resolveVercelAuth(getEnvVar)
   521	      const teamId = requireEnvVar('VERCEL_TEAM_ID', getEnvVar)
   522	      const projectId = getEnvVar('VERCEL_PROJECT_ID')?.trim()
   523	      const timeoutMs = readOptionalPositiveIntegerEnv(
   524	        VERCEL_SANDBOX_TIMEOUT_MS_ENV,
   525	        getEnvVar,
   526	      )
   527	      const runtime = getEnvVar(VERCEL_SANDBOX_RUNTIME_ENV)?.trim() || DEFAULT_VERCEL_SANDBOX_RUNTIME
   528	
   529	      const vercelClient = opts.vercelClient ?? createDefaultVercelClient({
   530	        token: auth.token,
   531	        teamId,
   532	        projectId,
   533	      }, { timeoutMs, runtime })
   534	
   535	      logger.info('[vercel-sandbox:mode] auth resolved', {
   536	        source: auth.source,
   537	        hasProjectId: Boolean(projectId),
   538	        timeoutMs: timeoutMs ?? null,
   539	        runtime,
   540	      })
   541	
   542	      const workspaceId = ctx.workspaceId ?? ctx.workspaceRoot
   543	      let tarballUrl: string | undefined
   544	      let workspace: ReturnType<typeof createVercelSandboxWorkspace> | undefined
   545	      let sandbox: ReturnType<typeof createVercelSandboxExec> | undefined
   546	
   547	      try {
   548	        if (ctx.templatePath) {
   549	          try {
   550	            const result = await runSandboxSetupStep({
   551	              telemetry,
   552	              ctx,
   553	              phase: 'template-package',
   554	              run: async () => await packageTemplate(ctx.templatePath!, opts.packageTemplateOpts),
   555	            })
   556	            tarballUrl = result.url
   557	            logger.info('[vercel-sandbox:mode] template packaged', {
   558	              hash: result.hash,
   559	              url: result.url,
   560	            })
   561	          } catch (error) {
   562	            logger.info('[vercel-sandbox:mode] template packaging failed, will use writeFiles fallback', {
   563	              error: error instanceof Error ? error.message : String(error),
   564	            })
   565	          }
   566	        }
   567	
   568	        const sandboxHandle = await runSandboxSetupStep({
   569	          telemetry,
   570	          ctx,
   571	          phase: 'resolve-handle',
   572	          run: async () => await resolveSandboxHandle(
   573	            workspaceId,
   574	            store,
   575	            vercelClient,
   576	            {
   577	              tarballUrl,
   578	              logger,
   579	              maxIdleMs: opts.orphanGuardMaxIdleMs === null
   580	                ? undefined
   581	                : opts.orphanGuardMaxIdleMs ?? ORPHAN_GUARD_MAX_IDLE_MS,
   582	              expiredSandboxPolicy: opts.expiredSandboxPolicy,
   583	            },
   584	          ),
   585	        })
   586	
   587	        const sandboxId = sandboxHandle.name ?? sandboxHandle.sandboxId ?? 'unknown-sandbox'
   588	        logger.info('[vercel-sandbox:mode] resolved sandbox handle', {
   589	          workspaceId,
   590	          sandboxId,
   591	          snapshotId: sandboxHandle.currentSnapshotId ?? sandboxHandle.sourceSnapshotId ?? null,
   592	          tarballUrl: tarballUrl ?? null,
   593	        })
   594	
   595	        if (snapshotScheduler && sandboxHandle.sandboxId) {
   596	          snapshotScheduler.trackWorkspace({
   597	            workspaceId,
   598	            sandbox: sandboxHandle as typeof sandboxHandle & { sandboxId: string; snapshot(opts?: { signal?: AbortSignal }): Promise<{ snapshotId: string }> },
   599	            store,
   600	          })
   601	        }
   602	        const markDirty = () => snapshotScheduler?.markDirty(workspaceId)
   603	
   604	        workspace = createVercelSandboxWorkspace(sandboxHandle, {
   605	          onMutation: markDirty,
   606	        })
   607	
   608	        // Fresh Vercel sandboxes do not guarantee our logical workspace root
   609	        // exists. Create it before any file-tree, mkdir, or rename operation so
   610	        // first user actions do not fail with ENOENT/404. This bootstrap is
   611	        // intentionally outside Workspace.mkdir so it does not mark the user's
   612	        // filesystem dirty or emit a fake mkdir event.
   613	        await runSandboxSetupStep({
   614	          telemetry,
   615	          ctx,
   616	          phase: 'ensure-workspace-root',
   617	          run: async () => { await ensureVercelWorkspaceRoot(sandboxHandle) },
   618	        })
   619	
   620	        if (ctx.templatePath) {
   621	          if (!tarballUrl) {
   622	            logger.info('[vercel-sandbox:mode] falling back to writeFiles for template', {
   623	              templatePath: ctx.templatePath,
   624	            })
   625	          }
   626	          await runSandboxSetupStep({
   627	            telemetry,
   628	            ctx,
   629	            phase: 'template-seed',
   630	            run: async () => {
   631	              await seedTemplateIntoVercelWorkspace(workspace!, ctx.templatePath!, logger)
   632	              await ensureTemplateExecutables(sandboxHandle)
   633	            },
   634	          })
   635	        }
   636	
   637	        sandbox = createVercelSandboxExec(sandboxHandle, {
   638	          onMutation: markDirty,
   639	        })
   640	        await runSandboxSetupStep({
   641	          telemetry,
