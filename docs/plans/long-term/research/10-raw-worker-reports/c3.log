    47	function resolveSnapshotKeepCount(getEnvVar: EnvGetter): number {
    48	  const raw = getEnvVar(SNAPSHOT_KEEP_ENV_VAR)?.trim()
    49	  if (!raw) {
    50	    return DEFAULT_SNAPSHOT_KEEP
    51	  }
    52	
