    15	export function autoDetectMode(): RuntimeModeId {
    16	  const explicitMode = getEnv('BORING_AGENT_MODE')
    17	  if (explicitMode) {
    18	    if (!isBuiltinRuntimeModeId(explicitMode)) {
    19	      throw new Error(
    20	        `Invalid BORING_AGENT_MODE "${explicitMode}". Expected direct, local, or vercel-sandbox.`,
    21	      )
    22	    }
    23	    return explicitMode
    24	  }
    25	
    26	  if (process.platform === 'linux' && hasBwrap()) {
    27	    return 'local'
    28	  }
    29	  return 'direct'
    30	}
