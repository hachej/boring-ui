    37	  if (isBuiltinRuntimeModeId(mode) && opts.adapters) return opts.adapters[mode]
    38	  if (isBuiltinRuntimeModeId(mode)) {
    39	    throw new Error(`Runtime mode "${mode}" requires a host-injected runtimeModeAdapter.`)
