   193	
   194	function meteredSlashCommandPromptError(command: string): Error {
   195	  return Object.assign(new Error('Slash command prompt execution is disabled while metering is configured.'), {
   196	    statusCode: 409,
   197	    code: ErrorCode.enum.METERING_UNSUPPORTED_COMMAND,
   198	    details: { command },
   199	  })
   200	}
   201	
   202	function meteredExtensionCommandContext(ctx: ExtensionCommandContext, command: string): ExtensionCommandContext {
   203	  const block = (): never => { throw meteredSlashCommandPromptError(command) }
   204	  const guarded = Object.defineProperties({}, Object.getOwnPropertyDescriptors(ctx)) as ExtensionCommandContext
   205	  guarded.compact = block
   206	  guarded.newSession = async () => block()
   207	  guarded.fork = async () => block()
   208	  guarded.navigateTree = async () => block()
   209	  guarded.switchSession = async () => block()
   210	  return guarded
   211	}
