   186	function modelUnavailableError(input: AgentSendInput): Error {
   187	  return Object.assign(new Error('Requested model is not available.'), {
   188	    statusCode: 400,
   189	    code: ErrorCode.enum.TOOL_INVALID_INPUT,
   190	    details: { provider: input.model?.provider, model: input.model?.id },
   191	  })
