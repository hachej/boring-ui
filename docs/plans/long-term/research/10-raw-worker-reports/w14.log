    47	    this.database.exec(`
    48	      CREATE TABLE IF NOT EXISTS agent_request_ledger (
    49	        request_key TEXT PRIMARY KEY,
    50	        digest TEXT NOT NULL,
    51	        state TEXT NOT NULL,
    52	        record_json TEXT NOT NULL,
    53	        updated_at INTEGER NOT NULL
    54	      )
    55	    `)
    56	  }
