   142	async function loadExtensionsJson(
   143	  cwd: string,
   144	): Promise<ExtensionsConfig | null> {
   145	  const configPath = join(cwd, EXTENSIONS_JSON);
   146	  if (!(await fileExists(configPath))) return null;
   147	  try {
   148	    const raw = await readFile(configPath, "utf-8");
   149	    return JSON.parse(raw) as ExtensionsConfig;
   150	  } catch {
   151	    return null;
   152	  }
