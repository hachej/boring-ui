   213	function resolveRequestedModel(
   214	  modelRegistry: ModelRegistry,
   215	  input: AgentSendInput,
   216	  options: { strict?: boolean } = {},
   217	) {
   218	  const requestedId = input.model?.id;
   219	  if (!input.model || !requestedId) return undefined;
   220	  const model = modelRegistry.find(input.model.provider, requestedId);
   221	  const available = modelRegistry.getAvailable();
   222	  const hasAuth = Boolean(model) && available.some(
   223	    (m) => m.provider === model!.provider && m.id === model!.id,
   224	  );
   225	  if (!model || !hasAuth) {
   226	    if (options.strict) throw modelUnavailableError(input)
   227	    return undefined
   228	  }
   229	  return model;
   230	}
