   232	function resolveDefaultModel(
   233	  modelRegistry: ModelRegistry,
   234	  override?: { provider: string; id: string },
   235	  strict?: boolean,
   236	) {
   237	  if (override) {
   238	    return resolveRequestedModel(modelRegistry, { model: override }, { strict });
   239	  }
   240	  const configured = readConfiguredDefaultModel();
   241	  if (configured) {
   242	    const model = modelRegistry.find(configured.provider, configured.id);
   243	    if (model) return model;
   244	  }
   245	  return undefined;
   246	}
