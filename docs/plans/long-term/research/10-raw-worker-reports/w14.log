   114	/** Process-lifetime live-turn projection. Reads never create activity rows. */
   115	export class AgentSessionActivityIndex {
   116	  private readonly activity = new Map<string, StoredAgentSessionActivity>()
   117	  private readonly subscribers = new Map<string, Set<(update: AgentSessionActivityUpdate) => void>>()
   118	
   119	  get(workspaceScopeId: string, ref: AgentSessionRef): AgentSessionActivity {
   120	    return this.activity.get(agentSessionKey(workspaceScopeId, ref))?.status ?? 'idle'
   121	  }
   122	
   123	  set(workspaceScopeId: string, ref: AgentSessionRef, status: AgentSessionActivity): void {
   124	    const key = agentSessionKey(workspaceScopeId, ref)
   125	    if (this.activity.get(key)?.status === status) return
   126	    const update = { ref, status }
   127	    this.activity.set(key, { workspaceScopeId, ...update })
   128	    for (const subscriber of this.subscribers.get(workspaceScopeId) ?? []) {
   129	      try { subscriber(update) } catch { /* Activity observers cannot fail an Agent run. */ }
   130	    }
   131	  }
   132	
   133	  snapshot(workspaceScopeId: string): AgentSessionActivityUpdate[] {
   134	    return [...this.activity.values()]
   135	      .filter((item) => item.workspaceScopeId === workspaceScopeId)
   136	      .map(({ ref, status }) => ({ ref, status }))
   137	  }
   138	
   139	  subscribe(workspaceScopeId: string, subscriber: (update: AgentSessionActivityUpdate) => void): () => void {
   140	    const subscribers = this.subscribers.get(workspaceScopeId) ?? new Set()
   141	    subscribers.add(subscriber)
   142	    this.subscribers.set(workspaceScopeId, subscribers)
   143	    return () => {
   144	      subscribers.delete(subscriber)
   145	      if (subscribers.size === 0) this.subscribers.delete(workspaceScopeId)
   146	    }
   147	  }
   148	
   149	  delete(workspaceScopeId: string, ref: AgentSessionRef): void {
   150	    this.activity.delete(agentSessionKey(workspaceScopeId, ref))
   151	  }
   152	
   153	  observe(workspaceScopeId: string, ref: AgentSessionRef, event: PiChatEvent): void {
   154	    if (event.type === 'agent-start') this.set(workspaceScopeId, ref, 'running')
   155	    if (event.type === 'agent-end') this.set(workspaceScopeId, ref, event.status === 'error' ? 'error' : 'idle')
   156	    if (event.type === 'error') this.set(workspaceScopeId, ref, 'error')
   157	  }
   158	}
