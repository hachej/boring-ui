   154	          code: ErrorCode.enum.AGENT_MCP_GRANT_TOOL_NOT_ALLOWED,
   155	          connectorId: grant.connectorId,
   156	          tool,
   157	          message: `Grant for connector '${grant.connectorId}' allows tool '${tool}', which is not part of the connector's known tool catalog; it was dropped.`,
