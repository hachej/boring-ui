    62	export function extractTools(mod: Record<string, unknown>): AgentTool[] {
    63	  const tools: AgentTool[] = [];
    64	
    65	  if (mod.default) {
    66	    const defaultExport = mod.default;
    67	    if (Array.isArray(defaultExport)) {
    68	      for (const item of defaultExport) {
    69	        const valid = validateTool(item);
    70	        if (valid) tools.push(valid);
    71	      }
    72	    } else {
    73	      const valid = validateTool(defaultExport);
    74	      if (valid) tools.push(valid);
    75	    }
    76	  }
    77	
    78	  if (mod.tools && Array.isArray(mod.tools)) {
    79	    for (const item of mod.tools) {
    80	      const valid = validateTool(item);
    81	      if (valid) tools.push(valid);
    82	    }
    83	  }
    84	
    85	  return tools;
    86	}
