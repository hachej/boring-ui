   160	function buildDynamicPromptExtension(
   161	  source: () => string | undefined | Promise<string | undefined>,
   162	): ExtensionFactory {
   163	  return (pi) => {
   164	    pi.on("before_agent_start", async (event) => {
   165	      const extra = (await source())?.trim()
   166	      if (!extra) return
   167	      return { systemPrompt: `${event.systemPrompt}\n\n${extra}` }
   168	    })
   169	  }
