   172	function buildToolErrorResultExtension(): ExtensionFactory {
   173	  return (pi) => {
   174	    pi.on("tool_result", async (event) => {
   175	      const marked = unmarkToolResultErrorDetails((event as { details?: unknown }).details)
   176	      if (!marked.isMarked) return
   177	      return {
   178	        details: marked.details,
   179	        isError: true,
   180	      }
   181	    })
   182	  }
   183	}
