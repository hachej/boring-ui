   146	    const allowedTools: string[] = []
   147	    // Defend against a grant sourced from a third-party/legacy store where
   148	    // `allowedTools` may be missing or non-array despite the interface
   149	    // declaring it required — iterating it directly would throw "not
   150	    // iterable" and take down resolution for every other ref.
   151	    for (const tool of Array.isArray(grant.allowedTools) ? grant.allowedTools : []) {
   152	      if (catalogTools && !catalogTools.includes(tool)) {
   153	        diagnostics.push({
   154	          code: ErrorCode.enum.AGENT_MCP_GRANT_TOOL_NOT_ALLOWED,
   155	          connectorId: grant.connectorId,
   156	          tool,
   157	          message: `Grant for connector '${grant.connectorId}' allows tool '${tool}', which is not part of the connector's known tool catalog; it was dropped.`,
