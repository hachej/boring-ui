   155	const defaultImport: ImportFn = (url: string) => import(url);
   156	
   157	export async function loadPlugins(
   158	  options: PluginLoaderOptions,
   159	): Promise<PluginLoadResult> {
   160	  const result: PluginLoadResult = { plugins: [], errors: [] };
   161	  const importFn = options.importFn ?? defaultImport;
   162	
   163	  const candidates: Array<{
   164	    path: string;
   165	    source: "global" | "local" | "npm" | "git";
   166	  }> = [];
   167	
   168	  if (!options.skipGlobal) {
   169	    const globals = await discoverFromDir(GLOBAL_DIR, "global");
   170	    candidates.push(...globals);
   171	  }
   172	
   173	  const localDir = join(options.cwd, LOCAL_DIR);
   174	  const locals = await discoverFromDir(localDir, "local");
   175	  candidates.push(...locals);
   176	
   177	  const npmDirs = await discoverNpmPlugins(options.cwd);
   178	  for (const dir of npmDirs) {
   179	    candidates.push({ path: dir, source: "npm" });
   180	  }
   181	
   182	  const config = await loadExtensionsJson(options.cwd);
   183	  if (config?.npm) {
   184	    for (const pkg of config.npm) {
   185	      const pkgDir = join(options.cwd, "node_modules", pkg);
   186	      if (await dirExists(pkgDir)) {
   187	        const already = candidates.some((c) => c.path === pkgDir);
   188	        if (!already) {
   189	          candidates.push({ path: pkgDir, source: "npm" });
   190	        }
   191	      }
   192	    }
   193	  }
   194	  if (config?.git?.length) {
   195	    for (const url of config.git) {
   196	      result.errors.push({
   197	        source: url,
   198	        error: "git URL extensions are not yet supported",
   199	      });
   200	    }
   201	  }
   202	
   203	  for (const candidate of candidates) {
   204	    try {
   205	      const tools =
   206	        candidate.source === "npm"
   207	          ? await loadNpmPlugin(candidate.path, importFn)
   208	          : await loadModule(candidate.path, importFn);
   209	
   210	      if (tools.length > 0) {
   211	        result.plugins.push({
   212	          source: candidate.source,
   213	          path: candidate.path,
   214	          tools,
   215	        });
   216	      }
   217	    } catch (err) {
   218	      result.errors.push({
   219	        source: candidate.path,
   220	        error: err instanceof Error ? err.message : String(err),
   221	      });
   222	    }
   223	  }
   224	
   225	  return result;
   226	}
   227	
   228	export function flattenPluginTools(result: PluginLoadResult): AgentTool[] {
   229	  return result.plugins.flatMap((p) => p.tools);
   230	}
