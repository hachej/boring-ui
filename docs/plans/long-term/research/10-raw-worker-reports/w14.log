    51	async function discoverFromDir(
    52	  dir: string,
    53	  source: "global" | "local",
    54	): Promise<{ path: string; source: "global" | "local" }[]> {
    55	  if (!(await dirExists(dir))) return [];
    56	  const entries = await readdir(dir);
    57	  return entries
    58	    .filter((e) => VALID_EXTENSIONS.has(extname(e)))
    59	    .map((e) => ({ path: join(dir, e), source }));
    60	}
