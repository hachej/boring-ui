    96	 * is actually allowed to use, through per-agent grants only — never a
    97	 * parallel authorization path.
    98	 *
    99	 * - Default-deny: no grants for `(workspaceId, agentTypeId)` -> no connectors.
   100	 * - Every declared ref without a matching grant is dropped with a stable
   101	 *   diagnostic; it is never silently ignored.
   102	 * - A granted connector does not imply all of its tools: `allowedTools` is
   103	 *   the tool-level filter, and (when a catalog is supplied) is further
   104	 *   intersected with the connector's known tool surface.
   105	 * - Isolation: resolution only ever consults grants whose `agentTypeId`
   106	 *   exactly matches the requested Agent, so two Agents in one workspace
   107	 *   never see each other's connectors.
   108	 */
   109	export function resolveAgentMcpGrants(input: ResolveAgentMcpGrantsInput): ResolvedAgentMcpGrants {
   110	  const { workspaceId, agentTypeId, mcpServerRefs, grants, catalog } = input
   111	  const connectors: ResolvedMcpConnectorGrant[] = []
   112	  const diagnostics: McpGrantDiagnostic[] = []
   113	
   114	  const grantsByConnector = new Map<string, McpGrant>()
   115	  for (const grant of grants) {
   116	    if (grant.workspaceId !== workspaceId || grant.agentTypeId !== agentTypeId) continue
   117	    grantsByConnector.set(grant.connectorId, grant)
   118	  }
   119	
   120	  for (const ref of new Set(mcpServerRefs)) {
   121	    const grant = grantsByConnector.get(ref)
   122	    if (!grant) {
   123	      diagnostics.push({
   124	        code: ErrorCode.enum.AGENT_MCP_GRANT_REF_UNGRANTED,
   125	        connectorId: ref,
   126	        message: `mcpServerRefs entry '${ref}' has no matching MCP grant for this Agent in this workspace; it was dropped.`,
