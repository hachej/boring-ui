   109	export function resolveAgentMcpGrants(input: ResolveAgentMcpGrantsInput): ResolvedAgentMcpGrants {
   110	  const { workspaceId, agentTypeId, mcpServerRefs, grants, catalog } = input
   111	  const connectors: ResolvedMcpConnectorGrant[] = []
   112	  const diagnostics: McpGrantDiagnostic[] = []
   113	
   114	  const grantsByConnector = new Map<string, McpGrant>()
