    97	async function discoverNpmPlugins(cwd: string): Promise<string[]> {
    98	  const nodeModulesDir = join(cwd, "node_modules");
    99	  if (!(await dirExists(nodeModulesDir))) return [];
   100	
   101	  try {
   102	    const entries = await readdir(nodeModulesDir);
   103	    return entries
   104	      .filter((e) => e.startsWith("pi-plugin-"))
   105	      .map((e) => join(nodeModulesDir, e));
   106	  } catch {
   107	    return [];
   108	  }
   109	}
   110	
   111	async function loadNpmPlugin(
   112	  pkgDir: string,
   113	  importFn: ImportFn,
   114	): Promise<AgentTool[]> {
   115	  const pkgJsonPath = join(pkgDir, "package.json");
   116	  if (!(await fileExists(pkgJsonPath))) return [];
   117	
   118	  const pkgJson = JSON.parse(await readFile(pkgJsonPath, "utf-8"));
   119	  const main = pkgJson.main ?? "index.js";
   120	  const resolvedMain = resolve(pkgDir, main);
   121	  const resolvedPkgDir = resolve(pkgDir);
   122	  // Guard against path traversal: resolvedMain must be exactly pkgDir
   123	  // (for entrypoints like "." or "./") or a direct child of pkgDir.
   124	  // Using sep ensures we match on directory boundaries (e.g. pkgDir
   125	  // = "/a" must not match "/ab/foo.js").
   126	  if (resolvedMain !== resolvedPkgDir && !resolvedMain.startsWith(resolvedPkgDir + sep)) {
   127	    return [];
   128	  }
   129	  // Extra guard: the relative path from pkgDir must not contain "..".
   130	  const relPath = relative(resolvedPkgDir, resolvedMain);
   131	  if (relPath.startsWith("..")) {
   132	    return [];
   133	  }
   134	  return loadModule(resolvedMain, importFn);
   135	}
