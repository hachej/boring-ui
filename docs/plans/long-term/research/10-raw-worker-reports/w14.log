   272	async function applyRequestedSessionOptions(
   273	  handle: PiSessionHandle,
   274	  input: AgentSendInput,
   275	  options: { strictModelResolution?: boolean } = {},
   276	): Promise<void> {
   277	  const requestedModel = resolveRequestedModel(handle.modelRegistry, input, { strict: options.strictModelResolution });
   278	  if (requestedModel) {
   279	    const current = handle.piSession.model;
   280	    if (
   281	      !current ||
   282	      current.provider !== requestedModel.provider ||
   283	      current.id !== requestedModel.id
