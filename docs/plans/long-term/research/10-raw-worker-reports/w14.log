   297	function extForAttachment(filename: string, contentType: string): string {
   298	  const fromName = extname(filename).toLowerCase().replace(/^\./, "");
   299	  if (/^[a-z0-9]{1,12}$/.test(fromName)) return fromName;
   300	  if (contentType === "image/jpeg") return "jpg";
   301	  if (contentType === "image/png") return "png";
   302	  if (contentType === "image/gif") return "gif";
   303	  if (contentType === "image/webp") return "webp";
   304	  if (contentType === "image/svg+xml") return "svg";
   305	  return "bin";
   306	}
   307	
   308	function basenameForAttachment(filename: string): string {
   309	  const base = filename.split("/").pop()?.split("\\").pop() ?? "image";
   310	  const withoutExt = base.replace(/\.[^.]*$/, "");
   311	  const safe = withoutExt
   312	    .normalize("NFKD")
   313	    .replace(/[^a-zA-Z0-9._-]+/g, "-")
   314	    .replace(/^-+|-+$/g, "")
   315	    .slice(0, 64);
   316	  return safe || "image";
   317	}
