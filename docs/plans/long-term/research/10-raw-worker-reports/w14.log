   134	      // filtering: silently admitting every grant.allowedTools entry here
   135	      // would mean an unrecognized/misconfigured connectorId gets a free
   136	      // pass to every tool a grant happens to list, which is the opposite
   137	      // of default-deny.
   138	      diagnostics.push({
   139	        code: ErrorCode.enum.AGENT_MCP_GRANT_CONNECTOR_UNKNOWN,
   140	        connectorId: grant.connectorId,
