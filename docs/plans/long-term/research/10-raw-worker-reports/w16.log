   123	    child.on('error', (error: NodeJS.ErrnoException) => {
   124	      if (error.code === 'ENOENT') {
   125	        fail(
   126	          new Error(
   127	            'bubblewrap binary "bwrap" not found on PATH; install bubblewrap to use local mode',
   128	          ),
   129	        )
   130	        return
   131	      }
   132	      fail(error)
   133	    })
   134	
   135	    child.on('close', (code) => {
   136	      if (code === 0) {
   137	        succeed()
   138	        return
   139	      }
   140	      fail(new Error(`bubblewrap availability check failed with exit code ${code ?? 'unknown'}`))
