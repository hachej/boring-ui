    98	export class AskUserRuntime {
    99	  readonly coordinator: AskUserCoordinator
   100	  readonly store: AskUserStore
   101	  private readonly ownerPrincipalId: string
   102	  private readonly now: () => Date
   103	  private readonly perSessionPerMinute: number
   104	  private readonly perPrincipalPerHour: number
   105	  private readonly sessionBuckets = new Map<string, RateLimitBucket>()
   106	  private readonly principalBuckets = new Map<string, RateLimitBucket>()
   107	
   108	  constructor(options: AskUserRuntimeOptions) {
   109	    this.store = options.store
   110	    this.coordinator = options.coordinator ?? new InProcessAskUserCoordinator()
   111	    this.ownerPrincipalId = options.ownerPrincipalId ?? "anonymous"
   112	    this.now = options.now ?? (() => new Date())
   113	    this.perSessionPerMinute = options.limits?.perSessionPerMinute ?? 6
   114	    this.perPrincipalPerHour = options.limits?.perPrincipalPerHour ?? 30
   115	  }
   116	
   117	  async abandonOrphanedPending(sessionIds: string[]): Promise<void> {
   118	    for (const sessionId of sessionIds) {
   119	      const pending = await this.store.getPending(sessionId)
   120	      if (pending && !this.coordinator.hasWaiter(pending.questionId)) {
   121	        await this.abandon(pending.questionId, pending.sessionId)
   122	      }
   123	    }
   124	  }
   125	
   126	
   127	  async ask(request: AskUserRequest, signal?: AbortSignal): Promise<AskUserToolResult> {
   128	    const ownerPrincipalId = request.ownerPrincipalId ?? this.ownerPrincipalId
   129	    await this.abandonOrphanedPending([request.sessionId])
   130	    this.assertAllowed(request.sessionId, ownerPrincipalId)
   131	    const parsedArtifacts = HumanArtifactListSchema.safeParse(request.artifacts ?? [])
   132	    if (!parsedArtifacts.success) throw new AskUserRuntimeError(ASK_USER_ERROR_CODES.SCHEMA_INVALID, parsedArtifacts.error.message)
   133	    const question = this.createQuestion({ ...request, artifacts: parsedArtifacts.data, ownerPrincipalId })
   134	    const parsed = AskUserFormSchemaSchema.safeParse(request.schema)
   135	    if (!parsed.success) throw new AskUserRuntimeError(ASK_USER_ERROR_CODES.SCHEMA_INVALID, parsed.error.message)
   136	    question.schema = parsed.data
   137	
   138	    // Register the waiter before publishing/persisting the question. The UI
   139	    // state publisher can make a question answerable as soon as createPending
   140	    // mutates the store; if the browser answers in that small window before the
   141	    // waiter exists, submitAnswer correctly treats it as abandoned. Cancellation
   142	    // is armed only after persistence so abort/timeout cannot leave a visible
   143	    // question with no waiter.
   144	    const pendingAnswer = this.coordinator.registerWaiter(question.questionId, question.sessionId)
   145	    try {
   146	      await this.store.createPending(question)
   147	      await this.store.appendTranscriptEvent({ type: "created", question, at: this.isoNow() })
   148	      await this.store.appendTranscriptEvent({ type: "ready", questionId: question.questionId, sessionId: question.sessionId, schema: parsed.data, at: this.isoNow() })
   149	      if (signal?.aborted) {
   150	        await this.cancelQuestion(question.questionId, question.sessionId, "aborted")
   151	        return await pendingAnswer
   152	      }
   153	      return await this.waitForAnswer(question, pendingAnswer, request.timeoutMs, signal)
   154	    } catch (error) {
   155	      this.coordinator.resolveCancelled(question.questionId, "abandoned")
   156	      throw error
   157	    }
   158	  }
   159	
   160	  async submitAnswer(questionId: string, sessionId: string, values: AskUserAnswer["values"]): Promise<"answered" | "abandoned"> {
   161	    const question = await this.store.getByQuestionId(questionId)
   162	    if (!question || question.sessionId !== sessionId) throw new AskUserRuntimeError(ASK_USER_ERROR_CODES.QUESTION_NOT_FOUND, "question not found")
   163	    if (!this.coordinator.hasWaiter(questionId)) {
   164	      await this.abandon(questionId, sessionId)
   165	      return "abandoned"
   166	    }
   167	    const answer: AskUserAnswer = { questionId, sessionId, values, submittedAt: this.isoNow() }
   168	    let answerPersisted = false
   169	    try {
   170	      await this.store.answer(questionId, answer)
   171	      answerPersisted = true
   172	      await this.store.appendTranscriptEvent({ type: "answered", answer, at: this.isoNow() })
   173	    } finally {
   174	      if (answerPersisted) this.coordinator.resolveAnswered(questionId, answer)
   175	    }
   176	    return "answered"
   177	  }
   178	
   179	  async cancelQuestion(questionId: string, sessionId: string, reason: AskUserCancelReason = "user_cancelled"): Promise<void> {
   180	    const question = await this.store.getByQuestionId(questionId)
   181	    if (!question || question.sessionId !== sessionId) throw new AskUserRuntimeError(ASK_USER_ERROR_CODES.QUESTION_NOT_FOUND, "question not found")
   182	    if (!this.coordinator.hasWaiter(questionId)) {
   183	      await this.abandon(questionId, sessionId)
   184	      return
   185	    }
   186	    let cancelPersisted = false
   187	    try {
   188	      await this.store.cancel(questionId)
   189	      cancelPersisted = true
   190	      await this.store.appendTranscriptEvent({ type: "cancelled", questionId, sessionId, reason, at: this.isoNow() })
   191	    } catch (error) {
   192	      if (!cancelPersisted) await this.resolveCancelledUnlessAnswered(questionId, reason)
   193	      throw error
   194	    } finally {
   195	      if (cancelPersisted) this.coordinator.resolveCancelled(questionId, reason)
   196	    }
   197	  }
   198	
   199	  private async waitForAnswer(
   200	    question: AskUserQuestion,
   201	    pendingAnswer: Promise<AskUserToolResult>,
   202	    timeoutMs?: number,
   203	    signal?: AbortSignal,
   204	  ): Promise<AskUserToolResult> {
   205	    let settled = false
   206	    const cancel = (reason: AskUserCancelReason) => {
   207	      if (settled) return
   208	      void this.cancelQuestion(question.questionId, question.sessionId, reason).catch(() => undefined)
   209	    }
   210	    const onAbort = () => cancel("aborted")
   211	    signal?.addEventListener("abort", onAbort, { once: true })
   212	    if (signal?.aborted) cancel("aborted")
   213	    const timeout = timeoutMs ? setTimeout(() => cancel("timeout"), timeoutMs) : undefined
   214	    try {
   215	      const result = await pendingAnswer
   216	      settled = true
   217	      return result
   218	    } finally {
   219	      settled = true
   220	      signal?.removeEventListener("abort", onAbort)
   221	      if (timeout) clearTimeout(timeout)
   222	    }
   223	  }
   224	
   225	  private async resolveCancelledUnlessAnswered(questionId: string, reason: AskUserCancelReason): Promise<void> {
   226	    const latest = await this.store.getByQuestionId(questionId).catch(() => null)
   227	    if (latest?.status === "answered") return
   228	    this.coordinator.resolveCancelled(questionId, reason)
   229	  }
   230	
   231	  private async abandon(questionId: string, sessionId: string): Promise<void> {
   232	    await this.store.markAbandoned(questionId)
   233	    await this.store.appendTranscriptEvent({ type: "abandoned", questionId, sessionId, at: this.isoNow() })
   234	    this.coordinator.resolveCancelled(questionId, "abandoned")
   235	  }
   236	
   237	  private createQuestion(request: Pick<AskUserRequest, "sessionId" | "title" | "context" | "artifacts" | "toolCallId" | "ownerPrincipalId">): AskUserQuestion {
   238	    const at = this.isoNow()
   239	    return {
   240	      questionId: randomUUID(),
   241	      sessionId: request.sessionId,
   242	      toolCallId: request.toolCallId,
   243	      ownerPrincipalId: request.ownerPrincipalId ?? this.ownerPrincipalId,
   244	      status: "ready",
   245	      title: request.title,
   246	      context: request.context,
   247	      artifacts: request.artifacts ?? [],
   248	      answerToken: randomBytes(32).toString("base64url"),
   249	      createdAt: at,
   250	      updatedAt: at,
   251	    }
   252	  }
   253	
   254	  private assertAllowed(sessionId: string, principalId: string): void {
   255	    if (!this.consume(this.sessionBuckets, sessionId, 60_000, this.perSessionPerMinute) || !this.consume(this.principalBuckets, principalId, 3_600_000, this.perPrincipalPerHour)) {
   256	      throw new AskUserRuntimeError(ASK_USER_ERROR_CODES.RATE_LIMITED, "ask_user rate limit exceeded")
   257	    }
   258	  }
   259	
   260	  private consume(buckets: Map<string, RateLimitBucket>, key: string, windowMs: number, limit: number): boolean {
   261	    const now = this.now().getTime()
   262	    const bucket = buckets.get(key)
   263	    if (!bucket || bucket.resetAt <= now) {
   264	      buckets.set(key, { count: 1, resetAt: now + windowMs })
   265	      return true
   266	    }
   267	    if (bucket.count >= limit) return false
   268	    bucket.count += 1
   269	    return true
   270	  }
   271	
   272	  private isoNow(): string {
   273	    return this.now().toISOString()
   274	  }
   275	}
   276	
   277	export function requireAskUserRuntime(runtime: AskUserRuntime | null | undefined): AskUserRuntime {
   278	  if (!runtime) throw new AskUserRuntimeError(ASK_USER_ERROR_CODES.RUNTIME_UNAVAILABLE, "ask_user runtime unavailable")
   279	  return runtime
   280	}
