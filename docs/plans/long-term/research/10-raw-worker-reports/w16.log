184-{
185-  type: 'submission_settled';
186-  submissionId: string;
187-  outcome: 'completed' | 'failed' | 'aborted';
188:  error?: {
189-    name?: string;
190-    message: string;
191-    type?: string;
192-    details?: string;
193-    dev?: string;
