   130	export interface PreparedInvocationEnvelopeV1 {
   131	  readonly bytes: Uint8Array;
   132	  readonly secretBearing: boolean;
   133	  readonly timeoutMs: number;
   134	  readonly maxOutputBytes: number;
   135	}
   136	
   137	export interface ResolvedInvocationCredentialFieldV1 {
   138	  readonly bindingId: string;
   139	  readonly fieldId: string;
   140	  readonly name: string;
   141	  readonly value: Uint8Array;
   142	}
   143	
   144	export function prepareInvocationEnvelopeV1(input: {
   145	  workspaceId: string;
   146	  request: RemoteWorkerExecRequestV1;
   147	  resolvedCredentialFields?: readonly ResolvedInvocationCredentialFieldV1[];
   148	}): PreparedInvocationEnvelopeV1 {
   149	  let request: RemoteWorkerExecRequestV1;
   150	  try {
   151	    request = RemoteWorkerExecRequestSchemaV1.parse(input.request);
   152	  } catch (error) {
   153	    throw runscRuntimeError(
   154	      REMOTE_WORKER_ERROR_CODES_V1.requestInvalid,
   155	      "remote-worker invocation failed strict validation",
   156	      error,
   157	    );
   158	  }
   159	  boundedUtf8Bytes(
   160	    request.command,
   161	    RUNSC_RUNTIME_LIMITS_V1.maxCommandBytes,
   162	    "command",
   163	  );
   164	  const timeoutMs = boundedPositiveInteger(
   165	    request.timeoutMs ?? RUNSC_RUNTIME_LIMITS_V1.defaultInvocationTimeoutMs,
   166	    RUNSC_RUNTIME_LIMITS_V1.maxInvocationTimeoutMs,
   167	    "invocation timeout",
   168	  );
   169	  const maxOutputBytes = boundedPositiveInteger(
   170	    request.maxOutputBytes,
   171	    RUNSC_RUNTIME_LIMITS_V1.maxCombinedOutputBytes,
   172	    "invocation output limit",
   173	  );
   174	  const cwd = request.cwd ?? "/workspace";
   175	  boundedUtf8Bytes(cwd, RUNSC_RUNTIME_LIMITS_V1.maxPathBytes, "cwd");
   176	  if (
   177	    (cwd !== "/workspace" && !cwd.startsWith("/workspace/")) ||
   178	    cwd.includes("\0") ||
   179	    cwd.split("/").includes("..")
   180	  ) {
   181	    throw runscRuntimeError(
   182	      REMOTE_WORKER_ERROR_CODES_V1.pathUnsafe,
   183	      "remote-worker invocation cwd is outside the workspace",
   184	    );
   185	  }
   186	
   187	  const secretNames = new Set<string>();
   188	  const expectedFields = new Map<string, string>();
   189	  for (const credential of request.credentialRefs ?? []) {
   190	    if (credential.ref.executionId !== request.invocationId) {
   191	      throw runscRuntimeError(
   192	        REMOTE_WORKER_ERROR_CODES_V1.secretReferenceRejected,
   193	        "remote-worker credential execution scope is invalid",
   194	      );
   195	    }
   196	    for (const field of credential.fields) {
   197	      validateEnvName(field.name);
   198	      const key = `${credential.ref.bindingId}\0${field.fieldId}`;
   199	      if (expectedFields.has(key) || secretNames.has(field.name)) {
   200	        throw runscRuntimeError(
   201	          REMOTE_WORKER_ERROR_CODES_V1.secretReferenceRejected,
   202	          "remote-worker credential fields must be unique",
   203	        );
   204	      }
   205	      expectedFields.set(key, field.name);
   206	      secretNames.add(field.name);
   207	    }
   208	  }
   209	  const resolvedFields = input.resolvedCredentialFields ?? [];
   210	  if (resolvedFields.length !== expectedFields.size) {
   211	    throw runscRuntimeError(
   212	      REMOTE_WORKER_ERROR_CODES_V1.secretReferenceRejected,
   213	      "remote-worker credential resolution is incomplete",
   214	    );
   215	  }
   216	  const delivered = new Set<string>();
   217	  for (const field of resolvedFields) {
   218	    const key = `${field.bindingId}\0${field.fieldId}`;
   219	    const expectedName = expectedFields.get(key);
   220	    if (
   221	      expectedName === undefined ||
   222	      expectedName !== field.name ||
   223	      delivered.has(key)
   224	    ) {
   225	      throw runscRuntimeError(
   226	        REMOTE_WORKER_ERROR_CODES_V1.secretReferenceRejected,
   227	        "remote-worker credential resolution does not match the request",
   228	      );
   229	    }
   230	    delivered.add(key);
   231	  }
   232	
   233	  const metadata = encodeBoundedJson(
   234	    {
   235	      version: 1,
   236	      command: request.command,
   237	      cwd,
   238	      timeoutMs,
   239	      maxOutputBytes,
   240	      graceMs: RUNSC_RUNTIME_LIMITS_V1.processGroupGraceMs,
   241	    },
   242	    RUNSC_RUNTIME_LIMITS_V1.maxEnvelopeBytes,
   243	  );
   244	  const bytes = encodeInvocationFrame(
   245	    metadata,
   246	    encodeCredentialFrame(resolvedFields),
   247	  );
   248	  return {
   249	    bytes,
   250	    secretBearing: expectedFields.size > 0,
   251	    timeoutMs,
   252	    maxOutputBytes,
   253	  };
   254	}

