    20	export type AskUserStoreChange = {
    21	  sessionId: string
    22	  questionId?: string
    23	  reason: "create" | "answer" | "cancel" | "abandon" | "clear" | "transcript"
    24	}
    25	
    26	export type AskUserStoreListener = (change: AskUserStoreChange) => void
    27	
    28	export interface AskUserStore {
    29	  getPending(sessionId: string): Promise<AskUserQuestion | null>
    30	  listPending(): Promise<AskUserQuestion[]>
    31	  getByQuestionId(questionId: string): Promise<AskUserQuestion | null>
    32	  createPending(question: AskUserQuestion): Promise<void>
    33	  answer(questionId: string, answer: AskUserAnswer): Promise<void>
    34	  cancel(questionId: string): Promise<void>
    35	  markAbandoned(questionId: string): Promise<void>
    36	  clearPending(sessionId: string): Promise<void>
    37	  appendTranscriptEvent(event: AskUserTranscriptEvent): Promise<void>
    38	  listTranscriptEvents(sessionId: string): Promise<AskUserTranscriptEvent[]>
    39	  getTranscriptEventsForQuestion(questionId: string): Promise<AskUserTranscriptEvent[]>
    40	  subscribe(listener: AskUserStoreListener): () => void
    41	}
    42	
    43	type StoredAskUserState = {
    44	  questions: Record<string, AskUserQuestion>
    45	  pendingBySession: Record<string, string>
    46	  answers: Record<string, AskUserAnswer>
    47	  transcriptsBySession: Record<string, AskUserTranscriptEvent[]>
    48	}
    49	
    50	const EMPTY_STATE: StoredAskUserState = {
    51	  questions: {},
    52	  pendingBySession: {},
    53	  answers: {},
    54	  transcriptsBySession: {},
    55	}
    56	
    57	export class FileAskUserStore implements AskUserStore {
    58	  private state: StoredAskUserState | null = null
    59	  private loadInFlight: Promise<StoredAskUserState> | null = null
    60	  private writeChain = Promise.resolve()
    61	  private readonly listeners = new Set<AskUserStoreListener>()
    62	
    63	  constructor(private readonly filePath: string) {}
    64	
    65	  async getPending(sessionId: string): Promise<AskUserQuestion | null> {
    66	    const state = await this.load()
    67	    const questionId = state.pendingBySession[sessionId]
    68	    if (!questionId) return null
    69	    const question = state.questions[questionId]
    70	    if (!question || !isPending(question)) return null
    71	    return clone(question)
    72	  }
    73	
    74	  async listPending(): Promise<AskUserQuestion[]> {
    75	    const state = await this.load()
    76	    return Object.values(state.pendingBySession)
    77	      .map((questionId) => state.questions[questionId])
    78	      .filter(isPending)
    79	      .map((question) => clone(question))
    80	  }
    81	
    82	  async getByQuestionId(questionId: string): Promise<AskUserQuestion | null> {
    83	    const state = await this.load()
    84	    return state.questions[questionId] ? clone(state.questions[questionId]) : null
    85	  }
    86	
    87	  async createPending(question: AskUserQuestion): Promise<void> {
    88	    await this.mutate(async (state) => {
    89	      const existing = state.pendingBySession[question.sessionId]
    90	      if (existing && isPending(state.questions[existing])) {
    91	        throw new AskUserStoreError(ASK_USER_ERROR_CODES.PENDING_EXISTS, "a pending question already exists for this session")
    92	      }
    93	      state.questions[question.questionId] = clone(question)
    94	      if (isPending(question)) state.pendingBySession[question.sessionId] = question.questionId
    95	      this.emit({ sessionId: question.sessionId, questionId: question.questionId, reason: "create" })
    96	    })
    97	  }
    98	
    99	  async answer(questionId: string, answer: AskUserAnswer): Promise<void> {
   100	    await this.mutate(async (state) => {
   101	      const question = requireQuestion(state, questionId)
   102	      if (answer.questionId !== questionId || answer.sessionId !== question.sessionId) {
   103	        throw new AskUserStoreError(ASK_USER_ERROR_CODES.SESSION_MISMATCH, "answer does not match question/session")
   104	      }
   105	      if (question.status === "cancelled") throw new AskUserStoreError(ASK_USER_ERROR_CODES.ALREADY_CANCELLED, "question already cancelled")
   106	      if (question.status === "answered") throw new AskUserStoreError(ASK_USER_ERROR_CODES.ALREADY_ANSWERED, "question already answered")
   107	      if (question.status !== "ready") throw new AskUserStoreError(ASK_USER_ERROR_CODES.ANSWER_INVALID, "question is not ready")
   108	      question.status = "answered"
   109	      question.updatedAt = nowIso()
   110	      state.answers[questionId] = clone(answer)
   111	      delete state.pendingBySession[question.sessionId]
   112	      this.emit({ sessionId: question.sessionId, questionId, reason: "answer" })
   113	    })
   114	  }
   115	
   116	  async cancel(questionId: string): Promise<void> {
   117	    await this.mutate(async (state) => {
   118	      const question = requireQuestion(state, questionId)
   119	      if (question.status === "answered") throw new AskUserStoreError(ASK_USER_ERROR_CODES.ALREADY_ANSWERED, "question already answered")
   120	      if (question.status === "cancelled") throw new AskUserStoreError(ASK_USER_ERROR_CODES.ALREADY_CANCELLED, "question already cancelled")
   121	      if (!isPending(question)) throw new AskUserStoreError(ASK_USER_ERROR_CODES.QUESTION_NOT_FOUND, "question is not pending")
   122	      question.status = "cancelled"
   123	      question.updatedAt = nowIso()
   124	      delete state.pendingBySession[question.sessionId]
   125	      this.emit({ sessionId: question.sessionId, questionId, reason: "cancel" })
   126	    })
   127	  }
   128	
   129	  async markAbandoned(questionId: string): Promise<void> {
   130	    await this.mutate(async (state) => {
   131	      const question = requireQuestion(state, questionId)
   132	      if (!isPending(question)) return
   133	      question.status = "abandoned"
   134	      question.updatedAt = nowIso()
   135	      delete state.pendingBySession[question.sessionId]
   136	      this.emit({ sessionId: question.sessionId, questionId, reason: "abandon" })
   137	    })
   138	  }
   139	
   140	  async clearPending(sessionId: string): Promise<void> {
   141	    await this.mutate(async (state) => {
   142	      const questionId = state.pendingBySession[sessionId]
   143	      if (!questionId) return
   144	      delete state.pendingBySession[sessionId]
   145	      this.emit({ sessionId, questionId, reason: "clear" })
   146	    })
   147	  }
   148	
   149	  async appendTranscriptEvent(event: AskUserTranscriptEvent): Promise<void> {
   150	    await this.mutate(async (state) => {
   151	      const sessionId = transcriptSessionId(event)
   152	      state.transcriptsBySession[sessionId] = [...(state.transcriptsBySession[sessionId] ?? []), clone(event)]
   153	      this.emit({ sessionId, questionId: transcriptQuestionId(event), reason: "transcript" })
   154	    })
   155	  }
   156	
   157	  async listTranscriptEvents(sessionId: string): Promise<AskUserTranscriptEvent[]> {
   158	    const state = await this.load()
   159	    return clone(state.transcriptsBySession[sessionId] ?? [])
   160	  }
   161	
   162	  async getTranscriptEventsForQuestion(questionId: string): Promise<AskUserTranscriptEvent[]> {
   163	    const state = await this.load()
   164	    const events = Object.values(state.transcriptsBySession).flat().filter((event) => transcriptQuestionId(event) === questionId)
   165	    return clone(events)
   166	  }
   167	
   168	  subscribe(listener: AskUserStoreListener): () => void {
   169	    this.listeners.add(listener)
   170	    return () => this.listeners.delete(listener)
   171	  }
   172	
   173	  private async mutate(fn: (state: StoredAskUserState) => Promise<void> | void): Promise<void> {
   174	    const run = this.writeChain.then(async () => {
   175	      const state = await this.load()
   176	      await fn(state)
   177	      await this.save(state)
   178	    })
   179	    this.writeChain = run.catch(() => undefined)
   180	    return run
   181	  }
   182	
   183	  private async load(): Promise<StoredAskUserState> {
   184	    if (this.state) return this.state
   185	    if (!this.loadInFlight) {
   186	      this.loadInFlight = (async () => {
   187	        try {
   188	          const raw = await readFile(this.filePath, "utf8")
   189	          this.state = { ...clone(EMPTY_STATE), ...JSON.parse(raw) }
   190	        } catch (error) {
   191	          if ((error as { code?: string }).code !== "ENOENT") throw error
   192	          this.state = clone(EMPTY_STATE)
   193	        }
   194	        return this.state as StoredAskUserState
   195	      })().finally(() => {
   196	        this.loadInFlight = null
   197	      })
   198	    }
   199	    return this.loadInFlight
   200	  }
   201	
   202	  private async save(state: StoredAskUserState): Promise<void> {
   203	    await mkdir(dirname(this.filePath), { recursive: true })
   204	    const tmp = join(dirname(this.filePath), `.${randomUUID()}.tmp`)
   205	    await writeFile(tmp, JSON.stringify(state, null, 2), "utf8")
   206	    await rename(tmp, this.filePath)
   207	  }
   208	
   209	  private emit(change: AskUserStoreChange): void {
   210	    for (const listener of this.listeners) {
   211	      try {
   212	        const result = listener(change) as unknown
   213	        if (isPromiseLike(result)) result.catch(() => undefined)
   214	      } catch {
   215	        // Store mutations must not be rolled back because an observer failed.
   216	      }
   217	    }
   218	  }
   219	}
   220	
   221	function isPromiseLike(value: unknown): value is Promise<unknown> {
   222	  return !!value && typeof value === "object" && "catch" in value && typeof value.catch === "function"
   223	}
   224	
   225	function isPending(question: AskUserQuestion | undefined): question is AskUserQuestion {
   226	  return question?.status === "ready"
   227	}
   228	
   229	function requireQuestion(state: StoredAskUserState, questionId: string): AskUserQuestion {
   230	  const question = state.questions[questionId]
   231	  if (!question) throw new AskUserStoreError(ASK_USER_ERROR_CODES.QUESTION_NOT_FOUND, `question ${questionId} not found`)
   232	  return question
