   128	export function createRunscInvocationCredentialResolverV1(
   129	  options: RunscInvocationCredentialResolverOptionsV1,
   130	): RunscInvocationCredentialResolverV1 {
   131	  return Object.freeze({
   132	    contractVersion: "boring.runsc-invocation-credential-resolver.v1" as const,
   133	    async resolve(
   134	      input: RunscInvocationCredentialResolutionInputV1,
   135	    ): Promise<ResolvedRunscInvocationCredentialsV1> {
   136	      const fieldCount = input.references.reduce(
   137	        (count, reference) => count + reference.fields.length,
   138	        0,
   139	      );
   140	      if (
   141	        input.invocationId.trim().length === 0 ||
   142	        input.invocationId.length >
   143	          RUNSC_SANDBOX_CREDENTIAL_LIMITS_V1.maxExecutionIdLength ||
   144	        fieldCount > RUNSC_SANDBOX_CREDENTIAL_LIMITS_V1.maxFields ||
   145	        metadataBytes(input) >
   146	          RUNSC_SANDBOX_CREDENTIAL_LIMITS_V1.maxMetadataBytes
   147	      ) {
   148	        throw runscRuntimeError(
   149	          REMOTE_WORKER_ERROR_CODES_V1.secretReferenceRejected,
   150	          "remote-worker credential reference was rejected",
   151	        );
   152	      }
   153	
   154	      const leases: SandboxCredentialSecretPayloadLeaseV1[] = [];
   155	      const fields: ResolvedInvocationCredentialFieldV1[] = [];
   156	      let totalSecretBytes = 0;
   157	      try {
   158	        for (const reference of input.references) {
   159	          if (reference.ref.executionId !== input.invocationId) {
   160	            throw new Error("credential execution mismatch");
   161	          }
   162	          const binding = options.bindings.require(
   163	            trustedBindingId(reference.ref.bindingId),
   164	          );
   165	          const provider = options.providers.require(
   166	            trustedProviderId(reference.ref.providerId),
   167	          );
   168	          if (
   169	            binding.id !== reference.ref.bindingId ||
   170	            binding.providerId !== reference.ref.providerId ||
   171	            provider.id !== reference.ref.providerId ||
   172	            provider.category === "llm" ||
   173	            binding.consumer.trust !== "untrusted" ||
   174	            !ALLOWED_SANDBOX_CREDENTIAL_CONSUMERS.has(binding.consumer.kind) ||
   175	            binding.delivery !== "sandbox-pipe" ||
   176	            binding.sandbox?.credentialChannel !== "fd-3"
   177	          ) {
   178	            throw new Error("credential binding rejected");
   179	          }
   180	          const requestedFieldIds = new Set(
   181	            reference.fields.map((field) => field.fieldId),
   182	          );
   183	          const allowedFieldIds = new Set<string>(binding.allowedFieldIds);
   184	          if (
   185	            requestedFieldIds.size !== reference.fields.length ||
   186	            [...requestedFieldIds].some(
   187	              (fieldId) => !allowedFieldIds.has(fieldId),
   188	            )
   189	          ) {
   190	            throw new Error("credential field rejected");
   191	          }
   192	
   193	          const trustedRef = Object.freeze({
   194	            contractVersion: "boring.provider-credential-ref.v1" as const,
   195	            providerId: binding.providerId,
   196	            executionId: input.invocationId,
   197	            bindingId: binding.id,
   198	          });
   199	          const lease = await options.payloadResolver.resolveForDelivery(
   200	            input.credentialScope,
   201	            {
   202	              contractVersion: "boring.sandbox-credential-delivery.v1",
   203	              workspaceId: input.workspaceId,
   204	              sandboxId: input.sandboxId,
   205	              executionId: input.invocationId,
   206	              deliveryAttemptId: reference.deliveryAttemptId,
   207	              ref: trustedRef,
   208	            },
   209	          );
   210	          leases.push(lease);
   211	          const payload = lease.payload;
   212	          if (
   213	            payload.contractVersion !==
   214	              "boring.sandbox-credential-secret-payload.v1" ||
   215	            runscCredentialPayloadMetadataBytesV1(payload) >
   216	              RUNSC_SANDBOX_CREDENTIAL_LIMITS_V1.maxMetadataBytes ||
   217	            payload.workspaceId !== input.workspaceId ||
   218	            payload.sandboxId !== input.sandboxId ||
   219	            payload.executionId !== input.invocationId ||
   220	            payload.deliveryAttemptId !== reference.deliveryAttemptId ||
   221	            payload.bindingId !== binding.id ||
   222	            !Number.isSafeInteger(payload.credentialVersion) ||
   223	            payload.credentialVersion <= 0 ||
   224	            !Number.isFinite(Date.parse(payload.expiresAt)) ||
   225	            Date.parse(payload.expiresAt) <= input.nowMs
   226	          ) {
   227	            throw new Error("credential payload scope rejected");
   228	          }
   229	          if (
   230	            payload.fields.length >
   231	              RUNSC_SANDBOX_CREDENTIAL_LIMITS_V1.maxFields ||
   232	            payload.fields.length !== requestedFieldIds.size
   233	          ) {
   234	            throw new Error("credential payload fields rejected");
   235	          }
   236	          const providerFields = new Map(
   237	            providerCredentialFields(provider).map((field) => [
   238	              field.id,
   239	              field,
   240	            ]),
   241	          );
   242	          const payloadFields = new Map<string, Uint8Array>(
   243	            payload.fields.map((field) => [field.fieldId, field.value]),
   244	          );
   245	          if (payloadFields.size !== payload.fields.length) {
   246	            throw new Error("credential payload fields rejected");
   247	          }
   248	          for (const payloadField of payload.fields) {
   249	            const definition = providerFields.get(payloadField.fieldId);
   250	            if (
   251	              !requestedFieldIds.has(payloadField.fieldId) ||
   252	              !(payloadField.value instanceof Uint8Array) ||
   253	              !definition ||
   254	              payloadField.value.byteLength > definition.maxBytes ||
   255	              payloadField.value.byteLength < (definition.minBytes ?? 0)
   256	            ) {
   257	              throw new Error("credential payload field rejected");
   258	            }
   259	            totalSecretBytes += payloadField.value.byteLength;
   260	            if (
   261	              totalSecretBytes >
   262	              RUNSC_SANDBOX_CREDENTIAL_LIMITS_V1.maxTotalBytes
   263	            ) {
   264	              throw new Error("credential payload exceeds aggregate bound");
   265	            }
   266	          }
   267	          for (const requested of reference.fields) {
   268	            const value = payloadFields.get(requested.fieldId);
   269	            if (!(value instanceof Uint8Array)) {
   270	              throw new Error("credential payload field missing");
   271	            }
   272	            fields.push({
   273	              bindingId: binding.id,
   274	              fieldId: requested.fieldId,
   275	              name: requested.name,
   276	              value,
   277	            });
   278	          }
   279	        }
   280	        return { fields, leases };
   281	      } catch (error) {
   282	        for (const lease of leases) {
   283	          try {
   284	            lease.dispose();
   285	          } catch {
   286	            // Resolver errors stay on the trusted side of the boundary.
   287	          }
   288	        }
   289	        throw runscRuntimeError(
   290	          REMOTE_WORKER_ERROR_CODES_V1.secretReferenceRejected,
   291	          "remote-worker credential reference was rejected",
   292	          error,
   293	        );
   294	      }
   295	    },
   296	  });
   297	}
     1	import {
     2	  REMOTE_WORKER_CREDENTIAL_NAME_MAX_BYTES_V1,
     3	  REMOTE_WORKER_ERROR_CODES_V1,
     4	  RemoteWorkerExecRequestSchemaV1,
     5	  type RemoteWorkerExecRequestV1,
     6	} from "../../../shared/remoteWorkerProtocolV1";
