   106	async function assertBwrapAvailable(): Promise<void> {
   107	  await new Promise<void>((resolvePromise, rejectPromise) => {
   108	    const child = spawn('bwrap', ['--version'], { stdio: 'ignore' })
   109	    let settled = false
