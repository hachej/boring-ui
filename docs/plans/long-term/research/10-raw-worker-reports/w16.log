   114	      sandboxId: payload.sandboxId,
   115	      executionId: payload.executionId,
   116	      deliveryAttemptId: payload.deliveryAttemptId,
   117	      bindingId: payload.bindingId,
   118	      credentialVersion: payload.credentialVersion,
   119	      expiresAt: payload.expiresAt,
   120	      fields: payload.fields.map((field) => ({
   121	        fieldId: field.fieldId,
   122	        byteLength: field.value.byteLength,
   123	      })),
   124	    }),
   125	  ).byteLength;
