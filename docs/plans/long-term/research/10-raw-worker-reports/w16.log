    27	function validateWorkspaceRoot(workspaceRoot: string): void {
    28	  if (workspaceRoot.length === 0) {
    29	    throw new Error('workspaceRoot must not be empty')
    30	  }
    31	
    32	  if (!isAbsolute(workspaceRoot)) {
    33	    throw new Error('workspaceRoot must be an absolute path')
    34	  }
    35	
    36	  for (const segment of workspaceRoot.split('/')) {
    37	    if (segment === '.' || segment === '..') {
    38	      throw new Error('workspaceRoot must not contain traversal segments')
    39	    }
    40	  }
    41	
    42	  if (workspaceRoot.includes('\0')) {
    43	    throw new Error('workspaceRoot must not contain null bytes')
    44	  }
    45	
    46	  if (workspaceRoot.includes('\n') || workspaceRoot.includes('\r')) {
    47	    throw new Error('workspaceRoot must not contain newlines')
    48	  }
    49	
    50	  if (Buffer.byteLength(workspaceRoot, 'utf8') > MAX_WORKSPACE_ROOT_LENGTH) {
    51	    throw new Error('workspaceRoot exceeds max path length')
    52	  }
    53	}
