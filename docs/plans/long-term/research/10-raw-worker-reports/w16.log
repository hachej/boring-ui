     8	import { runscRuntimeError } from "./errors";
     9	import { encodeBoundedJson } from "./jsonEnvelope";
    10	import {
    11	  RUNSC_RUNTIME_LIMITS_V1,
    12	  boundedPositiveInteger,
    13	  boundedUtf8Bytes,
    14	} from "./limits";
    15	
    16	const envNamePattern = /^[A-Za-z_][A-Za-z0-9_]*$/;
    17	const utf8Encoder = new TextEncoder();
    18	const invocationFrameMagic = new Uint8Array([0x42, 0x52, 0x49, 0x31]);
    19	const credentialFrameMagic = new Uint8Array([0x42, 0x52, 0x43, 0x31]);
    20	const reservedNames = new Set([
    21	  "BASH_ENV",
    22	  "DOCKER_CONFIG",
    23	  "DOCKER_HOST",
    24	  "ENV",
    25	  "HOME",
    26	  "IFS",
    27	  "LD_LIBRARY_PATH",
    28	  "LD_PRELOAD",
    29	  "NODE_OPTIONS",
    30	  "PATH",
    31	  "PWD",
    32	  "PYTHONHOME",
    33	  "PYTHONPATH",
    34	  "SHELL",
    35	  "_",
    36	]);
    37	
    38	export const RUNSC_RUNTIME_RESERVED_ENV_NAMES_V1 = Object.freeze([
    39	  ...reservedNames,
    40	]);
    41	
    42	function validateEnvName(name: string): void {
    43	  if (
    44	    !envNamePattern.test(name) ||
    45	    reservedNames.has(name) ||
    46	    name.startsWith("BORING_")
    47	  ) {
    48	    throw runscRuntimeError(
    49	      REMOTE_WORKER_ERROR_CODES_V1.secretReferenceRejected,
    50	      "remote-worker invocation env name is not allowed",
    51	    );
    52	  }
    53	}
    54	
    55	function encodeCredentialFrame(
    56	  fields: readonly ResolvedInvocationCredentialFieldV1[],
    57	): Uint8Array {
    58	  if (fields.length === 0) return new Uint8Array();
    59	  if (fields.length > 16) {
    60	    throw runscRuntimeError(
    61	      REMOTE_WORKER_ERROR_CODES_V1.secretReferenceRejected,
    62	      "remote-worker credential field count exceeds its bound",
    63	    );
    64	  }
    65	  const encodedNames = fields.map((field) => utf8Encoder.encode(field.name));
    66	  let size = 6;
    67	  for (let index = 0; index < fields.length; index += 1) {
    68	    const name = encodedNames[index]!;
    69	    const value = fields[index]!.value;
    70	    if (
    71	      name.byteLength === 0 ||
    72	      name.byteLength > REMOTE_WORKER_CREDENTIAL_NAME_MAX_BYTES_V1 ||
    73	      value.byteLength > RUNSC_RUNTIME_LIMITS_V1.maxEnvValueBytes
    74	    ) {
    75	      throw runscRuntimeError(
    76	        REMOTE_WORKER_ERROR_CODES_V1.secretReferenceRejected,
    77	        "remote-worker credential field exceeds its bound",
    78	      );
    79	    }
    80	    size += 6 + name.byteLength + value.byteLength;
    81	  }
    82	  if (size > RUNSC_RUNTIME_LIMITS_V1.maxEnvelopeBytes) {
    83	    throw runscRuntimeError(
    84	      REMOTE_WORKER_ERROR_CODES_V1.secretReferenceRejected,
    85	      "remote-worker credential frame exceeds its bound",
    86	    );
    87	  }
    88	  const frame = new Uint8Array(size);
    89	  frame.set(credentialFrameMagic, 0);
    90	  const view = new DataView(frame.buffer);
    91	  view.setUint16(4, fields.length, false);
    92	  let offset = 6;
    93	  for (let index = 0; index < fields.length; index += 1) {
    94	    const name = encodedNames[index]!;
    95	    const value = fields[index]!.value;
    96	    view.setUint16(offset, name.byteLength, false);
    97	    view.setUint32(offset + 2, value.byteLength, false);
    98	    offset += 6;
    99	    frame.set(name, offset);
   100	    offset += name.byteLength;
   101	    frame.set(value, offset);
   102	    offset += value.byteLength;
   103	  }
   104	  return frame;
   105	}
   106	
   107	function encodeInvocationFrame(
   108	  metadata: Uint8Array,
   109	  credentials: Uint8Array,
   110	): Uint8Array {
   111	  const size = 12 + metadata.byteLength + credentials.byteLength;
   112	  if (size > RUNSC_RUNTIME_LIMITS_V1.maxEnvelopeBytes) {
   113	    credentials.fill(0);
   114	    throw runscRuntimeError(
   115	      REMOTE_WORKER_ERROR_CODES_V1.requestInvalid,
   116	      "remote-worker invocation frame exceeds its bound",
   117	    );
   118	  }
   119	  const frame = new Uint8Array(size);
   120	  frame.set(invocationFrameMagic, 0);
   121	  const view = new DataView(frame.buffer);
   122	  view.setUint32(4, metadata.byteLength, false);
   123	  view.setUint32(8, credentials.byteLength, false);
   124	  frame.set(metadata, 12);
   125	  frame.set(credentials, 12 + metadata.byteLength);
   126	  credentials.fill(0);
   127	  return frame;
   128	}
