+import { mkdtemp, rm } from "node:fs/promises"
+import { tmpdir } from "node:os"
+import { join } from "node:path"
+
+async function main() {
+  const auditRoot = await mkdtemp(join(tmpdir(), "prompt-audit-"))
+  const root = "/home/ubuntu/projects/boring-ui-v2"
+  process.env.PI_CODING_AGENT_DIR = join(auditRoot, ".pi", "agent")
+  process.env.PI_CODING_AGENT_SESSION_DIR = join(auditRoot, ".pi", "agent", "sessions")
+  process.env.EARENDIL_WORKS_PI_CODING_AGENT_DIR = join(auditRoot, ".pi", "agent")
+  process.env.EARENDIL_WORKS_PI_CODING_AGENT_SESSION_DIR = join(auditRoot, ".pi", "agent", "sessions")
+  process.env.BORING_AGENT_SESSION_ROOT = join(auditRoot, ".pi", "agent", "sessions")
+  const { createAgentApp } = await import("/home/ubuntu/projects/boring-ui-v2/packages/agent/src/server/createAgentApp.ts")
+  const pi = await import("/home/ubuntu/projects/boring-ui-v2/node_modules/@mariozechner/pi-coding-agent/dist/index.js")
+  console.log(JSON.stringify({ envAgentDir: (pi as any).ENV_AGENT_DIR, envSessionDir: (pi as any).ENV_SESSION_DIR, agentDir: (pi as any).getAgentDir() }))
+  const app = await createAgentApp({ workspaceRoot: root, mode: "direct", logger: false })
+  const created = await app.inject({ method: "POST", url: "/api/v1/agent/pi-chat/sessions", payload: { title: "Audit" } })
+  console.log(JSON.stringify({ createdStatus: created.statusCode, createdBody: created.body.slice(0, 300) }))
+  const sessionId = JSON.parse(created.body).id
+  const post = await app.inject({
+    method: "POST",
+    url: `/api/v1/agent/pi-chat/${sessionId}/prompt`,
+    payload: {
+      message: "ok",
+      clientNonce: "audit",
+      model: { provider: "anthropic", id: "claude-haiku-4-5-20251001" },
+    },
+  })
+  console.log(JSON.stringify({ postStatus: post.statusCode, postBody: post.body.slice(0, 300) }))
+  const res = await app.inject({ method: "GET", url: `/api/v1/agent/sessions/${sessionId}/system-prompt` })
+  const p = JSON.parse(res.body).systemPrompt ?? ""
+  console.log(JSON.stringify({
+    status: res.statusCode,
+    chars: p.length,
+    bytes: Buffer.byteLength(p),
+    lines: p.split("\n").length,
+    approxTokens: Math.ceil(p.length / 4),
+    sections: {
+      piDocs: p.indexOf("Pi documentation"),
+      project: p.indexOf("<project_context>"),
+      skills: p.indexOf("<skills>"),
+      cwd: p.lastIndexOf("Current working directory:"),
+    },
+  }))
+  const appendStart = p.indexOf("\n\n## Workspace paths")
+  const toolsStart = p.indexOf("Available tools:")
+  const toolsEnd = p.indexOf("\n\nIn addition to the tools above")
+  const guidelinesStart = p.indexOf("Guidelines:")
+  const guidelinesEnd = p.indexOf("\n\nPi documentation")
+  const docsStart = p.indexOf("Pi documentation")
+  console.log(JSON.stringify({
+    sectionChars: {
+      replacedByCustomPrompt: appendStart,
+      persona: toolsStart,
+      toolCatalog: toolsEnd - toolsStart,
+      bridge: guidelinesStart - toolsEnd,
+      guidelines: guidelinesEnd - guidelinesStart,
+      piDocs: appendStart - docsStart,
+      retainedAppendAndCwd: p.length - appendStart,
+    },
+  }))
+  console.log(p)
+  await app.close()
+  await rm(auditRoot, { recursive: true, force: true })
+}
+
+void main()
