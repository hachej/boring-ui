index 0000000000000000000000000000000000000000..1c625480d39362a25d61bb43bbb74e9cdd427a88
--- /dev/null
+++ b//tmp/prompt-audit.mts
@@ -0,0 +1,42 @@
+import { mkdtemp, rm } from "node:fs/promises"
+import { tmpdir } from "node:os"
+import { join } from "node:path"
+import { createAgentApp } from "/home/ubuntu/projects/boring-ui-v2/packages/agent/src/server/createAgentApp.ts"
+
+async function main() {
+  const root = await mkdtemp(join(tmpdir(), "prompt-audit-"))
+  process.env.PI_CODING_AGENT_DIR = join(root, ".pi", "agent")
+  const app = await createAgentApp({ workspaceRoot: root, mode: "direct", logger: false })
+  const created = await app.inject({ method: "POST", url: "/api/v1/agent/pi-chat/sessions", payload: { title: "Audit" } })
+  console.log(JSON.stringify({ createdStatus: created.statusCode, createdBody: created.body.slice(0, 300) }))
+  const sessionId = JSON.parse(created.body).id
+  const post = await app.inject({
+    method: "POST",
+    url: `/api/v1/agent/pi-chat/${sessionId}/prompt`,
+    payload: {
+      message: "ok",
+      clientNonce: "audit",
+      model: { provider: "anthropic", id: "claude-haiku-4-5-20251001" },
+    },
+  })
+  console.log(JSON.stringify({ postStatus: post.statusCode, postBody: post.body.slice(0, 300) }))
+  const res = await app.inject({ method: "GET", url: `/api/v1/agent/sessions/${sessionId}/system-prompt` })
+  const p = JSON.parse(res.body).systemPrompt ?? ""
+  console.log(JSON.stringify({
+    status: res.statusCode,
+    chars: p.length,
+    bytes: Buffer.byteLength(p),
+    lines: p.split("\n").length,
+    approxTokens: Math.ceil(p.length / 4),
+    sections: {
+      piDocs: p.indexOf("Pi documentation"),
+      project: p.indexOf("<project_context>"),
+      skills: p.indexOf("<skills>"),
+      cwd: p.lastIndexOf("Current working directory:"),
+    },
+  }))
+  await app.close()
+  await rm(root, { recursive: true, force: true })
+}
+
+void main()
