  }

  get latestSeq(): number {
    return this.seq
  }

  mapSynthetic<T extends Omit<PiChatEvent, 'seq'>>(event: T): T & { seq: number } {
    return this.event(event)
  }

  map(event: AgentSessionEvent | unknown): PiChatEvent[] {
