            success: event.success === true,
            attempt: numberValue(event.attempt) ?? 0,
            finalError: optionalString(event.finalError),
          }),
        ]

      case 'ui_command':
      case 'ui-command':
        return [this.event({ type: 'ui-command', command: event.command ?? event.data ?? {}, displayOnly: true })]

      default:
        return []
    }
  }

