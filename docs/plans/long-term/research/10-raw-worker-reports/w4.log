      case 'message_start':
        return this.mapMessageStart(event)

      case 'message_update':
        return this.mapMessageUpdate(event)

      case 'message_end':
        return this.mapMessageEnd(event)

      case 'tool_execution_end':
        return this.mapToolExecutionEnd(event)

      case 'queue_update':
