+  waitForIdle(): Promise<void>;
+  reset(): void;
+  prompt(message: AgentMessage | AgentMessage[]): Promise<void>;
+  prompt(input: string, images?: ImageContent[]): Promise<void>;
+  continue(): Promise<void>;
+}
