+  ".": "./dist/index.*",
+  "./compat": "./dist/compat.*",
+  "./providers/*": "./dist/providers/*.*",
+  "./api/*": "./dist/api/*.*",
+  "./oauth": "./dist/oauth.*",
+  "./bedrock-provider": "./dist/bedrock-provider.*"
+}
+
+// @earendil-works/pi-coding-agent
+exports = {
+  ".": { types: "./dist/index.d.ts", import: "./dist/index.js" },
+  "./rpc-entry": { import: "./dist/rpc-entry.js" }
+}
