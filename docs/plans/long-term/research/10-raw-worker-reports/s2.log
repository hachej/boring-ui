+import test from "node:test";
+import assert from "node:assert/strict";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { Session } from "@earendil-works/pi-agent-core";
+import { HostSessionStorage } from "../src/host-session-storage.js";
+
+test("replays host records into a fresh SessionStorage instance", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "host-storage-test-"));
+  const path = join(dir, "records.jsonl");
+  try {
+    const firstStorage = await HostSessionStorage.create(path, {
+      id: "test-session",
+      createdAt: "2026-08-11T00:00:00.000Z",
+    });
+    const first = new Session(firstStorage);
+    await first.appendMessage({ role: "user", content: [{ type: "text", text: "hello" }], timestamp: 1 });
+    await first.appendMessage({
+      role: "assistant",
+      content: [{ type: "text", text: "world" }],
+      api: "google-generative-ai",
+      provider: "google",
+      model: "gemini-2.5-flash",
+      usage: { input: 1, output: 1, cacheRead: 0, cacheWrite: 0, totalTokens: 2, cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 } },
+      stopReason: "stop",
+      timestamp: 2,
+    });
+
+    const reopened = new Session(await HostSessionStorage.open(path));
+    const context = await reopened.buildContext();
+    assert.deepEqual(context.messages.map((message) => message.role), ["user", "assistant"]);
+    assert.equal(context.messages[1].content[0].text, "world");
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});

