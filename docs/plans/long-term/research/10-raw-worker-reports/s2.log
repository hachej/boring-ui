+import { mkdtemp, readdir, readFile, rm, stat } from "node:fs/promises";
+import { tmpdir, homedir } from "node:os";
+import { join } from "node:path";
+import { spawn } from "node:child_process";
+
+async function snapshotTree(root) {
+  const result = {};
+  async function walk(path, relative) {
+    let names;
+    try {
+      names = await readdir(path);
+    } catch (error) {
+      if (error.code === "ENOENT") return;
+      throw error;
+    }
+    for (const name of names.sort()) {
+      const absolute = join(path, name);
+      const rel = join(relative, name);
+      const info = await stat(absolute);
+      if (info.isDirectory()) await walk(absolute, rel);
+      else result[rel] = { size: info.size, mtimeMs: info.mtimeMs };
+    }
+  }
+  await walk(root, "");
+  return result;
+}
+
+function runWorker(recordPath, turn) {
+  return new Promise((resolve, reject) => {
+    const child = spawn(process.execPath, [join(import.meta.dirname, "turn-worker.js"), recordPath, turn], {
+      cwd: process.cwd(),
+      env: process.env,
+      stdio: ["ignore", "pipe", "pipe"],
+    });
+    let stdout = "";
+    let stderr = "";
+    child.stdout.on("data", (chunk) => { stdout += chunk; });
+    child.stderr.on("data", (chunk) => { stderr += chunk; });
+    child.on("error", reject);
+    child.on("close", (code) => {
+      if (code !== 0) reject(new Error(`worker ${turn} exited ${code}:\n${stderr}${stdout}`));
+      else resolve(JSON.parse(stdout.trim()));
+    });
+  });
+}
+
+const scratch = await mkdtemp(join(tmpdir(), "pi-host-storage-"));
+const recordPath = join(scratch, "host-records.jsonl");
+const piDefaultRoot = join(homedir(), ".pi", "agent", "sessions");
+
+try {
+  const before = await snapshotTree(piDefaultRoot);
+  const first = await runWorker(recordPath, "1");
+  const afterFirst = await snapshotTree(piDefaultRoot);
+  const second = await runWorker(recordPath, "2");
+  const afterSecond = await snapshotTree(piDefaultRoot);
+  const records = (await readFile(recordPath, "utf8")).trim().split("\n").map(JSON.parse);
+
+  if (first.pid === second.pid) throw new Error("turns unexpectedly ran in the same process");
+  if (first.text.trim() !== "STORED ORCHID-7319") throw new Error(`unexpected first reply: ${first.text}`);
+  if (second.text.trim() !== "ORCHID-7319") throw new Error(`continuity failed: ${second.text}`);
+  if (JSON.stringify(before) !== JSON.stringify(afterFirst)) throw new Error("pi default session tree changed after turn 1");
+  if (JSON.stringify(before) !== JSON.stringify(afterSecond)) throw new Error("pi default session tree changed after turn 2");
+
+  console.log(JSON.stringify({
+    pinned: {
+      agentCore: "0.80.7",
+      piAi: "0.80.7",
+      model: "google/gemini-2.5-flash",
+    },
+    first,
+    second,
+    processBoundaryProved: first.pid !== second.pid,
+    defaultSessionRoot: piDefaultRoot,
+    defaultSessionSnapshotBefore: before,
+    defaultSessionSnapshotAfterFirst: afterFirst,
+    defaultSessionSnapshotAfterSecond: afterSecond,
+    defaultSessionTreeUnchanged: JSON.stringify(before) === JSON.stringify(afterSecond),
+    hostRecordCount: records.length,
+    hostRecordOperations: records.map((record) => record.op),
+  }, null, 2));
+} finally {
+  await rm(scratch, { recursive: true, force: true });
+}
diff --git a/spike-pi-storage/src/turn-worker.js b/spike-pi-storage/src/turn-worker.js
