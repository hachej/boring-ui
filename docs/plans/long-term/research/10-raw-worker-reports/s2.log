+    "turn": "2",
+    "mode": "faux",
+    "text": "ORCHID-7319",
+    "stopReason": "stop",
+    "entryCount": 4,
+    "leafId": "d06b6b0f-37b0-42ee-9980-f77a41819724"
+  },
+  "processBoundaryProved": true,
