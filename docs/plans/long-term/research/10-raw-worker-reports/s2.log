diff --git a/spike-pi-storage/scripts/run-two-process-proof.sh b/spike-pi-storage/scripts/run-two-process-proof.sh
new file mode 100644
index 0000000000000000000000000000000000000000..c4b4f7f686c2d7bd048fc8996176f8b1429b89a8
--- /dev/null
