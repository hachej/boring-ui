diff --git a/spike-pi-storage/src/host-session-storage.js b/spike-pi-storage/src/host-session-storage.js
new file mode 100644
index 0000000000000000000000000000000000000000..e9db0a333379e54688e4ded9ba6848ed5ee602ae
--- /dev/null
+++ b/spike-pi-storage/src/host-session-storage.js
@@ -0,0 +1,100 @@
+import { appendFile, readFile } from "node:fs/promises";
+import { randomUUID } from "node:crypto";
+
+/**
+ * Minimal host-owned SessionStorage. Pi sees only this interface; the JSONL
+ * record stream is owned by the embedding host and is replayed into Maps.
+ */
+export class HostSessionStorage {
+  constructor({ recordPath, metadata, entries = [], leafId = null }) {
+    this.recordPath = recordPath;
+    this.metadata = metadata;
+    this.entries = [...entries];
+    this.byId = new Map(entries.map((entry) => [entry.id, entry]));
+    this.leafId = leafId;
+  }
+
+  static async create(recordPath, metadata) {
+    const storage = new HostSessionStorage({ recordPath, metadata });
+    await storage.write({ op: "metadata", metadata });
+    return storage;
+  }
+
+  static async open(recordPath) {
+    const input = await readFile(recordPath, "utf8");
+    let metadata;
+    let leafId = null;
+    const entries = [];
+    for (const line of input.split("\n")) {
+      if (!line) continue;
+      const record = JSON.parse(line);
+      if (record.op === "metadata") metadata = record.metadata;
+      if (record.op === "entry") entries.push(record.entry);
+      if (record.op === "leaf") leafId = record.leafId;
+    }
+    if (!metadata) throw new Error("host record stream has no metadata record");
+    return new HostSessionStorage({ recordPath, metadata, entries, leafId });
+  }
+
+  async write(record) {
+    await appendFile(this.recordPath, `${JSON.stringify(record)}\n`, "utf8");
+  }
+
+  async getMetadata() {
+    return this.metadata;
+  }
+
+  async getLeafId() {
+    return this.leafId;
+  }
+
+  async setLeafId(leafId) {
+    this.leafId = leafId;
+    await this.write({ op: "leaf", leafId });
+  }
+
+  async createEntryId() {
+    return randomUUID();
+  }
+
+  async appendEntry(entry) {
+    this.entries.push(entry);
+    this.byId.set(entry.id, entry);
+    await this.write({ op: "entry", entry });
+  }
+
+  async getEntry(id) {
+    return this.byId.get(id);
+  }
+
+  async findEntries(type) {
+    return this.entries.filter((entry) => entry.type === type);
+  }
+
+  async getLabel(id) {
+    let label;
+    for (const entry of this.entries) {
+      if (entry.type === "label" && entry.targetId === id) label = entry.label;
+    }
+    return label || undefined;
+  }
+
+  async getPathToRoot(leafId) {
+    const path = [];
+    let cursor = leafId;
+    const seen = new Set();
+    while (cursor !== null) {
+      if (seen.has(cursor)) throw new Error(`cycle in host session at ${cursor}`);
+      seen.add(cursor);
+      const entry = this.byId.get(cursor);
+      if (!entry) throw new Error(`missing host session entry ${cursor}`);
+      path.push(entry);
+      cursor = entry.parentId;
+    }
+    return path.reverse();
+  }
+
+  async getEntries() {
+    return [...this.entries];
+  }
+}
diff --git a/spike-pi-storage/src/run-spike.js b/spike-pi-storage/src/run-spike.js
new file mode 100644
index 0000000000000000000000000000000000000000..7c9fb4d040b365c17e8d3318084846adc3e50688
--- /dev/null
+++ b/spike-pi-storage/src/run-spike.js
@@ -0,0 +1,84 @@
+import { mkdtemp, readdir, readFile, rm, stat } from "node:fs/promises";
+import { tmpdir, homedir } from "node:os";
+import { join } from "node:path";
+import { spawn } from "node:child_process";
+
+async function snapshotTree(root) {
+  const result = {};
+  async function walk(path, relative) {
+    let names;
+    try {
+      names = await readdir(path);
+    } catch (error) {
+      if (error.code === "ENOENT") return;
+      throw error;
+    }
+    for (const name of names.sort()) {
+      const absolute = join(path, name);
+      const rel = join(relative, name);
+      const info = await stat(absolute);
+      if (info.isDirectory()) await walk(absolute, rel);
+      else result[rel] = { size: info.size, mtimeMs: info.mtimeMs };
+    }
+  }
+  await walk(root, "");
+  return result;
+}
+
+function runWorker(recordPath, turn) {
+  return new Promise((resolve, reject) => {
+    const child = spawn(process.execPath, [join(import.meta.dirname, "turn-worker.js"), recordPath, turn], {
+      cwd: process.cwd(),
+      env: process.env,
+      stdio: ["ignore", "pipe", "pipe"],
+    });
+    let stdout = "";
+    let stderr = "";
+    child.stdout.on("data", (chunk) => { stdout += chunk; });
+    child.stderr.on("data", (chunk) => { stderr += chunk; });
+    child.on("error", reject);
+    child.on("close", (code) => {
+      if (code !== 0) reject(new Error(`worker ${turn} exited ${code}:\n${stderr}${stdout}`));
+      else resolve(JSON.parse(stdout.trim()));
+    });
+  });
+}
+
+const scratch = await mkdtemp(join(tmpdir(), "pi-host-storage-"));
+const recordPath = join(scratch, "host-records.jsonl");
+const piDefaultRoot = join(homedir(), ".pi", "agent", "sessions");
+
+try {
+  const before = await snapshotTree(piDefaultRoot);
+  const first = await runWorker(recordPath, "1");
+  const afterFirst = await snapshotTree(piDefaultRoot);
+  const second = await runWorker(recordPath, "2");
+  const afterSecond = await snapshotTree(piDefaultRoot);
+  const records = (await readFile(recordPath, "utf8")).trim().split("\n").map(JSON.parse);
+
+  if (first.pid === second.pid) throw new Error("turns unexpectedly ran in the same process");
+  if (first.text.trim() !== "STORED ORCHID-7319") throw new Error(`unexpected first reply: ${first.text}`);
+  if (second.text.trim() !== "ORCHID-7319") throw new Error(`continuity failed: ${second.text}`);
+  if (JSON.stringify(before) !== JSON.stringify(afterFirst)) throw new Error("pi default session tree changed after turn 1");
+  if (JSON.stringify(before) !== JSON.stringify(afterSecond)) throw new Error("pi default session tree changed after turn 2");
+
+  console.log(JSON.stringify({
+    pinned: {
+      agentCore: "0.80.7",
+      piAi: "0.80.7",
+      model: "google/gemini-2.5-flash",
+    },
+    first,
+    second,
+    processBoundaryProved: first.pid !== second.pid,
+    defaultSessionRoot: piDefaultRoot,
+    defaultSessionSnapshotBefore: before,
+    defaultSessionSnapshotAfterFirst: afterFirst,
+    defaultSessionSnapshotAfterSecond: afterSecond,
+    defaultSessionTreeUnchanged: JSON.stringify(before) === JSON.stringify(afterSecond),
+    hostRecordCount: records.length,
+    hostRecordOperations: records.map((record) => record.op),
+  }, null, 2));
+} finally {
+  await rm(scratch, { recursive: true, force: true });
+}
diff --git a/spike-pi-storage/src/turn-worker.js b/spike-pi-storage/src/turn-worker.js
new file mode 100644
index 0000000000000000000000000000000000000000..46f6572b6aecb5f73a7c3241a73b14b83763f0c1
--- /dev/null
+++ b/spike-pi-storage/src/turn-worker.js
@@ -0,0 +1,47 @@
+import { AgentHarness, Session } from "@earendil-works/pi-agent-core";
+import { NodeExecutionEnv } from "@earendil-works/pi-agent-core/node";
+import { builtinModels } from "@earendil-works/pi-ai/providers/all";
+import { HostSessionStorage } from "./host-session-storage.js";
+
+const [recordPath, turn] = process.argv.slice(2);
+if (!recordPath || !turn) throw new Error("usage: turn-worker.js RECORD_PATH TURN");
+if (!process.env.GEMINI_API_KEY) throw new Error("GEMINI_API_KEY is required");
+
+const metadata = { id: "host-session-1", createdAt: "2026-08-11T00:00:00.000Z" };
+const storage = turn === "1"
+  ? await HostSessionStorage.create(recordPath, metadata)
+  : await HostSessionStorage.open(recordPath);
+const session = new Session(storage);
+const models = builtinModels();
+const model = models.getModel("google", "gemini-2.5-flash");
+if (!model) throw new Error("google/gemini-2.5-flash is absent from pinned pi-ai catalog");
+
+const env = new NodeExecutionEnv({ cwd: process.cwd(), shellEnv: process.env });
+const harness = new AgentHarness({
+  env,
+  session,
+  models,
+  model,
+  tools: [],
+  thinkingLevel: "off",
+  systemPrompt: "Answer briefly and exactly. This is a persistence test; do not use tools.",
+});
+
+const prompt = turn === "1"
+  ? "Remember this exact nonce for our next conversation turn: ORCHID-7319. Reply with exactly: STORED ORCHID-7319"
+  : "What exact nonce did I ask you to remember in the previous turn? Reply with exactly the nonce and nothing else.";
+const reply = await harness.prompt(prompt);
+const text = reply.content
+  .filter((part) => part.type === "text")
+  .map((part) => part.text)
+  .join("");
+
+console.log(JSON.stringify({
+  pid: process.pid,
+  turn,
+  text,
+  stopReason: reply.stopReason,
+  entryCount: (await storage.getEntries()).length,
+  leafId: await storage.getLeafId(),
+}));
+await env.cleanup();
diff --git a/spike-pi-storage/test/host-session-storage.test.js b/spike-pi-storage/test/host-session-storage.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..f62e7a36328697294af2a1a5110ab14c11a6f062
--- /dev/null
+++ b/spike-pi-storage/test/host-session-storage.test.js
@@ -0,0 +1,37 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { Session } from "@earendil-works/pi-agent-core";
+import { HostSessionStorage } from "../src/host-session-storage.js";
+
+test("replays host records into a fresh SessionStorage instance", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "host-storage-test-"));
+  const path = join(dir, "records.jsonl");
+  try {
+    const firstStorage = await HostSessionStorage.create(path, {
+      id: "test-session",
+      createdAt: "2026-08-11T00:00:00.000Z",
+    });
+    const first = new Session(firstStorage);
+    await first.appendMessage({ role: "user", content: [{ type: "text", text: "hello" }], timestamp: 1 });
+    await first.appendMessage({
+      role: "assistant",
+      content: [{ type: "text", text: "world" }],
+      api: "google-generative-ai",
+      provider: "google",
+      model: "gemini-2.5-flash",
+      usage: { input: 1, output: 1, cacheRead: 0, cacheWrite: 0, totalTokens: 2, cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 } },
+      stopReason: "stop",
+      timestamp: 2,
+    });
+
+    const reopened = new Session(await HostSessionStorage.open(path));
+    const context = await reopened.buildContext();
+    assert.deepEqual(context.messages.map((message) => message.role), ["user", "assistant"]);
+    assert.equal(context.messages[1].content[0].text, "world");
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});

