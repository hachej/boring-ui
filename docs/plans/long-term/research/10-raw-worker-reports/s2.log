+  if (JSON.stringify(before) !== JSON.stringify(afterFirst)) throw new Error("pi default session tree changed after turn 1");
+  if (JSON.stringify(before) !== JSON.stringify(afterSecond)) throw new Error("pi default session tree changed after turn 2");
+
+  console.log(JSON.stringify({
+    pinned: {
+      agentCore: "0.80.7",
+      piAi: "0.80.7",
+      model: "google/gemini-2.5-flash",
+    },
+    mode,
+    first,
+    second,
