 'use agent';
-import { useModel } from '@flue/runtime';
+import { useModel, useSandbox, useSkill, useTool } from '@flue/runtime';
+import { local } from '@flue/runtime/node';
+import codebaseQa from '../skills/codebase-qa/SKILL.md';
+import { projectFacts } from '../tools/project-facts.ts';
 
 // Every exported capitalized function in a 'use agent' module is an agent,
 // and the function's name is its durable identity. The return value is the
 // agent's system prompt.
 export function Hello() {
-	useModel('anthropic/claude-haiku-4-5');
-	return 'You are a helpful assistant. Keep replies short.';
+	useModel('google/gemini-2.5-flash');
+	useSandbox(local());
+	useTool(projectFacts);
+	useSkill(codebaseQa);
+	return 'Answer questions about the codebase in your current working directory. Cite file paths.';
 }
