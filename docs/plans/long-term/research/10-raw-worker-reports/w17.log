 const OPEN_COMMAND = "open-codebase-qa"
 
 export default function (pi: any) {
+  pi.registerTool({
+    name: "codebase_context",
+    description: "Return the current codebase root and the evidence standard for repository questions.",
+    parameters: { type: "object", properties: {}, additionalProperties: false },
+    async execute() {
+      return {
+        content: [{
+          type: "text",
+          text: `Codebase root: ${process.cwd()}. Inspect files before answering and cite their paths.`,
