--- /dev/null
+++ b/spike-dx/flue/src/tools/project-facts.ts
@@ -0,0 +1,15 @@
+import { defineTool } from '@flue/runtime';
+
+export const projectFacts = defineTool({
+	name: 'project_facts',
+	description: 'Return the project name and runtime from package.json. Use before answering repository overview questions.',
+	async run() {
+		const packageJson = await import('../../package.json', { with: { type: 'json' } });
+		return {
+			output: {
+				name: packageJson.default.name,
+				runtime: 'Flue on Node.js',
+			},
+		};
+	},
+});
