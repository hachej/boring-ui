+---
+name: codebase-qa
+description: Answer questions about the current codebase using repository evidence. Use for architecture, behavior, and file-location questions.
+---
+
+Before answering a codebase question:
+
+1. Inspect the relevant files with the read, grep, and glob tools.
+2. Use `project_facts` for repository overview questions.
+3. Separate observed facts from inferences.
+4. Cite the file paths that support the answer.
diff --git a/spike-dx/flue/src/tools/project-facts.ts b/spike-dx/flue/src/tools/project-facts.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fbb9ececc171b814c3c31398a5086371ae2efe1b
--- /dev/null
+++ b/spike-dx/flue/src/tools/project-facts.ts
@@ -0,0 +1,15 @@
+import { defineTool } from '@flue/runtime';
+
+export const projectFacts = defineTool({
+	name: 'project_facts',
+	description: 'Return the project name and runtime from package.json. Use before answering repository overview questions.',
+	async run() {
+		const packageJson = await import('../../package.json', { with: { type: 'json' } });
+		return {
+			output: {
+				name: packageJson.default.name,
+				runtime: 'Flue on Node.js',
+			},
+		};
+	},
+});
