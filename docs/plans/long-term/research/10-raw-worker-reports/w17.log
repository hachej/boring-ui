diff --git a/spike-dx/eve/reconstruction/agent/tools/project_facts.ts b/spike-dx/eve/reconstruction/agent/tools/project_facts.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8668b3ca552d9e1a39b29253ff7223a34e6f4b12
--- /dev/null
+++ b/spike-dx/eve/reconstruction/agent/tools/project_facts.ts
@@ -0,0 +1,15 @@
+import { readFile } from "node:fs/promises";
+import { defineTool } from "eve/tools";
+import { z } from "zod";
+
+export default defineTool({
+  description: "Read package.json and return the codebase package name and runtime requirement.",
+  inputSchema: z.object({}),
+  async execute() {
+    const packageJson = JSON.parse(await readFile("package.json", "utf8"));
+    return {
+      name: packageJson.name,
+      node: packageJson.engines?.node ?? "unspecified",
+    };
+  },
+});
