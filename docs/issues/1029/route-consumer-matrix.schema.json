{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "slice1Gate",
    "routes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "slice1Gate": {
      "type": "object",
      "required": ["compositionRoots", "sourceInventories"],
      "properties": {
        "compositionRoots": {
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "object",
            "required": ["id", "source", "proof", "projection", "proofLevel", "packageRoot", "testName"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 },
              "proof": { "type": "string", "minLength": 1 },
              "packageRoot": { "type": "string", "minLength": 1 },
              "testName": { "type": "string", "minLength": 1 },
              "projection": {
                "enum": ["direct", "compatibility", "delegates-to-workspace"]
              },
              "proofLevel": {
                "enum": ["exact-composed-table", "shared-exact-composed-table"]
              }
            },
            "additionalProperties": false
          }
        },
        "sourceInventories": {
          "type": "object",
          "required": ["legacyReferences", "publicServerExports", "generatedAttachmentUrls", "authorizationProof"],
          "properties": {
            "legacyReferences": {
              "type": "object",
              "required": ["count", "sha256"],
              "properties": {
                "count": { "type": "integer", "minimum": 1 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              },
              "additionalProperties": false
            },
            "publicServerExports": {
              "type": "object",
              "required": ["source", "symbols"],
              "properties": {
                "source": { "type": "string", "minLength": 1 },
                "symbols": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "additionalProperties": false
            },
            "generatedAttachmentUrls": {
              "type": "object",
              "required": ["addressed", "compatibility"],
              "properties": {
                "addressed": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "compatibility": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "additionalProperties": false
            },
            "authorizationProof": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "current",
          "final",
          "owner",
          "auth",
          "disposition",
          "consumers",
          "slice",
          "proof",
          "contract"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "current": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(GET|POST|PUT|PATCH|DELETE) /"
            }
          },
          "final": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(GET|POST|PUT|PATCH|DELETE) /"
                }
              }
            ]
          },
          "owner": {
            "enum": [
              "agent-host",
              "app-environment",
              "app-core"
            ]
          },
          "auth": {
            "enum": [
              "public",
              "authorized-scope",
              "workspace-member",
              "app-policy"
            ]
          },
          "disposition": {
            "enum": [
              "retain",
              "replace",
              "delete"
            ]
          },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "slice": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "proof": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "contract": {
            "type": "object",
            "required": [
              "request",
              "response"
            ],
            "properties": {
              "request": {
                "type": "string",
                "minLength": 1
              },
              "response": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
