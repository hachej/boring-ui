{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "finalGate",
    "routes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "finalGate": {
      "type": "object",
      "required": [
        "compositionRoots",
        "sourceInventories"
      ],
      "properties": {
        "compositionRoots": {
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "object",
            "required": [
              "id",
              "source",
              "proof",
              "projection",
              "applicableRouteIds",
              "proofLevel",
              "packageRoot",
              "testName"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "proof": {
                "type": "string",
                "minLength": 1
              },
              "packageRoot": {
                "type": "string",
                "minLength": 1
              },
              "testName": {
                "type": "string",
                "minLength": 1
              },
              "projection": {
                "enum": [
                  "direct",
                  "delegates-to-workspace"
                ]
              },
              "applicableRouteIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "proofLevel": {
                "enum": [
                  "exact-composed-table",
                  "shared-exact-composed-table"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "sourceInventories": {
          "type": "object",
          "required": [
            "forbiddenReferences",
            "publicServerExports",
            "generatedAttachmentUrls",
            "authorizationProof",
            "runtimeBridgeAuthority"
          ],
          "properties": {
            "forbiddenReferences": {
              "type": "object",
              "required": [
                "patterns",
                "count",
                "files"
              ],
              "properties": {
                "patterns": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "count": {
                  "const": 0
                },
                "files": {
                  "type": "array",
                  "maxItems": 0
                }
              },
              "additionalProperties": false
            },
            "publicServerExports": {
              "type": "object",
              "required": [
                "source",
                "symbols"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "symbols": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": false
            },
            "generatedAttachmentUrls": {
              "type": "object",
              "required": [
                "addressed"
              ],
              "properties": {
                "addressed": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": false
            },
            "authorizationProof": {
              "type": "string",
              "minLength": 1
            },
            "runtimeBridgeAuthority": {
              "type": "object",
              "required": ["disposition", "implementation", "hostProductionCallers", "publicServerExport"],
              "properties": {
                "disposition": { "const": "standalone-core-only" },
                "implementation": { "const": "packages/agent/src/core/createAgent.ts" },
                "hostProductionCallers": {
                  "type": "array",
                  "maxItems": 0
                },
                "publicServerExport": { "const": false }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "current",
          "final",
          "owner",
          "auth",
          "disposition",
          "consumers",
          "slice",
          "proof",
          "contract"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "enum": [
              "agent-host",
              "app-environment",
              "app-core"
            ]
          },
          "auth": {
            "enum": [
              "public",
              "authorized-scope",
              "workspace-member",
              "app-policy"
            ]
          },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "proof": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "contract": {
            "type": "object",
            "required": [
              "request",
              "response"
            ],
            "properties": {
              "request": {
                "type": "string",
                "minLength": 1
              },
              "response": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "current": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(GET|POST|PUT|PATCH|DELETE) /"
            }
          },
          "final": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(GET|POST|PUT|PATCH|DELETE) /"
                }
              }
            ]
          },
          "disposition": {
            "enum": [
              "retain",
              "replace",
              "delete"
            ]
          },
          "slice": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
