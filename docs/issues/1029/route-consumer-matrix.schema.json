{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "routes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "current",
          "final",
          "owner",
          "auth",
          "disposition",
          "consumers",
          "slice",
          "proof",
          "contract"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "current": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(GET|POST|PUT|PATCH|DELETE) /"
            }
          },
          "final": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(GET|POST|PUT|PATCH|DELETE) /"
                }
              }
            ]
          },
          "owner": {
            "enum": [
              "agent-host",
              "app-environment",
              "app-core"
            ]
          },
          "auth": {
            "enum": [
              "public",
              "authorized-scope",
              "workspace-member",
              "app-policy"
            ]
          },
          "disposition": {
            "enum": [
              "retain",
              "replace",
              "delete"
            ]
          },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "slice": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "proof": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "contract": {
            "type": "object",
            "required": [
              "request",
              "response"
            ],
            "properties": {
              "request": {
                "type": "string",
                "minLength": 1
              },
              "response": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
