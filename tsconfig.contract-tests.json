{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "disableSourceOfProjectReferenceRedirect": true
  },
  "include": ["examples/**/*.ts", "fixtures/**/*.ts", "lab/**/*.ts", "test/types/**/*.ts"]
}
