{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "html-viewer",
  "title": "HTML source and passive preview",
  "description": "Exact HTML source editing with a reconstructed passive preview and borrowed controller. Browser security qualification remains separate.",
  "dependencies": [
    "@hachej/boring-ui-kit@0.2.0",
    "@hachej/boring-files@0.2.0",
    "react@19.3.0",
    "react-dom@19.3.0"
  ],
  "files": [
    {
      "path": "registry/html-viewer/html-viewer.tsx",
      "content": "'use client';\n\nimport { HtmlViewer as RuntimeHtmlViewer } from '@hachej/boring-ui-kit/html-viewer';\nimport type { HtmlViewerProps } from '@hachej/boring-ui-kit/html-viewer';\n\nexport type { HtmlViewerProps } from '@hachej/boring-ui-kit/html-viewer';\n\nexport function HtmlViewer({ className, ...props }: HtmlViewerProps) {\n  return <RuntimeHtmlViewer {...props} className={['boring-html-recipe', className].filter(Boolean).join(' ')} />;\n}\n",
      "type": "registry:component",
      "target": "components/html-viewer/html-viewer.tsx"
    }
  ],
  "css": {
    ".boring-html-recipe[data-boring=\"html-viewer\"]": {
      "background": "var(--boring-html-background, var(--background, #fff))",
      "color": "var(--boring-html-foreground, var(--foreground, #111827))",
      "border": "1px solid var(--boring-html-border, var(--border, #d1d5db))",
      "border-radius": "var(--boring-html-radius, var(--radius, 0.75rem))",
      "padding": "1rem",
      "display": "grid",
      "gap": "0.75rem",
      "min-width": "0",
      "font-family": "inherit"
    },
    ".boring-html-recipe[data-boring=\"html-viewer\"] > header": {
      "display": "flex",
      "justify-content": "space-between",
      "align-items": "center",
      "flex-wrap": "wrap",
      "gap": "0.75rem"
    },
    ".boring-html-recipe[data-boring=\"html-viewer\"] [role=\"toolbar\"]": {
      "display": "flex",
      "flex-wrap": "wrap",
      "gap": "0.375rem"
    },
    ".boring-html-recipe[data-boring=\"html-viewer\"] button": {
      "font": "inherit",
      "background": "var(--boring-html-background, var(--background, #fff))",
      "color": "var(--boring-html-foreground, var(--foreground, #111827))",
      "border": "1px solid var(--boring-html-border, var(--border, #d1d5db))",
      "border-radius": "0.375rem",
      "padding": "0.375rem 0.625rem",
      "cursor": "pointer"
    },
    ".boring-html-recipe[data-boring=\"html-viewer\"] button[aria-pressed=\"true\"]": {
      "font-weight": "700",
      "text-decoration": "underline"
    },
    ".boring-html-recipe[data-boring=\"html-viewer\"] button:disabled": {
      "opacity": "0.5",
      "cursor": "not-allowed"
    },
    ".boring-html-recipe[data-boring=\"html-viewer\"] button:focus-visible, .boring-html-recipe[data-boring=\"html-viewer\"] textarea:focus-visible": {
      "outline": "2px solid var(--boring-html-focus, var(--ring, #2563eb))",
      "outline-offset": "2px"
    },
    ".boring-html-recipe[data-boring=\"html-viewer\"] .boring-html-viewer__source": {
      "box-sizing": "border-box",
      "width": "100%",
      "min-height": "18rem",
      "font-family": "monospace",
      "line-height": "1.5",
      "background": "var(--boring-html-background, var(--background, #fff))",
      "color": "var(--boring-html-foreground, var(--foreground, #111827))",
      "padding": "0.75rem",
      "border": "1px solid var(--boring-html-border, var(--border, #d1d5db))",
      "border-radius": "0.375rem",
      "resize": "vertical"
    },
    ".boring-html-recipe[data-boring=\"html-viewer\"] .boring-html-viewer__frame": {
      "box-sizing": "border-box",
      "width": "100%",
      "min-height": "18rem",
      "border": "1px solid var(--boring-html-border, var(--border, #d1d5db))",
      "border-radius": "0.375rem"
    },
    ".boring-html-recipe[data-boring=\"html-viewer\"] [role=\"status\"]": {
      "font-size": "0.875rem"
    },
    ".boring-html-recipe[data-boring=\"html-viewer\"] [role=\"alert\"]": {
      "border-inline-start": "0.25rem solid currentColor",
      "padding-inline-start": "0.75rem"
    }
  },
  "type": "registry:component"
}