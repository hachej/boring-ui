{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "markdown-editor",
  "title": "Markdown editor",
  "description": "A host-owned styled wrapper over the concrete borrowed Markdown controller.",
  "dependencies": [
    "@hachej/boring-ui-kit@^0.3.2",
    "@hachej/boring-files@^0.3.2",
    "react@^19.0.0",
    "react-dom@^19.0.0",
    "marked@^17.0.6",
    "@tiptap/core@^3.31.4",
    "@tiptap/react@^3.31.4",
    "@tiptap/pm@^3.31.4",
    "@tiptap/starter-kit@^3.31.4",
    "@tiptap/markdown@^3.31.4",
    "@tiptap/extensions@^3.31.4",
    "@tiptap/extension-list@^3.31.4",
    "@tiptap/extension-table@^3.31.4",
    "@tiptap/extension-image@^3.31.4",
    "@tiptap/extension-highlight@^3.31.4",
    "@tiptap/extension-bubble-menu@^3.31.4",
    "@tiptap/extension-floating-menu@^3.31.4"
  ],
  "registryDependencies": [
    "https://cdn.jsdelivr.net/npm/@hachej/boring-ui-kit@0.3.2/r/button.json"
  ],
  "files": [
    {
      "path": "registry/markdown-editor/markdown-editor.tsx",
      "content": "'use client';\n\nimport { MarkdownEditor as RuntimeMarkdownEditor } from '@hachej/boring-ui-kit/markdown-editor';\nimport type { MarkdownEditorProps } from '@hachej/boring-ui-kit/markdown-editor';\nimport { editorControls } from '../button/editor-controls';\n\nexport type { MarkdownEditorProps } from '@hachej/boring-ui-kit/markdown-editor';\n\nexport function MarkdownEditor({ className, ...props }: MarkdownEditorProps) {\n  return <RuntimeMarkdownEditor components={editorControls} {...props} className={['boring-markdown-recipe', className].filter(Boolean).join(' ')} />;\n}\n",
      "type": "registry:component",
      "target": "components/markdown-editor/markdown-editor.tsx"
    }
  ],
  "css": {
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"]": {
      "padding": "1rem",
      "display": "grid",
      "gap": "1rem",
      "min-width": "0"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] > header": {
      "display": "flex",
      "align-items": "center",
      "justify-content": "space-between",
      "flex-wrap": "wrap",
      "gap": "0.75rem"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] > header > strong": {
      "margin": "0"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] [role=\"toolbar\"]": {
      "display": "flex",
      "flex-wrap": "nowrap",
      "gap": "0.375rem"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-toolbar": {
      "min-width": "0",
      "overflow-x": "auto",
      "scrollbar-width": "none",
      "padding-right": "1.5rem",
      "padding-inline-end": "1.5rem"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-toolbar > *": {
      "flex-shrink": "0"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] nav[aria-label=\"Document outline\"]": {
      "padding-bottom": "0.75rem"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] nav ol": {
      "padding-left": "1.25rem",
      "margin": "0",
      "display": "grid",
      "gap": "0.25rem"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content": {
      "min-height": "12rem",
      "max-width": "75ch",
      "width": "100%",
      "margin-inline": "auto",
      "line-height": "1.7",
      "overflow-wrap": "anywhere"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content p": {
      "margin": "0.75rem 0"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content h1": {
      "font-size": "1.875rem",
      "line-height": "1.2",
      "margin": "1.25rem 0 0.75rem",
      "font-weight": "700"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content h2": {
      "font-size": "1.5rem",
      "line-height": "1.3",
      "margin": "1.25rem 0 0.75rem",
      "font-weight": "650"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content h3": {
      "font-size": "1.25rem",
      "margin": "1rem 0 0.5rem",
      "font-weight": "600"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content ul": {
      "list-style": "disc",
      "padding-left": "1.5rem"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content ol": {
      "list-style": "decimal",
      "padding-left": "1.5rem"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content ul[data-type=\"taskList\"]": {
      "list-style": "none",
      "padding-left": "0"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content li[data-type=\"taskItem\"]": {
      "display": "flex",
      "gap": "0.5rem",
      "align-items": "baseline"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content blockquote": {
      "border-left": "var(--default-border-width) solid var(--border)",
      "padding-left": "1rem",
      "margin-inline": "0",
      "color": "var(--muted-foreground)"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content pre, .boring-markdown-recipe[data-boring=\"markdown-editor\"] [data-boring=\"proposal\"] pre": {
      "overflow-x": "auto",
      "background": "var(--muted)",
      "border-radius": "var(--radius-md)",
      "padding": "0.75rem",
      "font-family": "var(--font-mono)"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content code": {
      "font-family": "var(--font-mono)",
      "font-size": "0.9em"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] > textarea": {
      "width": "100%",
      "resize": "vertical"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] [role=\"alert\"]": {
      "padding": "0.75rem",
      "overflow-wrap": "anywhere"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] [data-boring=\"proposal\"]": {
      "padding": "0.75rem"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] [data-boring=\"proposal\"] summary": {
      "cursor": "pointer"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content:focus-visible": {
      "outline": "2px solid var(--ring)",
      "outline-offset": "2px"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] [data-boring=\"proposal-diff\"]": {
      "overflow-x": "auto"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] [data-diff]": {
      "white-space": "pre-wrap",
      "overflow-wrap": "anywhere",
      "padding": "0.125rem 0.375rem"
    }
  },
  "docs": "Create and own a MarkdownController from @hachej/boring-ui-kit/markdown. Pass it to MarkdownEditor. The wrapper does not acquire resources or dispose the controller. Check the repository release notes for available npm versions; local tarball tests do not establish registry availability.",
  "type": "registry:component"
}
