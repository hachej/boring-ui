{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "markdown-editor",
  "title": "Markdown editor",
  "description": "A host-owned styled wrapper over the concrete borrowed Markdown controller.",
  "dependencies": [
    "@hachej/boring-ui-kit@1.0.0",
    "@hachej/boring-files@1.0.0",
    "react@19.3.0",
    "react-dom@19.3.0",
    "marked@17.0.6",
    "@tiptap/core@3.31.4",
    "@tiptap/react@3.31.4",
    "@tiptap/pm@3.31.4",
    "@tiptap/starter-kit@3.31.4",
    "@tiptap/markdown@3.31.4",
    "@tiptap/extensions@3.31.4",
    "@tiptap/extension-list@3.31.4",
    "@tiptap/extension-table@3.31.4",
    "@tiptap/extension-image@3.31.4",
    "@tiptap/extension-highlight@3.31.4",
    "@tiptap/extension-bubble-menu@3.31.4",
    "@tiptap/extension-floating-menu@3.31.4"
  ],
  "files": [
    {
      "path": "registry/markdown-editor/markdown-editor.tsx",
      "content": "'use client';\n\nimport { MarkdownEditor as RuntimeMarkdownEditor } from '@hachej/boring-ui-kit/markdown-editor';\nimport type { MarkdownEditorProps } from '@hachej/boring-ui-kit/markdown-editor';\n\nexport type { MarkdownEditorProps } from '@hachej/boring-ui-kit/markdown-editor';\n\nexport function MarkdownEditor({ className, ...props }: MarkdownEditorProps) {\n  return <RuntimeMarkdownEditor {...props} className={['boring-markdown-recipe', className].filter(Boolean).join(' ')} />;\n}\n",
      "type": "registry:component",
      "target": "components/markdown-editor/markdown-editor.tsx"
    }
  ],
  "css": {
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"]": {
      "background": "var(--boring-editor-background, var(--background, #fff))",
      "color": "var(--boring-editor-foreground, var(--foreground, #111827))",
      "border": "1px solid var(--boring-editor-border, var(--border, #d1d5db))",
      "border-radius": "var(--boring-editor-radius, var(--radius, 0.75rem))",
      "padding": "1rem",
      "display": "grid",
      "gap": "1rem",
      "min-width": "0",
      "font-family": "inherit"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] > header": {
      "display": "flex",
      "align-items": "center",
      "justify-content": "space-between",
      "flex-wrap": "wrap",
      "gap": "0.75rem"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] > header > strong": {
      "margin": "0",
      "font-size": "1.125rem",
      "font-weight": "600"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] [role=\"toolbar\"]": {
      "display": "flex",
      "flex-wrap": "wrap",
      "gap": "0.375rem"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] button": {
      "appearance": "none",
      "font": "inherit",
      "font-size": "0.875rem",
      "line-height": "1.4",
      "background": "var(--boring-editor-control-background, var(--background, #fff))",
      "color": "inherit",
      "border": "1px solid var(--boring-editor-border, var(--border, #d1d5db))",
      "border-radius": "0.375rem",
      "padding": "0.375rem 0.625rem",
      "cursor": "pointer"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] button[aria-pressed=\"true\"]": {
      "background": "var(--boring-editor-accent, var(--accent, #e5e7eb))",
      "font-weight": "600"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] button:disabled": {
      "opacity": "0.5",
      "cursor": "not-allowed"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] button:focus-visible, .boring-markdown-recipe[data-boring=\"markdown-editor\"] textarea:focus-visible": {
      "outline": "2px solid var(--boring-editor-focus, var(--ring, #2563eb))",
      "outline-offset": "2px"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] [role=\"status\"]": {
      "font-size": "0.875rem",
      "color": "var(--boring-editor-muted, var(--muted-foreground, #4b5563))"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] nav[aria-label=\"Document outline\"]": {
      "border-bottom": "1px solid var(--boring-editor-border, var(--border, #d1d5db))",
      "padding-bottom": "0.75rem"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] nav ol": {
      "padding-left": "1.25rem",
      "margin": "0",
      "display": "grid",
      "gap": "0.25rem"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content": {
      "min-height": "12rem",
      "max-width": "75ch",
      "width": "100%",
      "margin-inline": "auto",
      "line-height": "1.7",
      "overflow-wrap": "anywhere"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content p": {
      "margin": "0.75rem 0"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content h1": {
      "font-size": "1.875rem",
      "line-height": "1.2",
      "margin": "1.25rem 0 0.75rem",
      "font-weight": "700"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content h2": {
      "font-size": "1.5rem",
      "line-height": "1.3",
      "margin": "1.25rem 0 0.75rem",
      "font-weight": "650"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content h3": {
      "font-size": "1.25rem",
      "margin": "1rem 0 0.5rem",
      "font-weight": "600"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content ul": {
      "list-style": "disc",
      "padding-left": "1.5rem"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content ol": {
      "list-style": "decimal",
      "padding-left": "1.5rem"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content ul[data-type=\"taskList\"]": {
      "list-style": "none",
      "padding-left": "0"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content li[data-type=\"taskItem\"]": {
      "display": "flex",
      "gap": "0.5rem",
      "align-items": "baseline"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content blockquote": {
      "border-left": "3px solid var(--boring-editor-border, var(--border, #d1d5db))",
      "padding-left": "1rem",
      "margin-inline": "0",
      "color": "var(--boring-editor-muted, var(--muted-foreground, #4b5563))"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content pre, .boring-markdown-recipe[data-boring=\"markdown-editor\"] [data-boring=\"proposal\"] pre": {
      "overflow-x": "auto",
      "background": "var(--boring-editor-code-background, var(--muted, #f3f4f6))",
      "border-radius": "0.375rem",
      "padding": "0.75rem",
      "font-family": "ui-monospace, monospace"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content code": {
      "font-family": "ui-monospace, monospace",
      "font-size": "0.9em"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] > textarea": {
      "width": "100%",
      "min-height": "16rem",
      "resize": "vertical",
      "font-family": "ui-monospace, monospace",
      "font-size": "0.875rem",
      "line-height": "1.6",
      "padding": "0.75rem",
      "background": "inherit",
      "color": "inherit",
      "border": "1px solid var(--boring-editor-border, var(--border, #d1d5db))",
      "border-radius": "0.375rem",
      "box-sizing": "border-box"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] [role=\"alert\"]": {
      "border-left": "3px solid var(--boring-editor-danger, var(--destructive, #b91c1c))",
      "padding": "0.75rem",
      "overflow-wrap": "anywhere"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] [data-boring=\"proposal\"]": {
      "border": "1px solid var(--boring-editor-border, var(--border, #d1d5db))",
      "padding": "0.75rem",
      "border-radius": "0.375rem"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] [data-boring=\"proposal\"] summary": {
      "cursor": "pointer",
      "font-weight": "600"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] .boring-markdown-content:focus-visible": {
      "outline": "2px solid var(--boring-editor-focus, var(--ring, #2563eb))",
      "outline-offset": "2px"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] [data-boring=\"proposal-diff\"]": {
      "font-family": "ui-monospace, monospace",
      "font-size": "0.875rem",
      "line-height": "1.5",
      "overflow-x": "auto"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] [data-diff]": {
      "white-space": "pre-wrap",
      "overflow-wrap": "anywhere",
      "padding": "0.125rem 0.375rem"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] [data-diff=\"add\"]": {
      "background": "var(--boring-editor-diff-add-background, #ecfdf5)",
      "color": "var(--boring-editor-diff-add-foreground, #065f46)"
    },
    ".boring-markdown-recipe[data-boring=\"markdown-editor\"] [data-diff=\"remove\"]": {
      "background": "var(--boring-editor-diff-remove-background, #fff1f2)",
      "color": "var(--boring-editor-diff-remove-foreground, #9f1239)"
    }
  },
  "docs": "Create and own a MarkdownController from @hachej/boring-ui-kit/markdown. Pass it to MarkdownEditor. The wrapper does not acquire resources or dispose the controller. Version 1.0.0 is a private release candidate tested through local tarballs; no hosted registry or npm publication is advertised.",
  "type": "registry:component"
}